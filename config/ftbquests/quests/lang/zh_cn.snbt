		"{image:kubejs:textures/gui/ftb_kjs1.png width:80 height:100 align:center}"
	]
	quest.0BB5CE1550F46002.quest_subtitle: "我要干啥来着"
	quest.0BB5CE1550F46002.title: "置顶"
	quest.0BCF6B18963AB88F.quest_desc: [
		"那已死去的怪物，被某种魔法强行复苏，仿佛背后有某种意志在牵引。"
		""
		"&7当它再次倒下时，体内封存的力量似乎逸散而出……我得去查探一番，看看留下了什么痕迹。"
		""
		"&d解锁：魔法矿物"
	]
	quest.0BCF6B18963AB88F.quest_subtitle: "亡者力量"
	quest.0BCF6B18963AB88F.title: "震怒的死者之王"
	quest.0C2F2186BE39605E.quest_desc: [
		"&6猎人营地&r"
		"&7猎人群居生活，因此他们在主要狩猎地点沿线建造了营地，主要分布在猎物丰富的&b森林&r&7地带。这些营地也可以通过从起源之岛获得的&e卷起的地图&r&7找到。&r"
	]
	quest.0C2F2186BE39605E.quest_subtitle: "发现猎人营地"
	quest.0C2F2186BE39605E.title: "&6猎人营地&r"
	quest.0C95DCE08BB56AF5.quest_desc: [
		"&6灵固符文&r"
		""
		"&7灵固符文不会促进形体的能力，而只是向其奥术存在施加压力，增加&e灵魂护盾&r&7的容量和稳固度。&r"
	]
	quest.0C95DCE08BB56AF5.quest_subtitle: "促进制造的脉动"
	quest.0CC6907B16C93F5E.quest_subtitle: "丛林精粹"
	quest.0CCFA64CA88D2D22.quest_desc: [
		"# &3可按R键进行一键整理(默认设置下) &r"
		""
		"### &b注意事项 &r"
		"&7- 默认情况下 ，按R会以创造模式进行排序&r  "
		"&7- 按下Shift+R时，会以数量进行排序&r  "
		"&7- 按下Ctrl+R时，会以字母顺序进行排序&r  "
		"&7- 按下Alt+R时，会以ID进行排序&r  "
	]
	quest.0CCFA64CA88D2D22.quest_subtitle: "多种选择!"
	quest.0CCFA64CA88D2D22.title: "R键整理"
	quest.0CFA26B3944AAF49.quest_desc: [
		"如需提升材料属性，可使用星光充能仪进行强化。"
		""
		"在露天环境布置一个7×7的区域，中央放置充能仪，四角各立一根两格高的柱子。柱顶放置的方块将决定充能等级："
		"{image:kubejs:textures/gui/starlight_charger.png width:180 height:100 align:center}"
		""
		"等级1：绯红钢块，需要烈焰金粉作为催化剂。"
		""
		"等级2：蔚蓝琥珀金块，需要蔚蓝银粉作为催化剂。"
		""
		"等级3：提尔钢块，需要星辉粉作为催化剂。"
		""
		""
		"{@pagebreak}"
		"放置完成后，等待约15秒让充能仪识别环境。该设备仅在夜晚露天环境下工作，且需消耗能量。"
		""
		"高阶充能仪可使用低阶催化剂，但充能等级以催化剂对应的等级为准。"
	]
	quest.0CFA26B3944AAF49.quest_subtitle: "材料灌注"
	quest.0D134B44D9F3BA01.quest_desc: [
		"&6坚盾条约"
		"&7加速的外在与易碎的本性不可分离。&r&c灵魂护盾稳固度减半"
		"&7加速形态的灵魂护盾，如及时雨般化险为夷。&r&a增加灵魂护盾容量&r&a灵魂护盾恢复速率翻倍"
	]
	quest.0D134B44D9F3BA01.quest_subtitle: "行事警觉"
	quest.0D134B44D9F3BA01.title: "坚盾条约"
	quest.0D1AFFB3C244802E.quest_desc: [
		"&6传送门框架&r"
		"&7一种助力各位法师创造永久的传送门的功能性方块。&r"
		"&7刚被放置时，传送门框架只是一个空壳，只有其边框有碰撞箱。&r"
		""
		"&7通过使用&e此呼彼应魔杖&r&7等方式对传送门框架施放&b末影传送门&r&7法术，便可使之变为可以用于传送的传送门，它只能与另外一个被施放了施放末影传送门法术的传送门框架相连接以进行传送。这样的两个传送门没有相隔距离限制，且是永久存在的。&r"
		""
		"&7不要试图在创造了一个传送门的情况下破坏本方块，否则会出现模型消失但本方块依然存在的问题，直到你把它与另一个传送门相连接。&r"
		""
		"&7玩家可以通过消耗1个任意染料来为已激活的传送门染色，对应的另一个传送门也会被自动染色。&r"
	]
	quest.0D1AFFB3C244802E.quest_subtitle: "快速跃迁"
	quest.0ED82FFAE99D2480.quest_desc: [
		"&e廉价的化工产物。"
		"&6比岩浆更优秀的常规选择。"
		""
		"⚡ 速度：1.0x | ♨ 温度：2000 | ⏳ 消耗：0.3"
		""
		"&a提示&r&7：&f♨ &r&7温度决定可处理的材料等级，⚡ 速度影响处理耗时，⏳ 消耗代表燃料的持久度。"
	]
	quest.0ED82FFAE99D2480.quest_subtitle: "更好的燃料"
	quest.0EEA8DDC455E7FCB.quest_desc: [
		"&7在观察&8腐枯&r&7扩散的过程中（当然，是在可控环境下），我注意到这种形而上学的伤害偶尔能强大到在石头上留下疮疤——因此，我将其命名为“&6疮疤石&r&7”。"
		"&7"
		"{@pagebreak}"
		"&6疮疤石研究：质地"
		"&7疮疤石是一种奇怪的岩石，从某种意义上说，和&8腐枯&r&7有些类似。我在其中检测到了花岗岩、黑曜石、闪长岩、安山岩的碎屑，也有不少普通的石头；这些碎屑只是杂乱地散在其中，毫无规律可言。它也不会回应&b释缚仪式&r&7。"
		"&7"
		"{@pagebreak}"
		"&6疮疤石研究：制造"
		"&7这种石材的出现貌似纯属随机，我还未验明具体的引发条件。但大约每十次&8腐枯&r&7蔓延，这种残暴的嬗变即会刻出一处疮疤石团。"
		"&7"
		"{@pagebreak}"
		"&6疮疤石研究：怪异晶体"
		"&7虽然它对&b释缚仪式&r&7没有反应，但它好像有种奇怪的……增生物？这种增生物本身是晶体，却表现得像是植物。我不清楚它有什么用途。如果我是&d生物法师&r&7的话，这项发现大概算得上一生难遇。"
	]
	quest.0EEA8DDC455E7FCB.quest_subtitle: "扭曲的岩石"
	quest.0EF9389ADF9236E6.quest_desc: [
		"&6魔法精华&r"
		"&7用于提升&b法术强度&r&7和&b法术抗性&r&7的消耗品。每种均有3个等级，并有使用上限。通过以下方式获得：&r"
		"&7强度：由&e魔法生物&r&7掉落，通过&6仪式&r&7升级。&r"
		"&7抗性：通过&e缩物器&r&7获得，通过&6仪式&r&7升级。&r"
	]
	quest.0EF9389ADF9236E6.title: "&6魔法精华：抗性&r"
	quest.0F731D1ED5DD01BC.quest_desc: [
		"&6风拂条约"
		"&7风亦拂面。&r&c动量越大，所受击退就越强"
		"&7协风奔走。&r&a疾跑会积攒动量"
	]
	quest.0F731D1ED5DD01BC.quest_subtitle: "与风合一"
	quest.0F731D1ED5DD01BC.title: "风拂条约"
	quest.11047BEDA6023228.quest_desc: [
		"&6神秘宝珠&r"
		"&7右键点击可获得&e竖琴&r&7和&e失落旋律&r&7饰品。通过&6岛屿仪式&r&7获得。要能够使用神秘宝珠，你需要完成所有&b元素魔宠&r&7（吟游诗人魔宠除外）的驯服进度。&r"
		"&5或者直接进行仪式合成以跳过繁杂的驯服过程"
	]
	quest.110C8BBFDBFBA375.quest_subtitle: "&c这将清空你当前选择的难度设置，所有生物的血量，攻击倍率，护甲，护甲韧性将X8"
	quest.110C8BBFDBFBA375.title: "&c\"不可名状的怪力与暴戾\""
	quest.1117830BC3A66701.quest_desc: [
		"&6坩埚加速"
		"&7&b精魂坩埚&r&7有其短处：速度较慢。将&e奥术能量&r&7聚集至中央物品需要时间。这也并非毫无理由，大多数物质承受不了那么快的能流，过载催化剂也容易导致其破损。"
		"&7"
		"&7然而，若以神秘方式加热催化剂，就可以减轻这种排斥现象，同时加快聚集的速度。这正是&b精魂催化器&r&7的用途。但这也并不是完美方案，不稳定性常会使催化剂产生非必要的&c损伤&r&7。"
		"&7"
		"&7坩埚周围每座启动的催化器均会加快聚集的速度，最多接受八座。不过，失稳风险也会与催化器数成比例增加，可能导致催化剂受到额外非必要的损伤。"
	]
	quest.1117830BC3A66701.quest_subtitle: "加温加热"
	quest.1117830BC3A66701.title: "坩埚加速"
	quest.11789A166C0520B4.quest_subtitle: "魔宠召唤仪式"
	quest.11838DA838ECEA4D.quest_subtitle: "奥术材料"
	quest.11C363982673E669.quest_desc: [
		"&7我尝试了多种材料制作抄写台，最终发现符文木的效果最为显著。"
		""
		"在其表面进行誊录时，墨迹中的能量流转更为稳定，符文畸变与能量逸散的风险显著降低——简而言之，抄录的可靠性得到了切实保障。"
	]
	quest.11C363982673E669.quest_subtitle: "攥录法术"
	quest.11E9AE8529E6FBF2.quest_subtitle: "村庄英雄"
	quest.12070A3305878F5D.quest_desc: [
		"&6流体储罐&r"
		""
		"&6摆放&r"
		"&7当流体储罐被摆放成底面为正方形的1*1*n、2*2*n或3*3*n长方体时，相邻储罐会自动合并为整体。&r"
		"&7储罐结构的高度n最高为32格，超过此高度后上方的储罐将被视为独立的新储罐。&r"
		""
		"&6储存流体&r"
		"&7可储存各类流体，每个方块容量为8 B（8000 mB，即8桶）。需通过动力泵进行输入与输出。&r"
		"&7在创造模式下，手持装有流体的容器（如桶）右击储罐可直接注入流体；生存模式下则需使用分液池配合其他流体元件进行输入。&r"
		"&7手持扳手右击储罐可打开或关闭其观察窗，便于查看内部流体状态。&r"
		"&7流体储罐可被比较器、物品侦测器及存量转换器检测。物品侦测器的过滤槽可使用桶装或瓶装流体进行标记。&r"
		""
		"&6作为锅炉&r"
		"&7当在流体储罐表面安装蒸汽笛或蒸汽引擎时，该储罐结构将转变为锅炉结构。此时观察窗会消失，每个侧面将出现一个压力计。&r"
		"&7锅炉用于为连接的蒸汽笛或蒸汽引擎提供蒸汽。&r"
		""
		"&8手稿的这一页边缘画着一个叠高的罐体，侧面连着几个简笔的仪表。下方草草写着一行小字：装得满，看得清，必要时也能吼出声。&r"
	]
	quest.124EF6C94011C149.quest_desc: [
		"&6奇异蘑菇&r"
		"&7右键对已驯服的魔宠使用，赋予其1层‘&c狂怒&r&7’效果（受到攻击时，有概率消耗1层‘&c狂怒&r&7’以获得持续数秒的‘&c止心术&r&7’状态）。每只魔宠最多可叠加10层，由&e哞菇&r&7和被剪毛的&e沼泽村民&r&7掉落。&r"
	]
	quest.12C9785ECF565304.quest_subtitle: "阶段0"
	quest.131FF32C0FF28CA8.quest_desc: [
		""
		"击败它  将沸腾的死亡权能敛入一柄权杖  那颗失活的心脏  却是被抽离的时间终点的标本...击败它  将解放整个世界的魔法矿物"
		""
		"&7或许存在一种方法？可以在没有击败它的前提下夺走它的权杖"
	]
	quest.131FF32C0FF28CA8.quest_subtitle: "阶段0 击杀后解锁 阶段1"
	quest.13AFD3688361872A.quest_desc: [
		"# &a游戏修改内容 &r"
		""
		"### &e冰火传说调整 &r"
		"&7- &f小精灵不再偷取玩家物品&a，可放心圈养 &r"
		""
		"### &#FFBB1A死亡不掉落调整 &r"
		"&7- &f若不开启死亡不掉落，死亡复活不再恢复至完美状态，死亡会保留快捷栏物品与装备，&r"
		""
		"### &e铁魔法调整 &r"
		"&7- &f大部分法术现在需要&d学习后才能使用 &r"
		""
		"{@pagebreak}"
		"### &#FF9F9A物品Tooltip调整&r"
		"&7- &f如发现物品Tooltip过长,可使用滚轮上下滚动来浏览 &r"
		""
		"### &#FF91EE告示牌调整&r"
		"&7- &f贴在诸如箱子一类上面的告示牌,可以潜行进行修改,直接点击会穿过告示牌点击至容器内物品 &r"
		""
		"### &#C9FF74实体清理系统 &r"
		"&7- 配置文件路径: &9kubejs/server_scripts/entity_clean.js &r  "
		"&7- &f整合包自带&6自动清理系统(默认关闭)&f，可在此文件内配置:  "
		"  &7▪ &f清理内容  "
		"  &7▪ &f开关状态 &r  "
		"&7- &f如需手动清理，可使用命令: &b/rf entityclean &r"
	]
	quest.13AFD3688361872A.quest_subtitle: "游戏体验修改"
	quest.13AFD3688361872A.title: "一些改动"
	quest.13C22895EB17EE88.quest_desc: [
		"&6注液器&r"
		""
		"&7专用于执行“注液”加工的设备，可完成以下操作：&r"
		"&7使用流体装填容器类物品（如桶、玻璃瓶），对大多数模组流体同样有效；&r"
		"&7执行机械动力模组提供的特殊注液配方（如湿润草方块、制作烈焰蛋糕等）。&r"
		""
		"&6使用要求&r"
		"&7必须通过流体管道等流体元件向注液器输入流体，无法直接使用桶手动灌装。&r"
		"&7可对下方传送带或置物台上的物品进行加工。当可加工物品进入其工作范围时，将播放注液动画并消耗相应量的流体，每次注液过程耗时21游戏刻（1.05秒）。&r"
		"&7当注液器内无流体或流体不足时，会截停传送带上可被加工的物品，直至补充流体。&r"
		""
		"&8等它喝饱，才能喂饱下面的。&r"
	]
	quest.13C542FCBB189AEA.quest_subtitle: "无名旅者"
	quest.13CCBB1FAF6834F4.quest_desc: [
		"&6符文木方尖碑"
		"&7精魂灌注，其必要性和累人性都与日俱增，简单如制作一堆咒灰都要耗上几分钟。"
		""
		"&7而加速的方法就藏在&6神圣金&r&7之中。将最多四座由其制作的方尖碑放在祭坛周围，就能以每座&a四分之一&r&7的比例加快此过程的速度了。"
		""
		"&6经验晶方尖碑"
		"&7尽管其本身对灌注过程没有大用，方尖碑的构造还可再加利用。"
		""
		"&7将神圣金换为&e经验晶&r&7，方尖碑便会与附魔的才智谐和，从而提供大量附魔力量。"
		"&7一座这样的方尖碑，就可与&b五个书架&r&7等同。"
	]
	quest.13CCBB1FAF6834F4.quest_subtitle: "方尖碑"
	quest.13CCBB1FAF6834F4.title: "祭坛加速"
	quest.13DF171E70CF449D.quest_desc: [
		"&o用风力，或是水力，甚至最原始的人力，总之，它转动了起来。"
		"&r"
		"接上齿轮，让它们旋转碰撞，传输应力，奏响乐章——手稿上是这么写的。"
		""
		"我的疑惑都可以通过&6按[W]思索&r解决，我相信前路畅通无阻。"
		""
		"&8不过，只要是有羊毛的风车就能无风自动，这也是机械师的智慧吗？&r"
	]
	quest.13DF171E70CF449D.quest_subtitle: "然后齿轮开始转动..."
	quest.13DF171E70CF449D.title: "齿轮初鸣"
	quest.13FB94D18517171F.quest_desc: [
		"&6工作盆&r"
		""
		"&7它是机械师工坊里最宽容的容器，耐心地容纳着各种物品与流体，等待它们按照既定的配方发生转化。&r"
		""
		"&6内部的秩序&r"
		"&7工作盆拥有18个物品槽位：前9个用于接受原料，后9个用于存放成品。每种物品最多可堆叠一组（64个）。&r"
		"&7同时，它还拥有4个流体槽位，每种流体最多容纳&c1000 mb&7，所有流体总量不超过&c4000 mb&7。无论何时，单种流体都不会超过1000 mb的界限。&r"
		"&7物品与流体在此和平共处，互不干扰。甚至岩浆与水也能安然共存——它们在工作盆内不会相互作用。&r"
		"{@pagebreak}"
		"&6输入与输出的规则&r"
		"&7它的六个面都能接受或输出物品，但任何自动化输入每次只能送入&c1到16个&7物品。例外的是，以掉落物形式进入的物品可以一次堆满64个。&r"
		"&7动力臂、黄铜漏斗等元件最多也只能输入16个，且黄铜漏斗无法设置具体数量。&r"
		"&7输出时则宽松许多：安山漏斗每次输出1个，而黄铜漏斗、动力臂则可按配置输出1至64个。传送带与分液池也可以作为输入端，让物品从边缘滑入盆中。&r"
		"&7流体需通过动力泵或连接动力泵的管道进行传输。泵入时优先填充输入槽，泵出时优先抽取输出槽。若输出槽为空且有空间，则会抽取输入槽的流体——这一点需要格外留意，以免混淆配方。&r"
		"{@pagebreak}"
		"&6过滤与导向&r"
		"&7工作盆侧面有一个过滤器插槽。放入单个物品、&e过滤器&7或&e属性过滤器&7，即可指定它只生产标记的产物（流体可用瓶装样品标记）。&r"
		"&7当侧面无阻挡且斜下方有开放式容器时，工作盆会自动生成一个&e输出龙头/开口&7，尝试将产物送出。这个龙头拥有一个隐藏的输出槽位——只要其中有物品，工作盆就会停止工作，这是许多产线莫名卡住的常见原因。&r"
		"&7龙头一次只容纳一次配方的输出。若配方产出多个物品，第一个会进入龙头槽位，其余的则进入工作盆的输出槽。使用&e扳手&7可以调整龙头位置或将其关闭。只要斜下方方块不更新，龙头就不会再次出现。&r"
		"&7可被判定为自动输出容器的包括：工作盆、置物台、传送带、漏斗、粉碎轮等大多数机械动力元件，但原版漏斗不在此列。&r"
		"{@pagebreak}"
		"&6配方的处理顺序&r"
		"&7当与&e动力辊压机&7或&e动力搅拌器&7等设备协作时，工作盆会按以下逻辑处理配方：&r"
		"&7若输入槽有可处理的配方：先处理纯物品配方，再处理物品与流体混合的配方，最后处理纯流体配方。&r"
		"&7若输入槽没有配方：则优先处理所有物品槽位中的配方，然后是物品与流体的混合，最后是纯流体。&r"
		""
		"&7其他细节：同种物品会尽量堆叠在已存在的槽位中，不会轻易占用新槽位。若9个输出槽位已满，所有加工作业都将停止。&r"
		""
		"&8纸页边缘有块深色的污渍，像是有人把沾着机油的拇指按在了这里。&r"
	]
	quest.13FB94D18517171F.quest_subtitle: "一个小小的方形容器，但却是整个工厂的核心"
	quest.142C80D05D6B1FDC.quest_subtitle: "清除你调整过的所有难度设置，包括神弃之子"
	quest.143A6CDB76F7A3DC.quest_subtitle: "阶段0"
