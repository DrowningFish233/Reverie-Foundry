	quest.02AFD33E635B23E1.quest_desc: [
		"&6破念瘾君条约"
		"&7咒语带来的负面影响不容小觑。&r&c每有一天未收割精魂会导致戒断反应叠加，不断消耗更多饥饿值，直至渴望得以满足"
		"&7强加于意识的咒语——对奥术能量永无停歇的渴望。&r&a击碎灵魂产出额外奥术能量&r&a连续击碎产出更多"
	]
	quest.02AFD33E635B23E1.quest_subtitle: "破念复破念"
	quest.02AFD33E635B23E1.title: "破念瘾君条约"
	quest.02BFE6EA90831AED.quest_desc: [
		"&6重负意识誓约&r"
		""
		"&7所获的知识要求你谨慎考虑。&r"
