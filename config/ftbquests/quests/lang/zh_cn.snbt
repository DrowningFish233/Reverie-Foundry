	quest.3BE884F16DB02E3D.quest_subtitle: "不是我喜欢的部件，直接拿走"
	quest.3C4F9B874C336EB6.quest_desc: [
		"# &cBUG反馈渠道 &r"
		""
		"### &e反馈方式 &r"
		"&6➤ &f官方群聊反馈"
		"&6➤ &fGitHub提交Issue"
		""
		"&6鳕鱼如果看到会尽快处理的！！！"
		""
		"### &9官方链接 &r"
		"&6▪ &bGitHub Issues: "
		"&fhttps://github.com/DrowningFish233/Reverie-Foundry/issues"
		"&6▪ &bMC百科页面: "
		"&fhttps://www.mcmod.cn/modpack/907.html"
		""
		"### &3注意事项 &r"
		"&7- 反馈时请尽量提供:"
		"  &8• &f详细重现步骤"
