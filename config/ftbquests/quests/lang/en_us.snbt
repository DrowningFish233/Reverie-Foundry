	quest.00A163FF140033A4.quest_desc: [
		"&6Tremor Gel&r&7"
		"&7Material dropped after killing a &#A351DACrystal Moth&r&7;&r"
		""
		"&7Players can tame the &#A351DACrystal Moth&r&7. Feeding &eMoonmoth Paste&r&7 to a tamed Crystal Moth has a &#FFA07Alow chance&r&7 to produce 1 &#00CED1Tremor Gel&r&7;&r"
		""
		"&7Can be used to craft the &#8A2BE2Sonic Bomb&r&7.&r"
	]
	quest.00A5A64046D3B0EF.quest_desc: [
		"&6Compared to the Salvaging Tome, this advanced version better maintains enchantment stability, fully stripping and preserving all enchantments on equipment.&r"
		""
		"An upgraded version of the Salvaging Tome. It can transfer all enchantments on an item, but the item is still destroyed."
	]
