	quest.020AE936ACC785EC.quest_subtitle: "Number Shield Enjoyer"
	quest.020AE936ACC785EC.title: "Malice Fortress Chestplate Template"
	quest.020D4D3AF729797D.quest_desc: [
		"&7The &#66DDCCRepair Kit&7 can be loaded with materials for repair at a crafting table or in the player's own 4-slot crafting grid."
		""
		"&7You can place &#66CCFFSilent Gear materials&7 there to repair weapons and equipment. The prerequisite for repair is that the &#FFD700repair kit must contain the exact same material as the weapon's main part&7."
		""
		"{image:kubejs:textures/gui/silentgear/sturdy_repair_kit.png width:200 height:100 align:center click_action:none:}"
		"{@pagebreak}"
		"&7You can fill the slots to load multiple materials at once, or place them one at a time."
		""
		"&7To repair a tool, place the &#66CCFFSilent Gear tool&7 to be repaired into the crafting grid along with a &#66DDCCRepair Kit&7 loaded with the corresponding material."
		""
		"{image:kubejs:textures/gui/silentgear/sturdy_repair_kit2.png width:200 height:160 align:center click_action:none:}"
	]
	quest.020D4D3AF729797D.quest_subtitle: "My Silent Gear has no durability left! How do I repair it!"
	quest.020D4D3AF729797D.title: "Repair Kit"
	quest.0218EB7431BC6CBD.title: "Zombie Giant Rat Beast"
	quest.023E0809115DF9D3.quest_desc: ["&7Eliminates wind influence and adds a dashboard to the aircraft. Enhances immersion (?), improves stability during flight, and can prevent flips to some extent."]
	quest.02754C209AD4C9F5.quest_desc: ["&7I began trying to infuse Spirit energy into different objects—but clearly, results don't come from infusing at random. There is also a matter of compatibility between Spirits and different materials; only sufficiently compatible recipes can exist stably."]
	quest.02754C209AD4C9F5.title: "Material Research"
	quest.029325786CAA1DA2.quest_desc: [
