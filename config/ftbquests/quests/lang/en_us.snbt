	quest.00A163FF140033A4.quest_desc: [
		"&6Shivering Gel&r&7"
		"&7Dropped by &A351DAGlowing Moths&r&7 upon death; &r"
		""
		"&7Players can tame &A351DAGlowing Moths&r&7. Feeding &eLunaris Cactus Cream&r&7 to a tamed Glowing Moth has a &#FFA07Alow chance&r&7 to produce 1 &00CED1Shivering Gel&r&7; &r"
		""
		"&7Can be used to craft &8A2BE2Sonic Bombs&r&7. &r"
	]
	quest.00A5A64046D3B0EF.quest_desc: [
		"&6Compared to the Disenchantment Lexicon, this advanced version better maintains enchantment stability, allowing all enchantments on an item to be fully extracted and preserved intact.&r"
		""
		"An upgraded version of the Disenchantment Lexicon that can transfer all enchantments from an item, though the item is still destroyed."
	]
	quest.00A5A64046D3B0EF.quest_subtitle: "Recycle, Reuse!"
	quest.00C7BD5A5443E2F4.quest_desc: ["&7Functions like the vanilla &#66CCFFAxe&7. Can be crafted by placing a vanilla &#66CCFFAxe&7 in a crafting table to convert it into an &#66DDCCSilent Gear Axe&7."]
	quest.00C7BD5A5443E2F4.quest_subtitle: "Standard \"Lumber\" Tool"
	quest.0108AD0A0C6B606D.quest_desc: ["&7Right-click to throw a massive &#FFD700Anchor&7 to attack enemies. Sneak + Right-click summons &#66CCFFwaves&7 around you."]
	quest.0108AD0A0C6B606D.quest_subtitle: "My anchor hates what I hate and loathes what I loathe. My anchor... brooks no defiance!"
