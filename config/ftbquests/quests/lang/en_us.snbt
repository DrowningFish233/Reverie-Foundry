	quest.086482C52023DB55.quest_subtitle: "A utility tool for finding the underground dragon nest nearest to you."
	quest.0919F71D241AFD81.quest_desc: [
		"&6Pleasure Target Authority&r"
		""
		"&7Your form stagnates in time, anomaly detached from world. Form does not age, nor perceive outside.&r"
		"&7-Received &call healing&r&7 reduced to one quarter&r"
		""
		"&7Authority—treaty between your form and world's original.&r"
		"&7-When hit, form enters &6Stagnation State&r"
		"&7-In &6Stagnation State&r&7, all &epotion effects&r&7 timers pause and do not dissipate&r"
		"&7-Life regen, poison, etc., effects requiring time flow fail; those unaffected by stagnation remain effective&r"
	]
	quest.0919F71D241AFD81.quest_subtitle: "World's Happiest"
	quest.0919F71D241AFD81.title: "Pleasure Target Authority"
	quest.092C65BDEC1E30A4.quest_desc: [
		"&6Transmogrification Altar&r"
		""
		"&7Worried your weapon looks too ugly?&r"
		"&7Worried it lacks style?&r"
		""
		"&7The Transmogrification Altar is your premier choice! Whether you want to &apretend to be weak to eat the tiger&r&7 or &apretend to be a tiger to eat the pig&r&7! The choice is yours!&r"
		""
		"&7Place the &eweapon&r&7 to be transmogrified in the first slot, and place the item you want it to look like in the second slot. Then consume Amethyst Energy to transmogrify your weapon!&r&7&r"
	]
	quest.092C65BDEC1E30A4.quest_subtitle: "Ever-changing"
	quest.0973A81F39964B58.quest_subtitle: "Familiar Summoning Ritual"
	quest.09BD7CB2DEA2CD89.quest_subtitle: "Customized Experience"
	quest.09E68D57095A5F1D.quest_desc: [
		"&7Standardized weapons are limited by uniform specifications, making it difficult to fully utilize materials' characteristics."
		""
		"I'm not an outstanding craftsman, but I can still make them according to blueprints."
		""
		"&7Perhaps using different materials for each component is necessary to maximize the unique properties and energy inherent in the materials themselves."
	]
	quest.09E68D57095A5F1D.title: "The Beginning of Everything"
	quest.0A13EAB37AB4ACEF.quest_desc: [
		"&6Familiar Trinkets&r"
		"&7Familiar trinkets are items that can be equipped in accessory slots, providing different beneficial effects for the corresponding familiar.&r"
		""
		"&7&eMagic Leaf&r&7: Increases the &aspell power&r&7 of &bDruid&r&7 familiars. Can be found in &bJungle Temples&r&7.&r"
		""
		"&7&eHunter's Chain&r&7: Increases the &aspell power&r&7 of &bHunter&r&7 familiars. Can be found in &cEvoker Fortresses&r&7 or &bHunter Camps&r&7.&r"
		""
		"&7&eLich Emblem Necklace&r&7: Increases the &aspell power&r&7 of &cNecromancer&r&7 familiars. Can be found in &8Graveyards&r&7.&r"
		""
		"&7&eForgotten Crown&r&7: Increases the &aspell power&r&7 of &bConjurer&r&7 familiars. Can be found in &cAncient Cities&r&7.&r"
		""
		"&7&eShining Crown&r&7: Increases the &aspell power&r&7 of &6Archmage&r&7 familiars. Can be found in &6Archmage Laboratories&r&7.&r"
		""
		"&7&eGolden Bell&r&7: Increases the &aspell power&r&7 of &dIllusionist&r&7 familiars. Can be found in &bWoodland Mansions&r&7.&r"
		""
		"&7&eWizard's Candelabra&r&7: Increases the &aspell power&r&7 of &eBlazing&r&7 familiars. Can be found in &cArsonist Mage Towers&r&7.&r"
		"{@pagebreak}"
		"&7&eBlessed Chalice&r&7: Increases the &aspell power&r&7 of &aCleric&r&7 familiars. Can be found in &aCleric Huts&r&7.&r"
		""
		"&7&eThunder Emblem Necklace&r&7: Increases the &aspell power&r&7 of &6Stormcaller&r&7 familiars. Can be found in &bMountain Towers&r&7.&r"
		""
		"&7&eFoul Cheese Necklace&r&7: Increases the &aspell power&r&7 of &cPlague Doctor&r&7 familiars. Can be found in &bIce Spike Shipwrecks&r&7.&r"
		""
		"&7&eLost Melody&r&7: Increases the &aspell power&r&7 of &dBard&r&7 familiars. Can be obtained via &eMystic Orbs&r&7.&r"
		""
		"&7&eFrost Flower&r&7: Increases the &aspell power&r&7 of &bFrost&r&7 familiars. Can be found in &bIce Spider Nests&r&7.&r"
		""
		"&7&eDragon's Tear&r&7: Increases the &aspell power&r&7 of &6Dragoon&r&7 familiars. Dropped by &cEnder Dragon&r&7.&r"
		""
		"&7&ePandora's Box&r&7: Allows simultaneous &asummoning/dismissal&r&7 of up to 10 familiars. Obtained via crafting.&r"
	]
	quest.0A13EAB37AB4ACEF.title: "Any Familiar Trinket"
	quest.0A1FF9CCFB4FEA6C.quest_subtitle: "Hitting My Teammates"
	quest.0A1FF9CCFB4FEA6C.title: "First Player Kill"
	quest.0ABD1C741FFFC78C.quest_desc: [
		"&6Searing Frenzy Rune&r"
		""
		"&7Searing Frenzy Rune's ability similar to namesake ritual, grants wearer &bSearing Frenzy&r&7 effect at half potency, slightly speeding &aattack&r&7 and &adigging&r&7 speed.&r"
	]
	quest.0ABD1C741FFFC78C.quest_subtitle: "Polish Pulse"
	quest.0AD556BD2B2A47D2.quest_desc: [
		"&6Can be connected to fluid outlets for output, or use &r"
		""
		" [ { \"text\": \"Fluid Pipe[Click to Jump]\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"1F38C534465F33BC\" } } ]"
		""
		"&6for import operations, importing fluids into the forge to achieve automation"
	]
	quest.0AD556BD2B2A47D2.quest_subtitle: "Export Fluid? Import Fluid?"
	quest.0B0C47F37FDE6435.quest_desc: [
		"&7Soulweave Silk is lightweight yet resilient material filled with things like &6souls&r&7. Like forms, it naturally blocks &darcane energy&r&7. Though other materials share this effect, &6Soulweave Silk&r&7 easier to process, at least much better than &8stone&r&7."
		""
		"&7Soul fragments can glow, souls naturally glow. Why not let souls in silk emit light?"
		""
		"&7I created several &bbanners&r&7 to test effects, borrowing various &ereactants&r&7 and &6souls&r&7 to design patterns. When infused with energy, they emit &8dim light&r&7; infusing another soul makes them &edazzlingly bright&r&7."
	]
	quest.0B0C47F37FDE6435.quest_subtitle: "Weave Illusions"
	quest.0B33B7CF2E127A4F.quest_desc: [
		"&7During journeys, there are often many items needing storage. While chest storage offers considerable capacity, it sometimes proves inconvenient in certain situations..."
		""
		"I might need a lighter, more flexible carrying method."
	]
	quest.0B33B7CF2E127A4F.quest_subtitle: "Convenient and Fast"
	quest.0BA8FDE1647AA593.quest_subtitle: "Keep It Up"
