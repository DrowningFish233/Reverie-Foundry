	quest.029325786CAA1DA2.title: "Thunder Warhammer Template"
	quest.02AFD33E635B23E1.quest_desc: [
		"&6Pact of the Shattering Addict"
		"&7The negative effects brought by the incantation cannot be underestimated.&r&cEach day without harvesting Spirits causes withdrawal to stack, continuously consuming more hunger, until the craving is satisfied"
		"&7An incantation imposed upon the mind—a ceaseless craving for arcane energy.&r&aShattering souls produces extra arcane energy&r&aContinuous shattering produces even more"
		""
		"{image:kubejs:textures/gui/malum/pact_of_the_shattering_addict.png width:160 height:200 align:center}"
	]
	quest.02AFD33E635B23E1.quest_subtitle: "Shattering Upon Shattering"
	quest.02AFD33E635B23E1.title: "Pact of the Shattering Addict"
	quest.02BFE6EA90831AED.quest_desc: [
		"&6Oath of the Overburdened Mind&r"
		""
		"&7The knowledge you gain demands careful consideration.&r"
		"&7-&cSpell&r&7 charge time increased by one quarter&r"
		""
		"&7A dwelling place for arcane knowledge fused into the mind.&r"
		"&7-&aSpell charge capacity&r&7 doubled&r"
