	quest.01DFC41A894B42AC.quest_subtitle: "What are you looking at, never seen someone come home empty-handed?"
	quest.01FCAFCAA454BC91.quest_desc: [
		"&7Candles have been associated with the occult since ancient times. In Apotheosis enchanting, candles provide 1.25% &5Arcana&7. Although small, multiple candles together provide more &5Arcana&7 power."
		""
		"&7Candles scavenged in the early game can be used to scrape together some Arcana. Once you craft advanced bookshelves, they can retire."
	]
	quest.01FCAFCAA454BC91.quest_subtitle: "Weak Arcana Growth"
	quest.01FCAFCAA454BC91.title: "Primitive Occultism"
	quest.020AE936ACC785EC.quest_desc: [
		"&7Provides &#55D5D5Malice Ward capacity&7 based on &#66CCFFmagic armor&7."
