	quest.070C94F2F2F2D972.quest_desc: [
		"&6Repair Diffuser&r"
		""
		"&7Repair Diffuser, using fresh flesh as synesthetic anchor for natural life restoration. After completing one &6Focus Cycle&r&7, cauldron equipped with it has chance to slightly repair any &eCatalyst&r&7. But it cannot save already shattered catalysts.&r"
	]
	quest.070C94F2F2F2D972.quest_subtitle: "Dead Scar Tissue"
	quest.075AC794CF9E3665.quest_desc: [
		"# &eResource Pack Management &r"
		""
		"### &cResource Pack Path &r"
		"&7<Reverie Foundry>"
		"&7onfig\\paxi\\resourcepacks"
		""
		"### &6Operation Suggestions &r"
		"&f- Delete unwanted resource packs from this path"
		"&f- &cSome resources need to be additionally deleted in kubejs &r"
		"&f- For GUI texture packs:"
		" &7▪ &aStrongly recommend replacing rather than directly deleting &r"
		" &7▪ Replacement avoids missing UI elements issues"
		""
		"### &3Notes &r"
		"&7- Back up original files before operations"
		"&7- Deleting some resource packs may cause display abnormalities"
		"If display abnormalities occur, please delete resourcepack_load_order.json along with it"
	]
	quest.075AC794CF9E3665.quest_subtitle: "PAXI"
	quest.078C80DB81D1640E.quest_desc: [
		"&6Modpack Command Quick Reference&r"
		"&7The modpack provides many custom commands.&r"
		""
		"&6Wendigo&r"
		"&7&e/rf wendigosystem toggle&r&7 - Toggle Wendigo effects&r"
		"&7&e/rf wendigosystem status&r&7 - View status&r"
		""
		"&6Ore Stages&r"
		"&7&e/rf orestage&r&7 - View current stage status&r"
		"&7&e/rf orestage reset&r&7 - &cReset all data (Use with caution)&r&7"
		"&7&e/rf orestage reload&r&7 - Reload configuration files&r"
		"&7&e/rf orestage validate&r&7 - Validate config and auto-fix&r"
		"&7&e/rf orestage info&r&7 - View detailed progress info&r"
		"&7&e/rf orestage kills&r&7 - View kill statistics&r"
		""
		"&6Utility Functions&r"
		"&7&e/rf entityclean&r&7 - Clean up nearby miscellaneous entities; defaults to clearing some drops, arrows, etc. (configurable)&r"
		""
		"{@pagebreak}"
		"&6Added Tribulations&r"
		""
		"&6Status Management&r"
		"&7&e/rf deathsystem toggle&r&7 - Enable/Disable death penalty system&r"
		"&7&e/rf deathsystem status&r&7 - View death statistics and current status&r"
		""
		"&6Data Reset&r"
		"&7&e/rf deathsystem reset&r&7 - &cReset death count and restore max health on next respawn&r"
		""
		"&7&e/rf depression toggle&r&7 - Toggle Depression (Added Tribulation)&r"
		"&7&e/rf depression status&r&7 - View Depression (Added Tribulation)&r"
		""
		"&6Item Granting&r"
		"&7&e/rf give randomenchanted&r&7 - Claim a random enchanted book&r"
		"&7&e/rf give randomscrollid&r&7 - Claim a random scroll&r"
		"&7&e/rf give drunkard&r&7 - Claim the &bDrunkard Set&r&7 (various alcoholic drinks)&r"
		"&7&e/rf give traveler&r&7 - Claim the &bTraveler Set&r&7 (backpack + enchanted book)&r"
		"&7&e/rf give sorcerer&r&7 - Claim the &bSorcerer Set&r&7 (spellcasting equipment)&r"
		"&7&e/rf give warrior&r&7 - Claim the &bWarrior Set&r&7 (combat equipment)&r"
		""
		"&6Admin Functions&r"
		"&7&e/rf give setname playername&r&7 - Give another player a set&r"
		"&7&e/rf give setname playername clear&r&7 - &cReset a player's claim limit&r"
		""
		"&7&e/wits View current structure"
	]
	quest.078C80DB81D1640E.quest_subtitle: "I understand"
	quest.078C80DB81D1640E.title: "Useful Commands"
