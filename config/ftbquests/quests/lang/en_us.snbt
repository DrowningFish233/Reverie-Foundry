	quest.015EB916702B3797.title: "Inventory Check"
	quest.0166F102DF348A30.quest_desc: [
		"&6Pact of the Blastweaver&r"
		""
		"&7Your greed leads you to the ruins you have wrought.&r"
		"&7-&cGreed&r&7 increases &cexplosion&r&7 damage taken&r"
		""
		"&7Greed and urgency, honored by kinetic impact.&r"
		"&7-Greatly enhances &eexplosions&r&7, granting &6Greed&r&7 upon detonation&r"
