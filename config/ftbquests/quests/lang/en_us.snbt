	file.0000000000000001.title: "Reverie Foundry v0.5-Alpha"
	quest.002106F426003B4F.quest_desc: ["&7Increases the activation range, allowing the spawner to activate even when the player is farther away. Each upgrade adds 2 blocks, up to a maximum of 48 blocks."]
	quest.002106F426003B4F.quest_subtitle: "I can see you"
	quest.00616CF92A5F5FD1.quest_desc: [
		"&7The ominous premonition during the day was correct. This wilderness appears harmless in daylight, but at night, monsters begin to spawn. I can't even see where these monsters crawl out from; it's as if they appear out of thin air. I must have a complete shelter to safely spend the nights when I am unarmed."
		""
		"&7Using the initially gathered materials, I set up a crude shack in the lee of the wind. With the four walls enclosed, I finally have a sense of shelter and stability. Almost simultaneously, a clearer impulse rises from within—I need &6fire&7, need &riron&7, and even more, I need a furnace capable of processing metal."
	]
	quest.00616CF92A5F5FD1.title: "Establish a Base"
	quest.008A75CC21BEA1D0.title: "Light Horn Piranha"
	quest.00A163FF140033A4.quest_desc: [
		"&6Quivering Jelly&r&7"
		"&7A material dropped after killing the &#A351DAChrystal Moth&r&7.&r"
		""
		"&7Players can tame the &#A351DAChrystal Moth&r&7. Feeding &eLunar Moth Paste&r&7 to a tamed Chrystal Moth has a &#FFA07Alow probability&r&7 to produce 1 portion of &#00CED1Quivering Jelly&r&7.&r"
		""
		"&7Can be used to craft &#8A2BE2Sonic Bomb&r&7.&r"
	]
	quest.00A5A64046D3B0EF.quest_desc: [
		"&6Compared to the Disassembly Tome, this advanced version better maintains enchantment stability, allowing all enchantments on an item to be completely stripped and preserved.&r"
		""
		"An upgraded version of the Disassembly Tome, capable of transferring all enchantments from an item, but the item will still be destroyed."
	]
	quest.00A5A64046D3B0EF.quest_subtitle: "Recycle, and Reuse!"
	quest.00C7BD5A5443E2F4.quest_subtitle: "Standard 'Wood' Cutting Tool"
	quest.015EB916702B3797.quest_desc: [""]
	quest.015EB916702B3797.quest_subtitle: "To Be Continued"
	quest.015EB916702B3797.title: "Taking Stock"
	quest.0166F102DF348A30.quest_desc: [
		"&6Treaty of the Explosive Weaver&r"
		""
		"&7Your greed leads you to the ruin you yourself created.&r"
		"&7-&cGreed&r&7 increases &cExplosion&r&7 damage taken&r"
		""
		"&7Greed and haste, honored by kinetic impact.&r"
		"&7-Greatly enhances &eExplosions&r&7, granting &6Greed&r when detonated"
		"&7-&6Greed&r&7 increases &aLuck Probability&r"
		"&7-&6Greed&r&7 additionally enhances &eExplosions&r"
	]
	quest.0166F102DF348A30.quest_subtitle: "Reaping Ruin"
	quest.0166F102DF348A30.title: "Treaty of the Explosive Weaver"
	quest.017488D14BA19FAA.quest_desc: [
		"&fNote:"
		"&r&7Due to production capacity issues, some materials may not yet be compatible. Please look forward to future updates for support~&r"
	]
	quest.017488D14BA19FAA.quest_subtitle: "Check the Handbook frequently! It contains a complete material guide."
	quest.017488D14BA19FAA.title: "&eFor any mechanics or content you need to understand, remember to check the quests and handbook frequently!!!"
	quest.01891B78BD11035B.quest_subtitle: "Choose One"
	quest.01891B78BD11035B.title: "&a\"Honey that Masks Suffering at the Beginning?!\""
	quest.01DFC41A894B42AC.quest_subtitle: "Air Force"
	quest.01FCAFCAA454BC91.quest_desc: [
		"&7Candles have been associated with the occult since ancient times. In Apotheosis enchanting, candles provide 1.25% &5Arcana&7. Though small, multiple candles together provide more &5Arcana&7 power."
		""
		"&7Candles scavenged early on can be used to gather a bit of Arcana. They can be retired once you craft higher-tier bookshelves."
	]
	quest.01FCAFCAA454BC91.quest_subtitle: "Minor Arcana Increase"
	quest.01FCAFCAA454BC91.title: "Primitive Occultism"
	quest.0218EB7431BC6CBD.title: "Zombie Megarat"
	quest.023E0809115DF9D3.quest_desc: ["&7Eliminates wind effects and adds an instrument panel to the aircraft. Enhances immersion (?), and increases flight stability, helping to prevent flips to some extent."]
	quest.02754C209AD4C9F5.quest_desc: ["&7I have begun attempting to infuse the energy of spirits into different objects—but clearly, simply infusing them does not guarantee results. There is also a matter of compatibility between spirits and different materials; only sufficiently compatible recipes can stably exist."]
	quest.02754C209AD4C9F5.title: "Material Research"
	quest.02AFD33E635B23E1.quest_desc: [
		"&6Treaty of the Mind-Breaking Addict"
		"&7The negative side effects of the incantation are not to be underestimated.&r&cEach day without harvesting a spirit causes Withdrawal to stack, constantly consuming more hunger until the craving is satisfied"
		"&7A spell forced upon the consciousness—an unceasing craving for arcane energy.&r&aShattering souls produces additional Arcane Energy&r&aShattering consecutively produces even more"
	]
	quest.02AFD33E635B23E1.quest_subtitle: "Breaking Mind After Mind"
	quest.02AFD33E635B23E1.title: "Treaty of the Mind-Breaking Addict"
	quest.02BFE6EA90831AED.quest_desc: [
		"&6Pact of the Burdened Consciousness&r"
		""
		"&7The knowledge you have gained demands careful consideration.&r"
		"&7-&cSpell&r&7 charge time increased by a quarter&r"
		""
		"&7A vessel for arcane knowledge fused into consciousness.&r"
		"&7-&aSpell ammo capacity&r&7 doubled&r"
	]
	quest.02BFE6EA90831AED.quest_subtitle: "A Weight of Ten Thousand Pounds"
	quest.02BFE6EA90831AED.title: "Pact of the Burdened Consciousness"
	quest.02CBB1D9A926F86B.quest_desc: [
		"&6Tablecloth&r"
		""
		"&7A block combining item display and trading functionality. Can store and display up to four items, accessible via right-click. When multiple tablecloths are placed adjacent, their textures automatically connect.&r"
		""
		"&6Shop Functionality&r"
		"&7When paired with an &eInventory Transmitter&r&7, it can build an automated shop to sell stocked items to other players and collect payment.&r"
		""
		"&6Setting Items for Sale&r"
		"&7To set up a shop, follow these steps:&r"
		"&7Hold the Tablecloth and right-click an &eInventory Manager&r.&r"
		"&7In the interface, select the item and quantity to sell, specify the destination for goods, then click the &a‘Configure’&r&7 button.&r"
		"&7Place the configured Tablecloth in a suitable location to display the goods.&r"
		"&7Set the price for each item on the side of the Tablecloth.&r"
		"&7Each sales Tablecloth can be configured with up to nine different goods, but only the first four can be displayed simultaneously.&r"
		"&7Be sure to &clock the Logistics Network&r&7 in the top-right corner of the Inventory Manager interface to prevent goods from being directly extracted by others.&r"
		"{@pagebreak}"
		"&6Purchasing Items&r"
		"&7Aim at a sales Tablecloth to view transaction details. If stock is sufficient, trade directly.&r"
		"&7Right-click a sales Tablecloth to obtain a &ePurchase List&r&7, recording currently selected items. Holding the list allows you to continue buying other goods from the same shop; subsequent selections are automatically synced to the list.&r"
		"&7Hold the Purchase List and right-click the manager to checkout. The system automatically deducts the corresponding payment items from your inventory. Then, the &eInventory Transmitter&r&7 will send a request to extract the purchased goods.&r"
		"&7Payment made by customers is temporarily stored in the Inventory Transmitter. The shop owner can right-click to collect directly or use components like &efunnels&r&7 for automatic extraction.&r"
		""
		"&8A small line beside the manuscript: Display, price, trade—all reduced to simple contracts.&r"
	]
	quest.02CBB1D9A926F86B.quest_subtitle: "Tablecloth/Tabletop"
	quest.02CBB1D9A926F86B.title: "Shop"
	quest.03639EDED6577831.quest_desc: [
		"&#FFD700Greed - Erosion&r&7"
		"&7No special multiplier correction under normal conditions.&r"
		"&#00FFAA[Every 10 seconds]&r&7 If you have the &#FFAA00Greed&r&7 effect, increase its level by 1 (max level 3).&r"
		"&#00FFAA[After being attacked]&r&7 If you have the &#FFAA00Greed&r&7 effect, reset its level to 1.&r"
		"&7"
		"&#00FFAA[Per level of Greed effect]&r&7 Provides the following bonuses:&r"
		"&7- Chance for mobs to drop special items +5%&r"
		"&7- Looting, Luck of the Sea, and similar enchantment effect levels +2&r"
		"&7- Attraction range for experience orbs and dropped items +2 blocks&r"
		"&7- Experience gained from mining and kills +35%&r"
		"&7- Chance for spell scrolls not to be consumed +15%&r"
	]
	quest.03639EDED6577831.title: "Greed Erosion"
	quest.03D7343C57EF0A14.quest_desc: [
		"&7Prolonged contact with spirits seems to have confused my mind a bit; I can even hear strange calling sounds in my ears... No, that's not right."
		""
		"&7The call becomes clearer when holding a Soulstone; it seems to want to take me somewhere."
		""
		"&7An Eye of Ender points to the entrance of the End, so what would happen if a Soulstone were fused into an Eye of Ender?"
	]
	quest.03D7343C57EF0A14.quest_subtitle: "Soul Resonance"
	quest.03D7343C57EF0A14.title: "The Call"
	quest.0401FD00A60774F8.quest_desc: [
		"&6Torreya Forest&r"
		"&7Is one of the surface biomes in the Starlight Dimension."
		""
		"&7Torreya Forests usually generate along the &#5CACEEEther River&r&7."
		"&7The &#8B7355Torreya Trees&r&7 are tall and dense, forming winding, narrow river channels together with the Ether River."
		"&7This also makes Torreya Forests very likely to border multiple different surface biomes."
		""
		"&7High-luminance presences like &#5CACEEEther Liquid&r&7 and &#8B7355Torreya Vines&r&7 also significantly reduce monster spawning on the biome's surface."
	]
	quest.0401FD00A60774F8.quest_subtitle: "Interwoven Paths"
	quest.0401FD00A60774F8.title: "Torreya Forest"
	quest.04120B4A249AF41A.quest_desc: [
		"&7The villagers shared with you the technology of controlled soul fusion."
		""
		"&7Wraith: The study of soul harvesting and application. To harvest souls for the first time, you need to use a &6Scythe weapon&7. However, most materials made from essence also possess the ability to harvest souls. By adding a small amount of such material to weapons, armor, or even accessories, you can break free from the constraints of the scythe."
		""
		"Chapter Unlocked: &5Wraith"
		"[ { \"text\": \"[Click to Jump]\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"27B6C00949F92CCF\" } } ]"
	]
	quest.04120B4A249AF41A.title: "Soul Research"
	quest.046E980EB69A1209.quest_desc: [
		"&6Miniature Totem&r"
		"&7Can be bound to a familiar, and a familiar can only be bound to one totem at a time. When that familiar dies and you lack the mana to resurrect it, the bound totem will be consumed, causing the familiar to &arevive&r&7, and the totem is consumed.&r"
	]
	quest.0490EDB36F1CF908.quest_subtitle: "The Sky's the Limit"
	quest.04DD58980F332FEE.quest_subtitle: "Survivalist's Must-Have"
	quest.04F1594414B048D0.quest_desc: [
		"&7Increases the stack size of items in a single inventory slot. Each backpack can hold up to three Stack Upgrades, and when multiplied together, they can achieve an incredibly high stacking limit."
		""
		"&7The Stack Upgrade also works on tanks, increasing their storage capacity accordingly."
	]
	quest.04F1594414B048D0.quest_subtitle: "Stack a little, stack a bit more, stack a billion times more"
	quest.0594FF6909227B41.quest_desc: [
		"&6All&r affix effects can be looked up in the &6Reverie Foundry - Material Handbook&r."
		""
		"Affixes are divided into two major categories: one is the &6Silent Gear - Affixes section&r, and the other is the &6Unique Mechanics - Affixes section&r."
		"The affix effects inherent to Silent Gear are described in the former category, while the custom affixes added by the modpack are in the latter, for distinction."
		""
		"&7Codfish isn't very good at writing quests... Sorry if some parts aren't well-written..."
		""
		"Never mind, I'll help Codfish write. Oh, I'm not good at it either. My apologies."
	]
	quest.0594FF6909227B41.quest_subtitle: "Especially the Reverie Foundry - Material Handbook... Many mechanics and content are written inside."
	quest.059D21A5F949C15C.quest_desc: [
		"&2Players can store enchanted books into it, converting them into corresponding enchantment experience. Enchantment experience can be used to split or merge enchanted books."
		""
		"&cWithdrawing an enchanted book consumes the corresponding enchantment experience, and the cost increases exponentially with level."
		""
		"&2This mechanic reduces the number of equipment modifications. A top-tier piece of equipment may only require 1 modification instead of 4-5, significantly saving experience."
		""
		"&7Can be collected by hand; using a pickaxe speeds it up. Can be upgraded to the Library of Alexandria via Infusion."
		""
		"&eMining or upgrading does not lose stored enchantments."
		"{@pagebreak}"
		"&7Usage: In the GUI, you can search for the enchanted book you need directly in the top box. The three slots on the right are, from top to bottom: Filter Slot (yellow), used to place an enchantable item to display compatible enchantments; Input Slot (blue), used to deposit enchanted books into the library; Output Slot (yellow), used to withdraw selected enchanted books. You can also place an existing enchanted book here to continue selecting."
	]
	quest.059D21A5F949C15C.quest_subtitle: "Right here, may you find the book you seek"
	quest.059D21A5F949C15C.title: "A New Way to Store Magic"
	quest.05A4F69164ABBCCA.quest_subtitle: "Classic Long-Range Lethal Weapon"
	quest.05EA527792F0F44E.quest_desc: [
		"&6Scythe Potency Rune&r"
		""
		"&7The Scythe Potency Rune grants the wearer power at the cost of the &8souls&r&7 reaped by the scythe. For a duration, each kill makes the held &eweapon&r&7 increasingly &apowerful&r&7.&r"
	]
	quest.05EA527792F0F44E.quest_subtitle: "Destroying That Which Shatters"
	quest.05F1A3A4114BE50F.quest_desc: ["&7Now that the furnace is set up, try smelting some hardened steel to get some practice. Remember to add enough coal and amethyst first, otherwise the molten iron may react with a small amount of coal to become steel first, and steel cannot be used to make hardened steel."]
	quest.05F1A3A4114BE50F.title: "Practice Makes Perfect"
	quest.05F6670AAFE979C5.quest_subtitle: "Shouldn't you take a break now?"
	quest.05F6670AAFE979C5.title: "Playtime: 2h"
	quest.06BE812E1FAAD2B2.quest_subtitle: "No Maximum, Only Larger!"
	quest.06BE812E1FAAD2B2.title: "More Space !"
	quest.070C94F2F2F2D972.quest_desc: [
		"&6Repair Diffuser&r"
		""
		"&7The Repair Diffuser uses fresh flesh and blood as a sympathetic anchor for natural life regeneration. After completing one &6Focus Cycle&r&7, a crucible equipped with it has a chance to slightly repair any &eFocus Token&r&7. However, it cannot save Focus Tokens that have already shattered.&r"
	]
	quest.070C94F2F2F2D972.quest_subtitle: "Dead Scar Tissue"
	quest.075AC794CF9E3665.quest_desc: [
		"# &eResource Pack Management &r"
		""
		"### &cResource Pack Path &r"
		"&7<Reverie Foundry>"
		"&7\\config\\\\paxi\\\\resourcepacks"
		""
		"### &6Operation Suggestions &r"
		"&f- Delete resource packs you don't want to use from this path."
		"&f- &cSome resources require additional deletion in kubejs &r"
		"&f- For GUI texture packs:"
		"  &7▪ &aStrongly recommend replacing rather than directly deleting &r"
		"  &7▪ Replacement avoids missing UI elements."
		""
		"### &3Notes &r"
		"&7- Back up original files before making changes."
		"&7- Deleting certain resource packs may cause display issues."
		"If display issues occur, please delete the resourcepack_load_order.json file as well."
	]
	quest.075AC794CF9E3665.quest_subtitle: "PAXI"
	quest.078C80DB81D1640E.quest_desc: [
		"&6Modpack Command Quick Reference&r"
		"&7The modpack provides many custom commands.&r"
		""
		"&6Wendigo&r"
		"&7&e/rf wendigosystem toggle&r&7 - Toggle Wendigo effects&r"
		"&7&e/rf wendigosystem status&r&7 - View status&r"
		""
		"&6Ore Stages&r"
		"&7&e/rf orestage&r&7 - View current stage status&r"
		"&7&e/rf orestage reset&r&7 - &cReset all data (Use with caution)&r&7"
		"&7&e/rf orestage reload&r&7 - Reload config file&r"
		"&7&e/rf orestage validate&r&7 - Validate config and auto-fix&r"
		"&7&e/rf orestage info&r&7 - View detailed progress info&r"
		"&7&e/rf orestage kills&r&7 - View kill statistics&r"
		""
		"&6Utility Functions&r"
		"&7&e/rf entityclean&r&7 - Clean up miscellaneous entities nearby. By default, only cleans some dropped items, arrows, etc. (Configurable)&r"
		""
		"{@pagebreak}"
		"&6Additional Tribulations&r"
		""
		"&6Status Management&r"
		"&7&e/rf deathsystem toggle&r&7 - Enable/Disable death penalty system&r"
		"&7&e/rf deathsystem status&r&7 - View death statistics and current status&r"
		""
		"&6Data Reset&r"
		"&7&e/rf deathsystem reset&r&7 - &cReset death count and restore max health on next respawn&r"
		""
		"&7&e/rf depression toggle&r&7 - Toggle Depression (Additional Tribulations)&r"
		"&7&e/rf depression status&r&7 - View Depression (Additional Tribulations) status&r"
		""
		"&6Item Giving&r"
		"&7&e/rf give randomenchanted&r&7 - Claim random enchanted book&r"
		"&7&e/rf give randomscrollid&r&7 - Claim random scroll&r"
		"&7&e/rf give drunkard&r&7 - Claim &bDrunkard Set&r&7 (Various alcohols)&r"
		"&7&e/rf give traveler&r&7 - Claim &bTraveler Set&r&7 (Backpack + Enchanted Book)&r"
		"&7&e/rf give sorcerer&r&7 - Claim &bSorcerer Set&r&7 (Spell equipment)&r"
		"&7&e/rf give warrior&r&7 - Claim &bWarrior Set&r&7 (Combat equipment)&r"
		""
		"&6Admin Functions&r"
		"&7&e/rf give SetName PlayerName&r&7 - Give another player a set&r"
		"&7&e/rf give SetName PlayerName clear&r&7 - &cReset a player's claim limit&r"
		""
		"&7&e/wits View the current structure you are in"
	]
	quest.078C80DB81D1640E.quest_subtitle: "I Got It"
	quest.078C80DB81D1640E.title: "Utility Commands"
	quest.07922878C03DC46B.quest_desc: [
		"&7The tavern is noisy with people. I huddle in the darkest corner, the apple cider in front of me tasteless and watery."
		""
		"&7The blacksmithing competition notice posted on the wall feels both close at hand and impossibly distant. Everyone says seventy percent of victory lies in the materials. The 'Celestial Ingots' and 'Soaring Flame Iron' that appeared in past competitions—just their names alone are suffocating. And in my pack, I only have the most common Hardened Steel. Forget winning, even qualifying seems unlikely."
		""
		"&7\"&3Kid, your eyes are harder than the iron in your hand.&7\""
		""
		"&7A skinny old man has somehow sat down opposite me. His robes are faded from washing, but his eyes are sharp and grating. He glances at my shabby luggage and scoffs."
		""
		"&7\"&3Want to make a name with that pile of junk?&7\" He shakes his head, as if seeing a joke. \"&3Better play a game of &zchess&3 with this old man, clear your head.&7\""
		""
		"&7\"&rNo time.&7\" I turn my face away and lift my glass, wanting to &4leave&7."
		""
		"&7\"&3Then have a drink.&7\" He insists, raising his glass and clinking it against mine without waiting. \"&3To your pitiful bit of unwillingness.&7\""
		""
		"&7The moment the liquor goes down, a searing heat shoots to the top of my head. The world gradually blurs, spins, and darkness swallows everything."
		""
		"&7\"&3Running? I didn't say you could run...&7\""
	]
	quest.07922878C03DC46B.title: "The Beginning of Everything"
	quest.07C86BA6CAFFD6C8.quest_subtitle: "View the buffs your current familiar has acquired"
	quest.07E7C74E2EA9FB8E.quest_desc: [
		"&6Spiral Algae Forest&r"
		"&7Is one of the ocean biomes in the Starlight Dimension."
		""
		"&7The Spiral Algae Forest has vegetation coverage distinct from the Sea of Starlight."
		"&7The primary covering plants are &#20B2AASpiral Algae Plants&r&7, &#98FB98Sea Candle Grass&r&7, &#DB7093Sea Rose&r&7, rather than the usual &#9ACD32Abyssal Fruit Plants&r."
		""
		"&7Non-aquatic creatures can only spawn dozens of blocks deep underground in the Spiral Algae Forest."
	]
	quest.07E7C74E2EA9FB8E.quest_subtitle: "Eternal Feast"
	quest.07E7C74E2EA9FB8E.title: "Spiral Algae Forest"
	quest.07F1B2594FCCAF01.quest_desc: [
		"&6Agility Rune&r"
		""
		"&7The Agility Rune urges the consciousness to move and adapt in moments of danger, increasing &amovement speed&r&7. The amount increases as the wearer's vitality fades, up to doubling movement speed.&r"
	]
	quest.07F1B2594FCCAF01.quest_subtitle: "Pulse That Promotes Flight"
	quest.082F47A08B859C62.quest_subtitle: "Stage 3"
	quest.085ED7F06792B829.title: "Frozen One"
	quest.08600655258549DB.quest_desc: ["&7Too powerful, instant feeding and eating. Paired with high-saturation food, you become an undying demon—provided you don't get oneshot by a slap..."]
	quest.08600655258549DB.quest_subtitle: "Someone, feed the gentleman a pancake"
	quest.086482C52023DB55.quest_subtitle: "A utility tool for finding the nearest underground dragon lair"
	quest.0919F71D241AFD81.quest_desc: [
		"&6Mandate of the Joyful Target&r"
		""
		"&7Your form is static in time, an anomaly detached from the world. The form does not age, nor can it perceive the outside world.&r"
		"&7-All &cHealing&r&7 received reduced to a quarter&r"
		""
		"&7Mandate—the treaty between your form and the world's original.&r"
		"&7-When hit, the form enters &6Stasis&r"
		"&7-In &6Stasis&r&7, all &ePotion Effects&r&7 have their timers paused and do not decay&r"
		"&7-Life regeneration, poisoning, and other effects requiring time flow cease; those unaffected by stasis remain effective&r"
	]
	quest.0919F71D241AFD81.quest_subtitle: "The Happiest in the World"
	quest.0919F71D241AFD81.title: "Mandate of the Joyful Target"
	quest.092C65BDEC1E30A4.quest_desc: [
		"&6Transmutation Table&r"
		""
		"&7Worried your weapon looks too ugly?&r"
		"&7Concerned about insufficient prestige?&r"
		""
		"&7The Transmutation Table, your first choice! Whether for &aDisguising as weak to eat the strong&r&7 or &aDisguising as strong to eat the weak&r&7! The choice is yours!&r"
		""
		"&7Place the &eweapon&r&7 to be transmuted in the first slot, and the desired appearance in the second slot, then consume Amethyst energy to transmute your weapon!&r&7&r"
	]
	quest.092C65BDEC1E30A4.quest_subtitle: "Ever-Changing"
	quest.0937218D11FA4D34.quest_desc: [
		"&7If you want to make a sword, you first craft an &eIron Sword Blade&7 using a Sword Blade Blueprint and two Iron Ingots. Then, craft an &eIron Tool Handle&7 using a Tool Handle Blueprint and two Iron Ingots. Finally, combine the sword blade and handle to obtain a strange Iron Sword."
		""
		"&7At this point, the four parts — &eTip Upgrade, Binding, Coating, and Grip&7 — are all empty. You craft the corresponding four blueprints, then press U on each blueprint to see which materials can be used to craft these parts. After selecting your desired materials, you craft these four parts and combine them with the Iron Sword. Now the Iron Sword is even stranger (?)"
		""
		"&7Suddenly, you feel that the Iron Sword Blade isn't worthy of this sword — why not use Diamond instead? So you use two Diamonds and a Sword Blade Blueprint to craft a &eDiamond Sword Blade&7, then combine the Diamond Sword Blade with the strange Iron Sword to replace the Iron Sword Blade. You now have a strange Diamond Sword."
	]
	quest.0937218D11FA4D34.title: "In Case You Still Didn't Understand"
	quest.0973A81F39964B58.quest_subtitle: "Familiar Summoning Ritual"
	quest.09BD7CB2DEA2CD89.quest_subtitle: "Customized Experience"
	quest.09E68D57095A5F1D.quest_desc: [
		"&7Standardized weapons are limited by uniform specifications, making it difficult to fully utilize the unique properties of materials."
		""
		"Though I'm no master craftsman, I can at least follow blueprints to produce them."
		""
		"&7Perhaps using different materials for each component is the way to maximize the unique qualities and energy inherent in the materials themselves."
	]
	quest.09E68D57095A5F1D.title: "The Beginning of Everything"
	quest.0A12067C6B752CAC.quest_desc: ["&7With the help of the most mysterious Heart of the Sea, the Ocean Bookshelf has undergone a transformation. Its power is more surging, yet never becomes intense. The &aQuanta&7 and &5Arcana&7 provided by this bookshelf are two to three times that of its predecessor. However, the power of the Heart of the Sea is ultimately gentle, and it does not bring an additional &aQuanta&7 cap. After all, nothing is perfect; achieving this is already no small feat."]
	quest.0A12067C6B752CAC.quest_subtitle: "Embraced by Mystery"
	quest.0A12067C6B752CAC.title: "Embrace of the Heart"
	quest.0A13EAB37AB4ACEF.quest_desc: [
		"&6Familiar Trinkets&r"
		"&7Familiar trinkets are items that can be equipped in accessory slots, providing different buffs to the corresponding familiar.&r"
		""
		"&7&eMagic Leaf&r&7: Increases &aSpell Potency&r&7 for &bDruid&r&7 familiars. Can be found in &bJungle Temples&r&7.&r"
		""
		"&7&eHunter's Chain&r&7: Increases &aSpell Potency&r&7 for &bHunter&r&7 familiars. Can be found in &cEvoker Outposts&r&7 or &bHunter Camps&r&7.&r"
		""
		"&7&eLich Sigil Necklace&r&7: Increases &aSpell Potency&r&7 for &cNecromancer&r&7 familiars. Can be found in &8Graveyards&r&7.&r"
		""
		"&7&eCrown of the Forgotten&r&7: Increases &aSpell Potency&r&7 for &bConjurer&r&7 familiars. Can be found in &cAncient Cities&r&7.&r"
		""
		"&7&eShimmering Crown&r&7: Increases &aSpell Potency&r&7 for &6Archmage&r&7 familiars. Can be found in &6Archmage Laboratories&r&7.&r"
		""
		"&7&eGolden Bell&r&7: Increases &aSpell Potency&r&7 for &dIllusionist&r&7 familiars. Can be found in &bWoodland Mansions&r&7.&r"
		""
		"&7&eSorcerer's Candleholder&r&7: Increases &aSpell Potency&r&7 for &eBlazing&r&7 familiars. Can be found in &cArsonist Mage Towers&r&7.&r"
		"{@pagebreak}"
		"&7&eBlessed Chalice&r&7: Increases &aSpell Potency&r&7 for &aCleric&r&7 familiars. Can be found in &aCleric Huts&r&7.&r"
		""
		"&7&eStorm Sigil Necklace&r&7: Increases &aSpell Potency&r&7 for &6Stormcaller&r&7 familiars. Can be found in &bMountain Towers&r&7.&r"
		""
		"&7&eFetid Cheese Necklace&r&7: Increases &aSpell Potency&r&7 for &cPlague Doctor&r&7 familiars. Can be found in &bIce Spike Shipwrecks&r&7.&r"
		""
		"&7&eLost Melody&r&7: Increases &aSpell Potency&r&7 for &dBard&r&7 familiars. Can be obtained via &eMystic Orbs&r&7.&r"
		""
		"&7&eFrostbloom&r&7: Increases &aSpell Potency&r&7 for &bFrost&r&7 familiars. Can be found in &bIce Spider Nests&r&7.&r"
		""
		"&7&eDragon's Tear&r&7: Increases &aSpell Potency&r&7 for &6Dragoon&r&7 familiars. Dropped by the &cEnder Dragon&r&7.&r"
		""
		"&7&ePandora's Box&r&7: Allows &aSummoning/Dismissing&r&7 up to 10 familiars simultaneously. Obtained via crafting.&r"
	]
	quest.0A13EAB37AB4ACEF.title: "Any Familiar Trinket"
	quest.0A1FF9CCFB4FEA6C.quest_subtitle: "Friendly Fire"
	quest.0A1FF9CCFB4FEA6C.title: "First Player Kill"
	quest.0AB75E9FF0BDB42A.quest_desc: [
		"&7The village entrance was still under lockdown, but they didn't stop me. It was near dusk; wisps of cooking smoke rose from the scattered rooftops, slowly drifting away in the twilight. Someone was tidying up farm tools on the ridge of a field. When he straightened up and saw me, he paused for a moment, then turned his face away and continued bending over to bundle the straw in his hands."
		""
		"&7The village chief's door was slightly ajar. I stood outside for a while, hearing the faint rustle of paper being turned inside, then raised my hand and knocked."
		""
		"&7\"&3Come in.&7\""
		""
		"&7Pushing the door open, the village chief was sitting behind that old wooden table, several sheets of paper covered in writing spread out before him, his brow habitually furrowed. When he looked up and saw me, a flicker of surprise crossed his stern, old-fashioned face—clearly, he hadn't expected me back so soon."
		""
		"&7I took the crimson scepter from my pack and placed it on the table. The staff was dark red, like congealed blood, a dense aura of necromancy seeping from deep within it. The moment it touched the table, the temperature in the room seemed to drop several degrees. The village chief's gaze fell upon the scepter and lingered there for a long time."
		""
		"&7\"&3It seems you're far stronger than I imagined.&7\""
		""
		"{@pagebreak}"
		""
		"&7He reached out, as if wanting to touch it, but stopped mid-air. His rough knuckles curled slightly, and finally, he withdrew his hand, letting it fall onto the table as he slowly folded the half-written paper. His voice was lower than usual, carrying a hint of something hard to define—perhaps relief, or something else entirely."
		""
		"&7\"&3There's been no activity down there lately. I thought the uprising had just been delayed.&7\" He pushed the folded paper aside. \"&3Tomorrow at the gathering, I'll announce it to the whole village. Everyone will remember your contribution. If you're still staying in the village, I can set aside a proper room for you—&7\""
		""
		"&7\"&rThat won't be necessary.&7\" I interrupted him. \"&rI didn't go to kill the Necromancer King just for the village. I had my own purposes too. I'll just stay in that empty mill, but this time it'll be long-term.&7\""
		""
		"&7The village chief didn't dwell on it. He simply nodded: \"&3Alright, I'll have someone clear out the clutter in the mill later. That house is yours now. Stay as long as you like.&7\""
		""
		"&7I pushed the door open and stepped out. The dusk had deepened. The distant cooking smoke had faded, nearly melting into the last glow on the horizon. The wind swirled through chimneys and dirt paths, carrying the familiar, captivating scent of straw and burning firewood..."
		""
		"&0&m\"Sense of Belonging\" has been registered as a Key Item."
	]
	quest.0AB75E9FF0BDB42A.title: "Return to the Village"
	quest.0ABD1C741FFFC78C.quest_desc: [
		"&6Blazing Fury Rune&r"
		""
		"&7The Blazing Fury Rune's ability is similar to the ritual of the same name, granting the wearer the &bBlazing Fury&r&7 effect at half strength, slightly increasing &aAttack&r&7 and &aMining&r&7 speed.&r"
	]
	quest.0ABD1C741FFFC78C.quest_subtitle: "Polishing the Pulse"
	quest.0AC4291DE561460A.quest_desc: [
		"&6Ether River&r"
		"&7Is one of the rarer surface biomes in the Starlight Dimension."
		""
		"&7Like rivers in the Overworld, it is typically a &8transitional biome&r that separates water routes within or between multiple biomes."
		"&7Scattered &#E6E6FAQuartz Sulfur Blocks&r&7 have a chance to generate along the Ether River banks for players to collect."
		""
		"&7&#5CACEEEther&r&7 itself is a very &cdangerous&r high-luminance fluid, and it prevents any vegetation or creatures from spawning on its surface."
		"&7Creatures can only spawn dozens of blocks deep underground away from the Ether River."
		""
		"&7The area beneath the Ether River is the only place where &#E6E6FAQuartz Sulfur Geodes&r&7 can generate."
		""
		"&#5CACEEEther&r&7 can be used as fuel in a furnace."
	]
	quest.0AC4291DE561460A.quest_subtitle: "Painless Death"
	quest.0AC4291DE561460A.title: "Ether River"
	quest.0AD556BD2B2A47D2.quest_desc: [
		"&6Can be connected to a Drain as an output, or use &r"
		""
		" [ { \"text\": \"Fluid Pipe [Click to jump]\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"1F38C534465F33BC\" } } ]"
		""
		"&6for import operations, automating the process by importing fluids into the Forge."
	]
	quest.0AD556BD2B2A47D2.quest_subtitle: "Export Liquid? Import Liquid?"
	quest.0B0C47F37FDE6435.quest_desc: [
		"&7Soulweave is a light yet resilient material, full of things like &6souls&r&7. Like physical forms, it naturally blocks &dArcane Energy&r&7. Although other materials have this effect, &6Soulweave&r&7 is easier to work with, at least much better than &8Stone&r&7."
		""
		"&7Fragments of a soul can glow, so souls can naturally glow. Why not let the souls in the weave emit light?"
		""
		"&7I made several &bBanners&r&7 to test the effect, and borrowed various &eReagents&r&7 and &6Spirits&r&7 to design patterns. When infused with energy, they emit &8dim light&r&7; infusing another spirit makes them &eblazingly bright&r&7."
	]
	quest.0B0C47F37FDE6435.quest_subtitle: "Weaving the Unreal"
	quest.0B33B7CF2E127A4F.quest_desc: [
		"&7Traveling often involves a large number of items that need to be stored. While chests offer considerable capacity, they can be inconvenient in some situations..."
		""
		"I might need a lighter, more flexible way to carry things."
	]
	quest.0B33B7CF2E127A4F.quest_subtitle: "Convenient and Quick"
	quest.0B33B7CF2E127A4F.title: "AAA Kourindou Antique Wholesale"
	quest.0BA8FDE1647AA593.quest_subtitle: "Keep It Up"
	quest.0BA8FDE1647AA593.title: "First Death"
	quest.0BABB13A3B9A5412.quest_desc: ["Write crafting recipes into it, then place it in an Auto Crafter to enable automatic item crafting."]
	quest.0BABB13A3B9A5412.quest_subtitle: "Assembly Line Operation"
	quest.0BB5CE1550F46002.quest_desc: [
		""
		"When you have ongoing tasks that you might forget, you can pin them by clicking the location shown in the image below."
		"{image:kubejs:textures/gui/ftb_kjs2.png width:200 height:100 align:center fit:true}"
		""
		""
		"{@pagebreak}"
		"Success Example:"
		"{image:kubejs:textures/gui/ftb_kjs1.png width:80 height:100 align:center}"
	]
	quest.0BB5CE1550F46002.quest_subtitle: "What was I supposed to do again?"
	quest.0BB5CE1550F46002.title: "Pinning"
	quest.0BCF6B18963AB88F.quest_desc: [
		"The dead monster, forcibly revived by some magic, as if guided by a will behind it."
		""
		"&7When it falls again, the power sealed within seems to dissipate... I must investigate and see what traces are left."
		""
		"&7Defeating the Lord of the Dead will unlock the following ores:&r"
		"&7"
		"&#67B1E5Gobe&r&7"
		"&#C9C8E1Zenalite&r&7"
		"&#757369Runic Debris&r&7"
		"&#7EE344Chlorophyte&r&7"
		"&#770808Fearstone&r&7"
		"&#DD660ASolar Core&r"
		""
		"&8\"A will forcibly stitched into a broken shell by death magic. When these fragile sutures snap once more, the power it sustained—that which should not exist in this world—begins to unravel.\""
	]
	quest.0BCF6B18963AB88F.quest_subtitle: "Power of the Dead"
	quest.0BCF6B18963AB88F.title: "Wrathful Lord of the Dead"
	quest.0C1EFCAED337180F.quest_desc: [
		"&6Aurora Deer&r&7"
		"&7Neutral mob that retaliates when attacked; can only spawn on the surface of &#87CEEBStarlight Frozen Forest&r&7.&r"
		""
		"&7This creature only performs melee attacks and has low aggression.&r"
		""
		"&7After being attacked for a period, it lowers its head to charge (if the player is close to its head during this time, they may suffer melee damage, which could also interrupt the charge).&r"
		""
		"&7After charging, it will &#00FFFFCharge&r&7 in a random straight line for several blocks, dealing melee damage to targets it passes.&r"
		""
		"&7All the above attacks can be blocked with a shield.&r"
		""
		"&7&#FFA500Aurora Deer Antler&r&7 cannot drop when the Aurora Deer itself dies.&r"
		""
		"&7If the Aurora Deer charges and collides with any type of &#808080Stone-like Block&r&7:&r"
		""
		"&7It will definitely drop one full-durability &#FFA500Aurora Deer Antler&r&7, and the model of that deer will also be missing one antler.&r"
		""
		"&7One Aurora Deer can drop up to two &#FFA500Aurora Deer Antlers&r&7. Losing antlers does not affect its attack damage.&r"
	]
	quest.0C1EFCAED337180F.title: "Aurora Deer"
	quest.0C2F2186BE39605E.quest_desc: [
		"&6Hunter Camps&r"
		"&7Hunters live in groups, so they build camps along their main hunting routes, primarily in &bforest&r&7 biomes rich in game. These camps can also be located using &eRolled-up Maps&r&7 obtained from the Origin Isle.&r"
	]
	quest.0C2F2186BE39605E.quest_subtitle: "Discover Hunter Camps"
	quest.0C2F2186BE39605E.title: "&6Hunter Camps&r"
	quest.0C95DCE08BB56AF5.quest_desc: [
		"&6Soulbound Rune&r"
		""
		"&7The Soulbound Rune does not enhance the form's abilities, but rather exerts pressure on its arcane existence, increasing the capacity and stability of the &eSoul Shield&r&7.&r"
	]
	quest.0C95DCE08BB56AF5.quest_subtitle: "Pulse That Promotes Making"
	quest.0CC6907B16C93F5E.quest_subtitle: "Jungle Essence"
	quest.0CCFA64CA88D2D22.quest_desc: [
		"# &3You can press R to sort inventory with one click (by default) &r"
		""
		"### &bNotes &r"
		"&7- By default, pressing R sorts in creative mode style.&r  "
		"&7- Pressing Shift+R sorts by quantity.&r  "
		"&7- Pressing Ctrl+R sorts alphabetically.&r  "
		"&7- Pressing Alt+R sorts by ID.&r  "
	]
	quest.0CCFA64CA88D2D22.quest_subtitle: "Multiple Options!"
	quest.0CCFA64CA88D2D22.title: "R Sort"
	quest.0CFA26B3944AAF49.quest_desc: [
		"To enhance material properties, use the Starlight Charger for reinforcement."
		""
		"Set up a 7×7 area in an open environment. Place the charger in the center, with four 2-block-high pillars at the corners. The blocks placed on top of the pillars determine the charging level:"
		"{image:kubejs:textures/gui/starlight_charger.png width:180 height:100 align:center}"
		""
		"Level 1: Crimson Steel Block, requires Blazing Gold Dust as catalyst."
		""
		"Level 2: Azure Electrum Block, requires Azure Silver Dust as catalyst."
		""
		"Level 3: Tyr Steel Block, requires Starlight Powder as catalyst."
		""
		""
		"{@pagebreak}"
		"After placement, wait about 15 seconds for the charger to recognize the environment. This device only works in open areas at night and consumes energy."
		""
		"Higher-tier chargers can use lower-tier catalysts, but the charging level is determined by the catalyst used."
	]
	quest.0CFA26B3944AAF49.quest_subtitle: "Material Infusion"
	quest.0D0DADF7C531B664.quest_desc: ["&7If you lack experience during enchanting, Potions of Ancient Knowledge can solve most problems. Simply add the contents of a Bottle o' Enchanting to a coarse potion, and the potion will significantly increase the experience you gain. Adding another Bottle o' Enchanting to the brewed potion stacks the effect, drastically boosting it further, but that's the limit; no other means can push it beyond this point."]
	quest.0D0DADF7C531B664.quest_subtitle: "Tasty Little Drink"
	quest.0D134B44D9F3BA01.quest_desc: [
		"&6Treaty of the Sturdy Shield"
		"&7Accelerated exterior and fragile nature are inseparable.&r&cSoul Shield stability halved"
		"&7The soul shield in accelerated form, a timely rain to avert danger.&r&aIncreases Soul Shield capacity&r&aSoul Shield recovery rate doubled"
	]
	quest.0D134B44D9F3BA01.quest_subtitle: "Acting Vigilantly"
	quest.0D134B44D9F3BA01.title: "Treaty of the Sturdy Shield"
	quest.0D1AFFB3C244802E.quest_desc: [
		"&6Portal Frame&r"
		"&7A functional block that assists mages in creating permanent portals.&r"
		"&7When first placed, the portal frame is just an empty shell, with only its frame having a hitbox.&r"
		""
		"&7By casting the &bEnder Portal&r&7 spell on the portal frame using methods such as the &eHere-to-There Wand&r&7, it can be transformed into a portal usable for teleportation. It can only connect to another portal frame that has also been enchanted with the Ender Portal spell. Such paired portals have no distance limit and exist permanently.&r"
		""
		"&7Do not attempt to break this block after creating a portal, as this may cause the model to disappear while the block itself remains, until you connect it to another portal.&r"
		""
		"&7Players can dye an activated portal by consuming 1 of any dye; the corresponding paired portal will automatically be dyed the same color.&r"
		""
		"&8It yearns to be granted a paired destiny. Until it finds its other half, not even the void can erase it."
	]
	quest.0D1AFFB3C244802E.quest_subtitle: "Rapid Transit"
	quest.0DDD36DA6EAB60C4.quest_desc: [
		"&6Dark Swamp&r"
		"&7Is a surface biome in the Starlight Dimension."
		""
		"&7The Dark Swamp is mainly paved with &#4A331ANight Mud&r&7 and &#7FCC7FIllusory Grass&r&7 blocks, with relatively open terrain. The distribution of many shallow water pits complements the ground."
		"&7In addition to the standard Gloomstone layer and Voidstone layer, the Dark Swamp also generates a unique \"&#4A331ANight Mud Layer&r&7\" between the surface and the Gloomstone layer."
		""
		"&7The Night Mud Layer consists mainly of &#4A331ANight Mud&r&7 and &#A0A0A0Night Mud Crust&r&7. Most plants that can generate on the Dark Swamp surface can also generate in the Night Mud Layer (including wild &#FF9900Xinguo&r&7 crops)."
		"&7The Night Mud Layer has a chance to generate &#4A331ANight Mud Deep Silver Ore&r&7 or &#A0A0A0Night Mud Crust Deep Silver Ore&r&7, unique variants of &#C0C0C0Deep Silver Ore&r&7 that only appear in this biome."
		"&7Similarly, the underground of this biome is also the only place where &#9A32CDMiasma Amethyst Ore&r&7 naturally generates."
		""
		"&7The main tree type in the Dark Swamp is &#2F4F4FGloom Banyan&r&7 (equivalent to the Overworld's Mangrove)."
		"&7Compared to the Overworld's Mangrove Swamp, the tree generation spacing in this biome is &alonger&r&7, and player visibility within the biome is more &aopen&r."
		""
		"&7You can also find some unique plants in this biome: &#7FCC7FIllusory Grass&r&7, &#FF69B4Swamp Rose&r&7, &#9370DBFan Violet Flower&r&7, &#7FCC7FIllusory Fern&r&7, etc."
	]
	quest.0DDD36DA6EAB60C4.quest_subtitle: "Dark and Slimy"
	quest.0DDD36DA6EAB60C4.title: "Dark Swamp"
	quest.0ED82FFAE99D2480.quest_desc: [
		"&eA cheap chemical product."
		"&6A better conventional choice than lava."
		""
		"⚡ Speed: 1.0x | ♨ Temperature: 2000 | ⏳ Consumption: 0.3"
		""
		"&aTip&r&7: &f♨ &r&7Temperature determines the grade of materials that can be processed, ⚡ Speed affects processing time, ⏳ Consumption represents fuel longevity."
	]
	quest.0ED82FFAE99D2480.quest_subtitle: "Better Fuel"
	quest.0EEA8DDC455E7FCB.quest_desc: [
		"&7While observing the spread of &8Withering&r&7 (in a controlled environment, of course), I noticed this metaphysical damage occasionally becomes strong enough to leave scars on stone—thus, I named it \"&6Scarstone&r&7\"."
		"&7"
		"{@pagebreak}"
		"&6Scarstone Research: Texture"
		"&7Scarstone is a strange rock, somewhat similar to &8Withering&r&7 in a sense. I detected fragments of granite, obsidian, diorite, andesite within it, along with plenty of ordinary stone; these fragments are simply scattered haphazardly, with no discernible pattern. It also does not respond to the &bRite of Unbinding&r&7."
		"&7"
		"{@pagebreak}"
		"&6Scarstone Research: Creation"
		"&7The appearance of this stone seems purely random; I have yet to determine the specific triggering conditions. But roughly every ten spreads of &8Withering&r&7, this brutal transmutation carves out a cluster of Scarstone."
		"&7"
		"{@pagebreak}"
		"&6Scarstone Research: Bizarre Crystals"
		"&7Although it does not respond to the &bRite of Unbinding&r&7, it seems to have a strange... growth? This growth itself is crystalline, yet behaves like a plant. I don't know its use. If I were a &dBiomancer&r&7, this discovery would likely be a once-in-a-lifetime opportunity."
	]
	quest.0EEA8DDC455E7FCB.quest_subtitle: "Twisted Rock"
	quest.0EF9389ADF9236E6.quest_desc: [
		"&6Magic Essence&r"
		"&7A consumable used to increase &bSpell Potency&r&7 and &bSpell Resistance&r&7. Each type has 3 tiers and a usage limit. Obtained via:&r"
		"&7Potency: Dropped by &emagical creatures&r&7, upgraded via &6rituals&r&7.&r"
		"&7Resistance: Obtained via the &eShrinker&r&7, upgraded via &6rituals&r&7.&r"
	]
	quest.0EF9389ADF9236E6.title: "&6Magic Essence: Resistance&r"
	quest.0F430864AB53FB98.quest_desc: ["&7A structure generated in the Overworld by leaking Starlight power, the only initial path to the Starlight Dimension..."]
	quest.0F430864AB53FB98.quest_subtitle: "Ruins: Starlight Portal"
	quest.0F731D1ED5DD01BC.quest_desc: [
		"&6Treaty of the Caressing Wind"
		"&7The wind also caresses the face.&r&cGreater momentum increases knockback taken"
		"&7Cooperate with the wind to run.&r&aSprinting accumulates momentum"
	]
	quest.0F731D1ED5DD01BC.quest_subtitle: "Becoming One with the Wind"
	quest.0F731D1ED5DD01BC.title: "Treaty of the Caressing Wind"
	quest.0FE4EF207A6937B7.quest_desc: ["The small village is quite quaint. Not that I'm taking advantage, but I'll take the chests and you can keep the houses."]
	quest.0FE4EF207A6937B7.title: "Reach the Village"
	quest.1031E9949D709475.quest_desc: ["The End Bookshelf is a more advanced bookshelf crafted using the magic of Infused Dragon's Breath. Although this bookshelf doesn't provide extremely high stats, it raises the &aQuanta&r cap it provides to 90."]
	quest.1031E9949D709475.quest_subtitle: "Approaching the Endgame of Enchanting"
	quest.1031E9949D709475.title: "Introducing End Power"
	quest.11047BEDA6023228.quest_desc: [
		"&6Mystic Orb&r"
		"&7Right-click to obtain a &eHarp&r&7 and the &eLost Melody&r&7 trinket. Obtained via the &6Island Ritual&r&7. To use the Mystic Orb, you must complete all &belemental familiar&r&7 taming advancements (excluding the Bard familiar).&r"
		"&5Or directly perform the ritual synthesis to skip the tedious taming process."
	]
	quest.110C8BBFDBFBA375.quest_subtitle: "&cThis will clear your current difficulty settings. All mobs' health, attack multiplier, armor, and armor toughness will be multiplied by 8."
	quest.110C8BBFDBFBA375.title: "&c\"Unspeakable Brute Force and Ferocity\""
	quest.1117830BC3A66701.quest_desc: [
		"&6Crucible Acceleration"
		"&7The &bSpirit Crucible&r&7 has its shortcomings: it's slow. It takes time to concentrate &eArcane Energy&r&7 onto the central item. This is not without reason; most substances cannot withstand such a fast energy flow, and overloading catalysts can easily cause damage."
		"&7"
		"&7However, by mystically heating the catalyst, this repulsion phenomenon can be mitigated while also speeding up the concentration process. This is precisely the purpose of the &bSpirit Catalyzer&r&7. But this is not a perfect solution; instability often causes unnecessary &cdamage&r&7 to the catalyst."
		"&7"
		"&7Each active Catalyzer around the Crucible speeds up the concentration process, up to a maximum of eight. However, the risk of destabilization also increases proportionally with the number of Catalyzers, potentially causing additional unnecessary damage to the catalyst."
	]
	quest.1117830BC3A66701.quest_subtitle: "Warming the Heat"
	quest.1117830BC3A66701.title: "Crucible Acceleration"
	quest.11789A166C0520B4.quest_subtitle: "Familiar Summoning Ritual"
	quest.11C363982673E669.quest_desc: [
		"&7I experimented with various materials for crafting the scribing table, ultimately finding that Runic Wood yielded the most significant results."
		""
		"When transcribing on its surface, the energy flow within the ink was more stable, significantly reducing the risk of runic distortion and energy dissipation—in short, the reliability of transcription was tangibly improved."
	]
	quest.11C363982673E669.quest_subtitle: "Transcribing Spells"
	quest.11DCB93F9E3E9564.quest_desc: ["&7Makes mobs spawned from the spawner have no behavior (no AI)."]
	quest.11DCB93F9E3E9564.quest_subtitle: "Bulk Lobotomy"
	quest.11E9AE8529E6FBF2.quest_subtitle: "Hero of the Village"
	quest.12070A3305878F5D.quest_desc: [
		"&6Fluid Tank&r"
		""
		"&6Placement&r"
		"&7When Fluid Tanks are placed forming a cuboid with a square base (1*1*n, 2*2*n, or 3*3*n), adjacent tanks automatically merge into a single structure.&r"
		"&7The height n of the tank structure can be up to 32 blocks. Tanks placed above this height are considered a new, independent tank.&r"
		""
		"&6Storing Fluids&r"
		"&7Can store various fluids, each block holding 8 B (8000 mB, i.e., 8 buckets). Input and output require a &ePowered Pump&r.&r"
		"&7In Creative mode, holding a fluid-filled container (like a bucket) and right-clicking the tank directly injects fluid. In Survival mode, use a &eFluid Spout&r paired with other fluid components for input.&r"
		"&7Hold a Wrench and right-click a tank to open or close its inspection window for viewing internal fluid status.&r"
		"&7Fluid Tanks can be detected by comparators, item detectors, and threshold switches. The filter slot of an item detector can be marked using bucket or bottle fluids.&r"
		""
		"&6As a Boiler&r"
		"&7When a Steam Whistle or Steam Engine is installed on the surface of a Fluid Tank structure, the structure transforms into a Boiler. The inspection window disappears, and a pressure gauge appears on each side.&r"
		"&7Boilers provide steam to connected Steam Whistles or Steam Engines.&r"
		""
		"&8The edge of this manuscript page has a sketch of stacked tanks with simple gauges on the side. Below, a hastily scribbled note: Fill it, see through it, and when needed, let it roar.&r"
	]
	quest.124EF6C94011C149.quest_desc: [
		"&6Strange Mushroom&r"
		"&7Right-click on a tamed familiar to grant it 1 stack of the ‘&cFury&r&7’ effect (when attacked, has a chance to consume 1 stack of ‘&cFury&r&7’ to gain the ‘&cMind Stillness&r&7’ status for several seconds). Each familiar can stack up to 10 layers. Dropped by &eMooshrooms&r&7 and sheared &eSwamp Villagers&r&7.&r"
	]
	quest.12C9785ECF565304.quest_subtitle: "Stage 0"
	quest.131FF32C0FF28CA8.quest_desc: [
		""
		"Defeat it, gather the boiling death mandate into a scepter. That inert heart is a specimen of the extracted endpoint of time... Defeating it will liberate the magical ores of the entire world."
		""
		"&7Defeating the Lord of the Dead will unlock the following ores:&r"
		"&7"
		"&#67B1E5Gober&r&7"
		"&#C9C8E1Zenallite&r&7"
		"&#757369Runic Shard&r&7"
		"&#7EE344Chlorophyte&r&7"
		"&#770808Fearstone&r&7"
		"&#DD660ASun Core&r"
		""
		"&7Perhaps there is a way? To seize its scepter without defeating it."
	]
	quest.131FF32C0FF28CA8.quest_subtitle: "Stage 0, unlocks Stage 1 after kill"
	quest.1350642D5141B3BF.quest_desc: [
		"&6Seeker's Eye&r"
		"&7Can be used to locate the structure where a &6Boss&r&7 resides in the Starlight Dimension."
		""
		"&7Before use: You need to hold one of the following specific items in your offhand, which determines the structure the Seeker's Eye will search for."
		""
		"&6Cursed Garden&r&7 (&cMoonvine Colossus&r&7):"
		"&8Vines, Cave Moss, Moonglow Berries&r"
		"&8Red Crystal Roots, Blue Crystal Roots&r"
		"&8Red Ground Crystals, Blue Ground Crystals&r"
		""
		"&6Golem Forge&r&7 (&cStarlight Golem&r&7):"
		"&8Redstone Dust, Golem Steel Ingot, Oxidized Golem Steel Ingot&r"
		""
		"&7The Seeker's Eye functions similarly to an Eye of Ender."
		"&7Right-click to use, and it will fly a distance towards the direction of the &6Boss&r&7 structure, then hover in the air for a while before turning into an item and dropping."
		"&7Similarly, the Seeker's Eye has a chance to &cShatter&r&7 while hovering (consumed directly without returning)."
	]
	quest.1350642D5141B3BF.quest_subtitle: "Guidance of the Starlight"
	quest.13AFD3688361872A.quest_desc: [
		"# &aGame Modifications &r"
		""
		"### &eIce and Fire Adjustments &r"
		"&7- &fPixies no longer steal player items&a, can be safely kept. &r"
		""
		"### &#FFBB1AKeep Inventory Adjustment &r"
		"&7- &fIf Keep Inventory is not enabled, death no longer restores you to perfect condition. Death retains hotbar items and equipped gear.&r"
		""
		"{@pagebreak}"
		"### &#FF9F9AItem Tooltip Adjustment&r"
		"&7- &fIf an item's tooltip is too long, you can use the mouse wheel to scroll up/down to browse. &r"
		""
		"### &#FF91EESign Adjustment&r"
		"&7- &fFor signs placed on containers like chests, you can sneak to edit them. Directly clicking will pass through the sign to interact with the container's items. &r"
		""
		"### &#C9FF74Entity Cleanup System &r"
		"&7- Config file path: &9kubejs/server_scripts/entity_clean.js &r  "
		"&7- &fThe modpack includes an &6automatic cleanup system (disabled by default)&f, configurable in this file:  "
		"  &7▪ &fCleanup content  "
		"  &7▪ &fToggle status &r  "
		"&7- &fFor manual cleanup, use the command: &b/rf entityclean &r"
	]
	quest.13AFD3688361872A.quest_subtitle: "Gameplay Experience Modifications"
	quest.13AFD3688361872A.title: "Some Changes"
	quest.13C22895EB17EE88.quest_desc: [
		"&6Fluid Spout&r"
		""
		"&7A device specialized for performing ‘Fluid Filling’ processes, capable of:&r"
		"&7Filling container items (like buckets, glass bottles) with fluids, effective for most mod fluids as well;&r"
		"&7Executing special fluid filling recipes provided by the Create mod (e.g., wetting grass blocks, making blaze cakes).&r"
		""
		"&6Usage Requirements&r"
		"&7Must receive fluid input via fluid pipes or other fluid components; cannot be manually filled using buckets directly.&r"
		"&7Can process items on a conveyor belt or depot below. When a processable item enters its working range, it plays a filling animation and consumes the corresponding amount of fluid. Each filling process takes 21 game ticks (1.05 seconds).&r"
		"&7When the Fluid Spout has no fluid or insufficient fluid, it will stop processable items on the conveyor belt until fluid is replenished.&r"
		""
		"&8Let it drink its fill before it can feed what's below.&r"
	]
	quest.13C542FCBB189AEA.quest_subtitle: "Nameless Traveler"
	quest.13CCBB1FAF6834F4.quest_desc: [
		"&6Runewood Obelisk"
		"&7Spirit infusion, its necessity and laboriousness grow daily. Even something as simple as making a pile of Cursed Ash takes several minutes."
		""
		"&7The method of acceleration lies within &6Hallowed Gold&r&7. Placing up to four obelisks made from it around the altar speeds up this process by &aa quarter&r&7 per obelisk."
		""
		"Technology that can dramatically speed up spirit infusion, embodying the philosophy that \"faster is better\""
		"{@pagebreak}"
		"&6Experience Crystal Obelisk"
		"&7Although it isn't particularly useful for the infusion process itself, the obelisk's structure can be further utilized."
		""
		"&7Replacing Hallowed Gold with &eExperience Crystal&r&7 makes the obelisk harmonize with enchanted intellect, providing a large amount of enchanting power."
		"&7One such obelisk is equivalent to &bfive bookshelves&r&7."
	]
	quest.13CCBB1FAF6834F4.quest_subtitle: "Obelisks"
	quest.13CCBB1FAF6834F4.title: "Altar Acceleration"
	quest.13DF171E70CF449D.quest_desc: [
		"&oWith wind, or water, even the most primitive manpower—in any case, it began to turn."
		"&r"
		"Connect gears, let them spin and collide, transmit stress, play the symphony—so the manuscript says."
		""
		"My doubts can all be resolved by &6pressing [W] to ponder&r. I believe the path ahead is clear."
		""
		"&8However, is it also the machinist's wisdom that any windmill with wool can turn without wind?&r"
	]
	quest.13DF171E70CF449D.quest_subtitle: "And then the gears began to turn..."
	quest.13DF171E70CF449D.title: "First Whir of Gears"
	quest.13FB94D18517171F.quest_desc: [
		"&6Mixing Basin&r"
		""
		"&7It is the most tolerant container in the machinist's workshop, patiently holding various items and fluids, waiting for them to transform according to set recipes.&r"
		""
		"&6Internal Order&r"
		"&7The Mixing Basin has 18 item slots: the first 9 for accepting ingredients, the last 9 for storing products. Each item can stack up to one stack (64).&r"
		"&7It also has 4 fluid slots, each holding up to &c1000 mB&7, with total fluid not exceeding &c4000 mB&7. At any time, a single fluid type will not exceed the 1000 mB limit.&r"
		"&7Items and fluids coexist peacefully here, not interfering. Even lava and water can coexist safely—they do not interact inside the basin.&r"
		"{@pagebreak}"
		"&6Input and Output Rules&r"
		"&7All six sides can accept or output items, but any automated input can only send &c1 to 16&7 items at a time. The exception is items entering as entities, which can fill up to 64 at once.&r"
		"&7Components like Mechanical Arms and Brass Funnels can also input a maximum of 16 items, and Brass Funnels cannot set a specific quantity.&r"
		"&7Output is more lenient: Andesite Funnels output 1 per cycle, while Brass Funnels and Mechanical Arms can output 1 to 64 as configured. Conveyor Belts and Spouts can also serve as inputs, letting items slide in from the edge.&r"
		"&7Fluids must be transferred via Powered Pumps or pipes connected to them. When pumping in, it fills input slots first; when pumping out, it draws from output slots first. If output slots are empty and space is available, it will draw fluid from input slots—note this carefully to avoid confusing recipes.&r"
		"{@pagebreak}"
		"&6Filtering and Direction&r"
		"&7The side of the Mixing Basin has a filter slot. Placing a single item, an &eAttribute Filter&7, or &eProperty Filter&7 marks it to produce only that product (fluids can be marked using bottled samples).&r"
		"&7When the side is unobstructed and there is an open container diagonally below, the basin automatically generates an &eOutput Spout/Opening&7, attempting to send out products. This spout has a hidden output slot—if it contains an item, the basin stops working, a common cause of inexplicable production line halts.&r"
		"&7The spout holds output for only one recipe cycle. If a recipe yields multiple items, the first enters the spout slot, the rest go into the basin's output slots. Use a &eWrench&7 to adjust spout position or disable it. As long as the diagonal block doesn't update, the spout won't reappear.&r"
		"&7Blocks considered automatic output containers include: Mixing Basins, Depots, Conveyor Belts, Hoppers, Millstones, and most Create components, but vanilla hoppers are excluded.&r"
		"{@pagebreak}"
		"&6Recipe Processing Order&r"
		"&7When cooperating with devices like the &ePowered Press&7 or &ePowered Mixer&7, the basin processes recipes in this logic:&r"
		"&7If input slots have processable recipes: process pure item recipes first, then item-fluid mixed recipes, finally pure fluid recipes.&r"
		"&7If input slots have no recipes: prioritize all recipes in item slots, then item-fluid mixes, finally pure fluids.&r"
		""
		"&7Other details: Items of the same type try to stack in existing slots, not easily occupying new slots. If all 9 output slots are full, all processing stops.&r"
		""
		"&8The edge of the page has a dark stain, as if someone pressed a greasy thumb here.&r"
	]
	quest.13FB94D18517171F.quest_subtitle: "A small square container, but the heart of the entire factory"
	quest.142C80D05D6B1FDC.quest_subtitle: "Clears all difficulty settings you have adjusted, including 'Forsaken Child'."
	quest.143A6CDB76F7A3DC.quest_subtitle: "Stage 0"
	quest.147DBFF8D9EC5476.quest_subtitle: "Illager's Handheld Treasure"
	quest.14D4101B90CF5417.quest_subtitle: "Shouldn't you take a break now?"
	quest.14D4101B90CF5417.title: "Played for One Hour"
	quest.14F646FF9C81DCA0.quest_desc: [
		"&6Venomous Spider Fang&r"
		"&7Used to craft &cToxic Reagent&r&7 and heal &cPlague Doctor&r&7 familiars. Dropped by &cCave Spiders&r&7.&r"
	]
	quest.14F646FF9C81DCA0.quest_subtitle: "Toxin"
	quest.15420045F7ABF5AD.quest_desc: [
		"Upgraded via &bInfusion&r, the Nether Bookshelf has gained more powerful magic, providing higher &aQuanta&r and &4Quantization&r."
		"&l(Recommended Bookshelf)&r"
	]
	quest.15420045F7ABF5AD.quest_subtitle: "Better Quantization and Quanta"
	quest.15420045F7ABF5AD.title: "Chaotic Mana Enhancement"
	quest.159E4C31CF4AB181.quest_desc: [
		"&6Pact of the Unforgiving Void Maw&r"
		""
		"&7The essence devoured comes from malice, and thus craves corrosion.&r"
		"&7-Misuse slowly decays all &cHealing&r received&r"
		""
		"&7Corrosive patterns engraved into malice-summoning souls.&r"
		"&7-&6Malicious Critical&r&7 &8Devours&r&7 the &8Life Essence&r of affected creatures&r"
		"&7-Devoured essence &aHeals&r&7 you based on damage dealt&r"
	]
	quest.159E4C31CF4AB181.quest_subtitle: "Devouring All Things"
	quest.159E4C31CF4AB181.title: "Pact of the Unforgiving Void Maw"
	quest.15DDBCE29F4CEB4B.quest_subtitle: "Crafting material, primarily used for making advanced machinery and intelligent components."
	quest.15F15A1FF0EDD7E3.quest_desc: [
		"&7It's hard to imagine creating a creature just to kill it, but this special transformation that yields Nether Stars is indeed beyond human capability."
		""
		"&7The Wither is essentially vanilla difficulty; with a bit of preparation, it can be easily defeated."
	]
	quest.1618DB9594EF15C3.quest_subtitle: "It's lonely being invincible"
	quest.1633AD29D81FB414.quest_desc: [
		"&aQuanta&7 is a tiny bit higher than vanilla bookshelves... Blocks of different Quanta levels placed near an enchantment table will stack from low to high. For example, 15 vanilla bookshelves can stack to 30 Quanta. Placing ten Amethyst blocks then adds +10 Quanta, reaching 40. This also applies to other bookshelves."
		""
		"{@pagebreak}"
		"&7In the mine, a geode radiating magic caught your attention."
		"&7You discovered this thriving cluster of crystals. It emanates a faint but relatively strong magical force, at least better than your current bookshelves. You carefully brought it back and placed it near the enchantment table. You noticed the table's magical power increased slightly, and the instability of enchanting decreased a little. But this mere mouthful is still too little. You wonder if a more powerful version exists."
	]
	quest.1633AD29D81FB414.quest_subtitle: "Mysterious Crystals"
	quest.1633AD29D81FB414.title: "Natural Mana Stabilizer"
	quest.1675C48578D2D979.quest_desc: ["&7Both Wither Skeleton Skulls and regular Skeleton Skulls have new crafting recipes. If you need skulls to summon the Wither but can't seem to get any drops, you can craft them directly instead of endlessly chasing Wither Skeletons..."]
	quest.16FD71D5EBCE3C6A.quest_desc: [
		"&6Train Controls&r"
		""
		"&7This is the ‘helm’ of the train structure, allowing the driver—or another creature—to control the movement of the entire mechanical construct.&r"
		""
		"&6Installation&r"
		"&7Each train structure must contain at least one Train Controls, securely glued to the structure during assembly.&r"
		"&7If you want a creature to drive, place a &eSeat&7 or &eBlaze Burner&7 directly in front of the controls.&r"
		"&7For bidirectional travel, install one Train Controls at each end of the structure.&r"
		""
		"&6Operation&r"
		"&7After assembly, two control levers appear on the controls. Right-click to enter control mode.&r"
		"&7Use movement keys (WASD) to control the train's movement. A speed bar in the interface shows current speed in real-time. This bar has 18 segments divided into five stages.&r"
		"&7Speed automatically decreases when turning.&r"
		"&7Store coal in the train to increase travel speed; fuel is consumed over time.&r"
		"&7Scroll the mouse wheel to adjust the speed limit, displayed visually by a brass slider's position.&r"
		"&7The arrow above the speed bar indicates the relative direction of the train's forward movement in your field of view.&r"
		"&7If the train has a whistle, press the sprint key (default Ctrl) to sound it.&r"
		""
		"&8This page's corner is folded, with a simple sketch of a control panel in charcoal. Scribbled beside it: Hold tight, watch the track, remember the coal.&r"
	]
	quest.1739A8FBB4773234.quest_desc: ["Some metals do not have corresponding blocks and therefore cannot be cast."]
	quest.1739A8FBB4773234.quest_subtitle: "Fluid to Block"
	quest.17695E30CD9EB522.quest_subtitle: "Surely no one died over 100 times just for this quest's reward... right?"
	quest.17B9D8741CF45918.quest_desc: [
		"&7During my research into enchanting, I discovered some strange bookshelves."
		""
		"&7The Stone Bookshelf and Melon Bookshelf can be used to suppress untimely &5Arcana&7 and &cQuantization&7, creating conditions for &eInfusion&7."
		""
		"{@pagebreak}"
		"&7The Stone Bookshelf was an item born from the same accident. Unlike the unremarkable Deepslate bookshelf, this one made from more common stone showed a排斥性 towards enchantments. Perhaps andesite's entanglement with machinery runs too deep; this bookshelf actually reduces both &aQuanta&7 and &5Arcana&7. The certainty of technology here denies the mystery of magic, even though magic undoubtedly exists in this world."
		""
		"&7The Melon Bookshelf, on the other hand, was a ridiculous accident. While harvesting melons, I temporarily stacked them on a bookshelf. When I went to move the melons to the warehouse, I found the bookshelf's enchanting power had been suppressed. I continued my research and, on a whim, made a gilded melon into a bookshelf. Perhaps it's related to eating melons in hot weather? This bookshelf, while reducing &aQuanta&7, also suppresses the effects of &cQuantization&7. Whether this absurd reason holds true, or if the demonic power was partially bribed by the melon, remains unknown."
	]
	quest.17B9D8741CF45918.quest_subtitle: "Ability Suppression"
	quest.17B9D8741CF45918.title: "The Strangest Bookshelves"
	quest.17CD8FFD1387207D.quest_desc: [
		"&7Besides finding naturally spawned bosses, you can also summon bosses yourself using the Calamity Lich's Spirit Altar. Check JEI for the specific summoning recipes."
		""
		"&7Simply search for the boss name. If there is a spawn egg named \"&eSpawn: ****&7\" with the description \"&eImmediately summons the associated entity when used in the world&7\", it means the boss can be manually summoned. Click on the spawn egg to view the summoning recipe."
		""
		"&cPlease note: As the description states, this is a summoning ritual. The boss will be spawned immediately upon completion, so please perform the ritual in an open area."
	]
	quest.17CD8FFD1387207D.quest_subtitle: "At your age, at this stage, how can you even sleep?"
	quest.17CD8FFD1387207D.title: "Repeated Defeats"
	quest.17DE5C30E0CA8765.quest_desc: [
		"# &bPerformance Optimization Recommendations &r"
		""
		"### &e Video Settings Suggestions &r"
		"&b▸ &6Render Distance：&r&l8&r  "
		"&b▸ &6Max Shadow Distance：&r&l6&r  "
		"&b▸ &6Simulation Distance：&r&l6&r  "
		"&b▸ &6VSync：&r&cOff&r  "
		"&b▸ &6Max Framerate：&r&aUnlimited&r  "
		"&b▸ &6Entity Render Distance：&r&975%&r  "
		""
		"&7Other settings can remain default.  "
		""
		"### &3Notes &r"
		"&7- Adjust values slightly based on device performance.  "
		"&7- If experiencing lag, consider reducing render distance appropriately.  "
	]
	quest.17DE5C30E0CA8765.quest_subtitle: "Huh? Optimization isn't as good as imagined?"
	quest.182289427E06D427.quest_subtitle: "Auto-clicker's Best Friend"
	quest.182321BDA643635C.quest_desc: ["The current access efficiency of the storage network can no longer meet my needs; I must seek faster data read/write solutions."]
	quest.182321BDA643635C.quest_subtitle: "Faster, Better, Stronger!"
	quest.18AC27B34367E1DD.quest_desc: ["Performs a sneak operation to instantly mine blocks (This is a bug, but I think keeping it makes things more interesting)."]
	quest.18AC27B34367E1DD.quest_subtitle: "Tunnel Digger"
	quest.18C5ACA6F816EDCB.quest_desc: [
		"&6Miniature Shield&r"
		"&7Right-click on a tamed familiar to grant it a low probability to &ablock&r&7 attacks. Limited to 1 per familiar. Obtained via the &eShrinker&r&7.&r"
	]
	quest.18D4FAD08F8837FD.quest_desc: [
		"&6Pandora's Box&r"
		"&7Can simultaneously &aSummon/Dismiss&r&7 up to 10 familiars (obtained via crafting).&r"
	]
	quest.18D4FAD08F8837FD.quest_subtitle: "You opened Pandora's Box..."
	quest.19201243CFB2D97B.quest_desc: ["&7These sparkling diamonds are indeed a pleasant surprise. At least I haven't seen raw ore this large before, though then again, I never had the chance to mine personally before. I safely stored away these gems."]
	quest.19201243CFB2D97B.title: "Gems"
	quest.192F6B22F5E521FF.quest_desc: [
		"&7At least there's a place to sleep now..."
		""
		"&7The modpack has altered phantom spawning. Phantoms no longer spawn when players avoid sleeping for a long time. Instead, they now spawn when players &6sleep consecutively&7, as a &4penalty&r for skipping nights."
		""
		"&7This change may make naturally spawned phantoms rare. If phantom drops are needed, look for structures containing phantom spawners."
	]
	quest.192F6B22F5E521FF.title: "Establish a Base"
	quest.1954C7719D379871.quest_desc: [
		"&6Shield Apparatus&r"
		""
		"&7Borrowing the multi-phase stacking nature of Soulstained Steel, the Shield Apparatus has a chance to completely absorb the wear sustained by &eFocus Tokens&r&7, while slightly stabilizing the &aFocus Process&r&7. However, it does slow down the focus speed.&r"
	]
	quest.1954C7719D379871.quest_subtitle: "Facing the Storm"
	quest.1961FD8A838EAA52.quest_desc: [
		"\"The endless resentment of departed souls eventually coalesced into a horrific monster beyond description...\""
		""
		"&7A construct, an undead, an amalgamation of vengeful spirits. I found the assembly schematic in a chest within a Nether Fortress and decided to try building it following the instructions. Even though I sensed something ominous when I touched the Soul Sand, I didn't stop—with sufficient strength, what harm could a little curiosity do?"
		""
		"&7Turns out curiosity really can kill. The schematic didn't mention this thing would explode upon assembly. And I had just crafted that Totem of Undying too..."
	]
	quest.1961FD8A838EAA52.title: "Wither Manor"
	quest.1A4259700BD803E8.quest_desc: [
		"&6Andesite Funnel&r"
		""
		"&6Funnels and Items&r"
		"&7When attached to a container, the Andesite Funnel defaults to output mode, pushing items from the container as entities from its front. When switched to input mode, it rapidly absorbs all item entities in its block space, with no speed limit. Use a wrench to toggle mode.&r"
		"&7In input mode, holding an item and right-clicking the funnel's front directly deposits the item into its connected container.&r"
		"&7Consistent with common designs, a redstone signal can lock the Andesite Funnel, halting its operation.&r"
		""
		"&7Andesite Funnels can be installed above or below containers. When outputting upward, items are ejected with some momentum. If not collected promptly, entities pile above the funnel. This can be used for &avertical upward transport&r.&r"
		""
		"&6Regarding Vertical Orientation&r"
		"&7When the funnel mouth faces directly up or down, it cannot serve as a pure vertical transport pipe. For pure vertical transfer, consider Chutes or vanilla hoppers.&r"
		""
		"&6Connecting to Work Blocks&r"
		"&7When an Andesite Funnel is attached to a block's side and a specific work block exists directly below it, it directly exchanges items with that block. Using a wrench to toggle mode in this case changes its appearance to ‘&eAndesite Conveyor Funnel&r’.&r"
		"{@pagebreak}"
		"&7Blocks that can interface directly include: &eDepot&r, &eEjector&r, &eConveyor Belt&r, &eFluid Spout&r, &ePowered Saw&r (only when facing up), &eTrain Station&r.&r"
		""
		"&7If an Andesite Funnel is placed on a conveyor belt with its opening aligned with the belt's direction, it enters tunnel mode. Item input or output is then entirely determined by the belt's direction.&r"
		"&7Tunnel funnels default to retracted form; a wrench can switch them to extended form. Extended funnels cover part of the belt below, usable for decoration, and their hitbox changes accordingly.&r"
		""
		"&8Note on manuscript edge: It's flexible, but don't expect it to break fundamental rules.&r"
	]
	quest.1A58667FA2440598.quest_desc: [
		"&o&8Memories are like weathered inscriptions."
		"&o&8Every attempt to recall is hazy, dizzyingly vague—"
		"&o&8After the dizziness fades, only chaos remains."
	]
	quest.1A58667FA2440598.quest_subtitle: "Pack Your Bags"
	quest.1A58667FA2440598.title: "Wilderness Pioneering"
	quest.1A8CEE0746A74FC4.quest_subtitle: "Stage 0"
	quest.1AA4DC70AD282F2B.quest_desc: [
		"&6Impurity Stabilizer&r"
		""
		"&7&8Wicked Spirits&r&7 actively approach weaknesses and the weak, craving slaughter. The Impurity Stabilizer utilizes this property, providing significant &aPercentage Tuning Amplification&r&7 to the crucible's weakest attribute, aside from fuel usage rate and destabilization risk. However, this does have side effects, adding a slight burden to the standard &eTuning Process&r&7.&r"
	]
	quest.1AA4DC70AD282F2B.quest_subtitle: "Strength from Weakness"
	quest.1AA82BAE61749007.quest_desc: [
		"&6Slaughter Rune&r"
		""
		"&7The Slaughter Rune urges the consciousness to pursue destruction, increasing the wearer's &eScythe Proficiency&r&7 against injured targets. The rune seems to take effect on targets with health at or below half, causing the scythe to deal about two-fifths more damage to them.&r"
	]
	quest.1AA82BAE61749007.quest_subtitle: "Pulse That Promotes Destruction"
	quest.1AB5165BCAD5820E.quest_desc: [
		"&6Scorching Rune&r"
		""
		"&7The Scorching Rune urges the consciousness to share its radiance with surrounding things, but the consequences are not considered; it doubles the &eFire Damage&r&7 dealt by the wearer.&r"
	]
	quest.1AB5165BCAD5820E.quest_subtitle: "Pulse That Promotes Burning"
	quest.1AC360E218A91528.quest_desc: [
		"&aDue to extreme optimization, crashes may occur randomly when launching the game. If you wish to avoid this and can accept disabling some optimization features:"
		"&r"
		"Disable："
		"&7ImmediatelyFast （for versions 1.18 to 1.21.4; disable ImmediatelyFast's hud_batching, font_atlas_resizing, and fast_text_lookup, as they may cause crashes; &r"
	]
	quest.1AC360E218A91528.quest_subtitle: "Restarting should fix it."
	quest.1AC360E218A91528.title: "Stuck?"
	quest.1B819E833413B729.title: "Mystic Ghoul"
	quest.1BD8D56B55550058.quest_desc: [
		"&6Treaty of the Reaper"
		"&7Breaking bonds leads to &cPredicament&r&7.&r&cWeapons not permitted by the Mandate deal nine-tenths less damage&r&cWeapons not permitted by the Mandate rapidly break when used"
		"&7The soul signs a treaty with the scythe; arcane chains tightly connect the two.&r&aScythe attacks have a chance to trigger a chain slash"
	]
	quest.1BD8D56B55550058.quest_subtitle: "Mastering the Scythe"
	quest.1BD8D56B55550058.title: "Treaty of the Reaper"
	quest.1C22E01E9591DC36.quest_subtitle: "Friendly Fire Frenzy"
	quest.1C22E01E9591DC36.title: "Kill 10 Players"
	quest.1CBEB689E8C2B677.quest_desc: [
		"&6Research: Void Slate"
		"&7After passing through the &dWeeping Well&r&7, the &bSoulstone&r&7 transformed into a substance I call \"&8Void Slate&r&7\". While its physical properties are similar to Soulstone, it seems to lack a soul... yet its manner of interacting with Arcane Energy remains identical to Soulstone."
		"&7"
		"&7Perhaps this is the state of Soulstone before it acquires &dSoul Energy&r&7? I cannot determine its pattern of interaction with souls, nor can I transfer this property like I can to create &6Soulstained Steel&r&7. My only theory is that a state of complete absence of Arcane Energy, not even a trace, somehow possesses its own unique Arcane Energy. What could this energy be?"
		"&7"
		"{@pagebreak}"
		"&6Revisiting: Void Slate"
		"&7The complete absence of Arcane Energy also has its effect. The nature of Void Slate should now be clear—Soulstone; Soulstone attuned to the &8Void&r&7, not to Arcane Energy."
		"&7"
		"&7It may still be the precursor to Soulstone, but the two could be related in other ways... Its physical manifestation properties are consistent with Soulstone. The differing properties are entirely due to the different entities the stone interacts with."
	]
	quest.1CBEB689E8C2B677.quest_subtitle: "Blank Slate, Perhaps the Precursor"
	quest.1CD6A8BB98046D3C.quest_desc: [
		"&7Small components that provide various bonuses to aircraft. Depending on the aircraft type, they can compensate for weaknesses or enhance specific strengths."
		""
		"&7It's worth noting that the Enhanced Propeller's air resistance reduction seems to significantly help with aircraft speed improvement."
	]
	quest.1CDBC70DB8D56271.quest_desc: [
		"After some rest, I've reinforced my weapons and armor. It's time to continue exploring. The village is not my final destination. If possible, I must find a way home."
		"&0&mDo I really want to go home? I can't go home yet. My mission is to &kface the end&r&0&m."
	]
	quest.1CDBC70DB8D56271.title: "After a Brief Rest... Depart Again"
	quest.1CE41ACD131E060B.quest_desc: [
		"&6Starfire&r"
		"&7Can upgrade &eHot Spring Stone Equipment&r&7 into stronger &6Starfire Equipment&r&7. The upgrade process consumes a &bSmithing Template (Starfire Upgrade)&r."
		""
		"&7Starfire can also provide &dTexture Color&r for Armor Trim Smithing Templates in a Smithing Table."
		""
		"&7Holding and right-clicking can &aThrow&r&7 the held Starfire. Thrown Starfire explodes upon hitting a creature or block, applying the &cStarfire I for 10 seconds&r&7 effect to all creatures within a radius of &b3 blocks&r&7 of the impact point."
		"&7Thrown Starfire &cDoes not cause attack damage&r&7 when hitting a creature."
		""
		"&7Throwing Starfire at &8Sand&r&7 or &8Dusk Sand&r&7 will convert the hit sand or dusk sand into &eCoarse Glazed Terracotta&r."
		"&7&eGlazed Terracotta&r&7 processed from Coarse Glazed Terracotta is a material used to craft another type of &6Tier 2 Equipment&r&7."
		""
		"&7Holding Starfire and right-clicking a &8Torreya Campfire&r&7 transforms its burning flame into a brighter red."
		"&7The upgraded Torreya Campfire continuously applies &cStarfire I for 4 seconds&r&7 to non-friendly targets within a radius of &b10 blocks&r&7 of itself."
		"&7After upgrading, the &aHealth Regeneration effect&r&7 the Torreya Campfire previously had will continue to be retained."
		"&7Even if the Torreya Campfire is extinguished, the above enhancement abilities will continue to &aTake Effect&r&7 after it is re-lit."
	]
	quest.1CE41ACD131E060B.quest_subtitle: "Flame of Burning Crystal"
	quest.1D08BC5C6C98F4D7.quest_desc: ["&7You'd better not have done that on purpose."]
	quest.1D08BC5C6C98F4D7.quest_subtitle: "The legendary hero who triggered 5 raids?!?"
	quest.1D3C94736A0C19AA.quest_desc: ["Manages all configured auto-crafting schemes in your storage network, allowing item access and scheduling anytime."]
	quest.1D3C94736A0C19AA.quest_subtitle: "Assembly Line Operation"
	quest.1D7C2FBD7B33CA7A.quest_subtitle: "Stage 1"
	quest.1DC249D36D54E164.quest_subtitle: "Exquisite Creation"
	quest.1DDF2D0C0D0D8DDA.quest_desc: ["&7Flying fortress. Can fly slowly through the air and strafe downward with onboard weapons. Due to its enormous size, slow speed, and unremarkable weaponry, this is only mentioned here for reference and not recommended for practical use."]
	quest.1E1304B2BD351410.quest_desc: ["&7A classic combination that stands the test of time. The tank, paired with an experience pump, can store experience points, so even if you die, you won't lose your XP. The amount of experience a tank can store scales with the stack size of the backpack. By installing enough Stack Upgrades, you can store a massive amount of experience for when you need it most."]
	quest.1E1304B2BD351410.quest_subtitle: "Liquefied Experience"
	quest.1E2790853AD3FE5E.quest_desc: ["&7Allows you to set a destruction mode to get rid of unwanted junk items in your backpack. It's very useful for daily mob grinding, mining, or handling drops from spawner farms—but be careful not to destroy things you actually need."]
	quest.1E2790853AD3FE5E.quest_subtitle: "It's Called Void, But It's Really a Trash Can"
	quest.1E5FC0856DAA4E01.quest_subtitle: "Centurion"
	quest.1E5FC0856DAA4E01.title: "Slay Champion Mobs x100"
	quest.1EA661BBFE32AD97.quest_subtitle: "Swift Sword"
	quest.1EBAE1ABF6C57762.quest_desc: [
		"&7Indeed, permanent Mandates are also &8heavy burdens&r&7. Mandates are powerful, but their &cnegative effects&r&7 follow like shadows."
		"&7Mandates can be retrieved at a &6Brazier&r&7, allowing you to choose which price to pay."
		""
		"&7To retrieve a Mandate, first prepare the materials used during its proclamation at the Brazier, then ignite it using &5Violation Flame&r&7."
		"&7This operation will &crevoke&r&7 rather than proclaim the Mandate. The rest of the process is the same as proclamation; revoking a Mandate on a simple soul also requires weakening it before ignition."
	]
	quest.1EBAE1ABF6C57762.quest_subtitle: "The Price is Too High"
	quest.1EBAE1ABF6C57762.title: "Retrieving Mandates"
	quest.1EBDC6E060A25C43.quest_desc: [
		"&6Memory Fragment&r"
		"&7Remnants of a familiar's forgotten past; they will guide you to places the familiar considers &bhome&r&7.&r"
	]
	quest.1F113AE0032F16AA.quest_desc: ["&7Activate auto-pickup—it can sometimes save dropped items, because it really picks up fast. You can also use it to try and grab drops that might be nearby but hard to find."]
	quest.1F113AE0032F16AA.quest_subtitle: "Sorry, forgot to turn off auto-pickup"
	quest.1F38C534465F33BC.quest_desc: [
		"&6Fluid Pipe&r"
		""
		"&6Usage / How to Use&r"
		""
		"&6Transmitting Fluids&r"
		"&7Requires a &ePowered Pump&r&7 to provide pressure (power) for transmission. By default, a pump can transmit &c16 blocks&r&7. Another pump is needed to extend the range further.&r"
		"&7The pipe itself has no fluid transmission speed limit; speed depends on the extraction rate.&r"
		"{@pagebreak}"
		"&7If the pipe opening is exposed, it consumes 1000 mB of fluid to generate a corresponding fluid block in the direction of the opening (if no block form exists, only leak effects show, consuming 1 mB/t). It can also extract fluid blocks adjacent to the opening in reverse.&r"
		"&7When extracting infinite water, the pipe doesn't appear to consume the source, but the water block being extracted constantly alternates between source and flowing. If a single water block is extracted faster than 200 mB/t (equivalent to two pumps at 200 RPM), the source replenishment can't keep up (use a wrench to open the window to see intermittent flow). At this point, actual extraction speed no longer increases with pump speed.&r"
		"{@pagebreak}"
		"&7Additionally, when using multiple pipes to extract infinite water, ensure each extracted water block is adjacent to at least two water sources not being extracted by other pipes. Otherwise, multiple sources being drained simultaneously may cause infinite water to fail or cause extraction speed fluctuations.&r"
		"{@pagebreak}"
		"&7When water contains kelp, the pipe cannot extract from that block. Simply breaking the kelp doesn't restore extraction; the pipe system must be updated (e.g., changing block state, adjusting pump speed, replacing pipe opening fluid). Water in other waterlogged blocks can be extracted normally.&r"
		"&7Fluid Pipes can extract water and lava from &eCauldrons&r&7.&r"
		"&7Fluid Pipes can extract &eHoney&r&7 from &eBee Nests&r&7 or &eBeehives&r&7 filled with honey, unlocking the advancement [Automated Apiary].&r"
		"&7Pipes themselves have no buffer. If fluid is already flowing and the pipe is interrupted (broken or valve closed), fluid in the interrupted segment disappears as the flow process resets. Suddenly switching fluid sources also causes this effect.&r"
		""
		"&6Effect on Entities&r"
		"&7If the leaking fluid is a potion, it applies the effect to entities in front; milk removes potion effects.&r"
		"&7Water particles from leaking pipes extinguish fire on entities and blocks; lava particles ignite entities.&r"
		"&7Regardless of how much fluid is sprayed, the game always grants the full effect. This means players can use 1 mB of potion to give an entity the full effect.&r"
		""
		"&6Opening Inspection Window&r"
		"&7Use a wrench to open a pipe's inspection window, allowing you to see the fluid inside. A windowed pipe cannot bend. Use the wrench again to close.&r"
		""
		"&6Encasing&r"
		"&7Right-click with a &eCopper Casing&r&7 to encase it. The casing is not consumed.&r"
		"&7Encased pipes lock their opening directions and number of openings, and will not automatically connect to newly placed pipes nearby.&r"
		""
		"&6Fluid Interaction Reactions Inside Pipes&r"
		"&7When two fluids meet inside a pipe, the pipe is destroyed and generates a block based on the fluid types (specific reaction table omitted).&r"
	]
	quest.1F6AE0000E7194CE.quest_desc: [
		"&7Convinced this place isn't completely uninhabited, I set off in one direction. After a long effort, I actually came upon a settlement, but my previous encounters made me tense up and approach cautiously."
		""
		"&7A villager at the village entrance noticed me and stopped working. Their gazes were scrutinizing as they whispered amongst themselves. Soon, an elder with graying hair approached, accompanied by a few guards, stopping a few steps away. \"&3Traveler, this wilderness is unsettled. It's been a long time since we've seen a lone stranger. Where do you come from?&7\""
		""
		"&7I admitted that I woke up in the wilderness, not knowing what happened. The village chief frowned, not fully believing me, but didn't drive me away. \"&3The village has its rules,&7\" he said. \"&3You can trade things you find in the wild for essentials at the blacksmith or general store. You can stay temporarily in the empty mill to the east, but don't wander around the village after sunset. Things have been... restless lately.&7\""
		""
		"&7Indeed, the people here aren't friendly either. Though they didn't attack me directly, extreme vigilance was written on the guards' faces. Likely, the slightest transgression would provoke an attack."
		""
		"&7Are there monsters disguised as humans in the Chaotic Wasteland, or is it that..."
		""
		"&7Regardless, at least communication is possible. I can gather information about this area and trade for some needed supplies. The fatigue of being alone for so long suddenly washed over me. I need to rest properly in the village."
	]
	quest.1F6AE0000E7194CE.title: "Reach the Village"
	quest.1F71B459B51B8E4B.quest_desc: [
		"&6Intricate Component&r"
		""
		"&7The Intricate Component draws power from its fractal-like chaotic intricate nature, as its name suggests. After installation, fuel dependency increases and focus speed decreases, but the &eCrucible&r&7 has a chance to produce double the output in a single &6Focus Cycle&r&7.&r"
	]
	quest.1F71B459B51B8E4B.quest_subtitle: "Bountiful Abundance"
	quest.1F9846B94E48DEDF.quest_desc: ["&7Using the light of End Rods, I strengthened the End Bookshelf, symbol of finality. It now provides more enchanting stats, though the magic of End Rods isn't strong enough to reach the pinnacle of enchanting power."]
	quest.1F9846B94E48DEDF.quest_subtitle: "Strengthened End Bookshelf"
	quest.1F9846B94E48DEDF.title: "Ender Power Re-emerges"
	quest.1FB3D1FAE9A88C39.quest_desc: [
		"&6Machinist's Handbook&r"
		"&7Picked up by chance on the journey, this booklet seems to be the legacy of a machinist.&r"
		"&7According to the manuscript, mastering these arts allows one to become a machinist. This means I can build my own production lines, produce endless resources, access more synthesis methods, and extract resources from ores that furnaces cannot refine.&r"
		""
		"&7However, this is not a required path for the journey. Becoming a machinist offers almost no help to my combat prowess. The original owner of this manuscript couldn't even build a faulty robot to aid in battle. The benefits gained are more of a luxury than a necessity.&r"
		""
		"&7If interested, perhaps I could try to delve into it. The starting point for everything seems to be a cheap material called &6Andesite Alloy&r&7.&r"
	]
	quest.1FB3D1FAE9A88C39.quest_subtitle: "Won't affect anything even if you don't use it, probably"
	quest.1FB3D1FAE9A88C39.title: "Prologue of Gears"
	quest.1FB95C69AF3C83E3.quest_desc: [
		"&6Archmage Settlements&r"
		"&7Archmages travel to the &6End&r&7 dimension to study the secrets of the endless void, thus requiring a temporary dwelling. They have decided to construct temporary homes throughout the End to facilitate their research and exploration.&r"
	]
	quest.1FB95C69AF3C83E3.title: "&6Archmage Settlements&r"
	quest.1FBA0FE6A13F8E70.quest_subtitle: "You will receive a starter kit."
	quest.1FBA0FE6A13F8E70.title: "&a\"Honey that Masks Suffering at the Beginning\""
	quest.1FC7A319D738A388.quest_subtitle: "Classic Weapon"
	quest.1FD98B36E1B61A56.quest_desc: ["As an upgraded version of the bookshelf, the Nether Bookshelf provides a higher enchanting cap than an ordinary bookshelf. Magic from the Nether grants the bookshelf additional &4&lQuantization&r&r."]
	quest.1FD98B36E1B61A56.quest_subtitle: "The Advent of Quantization"
	quest.1FD98B36E1B61A56.title: "Nether Enchanting Power – Embrace Chaos"
	quest.20026163291DE7A2.quest_desc: ["&7This bookshelf currently performs identically to an ordinary wooden one. The cracks on it make it feel even more ancient and平凡 than an ordinary bookshelf. Yet, you can sense a mysterious power surging within, like a heartbeat, like sculk, waiting to be awakened."]
	quest.20026163291DE7A2.quest_subtitle: "Sculk Power Slumbers Deep"
	quest.20026163291DE7A2.title: "An Accidental Attempt?"
	quest.2037EF7CC87E7974.quest_desc: [
		""
		"Normally, it can be used as a casting device. Right-clicking the Drain, if it's connected to a &aCasting Table&r and &aMold Cavity&r, allows liquid outflow."
		""
		"Can receive &credstone signals&r."
		"{@pagebreak}"
		"Fluid can also be directly imported into liquid containers."
		"{image:kubejs:textures/gui/productivemetalworks_kjs_1.png width:150 height:100 align:center fit:true}"
	]
	quest.2037EF7CC87E7974.quest_subtitle: "Export Liquid"
	quest.20736EF41F1FED8E.quest_desc: ["Echo Shards effectively increase various drops produced by mobs, triggering an additional drop roll upon mob death. This attribute has a maximum of level 3."]
	quest.20736EF41F1FED8E.quest_subtitle: "Increased Drops\\nIncreased Drops"
	quest.2075CDEF8E217AEA.quest_subtitle: "And you are...?"
	quest.2075CDEF8E217AEA.title: "First Champion Mob Kill"
	quest.20848CB8F54AD783.quest_desc: ["&7Pure stats again. As a tip, it provides an extremely terrifying &42.1x&7 attack multiplier. The only downside is that the Acropolis might be far away and hard to reach..."]
	quest.20848CB8F54AD783.quest_subtitle: "You're in the Same League as the Stat Stick"
	quest.20EF8A85CD3EFF3A.quest_desc: [
		"&6Spirit Focusing"
		"&7Utilizing the divergent properties of &dTwisted Rock&r&7 and &cFoulstone&r&7, I created a device that can draw in and focus &eArcane Energy&r&7. If a compatible substrate is placed within, this process can be used to create new things."
		"&7"
		"&7The most basic substrate is the &6Alchemical Focus Token&r&7, very similar to a certain object I've seen before. By infusing it with &eArcane Energy&r&7 and adding a bit of mineral ash, it can be transmuted into an entirely new substance, but this process also &cdamages the Focus Token&r&7."
	]
	quest.20EF8A85CD3EFF3A.quest_subtitle: "Mysterious Replication"
	quest.20EF8A85CD3EFF3A.title: "Spirit Focusing"
	quest.21294371EDEA78C6.quest_desc: [
		"&7Security Cards are items bound to a player by right-clicking."
		""
		"Right-clicking binds it to a player and opens the configuration interface. Sneak + right-click resets the security settings."
	]
	quest.21294371EDEA78C6.quest_subtitle: "Let Me In!"
	quest.214D64602702D242.quest_desc: [
		"&6Suspicious Device&r"
		""
		"&7Arcane and Eldritch are indeed opposed, and indeed they can be used to create opposing enhancements. However, in the torrential flow of Arcane towards Eldritch termination, only chaos is produced, and the result is... a corruption-erupting explosion and the Withering it brings. This entry serves as a warning, not a recommendation.&r"
	]
	quest.214D64602702D242.quest_subtitle: "A Cautionary Tale"
	quest.215AB6260ED8DAAD.quest_desc: ["&7Feeling lucky?&r"]
	quest.215AB6260ED8DAAD.quest_subtitle: "Random Tier + Random Enchantment"
	quest.215AB6260ED8DAAD.title: "Random Enchanted Book Sale"
	quest.2190DB8F13415C43.quest_desc: [
		"&6Flame Promulgator"
		"&7&cEvolutionary Fire&r&7 is extremely intense; it destroys everything in its path for its own evolution and spread. Therefore, destructive weapons based on it must exist, and indeed they do."
		"&7"
		"&7I used a pair of &6Lantern Pliers&r&7 to create this \"&6Flame Promulgator&r&7\". It recalibrates &bAura Embers&r&7 to \"unlock\" them, turning their gentle flames into explosive infernos, and contains them until ready to launch."
		"&7"
		"&7I added a layer of safety, because... I don't want to rebuild my lab again. These flames are extremely explosive. Of course, basic blast protection like obsidian can block them."
	]
	quest.2190DB8F13415C43.quest_subtitle: "Evolution Surpasses All"
	quest.219B219DA2F8C114.quest_desc: [
		"&6Lush Shallows&r"
		"&7Is one of the ocean biomes in Starlight."
		""
		"&7The Lush Shallows have vegetation coverage distinct from the Sea of Starlight."
		"&7Its iconic &#32CD32Sea Bell Stem Thicket&r&7 and unique &#9ACD32Yellow-Green Ambient Color&r&7 give the biome an overall unique and tranquil atmosphere."
		""
		"&7Non-aquatic creatures can only spawn dozens of blocks deep underground in the Lush Shallows."
	]
	quest.219B219DA2F8C114.quest_subtitle: "Prosperous Forest"
	quest.219B219DA2F8C114.title: "Lush Shallows"
	quest.219F39116C48B242.quest_desc: [
		"&7If you want to store fluids directly rather than storing them in buckets, you need to use Fluid Storage."
		""
		"In the terminal, right-click with a bucket to pour the fluid into the terminal. Right-click with an empty bucket to fill a bucket."
	]
	quest.219F39116C48B242.quest_subtitle: "Fluid Storage"
	quest.21DFA7D5BF06FF3A.quest_desc: [
		"&6Mirror of Truth&r"
		"&7Used to reveal disguised &dIllusionist&r&7 familiars. Obtainable via &6ritual&r&7.&r"
	]
	quest.21F608E19AD6FDF6.quest_desc: ["Currently, only some basic materials can be recycled. With existing technology, more complex materials cannot be dismantled. Perhaps higher disassembly techniques can be learned in the future."]
	quest.21F608E19AD6FDF6.quest_subtitle: "Recycling"
	quest.221645B2BE16D7E1.quest_desc: [
		"&6Treaty of the Prospector&r"
		""
		"&7Greed Burns the Body&r"
		"&7-Being hit while under the '&cGreed&r' effect causes you to be engulfed in &cFlames&r"
		""
		"&7Benefit from the flames.&r"
		"&7-Collecting &eValuable Minerals&r grants the '&6Greed&r' effect&r"
		"&7-The '&6Greed&r' effect gradually increases &aLuck Probability&r"
		"&7-Gaining the '&6Greed&r' effect also restores one heart of &aLost Health&r"
	]
	quest.221645B2BE16D7E1.quest_subtitle: "Earth's Treasures"
	quest.221645B2BE16D7E1.title: "Treaty of the Prospector"
	quest.2218345B2D47B183.title: "Bitter Cometspook"
	quest.2227DDA9A63E5685.quest_subtitle: "Stage 0"
	quest.2248B07BE012F5B4.quest_desc: ["&7Original airship variant. Stable flight and relatively small size. The downside is its somewhat slow speed, making it unremarkable for exploration."]
	quest.2254C590DE6A8100.quest_desc: [
		"&6Treaty of the Berserker"
		"&7Harm yourself, harm others.&r&cFury subsides over time&r&cDamage taken doubled"
		"&7Endless fury, eternal rage; pain brings fury, fury is power.&r&aDamage taken turns into Fury&r&aDealing damage constantly fires &cWicked Arcane Bolts&r at enemies based on Fury"
	]
	quest.2254C590DE6A8100.quest_subtitle: "An Eye for an Eye"
	quest.2254C590DE6A8100.title: "Treaty of the Berserker"
	quest.22DBDBE68B6E1B4D.quest_desc: [
		"&6Weapon Enchanting&r"
		"&7Spell scrolls can be applied to weapons, allowing the player to cast the spell while wielding that weapon. Note: This will override spells from this mod or right-click abilities from other mods.&r"
		""
		"&6Robe Enchanting&r"
		"&7Players can also imbue robes added by this mod (such as the &cPlague Mage Robe&r&7, &cBlood Cultist Robe&r&7, etc.) with spells in a similar manner. While wearing an imbued robe, the player can cast the imbued spell. However, &eWandering Mage Robes&r&7 and &eSpooky Pumpkin Robes&r&7 cannot undergo this process.&r"
	]
	quest.2331CCFEF5A9EEE5.quest_desc: [
		"&6Treaty of the Solitary Druid&r"
		""
		"&7Unbound means disarmed.&r"
		"&7-After being injured, armor will hinder you, growing &cThorns&r to damage your soul&r"
		""
		"&7Wholeness means unbound.&r"
		"&7-Each empty armor slot grants five &eArmor&r&7 and two &eToughness&r"
		"&7-Each empty armor slot increases &aHealing&r&7 received by a quarter&r"
	]
	quest.2331CCFEF5A9EEE5.quest_subtitle: "Escaping External Things"
	quest.2331CCFEF5A9EEE5.title: "Treaty of the Solitary Druid"
	quest.233B0326CCA639C7.quest_desc: [
		"&6Duration Multiplier Rune&r"
		""
		"&7The Duration Multiplier Rune inhibits the form's process of breaking down substances, thereby extending the duration of &aPositive Effects&r&7 within the form.&r"
	]
	quest.233B0326CCA639C7.quest_subtitle: "Stagnating That Which Evolves"
	quest.2358AB144E490565.quest_subtitle: "Familiar Summoning Ritual"
	quest.23B6D00570354BE3.quest_desc: [
		"&6Boiler&r"
		""
		"&7An advanced power structure that generates stress by heating water to produce steam. It produces large amounts of stress and is a core power source widely used in the mid-to-late game.&r"
		"&7Stress Output: &c2048~294912 su&7"
		"&7RPM Range: &c16~64 RPM&7"
		""
		"&6Construction Method&r"
		"&7Place a &eSteam Engine&7 or &eSteam Whistle&7 on any-sized &eFluid Tank&7 structure, and the tank transforms into a Boiler.&r"
		""
		"&6Operating Conditions&r"
		"&7The boiler requires a continuous water input and a heat source placed beneath it to operate.&r"
		"&7Its efficiency is affected by **size**, **water level**, and **heat** attributes, each with 18 levels. Wear &eEngineer's Goggles&7 to observe the boiler and see specific attributes.&r"
		""
		"{@pagebreak}"
		"&7Attribute        Calculation Method&r"
		"&7📏 Size          Depends on boiler volume (m³). Size Level = Total Volume / 4&r"
		"&7💧 Water Level   Depends on water supply rate. One Powered Pump provides 1 mB/tick flow per 2 RPM. Water Level = Supply Rate (mB/tick) / 10, or Water Level = Pump RPM / 20&r"
		"&7🔥 Heat          Depends on total heat provided by all heat sources beneath it. See details below.&r"
		"&7The boiler does not store water; it calculates water level based on inflow rate. Water disappears upon entry. If the tank contained fluid before transformation, it is cleared.&r"
		"{@pagebreak}"
		"&6Heat Source Types&r"
		"&7Heat sources that can heat the boiler include:&r"
		"&7Heat Source Type         Heat Source                                   Provided Heat&r"
		"&7Passive Heat Source      Blaze Burner (off/empty), Campfire, Fire, Magma Block, Lava, Stove (Farmer's Delight), etc.         0&r"
		"&7Level 1 Heat Source      Blaze Burner (normal burning)                1&r"
		"&7Level 2 Heat Source      Blaze Burner (superheated burning)           2&r"
		"&7Passive heat sources only put the boiler into a &cPassive State&7, where it outputs a fixed &c2048 su&7. Adding more passive heat sources does not increase efficiency. When higher-level heat sources exist, passive ones are ineffective.&r"
		"&7The boiler is heated only by heat sources directly beneath its bottom.&r"
		""
		"{@pagebreak}"
		"&6Power Output&r"
		"&7The boiler's final level is determined by the **lowest** of the size, water level, and heat attributes.&r"
		"&7Install a &eSteam Engine&7 on the boiler and place a &eCogwheel&7 two blocks in front of the engine. Stress is output via the cogwheel.&r"
		""
		"&6Stress Calculation&r"
		"&7Except in passive state, boiler output stress is &cBoiler Level × 16384 su&7. Stress is evenly distributed among all Steam Engines.&r"
		"&7A single Steam Engine can output a maximum of &c16384 su&7. If total stress exceeds this, install multiple Steam Engines to avoid waste.&r"
		"&7Installing a number of engines equal to the boiler level outputs all stress; exceeding this number does not improve efficiency.&r"
		""
		"&6RPM Output&r"
		"&7The RPM output by Steam Engines is determined by the boiler's operating state and the ratio of engine count to boiler level, ranging from &c16 RPM ~ 64 RPM&7.&r"
		""
		"&8This page of the manuscript appears slightly curled, as if steamed.&r"
	]
	quest.2443B7C22B13BC1F.quest_desc: [
		"&7Inspired by the Obelisk of Hallowed Gold, you crafted an obelisk from what you thought were useless Experience Crystals. The magic of experience didn't affect soul-infusion rituals but instead showed an enhancement of another magical force—enchanting."
		""
		"&7Although it provides a large amount of &aQuanta&7, it is influenced by its original world. Its &aQuanta&7 cap is no different from an ordinary bookshelf."
		"{@pagebreak}"
		"&7And you might regret wasting such a precious thing later ("
	]
	quest.2443B7C22B13BC1F.quest_subtitle: "Ordinary Bookshelf (?)"
	quest.2443B7C22B13BC1F.title: "Powerful Yet Frail"
	quest.24525BF493E3277C.quest_desc: ["Can input items into it, or extract items from it. It is a superior alternative to Input Terminals and Output Methods."]
	quest.24525BF493E3277C.quest_subtitle: "Input or output items/fluids to/from the RS network."
	quest.2453187E1E29FF73.quest_desc: ["&7Using the light of Prismarine Shards, I amplified and twisted the power of the Ocean Bookshelf. Now it not only provides &5Arcana&7 but also a portion of &4Quantization&7. After all, uncertainty is part of mystery."]
	quest.2453187E1E29FF73.quest_subtitle: "A More Balanced Ocean Bookshelf"
	quest.2453187E1E29FF73.title: "Mystical Extension"
	quest.2482C01B41948195.quest_desc: ["&7A cheap and versatile material. Performs excellently whether used for weapons or armor. An outstanding transitional material. Its low cost allows for mass production, which can then be used to fill repair kits for on-the-go mending. With a bit of enchanting, it can handle most early-game enemies."]
	quest.2482C01B41948195.quest_subtitle: "King of Transitions"
	quest.24A6B77DD8DEA131.quest_desc: [
		"&7Scrolls, as single-use consumables, incur massive material loss, making their economy rather poor."
		""
		"Fortunately, after repeated attempts, I found a method to preserve the scroll's formula. While not as convenient as scrolls' ready-to-use nature, it significantly reduces the long-term cost of study and practice."
	]
	quest.24C387A38C376961.quest_subtitle: "You didn't farm deaths for this quest's reward, did you? Surely not... right?"
	quest.24F8461D0711F786.quest_desc: [
		"&6Anomalous Stamina Rune&r"
		""
		"&7The Anomalous Stamina Rune grants the wearer hysterical speed; they will always be able to sprint rapidly, even when &cHunger&r&7 is too low to normally sprint.&r"
	]
	quest.24F8461D0711F786.quest_subtitle: "Escaping That Which is Sought"
	quest.257E95B5ED03904D.quest_subtitle: "Better than a Hoe"
	quest.25C5815C5583AA74.quest_desc: [
		"&7Maintaining sanity in the Chaotic Wasteland is often difficult... or is it?&r"
		""
		"Your sanity &6slowly recovers over time&r. Generally, you won't face a sanity crisis unless you have to resort to some emergency snacks. Regardless, it's necessary to monitor your sanity changes. Low sanity leads to entering the Seven Sins Erosion state, while Emergency Sanity Solution can pull your sanity back to a safe level when it's low."
		""
		"&7&mHow can someone's sanity solution expire while sitting in storage? (Annoyed)&r&r"
		""
		"Sold by Cleric villagers, appearing in their trade options at levels 1, 3, and 5 respectively."
		""
		"{@pagebreak}"
		""
		"&aSanity Range: &#00FFAA-45&r&7 to &#00FFAA45&r"
		""
		"&7Sanity affects attack multiplier."
		"&7Attack multiplier fluctuates with sanity, ranging from &#FF55550.8x&r&7 to &#00AA001.2x&r&7."
		""
		"&#00FFAA[Despair]&r&7"
		"&7When your sanity falls below &#FF5555-45 points&r&7, taking sanity damage begins to accumulate &#FFAA00Despair Value&r&7."
		"&7When sanity recovers, it first offsets &#FFAA00Despair Value&r&7. Only after it's cleared will sanity increase."
		""
		"&#00FFAA[Despair Vulnerability]&r&7"
		"&7When taking damage, &#FFAA00Despair Value&r&7 provides additional vulnerability (up to &#FF55555x&r&7 vulnerability)."
		"&7After taking damage, &#FFAA00Despair Value&r&7 decreases by &#FF55555%&r."
		""
		"&#00FFAA[Despair Settlement]&r&7"
		"&7When you are knocked out, all &#FFAA00Despair Value&r&7 is cleared, and sanity is reset to zero."
		"&8\"The debt of despair is finally repaid. The frenzy subsides, the numbers reset. This is... the final peace."
	]
	quest.25C5815C5583AA74.quest_subtitle: "Stay Sane?"
	quest.25C5815C5583AA74.title: "Sanity Value"
	quest.25CE20F4B934CF78.quest_subtitle: "Stage 0"
	quest.26FC3272EF9F44E8.quest_desc: [
		"&6Crystallized Berry&r"
		"&7Excavated by &bSniffers&r&7. Can be fed to your familiar to obtain &eMemory Fragments&r&7.&r"
	]
	quest.27B6C00949F92CCF.quest_desc: [
		"&7I seem to have discovered something peculiar: a form of magic hitherto undocumented. To call oneself a magician while passing up the opportunity to learn magic would be a disservice."
		""
		"&7This mysterious school manipulates energy that seems rooted in &6souls&r&7. More precisely, the energy of the soul, the will and pulse that constitutes each of us."
		"{@pagebreak}"
		"&7So far, what I've described is only the basics. But I have discovered a method to separate the pulse of the soul and condense it into matter; I call these substances \"&6Spirit Crystals&r&7\". This is the foundation of my research."
		""
		"&7The nature of the condensed soul influences the crystal's properties. Each soul is unique, and the resulting crystals are also varied. I believe this crystal is the breakthrough in research."
	]
	quest.27B6C00949F92CCF.quest_subtitle: "Soul Magic"
	quest.27E19E564DC0F89F.quest_subtitle: "Familiar Summoning Ritual"
	quest.2808547613BD84C8.title: "Vinewraith"
	quest.287148E99E399EB1.quest_desc: ["Allows spawners to ignore light levels when spawning mobs."]
	quest.287148E99E399EB1.quest_subtitle: "Eternal Night Falls (on the Spawner)"
	quest.287148E99E399EB1.title: "Soul Lantern"
	quest.28A651F6B7D52DF2.quest_desc: [
		"&6Treaty of the Wicked Witch"
		"&7Feel &cAnger&r&7, also evoke &cAnger&r&7.&r&cEnemies can detect you from twice the distance"
		"&7A treaty specialized in fusing &cAnger&r&7 with &cPain&r&7.&r&aThe first strike against an enemy carries a &cWicked Arcane Bolt&r&a impact"
	]
	quest.28A651F6B7D52DF2.quest_subtitle: "Fight Without Ceasing"
	quest.28A651F6B7D52DF2.title: "Treaty of the Wicked Witch"
	quest.28DADF8AEF3ED946.quest_desc: [
		"&7The sky of the Nether is a frozen blood-red."
		""
		"&7I found these ruins on the charred bedrock. Armor lay scattered about, broken Netherite half-buried in ash, like a funeral unheld after a lost battle."
		""
		"&7I crouched, trying to dig out the nearest chestplate. Surely this armor could be salvaged for materials, but the moment my pickaxe struck metal, it moved."
		""
		"&7The armor propped itself up, dark red sparks erupting from its joints. It grabbed a nearby sword, turned, and swung at me. The movements were slow but heavy, the blade humming low as it cut through the air."
		""
		"&7I sidestepped, drew my weapon, and struck back. Luckily, it wasn't sturdy. After a few hits, it crumbled, unable to reform. A shame about the materials, though—scattered like that, no point in trying to salvage them."
		""
		"&7&mGuess I'd have to piece it together myself."
	]
	quest.28DADF8AEF3ED946.title: "Ancient Battlefield"
	quest.28F42F3025DEB18C.quest_desc: [
		"&6Chrystal Moth&r&7"
		"&7Flying neutral mob that only retaliates when attacked.&r"
		""
		"&7Group Aggro: After being attacked, all &#A351DAChrystal Moths&r&7 in the vicinity will target the attacker.&r"
		""
		"&7Before each attack, the Chrystal Moth needs time to charge:&r"
		""
		"&7It tries to keep its distance from the target by moving away and flying around the target left and right.&r"
		""
		"&7Then, it continuously fires &#F159BBSonic Waves&r&7 that track the target and ignore shield blocking. Each wave of sonic attacks can hit the same target up to 10 times (all can deal instant damage).&r"
		""
		"&7Although it looks similar to the Warden's Sonic Boom attack, the Chrystal Moth's sonic waves are physical damage (reduced by armor) rather than magic damage.&r"
		""
		"&7Players can tame a Chrystal Moth by holding any meat and right-clicking to feed it, with a certain probability of success.&r"
		""
		"&7Tamed Chrystal Moths only have one behavior mode: following the player (cannot be made to sit and stay).&r"
		""
		"&7Tamed Chrystal Moths will actively attack monsters that attack the player or are attacked by the player.&r"
		""
		"&7Hold &eLunar Moth Paste&r&7 and right-click a tamed Chrystal Moth:&r"
		""
		"&7The Chrystal Moth will consume it and has a low probability of producing 1 portion of &#F8CD4BQuivering Jelly&r&7.&r"
	]
	quest.28F42F3025DEB18C.title: "Chrystal Moth"
	quest.2911813B45667FF4.quest_desc: ["Using a symbol of the dragon's overbearing power, I crafted this bookshelf. Perhaps due to returning to simplicity, it only provides a massive amount of &aQuanta&r, and most importantly, can raise the &aQuanta&r cap to its maximum."]
	quest.2911813B45667FF4.quest_subtitle: "The Apex of Quanta"
	quest.2911813B45667FF4.title: "The Dragon's Roar"
	quest.291925E282FCB75C.quest_subtitle: "Most Likely a Ring"
	quest.292EE3446E29D4BA.quest_desc: [
		"&6Treaty of Wholeness"
		"&7Fullness requires health.&r&cNear starvation halves Armor and Toughness"
		"&7Wholeness means fullness.&r&aNear full satiation increases Armor and Toughness by one-fifth"
	]
	quest.292EE3446E29D4BA.quest_subtitle: "Pursuing Satisfaction"
	quest.292EE3446E29D4BA.title: "Treaty of Wholeness"
	quest.293A85724AE2C0E6.quest_desc: [
		"&eQuantum Stability:&r&7 Modifies the minimum final enchantment level affected by Quantization fluctuations, effectively negating the negative effects of Quantization while retaining its positive effects."
		""
		"&eThe Geode-Encased Stability Bookshelf&7 provides Quantum Stability."
	]
	quest.29833D624EE0F60A.quest_subtitle: "&cDisables natural sanity recovery (does not disable affix effects)."
	quest.29833D624EE0F60A.title: "&c\"Madness Seeps from the Corners of the Eyes\""
	quest.299FDA2700D417FA.quest_desc: [
		"&7The initial survival follows the most ancient laws. You punch tree trunks (?) to obtain basic wood, then use wood to mine harder stone. The wilderness roams with a considerable number of herbivorous creatures. They are clearly wild, yet only flee in panic when attacked, just like... resource points."
		""
		"&7Everything feels very 'real.' Wood is wood, stone is stone. It's just that resources here seem rougher, more primitive, requiring more sweat. The westward tilting sun urges you: don't linger, you must gather more. The night will definitely not be as peaceful as the day."
	]
	quest.299FDA2700D417FA.title: "Wilderness Pioneering"
	quest.2A0C75F0BB1001BC.quest_desc: [
		"&6Precision Mechanism&r"
		""
		"&7An advanced internal component requiring multiple precise processes to manufacture, commonly used in assembling complex machinery like the &eMechanical Arm&r.&r"
	]
	quest.2A8629B66F128293.quest_desc: ["&7Need I say more? It sounds good. Really good."]
	quest.2A8629B66F128293.quest_subtitle: "Built-in Entrance Sound Effect"
	quest.2AF2FF75BEEDF6FF.quest_desc: ["Increases the number of mobs spawned by a spawner in a single activation."]
	quest.2AF2FF75BEEDF6FF.quest_subtitle: "Minimum spend of 2000 here"
	quest.2B1C9E929C54873E.quest_desc: [
		"&7He withdrew a step, catching his breath, a few wounds on his body. I was the same, but neither of us was seriously hurt."
		""
		"&7\"&3Enough.&7\" His tone was calm, not displeased. He tossed me a pouch and handed me a bag of seeds."
		""
		"&7\"&3In the Starlight Forest live Starlight Birds. If you can, feed them for me.&7\""
		""
		"&7I took the cloth bag and the seeds, about to turn away. \"&3Actually, you can stay in the rift for a while after you enter.&7\""
		""
		"&7I stopped."
		""
		"&7\"&3In the mausoleum not far from here, something is about to awaken.&7\" His gaze was still fixed on the rift's edge, his voice steady as ever. \"&3You can stay in the rift for half a month, wait for the undead's agitation to subside, then continue. Though the Starlight Forest is lonely, it holds little threat.&7\""
		""
		"&7He paused, finally turning his eyes to me."
		""
		"&7\"&3Or—before it fully awakens, locate its soul fire and go straight into the mausoleum. If you can make some gains in the Starlight Dimension, defeating it won't be too hard.&7\""
		""
		"&7\"&3That being cannot be completely destroyed. But every time you defeat it, it must sleep for decades. While it sleeps, several sealed ore veins in the world will briefly reappear—not permanent, but a few years is enough for you to mine.&7\""
	]
	quest.2B1C9E929C54873E.title: "Open the Door"
	quest.2B4635BB16624A15.quest_desc: [
		"&7Using the natural magic of &6Runewood&r&7 as a base, I designed an altar for foundational spell research—the &5Spirit Altar&r&7. It is the other side of the equation, the application of Arcane Energy. By infusing &dSpirits&r&7 into items, then using this energy to influence other infusion processes, it's the starting point of research."
		"{@pagebreak}"
		"&7When using the altar, place the item to be infused upon it, along with a suitable &dSpirit&r&7. If other items are needed for the infusion, they must be placed on a &6Runewood Item Pedestal&r&7. Item Pedestals must be within four blocks of the altar to function properly."
		""
		"Place the item to be infused and all required spirits on the central altar; non-spirit materials go on item pedestals."
		""
		"{image:kubejs:textures/gui/malum_kjs1.png width:150 height:100 align:center fit:true}"
		"{@pagebreak}"
		"&7Once all Arcane Energy is in place, the energy within the &6Crystals&r&7 begins to flow into the central item. Other items to be fused are also drawn in during this process. Once all absorption is complete, the infusion product takes shape. However, this process is indeed &cquite slow&r&7..."
	]
	quest.2B4635BB16624A15.quest_subtitle: "Miraculous Creations"
	quest.2B4635BB16624A15.title: "Spirit Infusion"
	quest.2B8DFC4AE68FE112.quest_desc: [
		"&7I should now know what happens to living beings entering the well, at least the consequences for sentient beings."
		"&7"
		"&7I was too careless in my experiment and tripped over a reagent flask on the floor... falling directly into the dark substance within the well. That I can still write this clearly indicates &aSurvival&r&7... though I probably won't test this again."
		"&7"
		"{@pagebreak}"
		"&7I was expelled by what is now confirmed to be a liquid, just like the items I threw in. Later, I tested with monsters and calves; they &cdid not&r&7 bounce back, simply disappearing into the well, and I had no reason to waste more resources on further testing. Moreover, my attention is now entirely on what returned with me."
		"&7"
		"{@pagebreak}"
		"&7It's as if I shattered a soul; and my soul was the only one present at the time. This thought is a bit frightening, but all my body's functional data are still within acceptable limits. A &8Black&r&7 &dSpirit Crystal&r&7 returned with me, which I also collected. Could this be a harbinger of a ninth form of Arcane Energy? If so, what form of pulse does it represent? Further research is needed."
	]
	quest.2B8DFC4AE68FE112.quest_subtitle: "Mistake, or Blessing?"
	quest.2B8DFC4AE68FE112.title: "The Pitch-Black Crystal"
	quest.2BA0CB58302C7BD4.quest_desc: [
		"&6Treaty of Tidal Affinity"
		"&7The chains of the ocean tightly bind your heart.&r&cCannot receive healing when not in water"
		"&7Imprison yourself within the ocean, remembering the chanting call of the tides.&r&aWhile underwater, increases movement speed, attack speed, mining speed, damage resistance&r&aConduit Power enhances the above effects and allows passive health regeneration"
	]
	quest.2BA0CB58302C7BD4.quest_subtitle: "Becoming One with the Sea"
	quest.2BA0CB58302C7BD4.title: "Treaty of Tidal Affinity"
	quest.2C2C118EAFE0B1B7.quest_desc: [
		"&6Soul-Ash Bell&r"
		"&7Obtained via crafting, used to summon the boss &6Telos Echo · Primordial Fireborne&r&7.&r"
		"&7Hold and right-click to use. Upon use, it will produce sound and special particles, and attempt to summon the Fireborne.&r"
		"&7If a &cEmber-Soul Rune&r&7 is nearby, the Soul-Ash Bell will be consumed, and the Fireborne will be summoned. If no Ember-Soul Rune is nearby, it will not be consumed and will display the message ‘&cNo response received&r&7’.&r"
		"&7Each use, if not consumed, has a 3-second cooldown.&r"
		""
		"&8\"A resonance bell forged solely to recall the ‘ember’ stolen since the world’s first ignition; it resonates only with the lament of Ember-Soul Runes.\""
	]
	quest.2C2C118EAFE0B1B7.quest_subtitle: "Ding Ding Ding"
	quest.2C34F57D3538E222.quest_desc: [
		"This bookshelf is created by &bInfusing&r a Dormant Deep Dark Bookshelf, providing a decent amount of enchanting stats and a Quanta cap of 70."
		"{@pagebreak}"
		"&7What have I done?"
		"&7It seems I placed that crack-covered bookshelf onto the enchantment table. Then, entwined by the deep dark sculk, It began to grow and融合. Eventually, the cracks in this bookshelf were filled by It, and it became a new entity."
		"&7I feel Its greater power, and also that this bookshelf harbors no malice. Perhaps it's because it's my creation. Or maybe It needs something from me. In any case, I now possess a more powerful bookshelf."
	]
	quest.2C34F57D3538E222.quest_subtitle: "Embrace the Sculk"
	quest.2C34F57D3538E222.title: "Sculk Energy Activation"
	quest.2C5A0FE2059F81B1.quest_desc: ["&7Tools designed for familiars. Shrunken items/armor can be worn by familiars as accessories, while shrunken food can be fed to familiars to restore health. Please note that all food effects and buffs/debuffs will not take effect, so choose foods with high saturation."]
	quest.2C5C9488AA4912AD.quest_subtitle: "Used for casting wire"
	quest.2CA02120B210EB2D.quest_desc: [
		"&6Blaze Burner&r"
		""
		"&6Acquisition&r"
		"&7Right-click a &cBlaze&r&7 or &cBlaze Spawner&r&7 with an empty Blaze Burner to obtain.&r"
		""
		"&6Usage / How to Use&r"
		""
		"&6Burning States&r"
		"&7The Blaze Burner requires fuel to operate. Players can feed it by holding fuel and right-clicking.&r"
		"&7Feeding regular fuel puts it into a Normal Burning state, with burn time based on the fuel's vanilla &eFurnace&r&7 burn time. After normal burning ends, it enters an &cExtinguished&r&7 state.&r"
		"&7Feeding a &6Blaze Cake&r&7 puts it into a Superheated Burning state. The blaze inside turns blue. One Blaze Cake sustains superheated burning for &c160 seconds&r&7. After superheated burning ends, it enters a 250-second normal burning state, then extinguishes.&r"
		"&7Using a &6Creative Mode Blaze Cake&r&7 toggles between burning modes and permanently maintains the current state.&r"
		"&7Throwing an &eEgg&r&7 at it triggers a 4-second normal burn and a chewing sound effect.&r"
		"{@pagebreak}"
		"&7The default maximum burn time for a Blaze Burner is &c500 seconds&r&7.&r"
		"&7However, when a single item's burn time exceeds the 500-second limit and the burner is &cExtinguished&r&7, it adopts that item's burn limit instead of the 500-second maximum. E.g., a Block of Coal provides 800 seconds.&r"
		"&7If the burner is already burning, feeding it more regular fuel will not extend burn time beyond the 500-second limit. E.g., if it has 200 seconds left, feeding a Block of Coal results in 500 seconds total, not 800.&r"
		""
		"&7Blaze Burners can be fed by &eMechanical Arms&r&7 or &ePowered Arms&r&7. Both automatically detect the burner's state and stop feeding when fuel is sufficient.&r"
		"&7When fed by a Mechanical Arm with ample Blaze Cakes, it will not revert to normal burning; the arm detects the state and feeds before superheated burning ends. Feed with confidence.&r"
		"{@pagebreak}"
		"&6Heating Mixing Basins&r"
		"&7Blaze Burners can heat Mixing Basins to complete recipes requiring higher heat for ‘&cMixing&r&7’, ‘&cCompacting&r&7’, or ‘&cAuto-Brewing&r&7’.&r"
		"&7Some basin recipes require Normal Heating or Superheated Heating. Place the burner beneath the basin and provide fuel to achieve the required state. The burning state does not affect recipes needing lower heat levels.&r"
		""
		"&6Heating Boilers&r"
		"&7Blaze Burners can heat Boilers.&r"
		"&7Normal and Superheated burning provide &c1 point&r&7 and &c2 points&r&7 of heat respectively. See Boiler.&r"
		""
		"&6As Airflow Heating Medium for Blaze Burners&r"
		"&7Blaze Burners modify the air blast from a &eFan&r.&r"
		"&7When a fan's airflow passes over a Blaze Burner, it transforms into &aBulk Smoking/Bulk Blasting&r&7 airflow based on the burner's state.&r"
		"&7When &cExtinguished&r&7, airflow is in Bulk Smoking mode.&r"
		"&7When in Normal or Superheated burning, airflow is in Bulk Blasting mode.&r"
		""
		"&6Redstone Comparator&r"
		"&7Blaze Burners can be detected by a redstone comparator and produce a signal.&r"
		"&7When &cExtinguished&r&7, signal strength 0.&r"
		"&7In Normal Burning, max signal 2. When burn time < 5 seconds, strength 1; >5 seconds, strength 2.&r"
		"&7In Superheated Burning, signal strength 3.&r"
		"{@pagebreak}"
		"&6Driving Trains&r"
		"&7Blaze Burners can drive trains.&r"
		"&7To have a Blaze Burner drive a train, fix it in front of a Train Controls on the train structure during assembly. After assembly, right-click the burner with a configured Train Schedule. The blaze dons a hat and autonomously drives the train according to the schedule.&r"
		""
		"&6As Inventory Manager&r"
		"&7Blaze Burners can serve as Inventory Managers.&r"
		"&7When placed adjacent to an Inventory Transmitter, the burner acts as an Inventory Manager and can be right-clicked to interact.&r"
	]
	quest.2CE9BB7A7B825E19.quest_desc: [
		"&7This is a peculiar material enhancement device. It can utilize the power of Crimson Steel Blocks and starlight to enhance the stats of materials, making weapons hit harder and armor more durable. For specific enhancement methods and placement rules, please check"
		"[ { \"text\": \"[Here]\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0CFA26B3944AAF49\" } } ]"
	]
	quest.2CE9BB7A7B825E19.title: "Starlight Charging"
	quest.2D0DFDD4C050FFA3.quest_desc: [
		"This bookshelf, utilizing the power of the Ancient City entangled with sculk, provides a brand-new ability—obtaining treasure enchantments directly from the enchantment table."
		"However, opportunity and risk coexist. Those curse enchantments will also appear as treasure enchantments in the table. But I recall there's a device that can prevent curses from afflicting you."
	]
	quest.2D0DFDD4C050FFA3.quest_subtitle: "The Ancient City Re-emerges"
	quest.2D0DFDD4C050FFA3.title: "Gift from the Deep Dark"
	quest.2D740B904DAEAB78.quest_desc: [
		"&6Familiar Bed&r"
		"&7The Familiar Bed is a block that familiars can use to &asleep&r&7 and &arecover health&r&7. Familiars will search for nearby beds when they need healing.&r"
	]
	quest.2D740B904DAEAB78.quest_subtitle: "Warm Home"
	quest.2D7AB1B4FC01C3F8.quest_desc: [
		"&6Empathy Driver&r"
		""
		"&7Wicked and Sacred are opposing forces, why not combine both? When an &eCrucible&r&7 is equipped with an Empathy Driver, &8Wicked Spirits&r&7 remember the damage sustained by &eFocus Tokens&r&7. After the &eRepair Diffuser&r&7 performs repairs, &bSacred Spirits&r&7 'forgive' this damage, further repairing the Focus Token and boosting all attributes for the subsequent three &6Focus Cycles&r&7.&r"
	]
	quest.2D7AB1B4FC01C3F8.quest_subtitle: "Accepting Hatred"
	quest.2DD51904F4629516.quest_desc: [
		"Need to start from black..."
		""
		"Can be dyed after making bricks, but note that dyed bricks cannot be used to make controllers and other devices. They also need to be made into devices before dyeing."
		""
		"The bricks in this mod all have orientation. Pay attention if you want to build something aesthetically pleasing."
		""
		"Chapter &6Silent Gear&r unlocked."
		"[ { \"text\": \"[Click to jump]\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"09E68D57095A5F1D\" } } ]"
	]
	quest.2DD51904F4629516.quest_subtitle: "Forge Foundation"
	quest.2DE251239B528464.quest_desc: [
		"&6Creation of Arcane Clusters"
		"&7The faint glow emitted by &dSpirit Crystals&r&7 is strange and mystical; what would happen if this radiance were enhanced? &6Lantern Pliers&r&7 are well-suited for this task. Holding the pliers in one hand and a Spirit Crystal in the other creates an \"&eArcane Cluster&r&7\"."
		"&7"
		"&7These Arcane Clusters are condensations of pure Arcane Energy, with a small layer of protective magic to prevent overflow. They are nearly useless in magic, but are quite aesthetic as lamps."
	]
	quest.2DE251239B528464.quest_subtitle: "Decorative Crafting"
	quest.2E1DD9D5C7D1062D.quest_desc: [
		"&7Opening my eyes, I see a low, gray sky and a desolate, boundless wilderness. Cold wind sweeps sand and dust over exposed rocks and sparse, withered grass."
		""
		"&7After a brief moment of shock, I try to recall but find no useful information. I only remember falling asleep at the inn and waking up here. Fortunately, my travel pack wasn't lost, though for some reason, there's also a &6half-finished glass of apple cider&7."
		""
		"&7A blurry, angular humanoid figure materializes a few steps away, its outline as simple as a hasty sketch."
		""
		"&7\"&3Friend, you don't look so good. I think you'd best find some food before dark.&7\""
		""
		"&7As soon as the words are spoken, the figure dissipates like smoke."
	]
	quest.2E1DD9D5C7D1062D.title: "Chaotic Wasteland"
	quest.2E49C6ACDB5A84E2.quest_desc: [
		"&6Gloomstone Golem&r&7"
		"&7Placing a &#F5F5DCCarved Lunar Moth Cactus Fruit&r&7 on top of &#C0C0C0Gloomstone Bricks&r&7 &eSummons&r&7 a Gloomstone Golem.&r"
		""
		"&7Functionally similar to the &#808080Tuff Golem&r&7 mentioned in a past MC mob vote.&r"
		""
		"&7Hold any item and right-click the Gloomstone Golem, and it will &eHold and Display&r&7 that item in its hands.&r"
		""
		"&7While displaying an item, the Gloomstone Golem &cWill Not Move&r&7 but can still turn its body in other directions.&r"
		""
		"&7Items that have &#FF8C00Special Held Models&r&7 will also have corresponding rendering when held by the Gloomstone Golem.&r"
		""
		"&7&#FF4500Kill&r&7 / &#FFD700Right-click the item&r&7 held by the Gloomstone Golem to retrieve the item.&r"
	]
	quest.2E49C6ACDB5A84E2.quest_subtitle: "Item Display Stone Frame"
	quest.2E49C6ACDB5A84E2.title: "Gloomstone Golem"
	quest.2F38AC908EC156D9.quest_desc: [
		"&6Pact of the Scornful Destroyer&r"
		""
		"&7The Pact coexists with Malice's Shelter, and its power is also weakened by it.&r"
		"&7-Reduces &cMalice's Shelter&r&7 capacity&r"
		""
		"&7Corrosive patterns engraved into malice-summoning souls.&r"
		"&7-&6Malicious Critical&r&7 triggers &eChain Slashes&r on the target&r"
		"&7-&6Malice Conversion&r&7 increases the number and power of attached &eSlashing&r strikes&r"
	]
	quest.2F38AC908EC156D9.quest_subtitle: "Towering Over All Things"
	quest.2F38AC908EC156D9.title: "Pact of the Scornful Destroyer"
	quest.2F959196FB453034.quest_desc: [
		"These bookshelves are the highest tier of Sculk Bookshelves. While providing large amounts of &aQuanta&r, &4Quantization&r, and &5Arcana&r, they also grant additional &3Enchantment Clues"
		"&r. I suggest making several and welding them permanently next to your main enchanting table."
	]
	quest.2F959196FB453034.quest_subtitle: "Listen to the Bookshelf's Heartbeat"
	quest.2F959196FB453034.title: "Warden's Enhancement – Sculk Energy Peak"
	quest.2FE49A9C24350211.quest_subtitle: "Big Fork"
	quest.305A6FFD7FD5684F.title: "Mid-game - Defeat the Lord of the Dead"
	quest.309D32324902DF18.quest_subtitle: "Food Value > 8"
	quest.309D32324902DF18.title: "Main Meal Recycle x10"
	quest.31259F6B81819141.quest_subtitle: "Can inflict greater damage on enemies."
	quest.313E8F6035C2E842.quest_desc: [
		"&7Runewood trees are a peculiar combination of magic and nature, and are quite common. They are very &6aesthetic&r&7, but I value their &apracticality&r&7 more. Infused with &bMagic&r&7, they can serve as a &dArcane&r&7 base material."
		""
		"&7These trees primarily appear in wide &2Plains&r&7, with their presence also in &2Forests&r&7. Their most distinctive feature is their &6Leaves&r&7, which are a bright &6Orange-Yellow&r&7 color."
	]
	quest.313E8F6035C2E842.quest_subtitle: "Magical Materials"
	quest.314084A1E2474F20.quest_desc: [
		"&6Alchemical Cauldron&r"
		""
		"&7The Alchemical Cauldron has a light level of 3.&r"
		""
		"&6Primary Functions&r"
		"&7Brewing liquid forms of &bBottled Materials&r&7"
		"&7Crafting &bSpecific Materials&r&7"
		"&7Brewing &eVanilla Potions&r&7"
		"&7Reverting &eSpell Scrolls&r&7 back to ink&r"
		"&7Improving &eInk Quality&r&7"
		"&7Brewing mod-exclusive &6Potions&r&7"
		"{@pagebreak}"
		"&7Note: Lacks most vanilla cauldron properties (e.g., interacting with dripstone, filling from rain, washing dyed leather armor, etc.).&r"
		""
		"&6Interaction System&r"
		""
		"&6Storage Spaces&r"
		"&7The Alchemical Cauldron contains three storage spaces:&r"
		"&7&eWater Level&r&7: Four water levels, corresponding to different liquid heights in the cauldron.&r"
		"&7&eMaterial Slots&r&7: Four material slots for placing various ingredients.&r"
		"&7&ePotion Slots&r&7: Four potion slots for storing liquid products.&r"
		""
		"&6Capacity Details&r"
		"&7Each water level stores one bottle of water (250 mB); full water level stores one bucket (1 B).&r"
		"&7Each potion slot can store one bottle of &eInk&r&7, &ePotion&r&7, &6Elixir&r&7, or other special liquids.&r"
		"&7Each material slot can hold one ingredient; ingredients will float or sink in the cauldron.&r"
		""
		"&6Basic Operations&r"
		""
		"&6Placing Items&r"
		"&7Use a water bucket to raise the water level to four; each water bottle raises it by one level.&r"
		"&7Using a potion, elixir, or special liquid occupies one potion slot.&r"
		"{@pagebreak}"
		"&7Placeable materials include:&r"
		"&7Vanilla &eBrewing Ingredients&r&7"
		"&7&eInk Upgrading&r&7 materials (Copper Ingot, Iron Ingot, Gold Ingot, Amethyst Shard, etc.)&r"
		"&7Mod &6Elixir&r&7 materials (Dragon's Breath, Ender Pearl, Amethyst Cluster, Repentance Stone, etc.)&r"
		""
		"&6Collecting Items&r"
		"&7Bare-hand right-click: Take one item from a material slot.&r"
		"&7Empty bottle right-click: Collect from potion slots first; if potion slots are empty, collect a water bottle.&r"
		"&7Automation support: Can be input via hoppers; observers detect state changes; dispensers can automatically collect products.&r"
	]
	quest.31798154952775F5.quest_desc: [
		"&7Two days of work in the village. The forge fire never went out, and lights were on behind the elder's house late into the night. On the second night, he pushed open the mill door."
		""
		"&7\"&3You need to leave.&7\" He didn't enter, his voice somewhat low. \"&3The undead nearby aren't right lately. The village priest says something is about to wake. According to old rules, when that thing stirs, skeletons for miles around will rise.&7\""
		""
		"&7He paused."
		""
		"&7\"&3The village has survived this before. We know how. But with you here, I have to worry about you. The village is big, more eyes attract more undead. Once you're away, it'll be quieter, fewer will come.&7\""
		""
		"&7He pulled a few strips of dried meat from his bag and placed them on the wooden chest by the door. I looked down at the meat. He probably thought I was examining it, but I was actually thinking about that notebook. Leaving the village would make it easier to study what's inside."
		""
		"&7\"&rI'll leave tomorrow morning.&7\""
		""
		"&7The elder nodded and vanished into the night."
	]
	quest.31798154952775F5.title: "After a Brief Rest... Depart Again"
	quest.31B0A26B1374A322.quest_desc: [
		"&6Starfire Bird&r"
		"&7A small bird usually only encountered in Starlight Forests (excluding its variant, Starlight Dense Forest). Good at flying, very friendly and cute."
		"&7Comes in &#FF6B6BRed&r&7 and &#1E90FFBlue&r&7 appearance variants; the &#FF6B6BRed variant&r&7 is far more common than the blue one."
		""
		"&7You can find the &eStarfire Bird Nest&r co-generating on nearby Moonglow Trees."
		"&7Starfire Birds usually &aClaim&r&7 one of the nearby Starfire Bird Nests or &eStarfire Birdhouses&r&7 for resting and breeding."
		"&7If they are slow to claim, place some &8Seeds&r&7 inside the nest/birdhouse, or try to use the nest/birdhouse they initially claimed."
		"&7Each Starfire Bird Nest/Birdhouse can hold up to &b2&r&7 adult Starfire Birds and several baby Starfire Birds or Starfire Bird Eggs simultaneously."
		""
		"&7The player needs to hold &8Seeds&r&7 and actively right-click to &aFeed&r&7 two Starfire Birds."
		"&7After the breeding animation completes, one of the Starfire Birds will fly to its claimed Starfire Bird Nest/Birdhouse and lay an &eEgg&r."
		"&7If a Starfire Bird hasn't successfully claimed a Starfire Bird Nest/Birdhouse, it may &cFail to Breed&r."
		""
		"&7The egg takes some time to hatch into a baby Starfire Bird."
		"&7At this point, you can choose to hold Shift and right-click the nest/birdhouse with an empty hand to take the Starfire Bird Egg inside."
		"&7A taken Starfire Bird Egg can also be put back by holding Shift and right-clicking while holding the egg."
		"&7Note! If a nest/birdhouse is &cMined and Broken&r&7, the eggs inside will &cSpoil&r."
		""
		"{@pagebreak}"
		""
		"&7Baby Starfire Birds cannot fly and will not leave the nest/birdhouse until they are adults."
		"&7Baby Starfire Birds that haven't left the nest/birdhouse &cCannot Be Interacted with via Items&r&7 (e.g., feeding seeds to speed growth)."
		"&7If needed, break the nest/birdhouse, and the baby birds will automatically leave the nest/birdhouse and allow player interaction."
		""
		"&7Of course, using an axe with &bSilk Touch&r to break a nest/birdhouse will &aStore&r&7 all adult Starfire Birds, baby Starfire Birds, Starfire Bird Eggs, and seeds placed by the player inside that nest/birdhouse."
		"&7When the player places this nest/birdhouse again, they will also be restored intact inside the nest/birdhouse."
		""
		"&7Players can place any type of &8Seed&r&7 into a Starfire Bird Nest/Birdhouse (up to &b5 seeds&r simultaneously)."
		"&7When a Starfire Bird's claimed nest/birdhouse still contains seeds, the Starfire Bird will &aConsume&r&7 them and, upon leaving the nest/birdhouse, fly towards you and spit out &b1~2 types&r&7 of random items for you."
		""
		"&7The items Starfire Birds can gift to players are drawn from the loot table below."
		"&7Among them, &eStarfire (item)&r&7 is a &6Unique Product&r&7 of Starfire Birds."
		"&7This is a &6Very Important Resource&r&7, a core material for crafting some &6Tier 2 Equipment&r&7."
	]
	quest.31B0A26B1374A322.quest_subtitle: "Round and Chubby"
	quest.31B0A26B1374A322.title: "Starfire Bird"
	quest.31CD959C475E5714.quest_desc: ["The recommendations here are only for the current version and are not guaranteed to be comprehensive. They may change at any time as game content updates progress. For reference only."]
	quest.321B703A9E877386.quest_subtitle: "&eSome entries will be invalidated, but new extreme entries are added (WIP)."
	quest.321B703A9E877386.title: "&e\"Listen to the Blasphemous Whispers from the Abyss\" (WIP)"
	quest.3220FA89E7935BC3.quest_desc: [
		"&7Just an ordinary Nether Fortress."
		"&7The loot chests in the fortress have some new items worth scavenging. Other structures that yield Nether Fortress loot have similarly been enhanced, increasing their value."
		""
		"&7I've heard that Blazes in the fortress drop accessories called \"Sun Stones.\" If I could find the other half, the \"Moon Stone\"..."
	]
	quest.3220FA89E7935BC3.title: "Gloomy Fortress"
	quest.32590328D9FB113D.quest_desc: [
		"&7Accessories can be combined and upgraded like in Terraria. Some simple mobility accessories can speed up early exploration. A very small number of accessories are disabled due to being too overpowered (Flying Carpet: Why me?)"
		""
		"&7Defeating the Wither has a &6chance&7 to drop a Demon Heart. Using it increases your accessory slot count, but there's a limit to how many times it can be used."
	]
	quest.3280E06AA7147B28.quest_subtitle: "Can only be worn on the arm."
	quest.32EC8C6D17383BB2.quest_desc: ["&cQuantization (0%~100%):&r &7Fluctuates your final enchantment level, raising the upper limit while lowering the lower limit. Enchantment tables have a default of 15%."]
	quest.330C44884F7FF5A2.quest_desc: ["Acts as the terminal for the Forge. Items can be input via hoppers, etc., to achieve automation."]
	quest.330C44884F7FF5A2.quest_subtitle: "Smelt Metal"
	quest.330C44884F7FF5A2.title: "Smelting Controller"
	quest.332CE7AF2598E3F1.quest_subtitle: "&4Audience"
	quest.3368D9266C268467.quest_subtitle: "Familiar Summoning Ritual"
	quest.337B0F8208EA7383.quest_desc: [
		"&6Place Ink&r"
		"&7Ink quality determines scroll quality.&r"
		""
		"&6Place Paper&r"
		"&7Writing a scroll consumes one piece of paper.&r"
		""
		"&6Place School Material&r"
		"&7&eSchool Materials&r&7 determine the spell school.&r"
		"&7After placing an &eSchool Material&r&7, available spells for transcription will be displayed. Some spells may appear as question marks; try using higher-quality ink to transcribe them.&r"
		"&7The finished scroll will appear here. Note: Only left-clicking to take it will consume the raw materials.&r"
	]
	quest.337C34C06A879409.quest_desc: [
		"This upgraded Deep Dark Bookshelf channels power into Quantization, providing large amounts of &4Quantization&r without offering &5Arcana&r."
		"(Important Bookshelf)"
	]
	quest.337C34C06A879409.quest_subtitle: "Chaotic Power Surges"
	quest.337C34C06A879409.title: "Sculk Growth – Soul Trade"
	quest.338D68165E0EA626.quest_desc: [
		"&7The depths of the mausoleum were more spacious than I imagined."
		""
		"&7The hall was enclosed on three sides, with only a throne against the wall. The stone was rough, the carving crude—as if chiseled hastily and never repaired. The Lord of the Death sat there, withered bones draped in faded ritual robes, hands resting on the armrests, head bowed, those two red glows already lit."
		""
		"&7This changed nothing. Perhaps the power it had gathered hadn't fully awakened, or perhaps it was useless beyond commanding the undead. The minions it summoned couldn't withstand a single strike from me, only the nuisance of its sinister spells. Even its own body was as brittle as paper; a few blows severed its legs. Victory was certain."
		""
		"&7The Lord of the Dead crumbled into scattered bones. Maybe decades from now it would revive in another undead body, but that was none of my concern. The floor was littered with everything it had hoarded over its long existence. Scrolls tied neatly, some leather cords already rotted, spell components sorted into small pouches. It didn't forge, didn't study—just collected, hoarded, dragging treasures back to its lair."
		""
		"&7When it fell, the power sealed within seemed to dissipate... I need to investigate, see what traces remain.&7 But first, I need a good &zrest&7. After such a long journey and this battle, I can barely stand."
	]
	quest.338D68165E0EA626.title: "Defeat the Lord of the Dead"
	quest.339C3EB0CB099097.quest_desc: [
		"&7So far, every &6Amulet&r&7 I've created has found practical use. Naturally, side effects have followed, forcing me to spend much time selecting suitable amulets. However, certain effects from these amulets can definitely be isolated."
		"&7"
		"&7Thus begins &6Rune Artifice&r&7, specifically using &dBrooches&r&7 and &eRunes&r&7. The brooch serves only as a base core; its placement close to the heart symbolizes the inherent cost of pain in runic power."
		"&7"
		"{@pagebreak}"
		"&7Rune Artifice starts with inscribing &eRunes&r&7, an operation that requires a &bRune Workbench&r&7; one should be crafted first. The simplest entry brooch is the &dRune Brooch&r&7, which can be used to wear the runes I create."
	]
	quest.339C3EB0CB099097.quest_subtitle: "The Heart's Pin"
	quest.339C3EB0CB099097.title: "Rune Artifice"
	quest.3462310EEE3AC2DF.quest_desc: ["Attempts to input items from the container it's attached to."]
	quest.3462310EEE3AC2DF.quest_subtitle: "Input items or fluids into the RS network."
	quest.34AFC6414A805C2D.quest_desc: ["Recovery method: Eat Golden Apple, Enchanted Golden Apple, or GoodApple."]
	quest.34AFC6414A805C2D.quest_subtitle: "&cYou lose maximum health each time you die."
	quest.34AFC6414A805C2D.title: "&c\"Death is a Process of Casting Off the Self\""
	quest.34D5717A03B609A1.quest_desc: [
		"&6Spell Mastery Rune&r"
		""
		"&7The Spell Mastery Rune reflects and imitates Arcane Energy, allowing me to charge &eStaves&r&7 at twice the speed.&r"
	]
	quest.34D5717A03B609A1.quest_subtitle: "Creating That Which Destroys"
	quest.350A83A36269F87B.quest_desc: ["&7Finally, I created an experimental substrate called \"&6Alchemical Mineral Dust&r&7\". Its texture is close to solid animal fat under normal circumstances, but with a slight application of force, it reveals strong &aMalleability&r&7. This is undoubtedly a useful &6Material&r&7."]
	quest.350A83A36269F87B.quest_subtitle: "Clay Number Two"
	quest.3531099CA2E8832A.quest_desc: [
		"&6Bounty of the Tide Rune&r"
		""
		"&7The Bounty of the Tide Rune's ability is similar to the ritual of the same name, granting the wearer the &bBounty of the Tide&r&7 effect at half strength, providing a boost equivalent to an additional level of the &eLure Enchantment&r&7.&r"
	]
	quest.3531099CA2E8832A.quest_subtitle: "Blessing Pulse"
	quest.35560F1953AD1C76.quest_subtitle: "Familiar Summoning Ritual"
	quest.35957B7E0ACF4060.quest_desc: [
		"&6Super Glue&r"
		""
		"&6Purpose&r"
		"&7This sticky medium bonds multiple blocks into a single entity, allowing dynamic structure components to recognize and assemble them as a unified &eContraption&7.&r"
		""
		"&6Bonding Blocks&r"
		"&7Right-click a block to set the start point, then right-click a second block. All blocks within the rectangular space defined by the two points are bonded, generating a ‘Super Glue’ entity as a marker.&r"
		"&7There must be a continuous block connection between the two selected points; otherwise, the highlight turns yellow and bonding fails.&r"
		"&7While holding Super Glue and aiming at a block, press Ctrl to highlight all bonded blocks associated with it in blue.&r"
		"&7If Super Glue is held in the off-hand, blocks placed with the main hand automatically bond to the block right-clicked.&r"
		"&7When printing a blueprint containing Super Glue with a Schematicannon, ensure a chest has sufficient-durability Super Glue stored; the cannon automatically applies it.&r"
		""
		"&6Removing Bonds&r"
		"&7Hold Super Glue and left-click any block within a bonded rectangle to delete that glue frame and unbond all associated blocks.&r"
		""
		"&8The manuscript edge has a small dried glue stain. Scribbled beside it: Easy to stick together, not hard to take apart—just don't get it on your hands.&r"
	]
	quest.35957B7E0ACF4060.quest_subtitle: "Time to Apply Glue"
	quest.359B24E94B66AFA3.quest_subtitle: "Stage 3"
	quest.35AEBBC251933E78.quest_subtitle: "Stage 2"
	quest.35C26E629284AC1A.quest_desc: [
		"&7You'll need to hunt down hoglins everywhere... An excellent handle material with balanced bonuses and Bulwark as a bonus, but not that easy to obtain."
		""
		"&7The upgraded Blood-Infused Hoglin Leather has identical stats, only adding Crimson Spell Power. It won't be listed separately."
	]
	quest.35C26E629284AC1A.quest_subtitle: "Why does pig leather give spell power..."
	quest.35FFD854DFF94776.quest_desc: [
		"&7To overcome the limitation of wireless terminals losing connection over long distances..."
		""
		"Setting up Wireless Access Points to expand signal coverage, building a structure akin to a cell tower, might be a more feasible solution."
	]
	quest.35FFD854DFF94776.quest_subtitle: "WiFi"
	quest.360AE4AB3B482FAC.quest_desc: [
		"&nCrime and Reputation System&r"
		""
		"&6Core Mechanics"
		"&b1. &3Crime Levels&r"
		"Criminal acts are divided into three levels, affecting the player's relationship with villagers:"
		""
		"&aLight Crime&r：Slightly lowers reputation."
		""
		"&eMedium Crime&r：Significantly lowers reputation, &cIron Golems or Guards&r will attack the player."
		""
		"&cHeavy Crime&r：Reputation drops to minimum, &4Iron Golems will attack the player immediately&r."
		""
		"&b2. &3Trigger Conditions&r"
		"The player must commit the act within a &9Protected Structure&r (villages only by default)."
		"A villager or guard must &6witness&r the crime (detection distance is affected by player invisibility, sneaking, and light level)."
		"&4Villagers have limited 'intelligence'—even if the player placed a block, destroying it is still considered theft."
		"{@pagebreak}"
		""
		"&6Criminal Acts List"
		"&b1. &3Breaking Blocks&r"
		"&aLight Crime&r：Breaking crops, hay bales, lanterns, campfires, etc."
		"&eMedium Crime&r：Breaking chests, barrels, work site blocks (like cartography tables), beds."
		"&cHeavy Crime&r：Breaking bells."
		"&b2. &3Interacting with Blocks&r"
		"&eMedium Crime&r：Opening chests or barrels (considered attempted theft)."
		"&b3. &3Killing Creatures&r"
		"&eMedium Crime&r：Killing passive animals (pigs, cows, chickens, etc.) or villager pets (cats, horses, etc.)."
		"&b4. &3Bed-related&r"
		"&aLight Crime&r：Kicking a villager out of bed."
		"&eMedium Crime&r：Occupying a bed already claimed by a villager."
		"{@pagebreak}"
		""
		"&6Witnessing and Detection&r"
		"&bWitness Range&r"
		"Detection distance is affected by:"
		""
		"&7Sneaking&r reduces the chance of being seen."
		"&5Low light or Invisibility Potions&r can hide criminal acts."
		"&bWitness Reactions&r"
		"&cIron Golems and Guards&r will attack players who commit &eMedium&r or &cHeavy&r crimes (if witnessed)."
		"&aLight Crimes&r only lower reputation and do not provoke attacks."
		"&bOf course, you can also slaughter them where other villagers can't see."
	]
	quest.360AE4AB3B482FAC.quest_subtitle: "Reputation Value"
	quest.3611F55056F7105F.quest_desc: [
		"&#00AA00Gluttony - Erosion&r&7"
		"&7When carrying the 'Gluttony' effect, it is considered to apply &#00AA00Gluttony Nutrition&r&7 stacks.&r"
		"&#00FFAA[After consuming food]&r&7 Gain &#00AA00Gluttony Nutrition&r&7 stacks equal to the food's nutritional value.&r"
		"&#00FFAA[Every 1.5 seconds]&r&7 &#00AA00Gluttony Nutrition&r&7 stacks decrease by 1 (minimum -20 stacks).&r"
		"&7"
		"&#00FFAA[Gluttony Nutrition > 40]&r&7 Grants yourself &#FFAA00Gluttony&r&7 (level = (Gluttony Nutrition - 50) / 2, duration 2 seconds), &#FFAA00Regeneration I&r&7 (duration 2 seconds), and &#FFAA00Mana Gluttony V&r&7 (duration 4 seconds).&r"
		"&#00FFAA[Gluttony Nutrition > 30]&r&7 Grants yourself &#FFAA00Regeneration I&r&7 (duration 2 seconds) and &#FFAA00Gluttony IV&r&7 (duration 4 seconds).&r"
		"&#00FFAA[Gluttony Nutrition > 20]&r&7 Grants yourself &#FFAA00Regeneration I&r&7 (duration 2 seconds) and &#FFAA00Mana Gluttony III&r&7 (duration 4 seconds).&r"
		"&#00FFAA[Gluttony Nutrition > 10]&r&7 Grants yourself &#FFAA00Mana Gluttony II&r&7 (duration 2 seconds).&r"
		"&#00FFAA[Gluttony Nutrition > 0]&r&7 Grants yourself &#FFAA00Mana Gluttony I&r&7 (duration 2 seconds).&r"
		"&#00FFAA[Gluttony Nutrition > -10]&r&7 Grants yourself &#FF5555Weakness III&r&7 (duration 2 seconds).&r"
		"&#00FFAA[Gluttony Nutrition ≥ -20]&r&7 Grants yourself &#FF5555Weakness 255&r&7 (duration 2 seconds).&r"
		"&7"
		"&#00FFAA[When attacking]&r&7 If you have the &#FFAA00Gluttony&r&7 effect, increase the final damage of this attack by (1 + 0.5 × Gluttony level) times.&r"
		"&7"
		"&#00FFAA[After consuming food]&r&7 If you are in the 'Gluttony' state, that food receives a &#FF00005-minute cooldown&r&7.&r"
	]
	quest.3611F55056F7105F.title: "Gluttony Erosion"
	quest.364547BCDEFB8DDE.quest_desc: [
		"&6Portable Storage Interface&r"
		""
		"&7When a structure begins to rotate or slide, those golden interfaces fixed to the &eContraption&r&7 seem to awaken. Upon detecting another similar ‘face’ at the correct distance and orientation, it will pour forth all items from its own container, flowing along that invisible pact.&r"
		""
		"&6Making It Work&r"
		"&7This requires careful arrangement: the two interfaces must be &cfacing each other&r&7, spaced &cexactly 1 to 2 blocks&r&7 apart. Moreover, at least one must belong to a &eContraption&r&7—it is motion that gives this exchange meaning.&r"
		"{@pagebreak}"
		"&7Don't worry about occasional slight misalignment during docking; the transmission contract remains valid.&r"
		""
		"&6Finer Control&r"
		"&7Paired with an &eItem Detector&r&7 or &eThreshold Switch&r&7, you can know the contents of a moving container. A simple redstone signal can &alock&r&7 a block-form interface, making it ignore passing counterparts—though no outward change is visible.&r"
		"{@pagebreak}"
		"&7Finally, remember the principle of elegance: &cExcessive speed or rotation&r&7 makes this handshake hurried and prone to failure. If the receiver is stationary, be sure to equip it with a &eHopper&r&7 or &eChute&r&7; it needs a ‘hand’ to catch the flowing gift.&r"
		""
		"&8This part of the manuscript has a rough sketch of two docked interfaces, labeled: They hate bumps but love to dance.&r"
	]
	quest.364547BCDEFB8DDE.quest_subtitle: "An interface for exchanging items, allowing containers on contraptions to interact with the outside world."
	quest.36713AC6F99D301E.quest_desc: [
		"&7Sometimes, matter itself can be imbued with the &6Energy of Souls&r&7, even though the matter itself has no soul."
		""
		"&7This is precisely the basis of &6Spirit Magic&r&7—imbuing soul-less things with a soul. &6Soulstone&r&7 is a mineral whose arcane properties surpass its physical ones; refined, it has many uses in my research. It strongly radiates &dMagical Energy&r&7."
	]
	quest.36713AC6F99D301E.quest_subtitle: "Out of Phase"
	quest.369E5D74EA1CA624.quest_desc: ["&7Big belly, can it hold much...? Has enormous cargo space, allowing you to move with your belongings. But it falls slightly short compared to the Sophisticated Backpacks mod—probably not qualified for the job."]
	quest.36DC8D2564CAC70C.quest_desc: [
		"&7Deeprock Precious Gold is a peculiar and very useful metal. Its physical appearance is identical to &6Gold&r&7, but its properties are &cmarkedly different&r&7."
		""
		"&7This ore can be found in underground &8Deepslate layers&r&7, embedded within veins rich with &6Gold Ore&r&7."
	]
	quest.36DC8D2564CAC70C.quest_subtitle: "Infused with Arcana"
	quest.376EE9781C85F70E.quest_desc: [
		"&7The villagers survive in this remote place by more than just farming. The old blacksmith in the village showed me a skill that opened my eyes."
		""
		"&7I took out some old accessories found in the ruins, their magic patterns nearly buried under grime. \"&3These things,&7\" the blacksmith said, pinching a ring with rough fingers, squinting at it against the forge fire. \"&3Like people, their light gets buried with age. But we have a way to 'revive' them.&7\""
		""
		"&7The method he spoke of was called \"Reforging.\" It wasn't simply cleaning and repairing. It used a special resonance hammer with precise strikes to \"reawaken\" the dormant \"prefixes\" within the accessory. Done right, a dusty old item could shine with purer efficacy than when it was new. Of course, the old smith admitted, puffing his pipe: \"&3It's a craft, no guarantees. Too much force, you risk hidden damage; too little, nothing happens. But you can always fix it back, just costs more time and materials.&7\""
		"."
		""
		"&7I followed and learned for a few days, understood the tricks, but knew my limits as soon as I tried. The force and angle of the hammer strike—a slight difference, and the result was completely off. Looking at a few iron ingots now cracked from my unskilled hands, I shook my head. Time to go mining, dig up more iron to forge this damned \"Reforging Hammer.\""
	]
	quest.376EE9781C85F70E.title: "Skill Acquisition"
	quest.379D5523E1B96E7C.quest_desc: [
		"&7Public smelting recipes are either extremely low-cost, something everyone can figure out, or extremely practical, which creators are willing to share. Hardened Steel coincidentally combines both characteristics. Its smelting recipe is simple, requiring only the addition of some amethyst compared to regular steel, yet the performance improvement is substantial. After being made public, it was quickly applied in various scenarios."
		""
		"&7For a forger like me who hasn't mastered new alloys, Hardened Steel is undoubtedly the material of choice, quite suitable for forging weapons or armor. It's laughable that I wanted to enter the competition with Hardened Steel. Anyone who can swing a hammer can make Hardened Steel. Was I going to bet on other competitors making mistakes on the spot?"
		""
		"&7Better make some decent equipment first. Dwelling on such unrealistic thoughts, if I get ambushed by monsters, it won't be funny."
	]
	quest.379D5523E1B96E7C.title: "Fire Up the Furnace"
	quest.37AB4AF2D44BDEB1.quest_desc: [
		"&5I have discovered a... structure&r&7. Its implications run deeper than almost anything I've found before; its very existence is proof that others have already delved into arcane research."
		""
		"&7I call this well the \"&5Weeping Well&r&7\", because it constantly emits an aura of &5Sorrow&r&7, and within it lies a small pool of... &5Substance&r&7."
		""
		"&7I cannot quite determine what that substance is. While it doesn't look like a liquid, it certainly isn't solid in physical terms either."
		""
		"&7The Arcane Tome in my backpack even emitted an &6Eerie Glow&r&7, as if gaining a will, wanting to plunge into the well."
	]
	quest.37AB4AF2D44BDEB1.quest_subtitle: "&zThere's an urge to jump in"
	quest.37B8C9432DCC6DAD.quest_desc: ["&7By common sense, a place resembling the Nether must have combustible materials, and &cBlazing Quartz&r&7 is one such material. It's similar to &8Coal&r&7, and can even be used to make &eTorches&r&7. Although relatively &7Ordinary&r&7, its uses are not few."]
	quest.37B8C9432DCC6DAD.quest_subtitle: "Ignition"
	quest.3801B9633700F23D.quest_desc: [
		"&6Treaty of Fate Reweaving&r"
		""
		"&7The burning star makes you wither.&r"
		"&7-&cFate Reweaving&r&7 cooldown is extremely long&r"
		"&7-Cooldown halves &cArcane Resonance&r&r"
		"&7-Harvesting spirits consumes &cHunger&r"
		""
		"&7The unrestrained might brought by Death itself.&r"
		"&7-&6Fate Reweaving&r&7 can prevent death&r"
		"&7-&6Fate Reweaving&r&7 grants brief &aInvulnerability&r&7 and quickly triggers effects of &bHarvesting Spirits&r"
	]
	quest.3801B9633700F23D.quest_subtitle: "Deceiving Fate"
	quest.3801B9633700F23D.title: "Treaty of Fate Reweaving"
	quest.38092862F38315D2.quest_subtitle: "A utility tool for finding Ancient Cities"
	quest.3834AAC7BBB3BDAF.quest_desc: [
		"&6Vitality Rune&r"
		""
		"&7The Vitality Rune urges the form to heal itself, increasing &aAll Healing&r&7 received by the wearer by about one-fifth.&r"
	]
	quest.3834AAC7BBB3BDAF.quest_subtitle: "Pulse That Promotes Mending"
	quest.3847F6BA291E6556.quest_desc: [
		"Upgraded via &bInfusion&r, the Ocean Bookshelf has gained more powerful magic, providing higher &aQuanta&r and &5Arcana&r."
		"&l(Recommended Bookshelf)&r"
	]
	quest.3847F6BA291E6556.quest_subtitle: "Better Arcana and Quanta"
	quest.3847F6BA291E6556.title: "Mystical Mana Enhancement"
	quest.388B4D246EC83BC4.quest_desc: [
		"&6Treaty of the Lifeweaver"
		"&7All living beings deserve &aCare&r&7.&r&cHealing Aura treats all equally, friend or foe"
		"&7Such &aGenerosity&r&7 is rarely seen: you share your flesh and will with others.&r&aPassive health regeneration&r&aHealing is shared with nearby creatures"
	]
	quest.388B4D246EC83BC4.quest_subtitle: "Bestowing Upon All Things"
	quest.388B4D246EC83BC4.title: "Treaty of the Lifeweaver"
	quest.3890E1D60D9F389F.quest_desc: [
		"&6Defense Rune&r"
		""
		"&7The Defense Rune urges the form to stand firm, increasing the wearer's &aArmor&r&7 by about one-fifth.&r"
	]
	quest.3890E1D60D9F389F.quest_subtitle: "Pulse That Promotes Holding Firm"
	quest.39980DF0631D9B6C.quest_desc: [
		"&6Treaty of the Rotten Ascetic&r"
		""
		"&7Your loyalty to decay ravages your form.&r"
		"&7-&cSaturation and Hunger&r&7 cannot restore health&r"
		"&7-The Mandate only permits consuming &8Rotten Food&r&7; consuming food it forbids causes &cDamage&r"
		""
		"&7Decay becomes your best friend.&r"
		"&7-&6Gluttony&r&7 becomes &6Test of Faith&r"
		"&7-&6Test of Faith&r&7 increases &aHealing&r&7 received and spawns &bLocusts&r when healed&r"
		"&7-&6Test of Faith&r&7 duration is significantly longer&r"
		"&7-Consuming &8Rotten Food&r&7 restores health&r"
	]
	quest.39980DF0631D9B6C.quest_subtitle: "Seeking Beauty in Dross"
	quest.39980DF0631D9B6C.title: "Treaty of the Rotten Ascetic"
	quest.39AB32E04D04B64F.quest_subtitle: "Stage 1"
	quest.39F72CD10646574F.quest_desc: ["Searching for a specific enchantment among hundreds is like finding a needle in a haystack. Enchantment books limited to specific types significantly improve this—these books have affinity only for enchantments of a particular category, making them an excellent way to obtain target enchantments."]
	quest.39F72CD10646574F.quest_subtitle: "Practical Enchantments"
	quest.3A08D5D6D65FF6F2.quest_desc: [
		"&7The tomb contains multiple branches and numerous undead mob spawners. A few rooms contain &4traps&7, so check carefully before opening chests."
		""
		"&7The Lord of the Dead slumbers on the throne in the central hall. The hall also contains spawners that continuously generate zombies. Prepare well before starting the fight. Right-click the sleeping Lord of the Dead to awaken him."
		""
		"&mWait, why didn't I just sneak attack?"
	]
	quest.3A08D5D6D65FF6F2.quest_subtitle: "Pry It Open"
	quest.3A08D5D6D65FF6F2.title: "The Catacombs"
	quest.3A5AE9FCABEA41E0.quest_desc: [
		"&7I thought I would soon forget the Necromancer King's curse: happiness will depart from me."
		""
		"&7But when I returned to the village, hoping for a peaceful life, the Chaotic Wasteland began to reveal its true nature—torrential rains one moment, prolonged drought the next. And those ceaseless \"trials\" clung to me like persistent evil spirits, never truly leaving."
		""
		"&7The village was well-prepared for all this, with ample reserves and tight security. Each disaster failed to cause major damage, but everyone's spirit was exhausted. I could see the confusion and numbness in the villagers' eyes—born on this land, what choice did they have but to endure?"
		""
		"&7I could fend off goblin invasions, slaughter the reanimated undead, and wipe out the insolent piglins. But how could I withstand drought and hail? How could I contend with this entire Chaotic Wasteland?"
		""
		"&7No. I believe human effort is not limited to this. Ultimately, all of this is simply because my &zpower&7 is insufficient."
		""
		"&7I must embark on the journey once again."
	]
	quest.3A5D807E30DF3E8C.quest_desc: [
		"&7No matter your profession or goal, &cRedstone&r&7 is an essential aid."
		"&7Building &cPiston Doors&r&7 is not exclusive to engineers. Now I too have contributed to redstone's development: the &5Spirit Diode&r&7."
		"&7By etching the pulse of &eElemental Spirits&r&7 into a &bSpiritfire-treated&r&7 &6Copper substrate&r&7, four interesting &cRedstone Devices&r&7 can be created."
		""
		"&7These diodes convert redstone signals into &dArcane Inclinations&r&7, letting the &eSpirit&r&7 shape the outcome according to its nature, then convert it back to a redstone signal."
		"&7&bSpiritfire&r&7 is the transmission medium, and &6Copper&r&7 is the conceptual anchor for &7Machinery&r&7 and &7Logic&r&7."
		"{@pagebreak}"
		"&6Signal Delay Buffer"
		"&7The Azure Water Spirit seeks change, seeks adaptation."
		"&7If a signal is input, the buffer passes it through, but with a \"&bSticky&r&7\" effect: it continues to output for a while after the input is removed."
		""
		"{@pagebreak}"
		"&6Signal Interrupter"
		"&7The Infernal Fire Spirit seeks to burn, to shine."
		"&7If a signal is input, the interrupter passes it through, but with a \"&cSlow&r&7\" effect: the diode holds the signal, \"contemplates\" it, then releases it after a delay."
		""
		"{@pagebreak}"
		"&6Signal Charge Sustainer"
		"&7The Azure Sky Spirit seeks to soar, to ascend."
		"&7If a signal is input, the sustainer passes it through, but needs to \"&eWarm Up&r&7\" first: the output signal strength slowly increases to match the input."
		"&7If the input is removed or a weaker signal is input, the sustainer gradually decreases its output signal in a similar manner."
		""
		"{@pagebreak}"
		"&6Signal Generator"
		"&7The Earthen Spirit seeks steadfastness, stability."
		"&7Regardless of input, the generator acts like a clock pulse generator, occasionally inverting the input signal at a steady rhythm, while passing it through directly at other times."
	]
	quest.3A5D807E30DF3E8C.quest_subtitle: "Signal Modulation"
	quest.3A5D807E30DF3E8C.title: "Signal Artificing"
	quest.3A5DD56949CF4827.quest_desc: [
		""
		"{image:kubejs:textures/gui/key_reload.png width:150 height:40 align:center}"
		""
		"{@pagebreak}"
		"Of course, due to some mod reasons, please manually set the <Key Combo> keybind group to the B key."
	]
	quest.3A5DD56949CF4827.quest_subtitle: "The modpack's default keybinds are already configured. You just need to find the Key Bindings menu and click (Reset All Keys)."
	quest.3B0E439056FB5B0B.quest_desc: ["&7Backpacks can be equipped with various upgrades. The number of upgrade slots is directly related to the backpack's tier. Diamond backpacks have five upgrade slots, while Netherite backpacks have seven. So, upgrading your backpack tier is necessary to install more upgrades."]
	quest.3B7226A9387FD816.quest_subtitle: "Cursed Flower"
	quest.3C4F9B874C336EB6.quest_desc: [
		"# &cBUG Reporting Channels &r"
		""
		"### &eReporting Methods &r"
		"&6➤ &fOfficial group chat feedback"
		"&6➤ &fGitHub Issue submission"
		""
		"&6Codfish will try to handle them as soon as possible if seen!!!"
		""
		"### &9Official Links &r"
		"&6▪ &bGitHub Issues: "
		"&fhttps://github.com/DrowningFish233/Reverie-Foundry/issues"
		"&6▪ &bMC百科 Page: "
		"&fhttps://www.mcmod.cn/modpack/907.html"
		""
		"### &3Notes &r"
		"&7- When reporting, please try to provide:"
		"  &8• &fDetailed reproduction steps"
		"  &8• &fRelevant screenshots/logs"
		"  &8• &fModpack version information "
	]
	quest.3C4F9B874C336EB6.quest_subtitle: "Report!"
	quest.3CCFC8763640AC83.quest_desc: [
		"&6Mechanical Arm&r"
		""
		"&6Moving Items&r"
		"&7The Mechanical Arm is the most flexible logistics method within Create, capable of moving items between any two points within its working range.&r"
		"&7It requires a gear-driven power source; faster RPM means faster operation. Its working range is roughly a sphere with a radius of &c5&r&7 blocks (3D space).&r"
		"&7It can move up to one stack of items per cycle.&r"
		""
		"&6Placement&r"
		"&7Using a Mechanical Arm requires setting input and output targets. It picks up from inputs (blue) and places at outputs (yellow). Method:&r"
		"&7Hold the arm, right-click a position to set as input (first click) or output (second click). Multiple inputs/outputs can be set. After setting, place the arm. Targets outside its range are automatically removed. Left-click during setup to cancel.&r"
		"&7Note: The arm can only target ‘&eOpen Storage Spaces&r&7’, like conveyor belts, depots, chutes, etc. Vanilla containers like hoppers and chests cannot be targeted.&r"
		"{@pagebreak}"
		"&7All valid targets include (red marks can only be outputs):&r"
		"&7Conveyor Belt, Chute (Smart Chute), Depot, Ejector, Mixing Basin, Mechanical Crafter, Millstone, Deployer, Powered Saw (when powered), Jukebox, Train Station, Packager, Unpacker, Blaze Burner (empty), Millstone Controller, Composter, Respawn Anchor, Input-mode Create Funnel, Campfire (Soul Campfire).&r"
		"&7When placed on the bottom of a block, the arm is inverted.&r"
		""
		"&6Distribution Method&r"
		"&7If the arm has multiple outputs, you can set distribution method among them. Long right-click the side panel of the arm's base to configure.&r"
	]
	quest.3CDB29B0059175A8.quest_desc: [
		"&6Familiar Soul&r"
		"&7The core material for manifesting a familiar into the world. This item is obtained by capturing &8Lost Souls&r&7 with an empty bottle on the &6Origin Isle&r&7. Bottled souls can be released back into the wild.&r"
	]
	quest.3CDB29B0059175A8.quest_subtitle: "Lost Souls"
	quest.3D29D3316A8362E6.quest_desc: ["&7Generally used for pulverizing. You need a hammer to do this. Place the material you want to pulverize on a Stone Anvil, then strike it with a hammer to produce powder. These powders generally have special uses—you'll know when you need them."]
	quest.3D29D3316A8362E6.quest_subtitle: "Primitive Crafting"
	quest.3D3CC5601B817E4D.quest_desc: [
		"&7I walked across the wasteland for a long time until I saw a rift that shouldn't exist—air torn and poorly stitched like an old scar, edges shimmering faintly white."
		""
		"&7Someone sat beside the rift."
		""
		"&7He wore a faded blue robe, held no weapon, just quietly watched the tear. As I approached, he turned his head. His face was ordinary, like a passerby in a village market."
		""
		"&7\"&3You want to go in.&7\" He stated, not asked. \"&3Or rather, &zyou will go in&3.&7\""
		""
		"&7I didn't answer."
		""
		"&7\"&3Only the brave and just are permitted to enter.&7\" His tone was flat, as if stating a rule he had no power to change."
		""
		"&7Then he raised his hand and drew his sword."
	]
	quest.3D3CC5601B817E4D.title: "Shattered Gate"
	quest.3D485A80778437EF.quest_desc: [
		"&aQuanta (0~100):&r&7 Determines the maximum enchantment level the enchantment table can achieve. Max Enchantment Level = Quanta Level."
		""
		"&7The vanilla Quanta cap is 30, so the Quanta cap achievable with vanilla bookshelves is also 30. For higher-level enchantments, you need the power of Apotheosis bookshelves..."
		""
		"&7The higher the Quanta, the better the enchantment results, potentially far exceeding the vanilla enchantment level limit."
	]
	quest.3D65B82D6967E302.quest_desc: [
		"&7Disk Drives can be used as storage blocks, but they require a disk to be inserted as the storage medium."
		""
		"If no disk is inserted, it cannot be used as storage space. Think of it as a computer's USB drive."
		""
		"{@pagebreak}"
		""
		"&7The Disk Interface is a tool for reading or writing items stored on a disk."
		""
		"Configure import/export via the device UI, set blacklists, whitelists, etc.... to export/import various items and store them."
	]
	quest.3D65B82D6967E302.quest_subtitle: "Plug and Play"
	quest.3D65B82D6967E302.title: "Disk Storage"
	quest.3D71CE179BBC6433.quest_desc: [
		"&6Tower Squid Sac&r&7"
		"&7A material dropped after killing the &#1E90FFTower Squid&r&7 (mob).&r"
		""
		"&7Cannot replace &8Vanilla Ink Sacs&r&7 in other crafting recipes.&r"
	]
	quest.3D854DF7007E1CB8.quest_desc: [
		"&eThe loot reward level increases with the number of times the BOSS is defeated."
		""
		"&7Due to some craftsmen's lack of skill, there are sometimes wasteful acts—forcing materials unsuitable for a component onto it."
		""
		"This causes a loss of material properties. Fortunately, it's not entirely unusable; replacing it restores the proper attributes."
	]
	quest.3D854DF7007E1CB8.quest_subtitle: "Legacy Equipment"
	quest.3DEBEF47CB42C180.quest_desc: [
		"As the heat value of the fuel used increases, the temperature achievable during smelting also rises accordingly."
		""
		"&eOn the left are the types of fuel that can be used.&r"
	]
	quest.3DEBEF47CB42C180.quest_subtitle: "Energy Consumption and Heating"
	quest.3F4F2D1D8EC995BA.quest_desc: [
		"Redstone Comparators allow spawners to be controlled by redstone."
		"With this modification installed, the spawner will only work when receiving a redstone signal. This provides a more direct control method for automated monster farms."
	]
	quest.3F4F2D1D8EC995BA.quest_subtitle: "Redstone Spawner"
	quest.3F65163CBB21A321.quest_desc: [
		"&7Should I avoid its edge?"
		""
		"Learned from the gatekeeper that the Lord of the Dead is up to something. Hiding is not an option. The only good Lord of the Dead is one that drops loot."
		""
		"&7Before challenging the Lord of the Dead, you can try defeating other bosses in this stage to get materials and further strengthen your gear. Specific boss stages can be viewed in the Bounty chapter."
	]
	quest.3F65163CBB21A321.title: "Prepare for Battle"
	quest.3F95B455EACD5B91.quest_desc: ["&7Still straightforward, still all about stats. An excellent plating material. The downside is its high cost and difficulty to obtain early on. Other than that, it's all advantages."]
	quest.3F95B455EACD5B91.quest_subtitle: "Unpretentious Stats"
	quest.3FA1E5E68F50BA85.quest_desc: [
		"&7This device can monitor a specific item in the storage network in real time. To select the item you want to monitor, sneak + right-click with an empty hand to open the panel and adjust."
		""
		"Left-click an item icon with an empty hand to directly retrieve the item; right-click to deposit items."
	]
	quest.3FA1E5E68F50BA85.quest_subtitle: "Real-Time Monitoring"
	quest.3FD324391F9D0115.quest_desc: ["This summoning ritual can only be performed within the Golem Forge."]
	quest.3FD324391F9D0115.quest_subtitle: "Starlight Golem"
	quest.3FD324391F9D0115.title: "Summoning Ritual"
	quest.3FD3535AE922834F.quest_desc: [
		"&7The number of BOSSes defeated will increase the player's (personal) Tier level."
		""
		"Consuming a \"&bGood Apple&r\" or killing the final BOSS can lower the Tier by 1 level."
		""
		"&bTier affects:"
		"&7The rarity of Silent Gear items obtained from Equipment Pouches."
		""
		"&7The champion spawn rate of monsters and the probability of high-tier champions appearing."
	]
	quest.3FD3535AE922834F.quest_subtitle: "&zYou believe you are ready to face challenges, and most importantly, you feel Lady Luck is smiling upon you. It's time to start your own adventure!"
	quest.3FD839536F2A224B.quest_desc: [
		"&ePure energy condensed from starlight."
		"&6Burns at an astonishing rate, capable of processing your needed materials extremely quickly."
		""
		"⚡ Speed: 1.5x | ♨ Temperature: 3000 | ⏳ Consumption: 0.4"
		""
		"&aTip&r&7: &f♨ &r&7Temperature determines the grade of materials that can be processed, ⚡ Speed affects processing time, ⏳ Consumption represents fuel longevity."
	]
	quest.3FD839536F2A224B.quest_subtitle: "Rapid Combustion"
	quest.3FFA3C2B5E1FC24A.quest_desc: [
		"&6Cursed Garden&r"
		"&7Is a large surface structure guarded by the &cMoonvine Colossus&r&7."
		""
		"&7The entire Cursed Garden is a &8Large Maze&r constructed from various high walls."
		"&7All four outer walls have a &8Narrow Entrance&r&7, and the central endpoint is a very flat and &aSpacious Area&r&7."
		""
		"&7All &6Loot Chests&r&7 are distributed within the maze passages. Both the maze passages and the endpoint spawn many &#8FBC8FVinewraiths&r&7 as guards."
		"&7You can use the &eSeeker's Eye&r&7 to locate this structure."
	]
	quest.3FFA3C2B5E1FC24A.quest_subtitle: "Once a lush and vibrant garden, now eroded by a curse."
	quest.3FFA3C2B5E1FC24A.title: "Cursed Garden"
	quest.4015BC05F1AAD9EB.quest_subtitle: "Used for casting rods"
	quest.4073FA79B270F976.quest_desc: [
		"&7An excellent survival-oriented material. Crafting armor directly from it yields low defense, but it can be used as plating or alloy material."
		""
		"&7The Soul Catalyst modifier provides a large number of soul shield-related bonuses, while also increasing scythe proficiency."
		""
		"&7The soul shield is an independent damage reduction mechanic. Without any bonuses, it provides very high reduction against magic damage and moderate reduction against physical damage. Scythe proficiency directly increases the attack multiplier of scythe weapons."
		""
		"&7The Soul Shatter modifier allows non-scythe kills to also produce essence, so you can still collect essence for Wraith even without using a scythe."
	]
	quest.4073FA79B270F976.quest_subtitle: "Armor Up, Move"
	quest.409F4DBFD0F05A3B.quest_desc: [
		"&7Night deepened, the village fell silent, broken only by the occasional footsteps of the night watch and distant dog barks. Frustrated with reforging, I couldn't sleep, still pondering how to hammer out better prefixes."
		""
		"&7Just then, a faint &dglow&7 flashed outside the window—not the warm yellow of a lantern, but a fleeting, pinkish spark."
		""
		"&7\"Don't wander at night...\" The elder's warning immediately came to mind, but curiosity and a strange pull overpowered caution. I gently pushed open the door and slipped into the shadows."
		""
		"&7The light flickered again around a corner. I followed quietly, glimpsing a short, stout figure in a green coat crouching furtively behind the mill, clutching an ornate glass jar that pulsed with shifting pink light."
		""
		"&7A villager. He looked around cautiously, didn't seem to see me. Just as he was about to leave, I accidentally stepped on a twig—*crack*."
		""
		"&7He froze, spun around, revealing a face I'd seen near the blacksmith during the day. Fear flashed in his eyes. He instinctively hugged the jar and ran."
		""
		"{@pagebreak}"
		""
		"&7I didn't shout. In a flash, I was after him. Cumbered by the jar, he was slow. I soon cornered him by a woodpile."
		""
		"&7\"&3...Don't tell the elder.&7\" He panted, sweating, but gradually calmed down. \"&3You don't know what these are... right? We can make a deal.&7\""
		""
		"&7I stared at him in silence."
		""
		"&7\"&3The elder and everyone say this is taboo, the root of disaster... but I think power itself isn't right or wrong. It's the user that matters.&7\""
		""
		"&7He saw no pure hostility in my eyes. After a brief hesitation, he pulled a worn &zthick notebook&7 from his pocket and shoved it towards me."
		""
		"&7\"&3This is... some research notes by me and some former colleagues. Take it, read it away from the village, don't study it here. In exchange, you never saw me tonight, and I never saw you. Deal?&7\""
		""
		"&7I took the notebook. It was heavy. I looked at the glowing glass jar in his arms, then at his grim, regretful face. Slowly, I nodded."
	]
	quest.409F4DBFD0F05A3B.title: "Soul Research"
	quest.40C75417213642DC.quest_subtitle: "Stage 0"
	quest.41555B67D70627EB.quest_subtitle: "Who can kill me!"
	quest.417E7341644D16C8.quest_desc: [
		"&6Treaty of Runic Depletion"
		"&7Your soul has its carrying limit.&r&cEach equipped rune reduces healing received, armor, toughness, magic resistance by one-twentieth"
		"&7A part of your soul becomes rune sockets.&r&aGrants two rune slots"
	]
	quest.417E7341644D16C8.quest_subtitle: "Abiding by Ancient Pacts"
	quest.417E7341644D16C8.title: "Treaty of Runic Depletion"
	quest.41968B5035595DD8.quest_desc: [
		"&7In Apotheosis, Silk Touch has been enhanced. When mining a spawner with a pickaxe-type tool enchanted with Silk Touch, it consumes 150 durability and drops the spawner item. This mechanic allows players to easily collect spawners and place them in suitable locations for use."
		""
		"&7Additionally, Apotheosis allows players to adjust various attributes of spawners using different materials, enabling a single spawner to reach a higher potential."
		""
		"Hold Ctrl to view specific spawner information."
	]
	quest.41968B5035595DD8.quest_subtitle: "Silk Touch Greatly Enhanced"
	quest.41968B5035595DD8.title: "How to Obtain Spawners"
	quest.41A6E2C475A1E6F5.quest_desc: ["&7Biplane Pro version. Larger than the original biplane, but gains the ability to land on water. This reduces crash risk during takeoff and landing over large water bodies—after all, there are plenty of natural lakes, but natural runways are basically non-existent."]
	quest.41E17B4557322ADD.quest_desc: [
		"Increases damage based on player speed."
		""
		"Right-click to perform a thrust. Damage is based on weapon stats and speed bonus (Attack determines damage, Attack Speed determines cooldown)."
	]
	quest.41E17B4557322ADD.quest_subtitle: "Long, Stabby, Stick"
	quest.4213B825EDC1B32D.quest_desc: [
		"&6Rune Brooch&r"
		""
		"&7The Rune Brooch is the simplest and plainest brooch. It symbolizes power at an added cost, or bloodied hands holding thorny enlightenment. When worn, it removes one empty slot meant for &cRing&r&7 power from my hands and grants me the &aAbility&r&7 to inscribe one rune on each palm.&r"
		"{@pagebreak}"
		"&6Glass Brooch&r"
		""
		"&7The Rune Brooch works well, but the symbolic vessel for power isn't limited to hands. Through the Glass Brooch, I can direct it to my blood, at the cost of depriving part of my &cVitality&r&7, gaining the &aAbility&r&7 to inscribe two runes on my chest.&r"
		"{@pagebreak}"
		"&6Ornate Brooch&r"
		""
		"&7Brooches symbolize sacrifice. But in terms of others' perception, this sacrifice might seem abstract, ambiguous, even absurdly comical. The form of a necklace isn't too different from a belt; by stripping away concepts of fashion and propriety, I can wear a belt's &aPower&r&7 around my neck.&r"
		"{@pagebreak}"
		"&6Gluttonous Brooch&r"
		""
		"&7Sacrifice isn't limited to the physical; spiritual sacrifice is also sacrifice. The Gluttonous Brooch deprives &cSatiety&r&7, causing me to constantly crave food even after eating sufficiently. In exchange, my shriveled abdomen gains a &abelt&r&7 slot.&r"
	]
	quest.4213B825EDC1B32D.quest_subtitle: "The Price"
	quest.4276FE7E4037AC05.quest_desc: [
		"&7A relatively common structure in the Nether."
		"&7The center of the battlefield holds a trial spawner that generates Ancient Knights. Scattered armor lies around the environment; mining it has a chance to drop &6Netherite Scraps&7 and spawn an Ancient Knight."
		""
		"&7Once you can handle Ancient Knights, this is a convenient spot to get Netherite. It also produces &6Ash Essence&7, an important material."
	]
	quest.4276FE7E4037AC05.title: "Ancient Battlefield"
	quest.42F6170490C96218.quest_subtitle: "No Rivals Left"
	quest.42F6170490C96218.title: "Slay Champion Mobs x1000"
	quest.43B69EBAF5DCC756.quest_subtitle: "All-Purpose Tool"
	quest.43DDDB9D9BA35A28.quest_desc: [
		"&7Pacts and sacrifice hold power. The &6Brooch&r&7 is an example—one thing exchanged for another."
		"&7Legends are full of stories of those who gain power through voluntary sacrifice. I have designed a system to semi-permanently impose such treaties, or Mandates, upon the soul via the &5Soulbound Brazier&r&7."
		""
		"&7The brazier itself is more of a &dConductive Core&r&7 than a machine device—it channels souls using &eHallowed Gold Lining&r&7 and &6Deeprock Precious Gold Inlays&r&7."
		"&7Once materials are prepared, ignite the brazier with &bSpiritfire&r&7."
		""
		"Check the Arcane Tome for the specific materials required for each Mandate."
		"{@pagebreak}"
		"&7Each Mandate requires offerings—a &cCore Item&r&7, additional &7Raw Materials&r&7, and the &dArcane Energy&r&7 needed to sustain the Mandate—all of which should be placed directly into the brazier; interact with the brazier to do so."
		"&7After igniting the brazier, the pact must be sealed with one's own &4Blood&r&7. The number of people offering blood is unlimited, as long as they are willing."
		""
		"{@pagebreak}"
		"&7Mandates can even be imposed upon simple souls, though they may not know how to utilize them well."
		"&7Weakening a creature before igniting the brazier allows it to join the Mandate."
		""
		"&7It seems a soul can only hold &cTwo Mandates&r&7 simultaneously; any more will not take effect."
		"&6It bears repeating: Mandates are bound to the soul itself, and thus cannot be revoked without powerful means."
	]
	quest.43DDDB9D9BA35A28.quest_subtitle: "Price for Power"
	quest.43DDDB9D9BA35A28.title: "Mandates, and Other Pacts"
	quest.4432A2327732E7FF.quest_desc: [
		"&7Withering, &cThings that can destroy and damage&r&7. The creations of the Unbound Rite have many strange properties; I want to try to categorize them."
		"&7"
		"&7A simple explanation is that it's just another energy form infecting the world, but this explanation is clearly incorrect. Withering is harmless, at least in itself. It's just a... &7Substance."
		"&7"
		"{@pagebreak}"
		"&6Withering Research: Substance"
		"&7The &bUnbound Rite&r&7, as the name suggests, is a random process. It transmutes matter, but the products are fickle. So the powder it randomly produces is just unrelated material fragments piled together haphazardly, and quite foul-smelling. Not recommended for consumption or farming, but otherwise not harmful."
		"&7"
		"{@pagebreak}"
		"&6Withering Research: Flora"
		"&7While testing the interaction between &8Withering&r&7 and bone meal, I observed two plants that frequently appear—&aWithering Root Strands&r&7 and &aWithering Pearl Clusters&r&7. Neither is particularly useful, but they seem to grow on Withering without water or light. Interesting."
		"&7"
		"{@pagebreak}"
		"&6Withering Research: Spread"
		"&7Withering does not spread on its own, as it's just randomly generated material. But it has a &dSpirit Memory&r&7, a reproducible pattern. If given &eArcane Energy&r&7 or effective fertilizer, Withering randomly reproduces this pattern in the surrounding area."
		"&7"
		"{@pagebreak}"
		"&6Withering Research: Resonance"
		"&7This reproduction is precisely why it is so important for the &bRite of Unbinding&r&7. The &bRite of Unbinding&r&7 remembers the brutality of its creation process and &dResonates&r&7 with the memory within Withering, injecting its energy into things above the Withering."
	]
	quest.443DAEA62297C415.quest_desc: [
		"&6Origin Isle&r"
		"&7This is a long-forgotten, isolated island in the vast ocean, holding the &6secrets&r&7 of familiars' origins. The island's only inhabitants are tiny ‘&8Lost Souls&r&7’—early forms of familiars that failed to evolve into complete familiars. These souls can be captured with an empty bottle for new rituals. Rituals must be performed on the &epedestal&r&7 at the island's center.&r"
		""
		"&7To locate this island, you first need a &bSniffer&r&7. They can sometimes excavate &eCrystallized Berries&r&7. Alternatively, you can purchase berries from &dFloral Endermen&r&7. Feeding a Crystallized Berry to a tamed familiar will evoke their vague memories of birth and the past, condensing into &eMemory Fragments&r&7. Memory Fragments function like Eyes of Ender, guiding you to the Origin Isle's location.&r"
	]
	quest.443DAEA62297C415.quest_subtitle: "Discover the Origin Isle"
	quest.443DAEA62297C415.title: "Land of Origin"
	quest.446683FEB932319C.quest_desc: [
		"&6Twisted Anomaly Rune&r"
		""
		"&7The Twisted Anomaly Rune does not enhance the consciousness's abilities, but randomly distorts its behavior, causing the wearer's attack damage to randomly fluctuate—sometimes hitting the enemy's weakness precisely, in which case attack damage &aDoubles&r&7.&r"
	]
	quest.446683FEB932319C.quest_subtitle: "Pulse That Promotes Corruption"
	quest.447E0F674624A5FA.quest_desc: [
		"&6Rose Quartz&r"
		"&7A pale red crystal formed by fusing Redstone and Nether Quartz.&r"
		"&7Hold Rose Quartz in the main hand and Sandpaper in the off-hand to begin polishing. Polishing consumes the quartz immediately; interrupting the animation returns the item. Upon completion, you obtain &ePolished Rose Quartz&7.&r"
	]
	quest.44BFA62BE707B244.quest_desc: ["This adjustment affects the initial health of spawned monsters. Lower initial health is beneficial for automatic setups or manual farming, reducing kill time and preventing bottlenecks. One item changes this parameter by 5%. Minimum value is 20%."]
	quest.44BFA62BE707B244.quest_subtitle: "Born Frail"
	quest.44FF46EF1BE66093.quest_desc: [
		"&6Yeti&r&7"
		"&7Passive mob, only spawns in &#87CEEBStarlight Frozen Forest&r&7.&r"
		""
		"&7Sometimes changes its movement to rolling on the ground.&r"
		""
		"&7Hold shears and right-click the Yeti to shear it (similar to shearing sheep):&r"
		""
		"&7Immediately drops 1~3 &#F5F5DCWhite Yeti Fur&r&7, and the Yeti's texture changes to a bald, exposed skin texture (recovers after 2~3 minutes, cannot be sheared again before recovery).&r"
	]
	quest.44FF46EF1BE66093.title: "Yeti"
	quest.45A1C2B4E1B4D9BC.quest_desc: [
		"&6Treaty of the Rotten Glutton&r"
		""
		"&7Decay will eventually consume you.&r"
		"&7-Each level of &cRavenous Craving&r adds additional &cDamage&r taken&r"
		"&7-&cPoison&r&7 damage taken doubled&r"
		"&7-&cHunger&r&7 damage causes &cPoisoning&r"
		""
		"&7Decay becomes your strongest weapon.&r"
		"&7-&6Gluttony&r&7 becomes &6Ravenous Craving&r"
		"&7-&6Ravenous Craving&r increases &eScythe Proficiency&r&7 and spawns &bLocusts&r when the scythe deals damage&r"
		"&7-&6Ravenous Craving&r intensifies faster and has a higher cap&r"
	]
	quest.45A1C2B4E1B4D9BC.quest_subtitle: "Endless Feeding"
	quest.45A1C2B4E1B4D9BC.title: "Treaty of the Rotten Glutton"
	quest.45A31DEFA09A002A.quest_desc: [
		"&6Starlight Frozen Forest&r"
		"&7Is a surface biome in the Starlight Dimension."
		""
		"&7The terrain of Starlight Frozen Forest is &aHigher&r&7 (similar to mountainous biomes in the Overworld). Perennial snow cover gives the vegetation here a &fSilver-White&r hue distinct from other biomes."
		"&7The main tree type in Starlight Frozen Forest is &8Boreal Tree&r&7 (equivalent to Spruce in the Overworld)."
		""
		"&7The underground (Y > 0) of Starlight Frozen Forest primarily consists of &bPermafrost&r&7 rather than Gloomstone. Its underground is also the only way for players to find &ePermastone&r&7."
		"&7You can also find unique plants in this biome: &8Pinecone Flower, Umbrella Moon Grass, Glowing Umbrella Moon Grass, etc.&r"
	]
	quest.45A31DEFA09A002A.quest_subtitle: "Biting Cold Forest"
	quest.45A31DEFA09A002A.title: "Starlight Frozen Forest"
	quest.46318C4037942B1E.quest_desc: [
		"Can provide a temperature of 1500 degrees Celsius. Requires a Power Furnace to function normally."
		""
		"&eIt's not that one forge can only use one... multiple can be placed in the same furnace to supply fuel consumption."
	]
	quest.46318C4037942B1E.quest_subtitle: "Low-Temperature Heating"
	quest.463ED67306260BA3.quest_desc: [
		"This bookshelf is different from others; it provides a unique attribute—&eQuantum Stability&r."
		"&eQuantum Stability&r offers a way to eliminate the negative effects of Quantization. When present, the impact on the minimum enchantment level from &4Quantization&r is removed, leaving only the ability to provide additional enchantment levels. Additionally, the -15% &4Quantization&r can suppress the enchantment table's &4Quantization&r and &5Arcana&r to 0, facilitating future &aInfusion&r operations. The required Budding Amethyst can be obtained by &bInfusing&r Amethyst Blocks. (Recommended Bookshelf)"
		"{@pagebreak}"
		"Influenced by the concept of magical enhancement, I attempted to &9Infuse&r Amethyst."
		"Amethyst Shards are too weak, and Amethyst Clusters are already occupied by ancient power. Only Amethyst Blocks could bear this power, transforming into Budding Amethyst. Unfortunately, Budding Amethyst is too fragile, and its power is entirely directed towards growing Amethyst Clusters. So, I encased it in a bookshelf made of Calcite. The geode-like environment fully channeled the Budding Amethyst's power, manifesting a stronger force for suppressing &4Quantization&r—&eQuantum Stability&r. Unlike simply reducing &4Quantization&r, this ability only removes the negative effects of Quantization while preserving all its benefits. So, can I just weld this bookshelf permanently to the enchantment table? ("
	]
	quest.463ED67306260BA3.quest_subtitle: "Awakening of Natural Power"
	quest.463ED67306260BA3.title: "Mana Stability Amplification"
	quest.46B09EB249B0D6E0.title: "Lone Star Skeleton"
	quest.46C1263DC7062475.quest_desc: [
		"&6Twisting Engine&r"
		""
		"&7The Twisting Engine violates the laws of nature, and its practical application requires extreme caution. The Twisting Engine rejects causality, occasionally instantly completing a &6Focus Cycle&r&7 shortly after the normal end of the previous cycle, just before the next one begins.&r"
		""
		"&7Furthermore, chain activation of Twisting Engines grants stackable &aBonuses&r&7 to all other attributes. But as is probably obvious, this operation significantly increases &cFuel Consumption&r&7. Finally, it also slightly increases the burden of the standard &eTuning Process&r&7.&r"
	]
	quest.46C1263DC7062475.quest_subtitle: "Detached from Linear Time"
	quest.46C1B03029F1C41D.quest_desc: ["&7Allows you to拆卸 a specific part from your current equipment. Although you can generally directly craft with a new part to replace the old one, you might still find this tool useful."]
	quest.47CF8DC4847AD311.quest_subtitle: "Stage 2"
	quest.47D658272D1D7048.quest_desc: [
		"&7Still using the Sword Blueprint as an example. Items crafted with this blueprint are called &2\"Primary Components\"&7. The item crafted from the Sword Blueprint is the Sword Blade. When crafting components using blueprints, you need to fill them with matching materials. For example, the Sword Blueprint requires two of the same material—two Iron Ingots, two Diamonds, etc. The specific quantity varies depending on the blueprint. These materials need to be capable of forming &2\"Primary Components\"&7 to be made into a Sword Blade."
		""
		"&7The crafted Primary Component cannot be used directly yet. Sword Blades and tools must be combined with a handle, while armor components can be directly crafted into finished armor pieces. Any missing parts can be added later."
		""
		"&7The previously mentioned &eTip Upgrade, Binding, Coating, Grip&7 and other parts also need to be crafted using blueprints. They are not Primary Components—even without these parts, the item can still be used. Later, you can install them by crafting the item together with these parts. They provide additional bonuses to weapons and armor."
		""
		"&7If you're dissatisfied with a certain part and have a better material to replace it, simply craft the item with the new part in a crafting grid to replace the old one. The old part will be剥离 and will not disappear."
	]
	quest.47D658272D1D7048.title: "Modular Assembly Explained"
	quest.48A06F2501866438.quest_desc: [
		"&7This bookshelf is an extremely enhanced version of the Nether Bookshelf. Utilizing the chaos and blaze power contained within Blaze Powder and Fire Charges, this bookshelf has undergone apotheosis, becoming a more powerful entity. It provides even stronger &aQuanta&7 cap and &4Quantization&7 than the Nether Bookshelf."
		"&7However, this power is so violent and rampaging that it seems to want to devour everything it knows, dragging the world into eternal chaos. This bookshelf might even prevent you from glimpsing results in the enchantment table in advance. Use with caution."
	]
	quest.48A06F2501866438.quest_subtitle: "Hell Descends"
	quest.48A06F2501866438.title: "Chaos Approaches"
	quest.48B59F0341701B48.quest_desc: [
		"&7An expensive yet powerful material. Mithril is found between Y-levels -63 and -38, and generates quite sparingly. It's easier to mine when using the Nether Hammer to clear the way. Mining yield is affected by Fortune."
		""
		"&7Its strength lies in the Arcane Resonance 4 modifier. For every 10 Mana the player has, it provides 1% increased damage, up to a limit of modifier level * 20. This means that a Mithril Cloth handle can grant a terrifying 80% damage boost if the player has sufficient Mana."
		""
		"&eIf multiple Arcane Resonance modifiers exist on different pieces of equipment, the Mana increase effect can stack, but the damage increase cannot stack—the highest level modifier will be used."
	]
	quest.48B59F0341701B48.quest_subtitle: "You get what you pay for"
	quest.48BEC55ECB0AC9A3.quest_desc: [
		"&6Portable Fluid Interface&r"
		""
		"&7A connecting component specialized for extracting or inputting fluids between moving contraptions.&r"
		""
		"&6Transmitting Fluids&r"
		"&7When a Portable Fluid Interface faces another interface on a contraption, spaced 1 to 2 blocks apart, they automatically dock and begin fluid transfer.&r"
		"&7Requires a Powered Pump; direction and speed are determined by the pump's rotation and RPM.&r"
		"&7If the target interface is on a moving contraption, that contraption is temporarily halted until the current transfer completes.&r"
		"&7Docking may involve slight misalignment but doesn't affect actual transfer.&r"
		"&7When contraption speed or rotation is too high, interface interaction success rate drops significantly.&r"
		""
		"&6Redstone Lock&r"
		"&7Portable Fluid Interfaces can be locked by a redstone signal. When locked, they won't halt contraptions or transfer fluids.&r"
		""
		"&8They hate bumps but love to dance.&r"
	]
	quest.4923304658C6BF41.quest_desc: [
		"&eThe ultimate fuel. It seems wasteful to use it as such."
		"&6Combines the lowest consumption, fastest speed, and highest temperature, nearing perfection."
		""
		"⚡ Speed: 3.0x | ♨ Temperature: 6000 | ⏳ Consumption: 0.1"
		""
		"&aTip&r&7: &f♨ &r&7Temperature determines the grade of materials that can be processed, ⚡ Speed affects processing time, ⏳ Consumption represents fuel longevity."
	]
	quest.4923304658C6BF41.quest_subtitle: "Ultimate Fuel"
	quest.4939B8B2FE7A3B5D.quest_subtitle: "Stage 1"
	quest.496E4A2F2E407B7E.quest_subtitle: "Can this thing really kill?"
	quest.49840E89ACF73DAF.quest_subtitle: "Little Spoon"
	quest.4996E5CD9E56D25E.quest_subtitle: "Food Value > 8"
	quest.4996E5CD9E56D25E.title: "Main Meal Recycle x32"
	quest.4A1A9E32ABF05FD0.quest_subtitle: "Places the marked item or fluid. Cannot have any blocks (except fluids) in front of it when working normally."
	quest.4A4B782308B84A50.quest_subtitle: "Observation Window"
	quest.4A7080BE52CC6335.quest_subtitle: "Garden Tool"
	quest.4AC2F5D5FF711C0F.quest_desc: [
		"&6Resonance Tuner&r"
		""
		"&7&eAzure Sky&r&7 and &6Earthen&r&7 typically do not react with each other, and this non-reaction also has its uses. The Resonance Tuner moderates the interaction of different forces within the &eCrucible&r&7, significantly reducing or even completely removing &cDestabilization Risk&r&7 at the cost of slowing processing speed.&r"
	]
	quest.4AC2F5D5FF711C0F.quest_subtitle: "Dissonance Mitigation"
	quest.4AEAA66A5B802779.quest_desc: [
		"&e\"Fast is good!\""
		"&7The Biplane's base speed is much higher than other aircraft types. With Engine and Propeller upgrades installed, it can even compete with chunk loading speed. However, it also carries an enormous crash risk, and crashes result in &cexplosions&7—meaning dropped aircraft might be burned by the explosion flames. Always ensure you have a proper runway for takeoff and landing, and travel cautiously."
	]
	quest.4AF740882E852DBF.quest_desc: [
		"&6Familiar House&r"
		"&7The Familiar House is a block that can store up to 10 familiars. Familiars stored inside are &ainvulnerable&r&7 and generally will not attack other creatures (with some exceptions). The Familiar House has two modes:&r"
		""
		"&7&bStorage Mode&r&7: Allows the player to freely &amove&r&7 familiars between their own familiars and those stored in the house.&r"
		"&7&bRoaming Mode&r&7: Allows stored familiars to &awander&r&7 within a configurable distance. In this mode, you can also enable or disable familiars' abilities while roaming. The Familiar House block can only be broken by its &cowner&r&7, and only when it is in Storage Mode and contains no familiars.&r"
		""
		"&6Important Note&r&7: Only one Familiar House block can be used within a 16-block radius.&r"
	]
	quest.4AF740882E852DBF.quest_subtitle: "Grand Villa"
	quest.4AFE778B9A79DA33.quest_subtitle: "Fleet-Footed"
	quest.4B3F9F49C0FF6B3B.quest_desc: [
		"Although preparation techniques have improved, Arcane Essence Ink—especially high-tier grades—remains undeniably precious."
		""
		"&8Its value is forever etched in the price of its creation."
	]
	quest.4B3F9F49C0FF6B3B.quest_subtitle: "Exquisite Craftsmanship"
	quest.4B3F9F49C0FF6B3B.title: "Arcane Ink"
	quest.4B6AD3BEF9352961.quest_desc: [
		"&eA furnace that requires power input to function."
		""
		"Compared to traditional smelting relying on fuel combustion, electric smelting is more convenient—simply provide power to process most materials."
	]
	quest.4B6AD3BEF9352961.quest_subtitle: "Electric Smelting"
	quest.4BA0280CD5AC4EB5.quest_subtitle: "A Nobler Scissor...?"
	quest.4C04EAB3BF7A1201.quest_desc: ["&7Recommended at this stage because it can be obtained here, but that doesn't mean it's only usable here. Some extremely powerful materials will be useful no matter what stage you're in."]
	quest.4C04EAB3BF7A1201.title: "Early Game - Pre-Necromancer King"
	quest.4C4D49730F599ADA.quest_desc: [
		"&6Crystalline Desert&r"
		"&7Is a surface biome in the Starlight Dimension."
		""
		"&7The Crystalline Desert is mainly paved with &8Dusk Sand&r&7, with a few &8Dead Moonglow Trees&r&7 generating on the surface."
		"&7Both the surface and dozens of layers underground in the Crystalline Desert generate crystal cluster features composed of &cRed Starlight Crystals&r&7 and &bBlue Starlight Crystals&r&7. This is an important way for players to obtain &cBoth Types of Crystal Shards&r&7."
		""
		"&7Compared to other surface biomes, the feature coverage in the Crystalline Desert is &aLower&r&7, making it easier for players to locate &eHot Springs&r&7."
		"&7You can also find unique plants in this biome: &8Lunar Moth Cactus, Dead Moonglow Bushes, Purple Desert Grass, Desert Violet Flower, Starfly Tree, Dusk Surge Grass, Fly Fruit, etc.&r"
	]
	quest.4C4D49730F599ADA.quest_subtitle: "Twinkle Twinkle Little Crystal"
	quest.4C4D49730F599ADA.title: "Crystalline Desert"
	quest.4C7B1F3BC1ACBD92.quest_desc: ["&7Adjusts fuel consumption and engine output. The latter directly affects flight speed. Comparatively, fuel isn't particularly precious."]
	quest.4CC2D82F6A669265.quest_desc: [
		"&6Blazing Diode&r"
		""
		"&7The Blazing Diode borrows the powerful force of fiery souls, reducing the &cFuel Requirement&r&7 of &eCatalyzers&r&7 around the &eCrucible&r&7 while slightly speeding up the &aFocus Process&r&7.&r"
	]
	quest.4CC2D82F6A669265.quest_subtitle: "Supreme Power"
	quest.4D2714BB06E019FF.quest_desc: [
		"&7After carefully considering the properties I observed in &dSpirit Crystals&r&7, I couldn't help but think that structure itself might be significant. To test this conclusion, I created an &8Echo Matter&r&7 imitation, used to simulate &cWicked Arcane Energy&r&7; condensed soul memory was the closest substance I could think of. It achieved precision down to one-hundred-thousandth of a block."
		"&7"
		"&7I didn't expect it to explode in front of me."
		"&7"
		"&7But explosions are also useful, provided they can be controlled. So I made another sample, but this time I designed a structure for the pseudo-crystal to operate—a housing made of &6Soulwood&r&7 and &6Soulstained Steel&r&7 to channel the energy outward. When focusing a spell onto a staff, it resembles a miniature version of a rite, though the effects produced are somewhat different."
		"&7"
		"{@pagebreak}"
		"&7A staff in melee combat... barely serviceable. I'd probably choose a scythe as my primary weapon, but staves aren't bad either. They typically emphasize enhancing magical damage over physical damage, which can sometimes be useful. Their true uniqueness is revealed when I &ause&r&7 them."
		"&7"
		"&7The Echo Spell Staff condenses liquid Wicked Arcane Energy into a sphere and launches it, reminiscent of a witch's hex. Activating it takes some time, and it apparently cannot be fired multiple times in quick succession, but each shot deals significant damage to the target. The staff borrows from my soul to charge, and because of this, the ammo count for all staves I carry is pooled together."
		"&7"
		"{@pagebreak}"
		"&7This method of creating simulated Arcane Energy failed with other energies, perhaps due to materials. The resonance between Echo Matter and Wicked Arcane Energy might simply stem from the death required to create Experience Crystals."
		"&7"
		"{@pagebreak}"
		"&6Ammo Capacity"
		"&7As far as I know, Spirit Crystals contain limited energy... but this only applies to the peculiar non-physical substance of Arcane Energy. The &6Ammo Capacity&r&7 enchantment allows a staff to accumulate more energy within the same physical space, storing roughly one more spell projectile per level. Staves with this enchantment cannot also accept the Rapid Charge enchantment."
		"&7"
		"{@pagebreak}"
		"&6Rapid Charge"
		"&7Staves can channel physically manifested magic. Clearly, magic can flow out and in; consciously directing its flow is not impossible. When used in melee, a staff with the &6Rapid Charge&r&7 enchantment has a chance to replenish its energy reservoir, refilling roughly the equivalent of one spell projectile. Staves with this enchantment cannot also accept the Ammo Capacity enchantment."
	]
	quest.4D2714BB06E019FF.quest_subtitle: "Let Magicians Fear My Might"
	quest.4D2714BB06E019FF.title: "Spirit Staves"
	quest.4D2D9898C6477E3B.quest_desc: [
		"&7For all aircraft: Press the R key to exit the aircraft. Some models may require pressing twice to prevent misoperation. Since R conflicts with shader pack reloading, rebinding is recommended."
		""
		"&7After boarding, press the inventory key to open the aircraft page. Here you can install aircraft upgrade components. If the aircraft requires fuel, you can also add it on this page."
		""
		"&7For biplanes: Hold &eSpace&7 to start the engine. The aircraft will begin sliding during startup—prepare your takeoff runway. Once the engine is running, briefly press &eS&7 to pitch the nose up for takeoff. After takeoff, press &eD&7 to lower the nose. Hold &eShift&7 to shut down the engine and glide for landing."
		""
		"&cBiplanes fly fast but have higher takeoff and landing risks. Crashes result in explosions—please be careful (the damage is really high)."
		""
		"&7For helicopters/gyrocopters: Space to ascend, Shift to descend."
		""
		"&7For human-powered aircraft: Hold W to provide power. Once power reaches maximum, it stabilizes, and W then functions as normal forward control. Continuously consumes saturation during flight."
	]
	quest.4D2D9898C6477E3B.quest_subtitle: "At least you know how to hit the gas and brakes... right?"
	quest.4D73E8E5F27EE986.quest_desc: [
		"&7I stand before the mausoleum entrance."
		""
		"&7The short blade has a new edge. Every forge mark on the armor remembers the path I've walked. Forge, anvil, the rhythm of hammering day and night—I've come a long way to stand here."
		""
		"&7Not for justice. The gatekeeper said that thing can't be truly killed—it sleeps, wakes, sleeps again. No hatred, no mission."
		""
		"&7I only heard that every time it falls, several ores never seen in the world briefly appear."
		""
		"&7A few years. Enough for a smith to pour their heart into trying, refining, forging what previous craftsmen only dared to sketch. What smith's heart wouldn't be moved?"
		""
		"&7The mausoleum's stone door was unlocked. Inside, dark. The cat's eye gems I'd set began to glow. I gripped my weapon and stepped in."
	]
	quest.4D73E8E5F27EE986.title: "Prepare for Battle"
	quest.4DBB3CA0C3949A66.quest_desc: [
		"&6Stormcaller Familiar&r"
		"&7Combat: Specializes in &elightning magic&r&7, can attack multiple targets simultaneously.&r"
		"&7Abilities:&r"
		"&7&aMaster of Charge&r&7: Can charge its master for a period, increasing their speed and strength.&r"
		"&7&aCharged Creeper&r&7: Whenever it spots a Creeper, it will follow and charge it.&r"
		"&7Spawn: Can be found wandering in &bMountains&r&7, seeking good spots to attract lightning.&r"
		""
		"{@pagebreak}"
		"&6Archmage Familiar&r"
		"&7Combat: Specializes in &ebasic magic&r&7 of various schools.&r"
		"&7Abilities:&r"
		"&7&aTransmutation&r&7: Can transform &eSpell Scrolls&r&7 placed on a pedestal into other random scrolls of the same rarity, with a small chance to obtain a higher rarity scroll.&r"
		"&7&cEnderman's Nightmare&r&7: Endermen fear it and will flee upon sight.&r"
		"&7&aShulker Defense&r&7: Can counter Shulker projectiles.&r"
		"&7Spawn: Can be found studying in temporary laboratories located in the &6End&r&7.&r"
		""
		"{@pagebreak}"
		"&6Necromancer Familiar&r"
		"&7Combat: Specializes in &cblood magic&r&7, including necromantic abilities to summon undead.&r"
		"&7Abilities:&r"
		"&7&cUndead Frenzy&r&7: Can send nearby undead entities into a frenzy, causing them to attack nearby entities chaotically.&r"
		"&7&cWithering&r&7: Can transform nearby Skeletons into Wither Skeletons.&r"
		"&7Spawn: Can be found studying death in &8Soul Sand Valley&r&7 graveyards.&r"
		""
		"{@pagebreak}"
		"&6Conjurer Familiar&r"
		"&7Combat: Specializes in &8void magic&r&7 and unknown arts, able to summon shadow-born creations.&r"
		"&7Abilities:&r"
		"&7&aTrue Sight&r&7: Can grant the master &aNight Vision&r&7 and make them immune to Blindness and Darkness effects.&r"
		"&7&aDark Ritual&r&7: Can deactivate &cSculk Shriekers&r&7, allowing the master to avoid detection by Wardens.&r"
		"&7Spawn: Can be found studying dark arts in laboratories located in &cAncient Cities&r&7.&r"
		""
		"{@pagebreak}"
		"&6Hunter Familiar&r"
		"&7Combat: Specializes in using &ebows&r&7 to attack enemies, combined with swift movement.&r"
		"&7Abilities:&r"
		"&7&aWatcher&r&7: Can protect the master from attacks by enemies targeting them, even if the master is unaware.&r"
		"&7&aSniff Loot&r&r&7: The master can hold any item and right-click the familiar, causing it to search for entities that drop that item nearby and mark them for the master.&r"
		"&7Spawn: Can be found living in camps within various &bForest&r&7 biomes.&r"
		""
		"{@pagebreak}"
		"&6Druid Familiar&r"
		"&7Combat: Specializes in using &bnature magic&r&7 to control enemies.&r"
		"&7Abilities:&r"
		"&7&aOvergrowth&r&7: Can use bone meal on nearby crops.&r"
		"&7&aNature's Blessing&r&7: Can breed nearby animals.&r"
		"&7Spawn: Can be found protecting forests worldwide.&r"
		""
		"{@pagebreak}"
		"&6Illusionist Familiar&r"
		"&7Combat: Specializes in &dillusion magic&r&7, controlling enemies through deception.&r"
		"&7Abilities:&r"
		"&7&aMagic Trick&r&7: When the master's health is low, the Illusionist will perform a magic trick to hide the master from enemies.&r"
		"&7&aDecoy&r&7: When its own health is low, it will vanish and leave behind an explosive duplicate that taunts nearby enemies to attack it.&r"
		"&7&aPickpocket&r&7: When unnoticed and there are gold nuggets or emeralds on the ground, this little trickster will claim them for itself.&r"
		"&7Spawn: Illusionists spawn naturally disguised as other overworld familiars; use the &eMirror of Truth&r&7 to reveal them.&r"
		""
		"{@pagebreak}"
		"&6Plague Doctor Familiar&r"
		"&7Combat: Specializes in &cpoison magic&r&7, causing enemies to die slowly from poison.&r"
		"&7Abilities:&r"
		"&7&cToxic Blood&r&7: Its master and itself deal extra damage to poisoned entities. When the Plague Doctor familiar is attacked, it retaliates by throwing a poison bottle.&r"
		"&7Acquisition: To obtain it, you must craft a bottle of &cToxic Reagent&r&7 and give it to a tamed Druid familiar.&r"
		""
		"{@pagebreak}"
		"&6Blazing Familiar&r"
		"&7Combat: Specializes in &efire magic&r&7, burning enemies to death.&r"
		"&7Abilities:&r"
		"&7&cMolten Heart&r&7: When attacked, sets the attacker on fire for a duration.&r"
		"&7&aHeat Resistance&r&7: Grants fire immunity to its master and itself.&r"
		"&7Spawn: Can be found wandering in hot areas of the &cNether&r&7.&r"
		""
		"{@pagebreak}"
		"&6Cleric Familiar&r"
		"&7Combat: Specializes in &aholy magic&r&7, primarily a support role but can also cast powerful holy spells to purify enemies.&r"
		"&7Abilities:&r"
		"&7&aRedemption&r&7: It will attack undead in sight, but if it sees a Zombie Villager, it will use holy power to cure and redeem it.&r"
		"&7Acquisition: To obtain a Cleric familiar, you must cast a &aPurification Spell&r&7 near an untamed Necromancer familiar.&r"
		""
		"{@pagebreak}"
		"&6Bard Familiar&r"
		"&7Combat: Specializes in &dmusical magic&r&7, attacking enemies with powerful melodies and aiding allies with supportive tunes.&r"
		"&7Abilities:&r"
		"&7&aMusical Nature&r&7: It plays melodies, making adventures more delightful.&r"
		"&7Acquisition: To obtain it, you must cast a &eMusical Spell&r&7 near an untamed familiar to pique its interest in music.&r"
		""
		"{@pagebreak}"
		"&6Frost Familiar&r"
		"&7Combat: Specializes in &bfrost magic&r&7, with a good balance between offense, defense, and mobility, along with decent control abilities.&r"
		"&7Abilities:&r"
		"&7&aFrost Walk&r&7: It and its master can freeze water underfoot for easy traversal.&r"
		"&7&aFrost Heart&r&7: It and its master are immune to freezing effects, including powder snow freezing.&r"
		"&7Spawn: Can be found wandering in &bSnowy Biomes&r&7.&r"
		""
		"{@pagebreak}"
		"&6Dragoon Familiar&r"
		"&7Combat: Specializes in &6ender magic&r&7, focusing on melee combat.&r"
		"&7Abilities:&r"
		"&7&eDragon's Breath&r&7: It can collect Dragon's Breath using glass bottles.&r"
		"&7&aDragon Heart&r&7: Its Dragon Heart allows it to naturally regenerate health.&r"
		"&7&aGuardian&r&7: When an allied familiar is attacked within melee range, it will swap places with them and lock onto the attacker.&r"
		"&7Spawn: Spawns on the &6Outer End Islands&r&7.&r"
	]
	quest.4DBB3CA0C3949A66.quest_subtitle: "Cute, huh"
	quest.4DC5D99569CC3F68.quest_desc: [
		"This upgraded Deep Dark Bookshelf channels power into &5Arcana&r, providing large amounts of &5Arcana&r without offering &4Quantization&r."
		"(Important Bookshelf)"
	]
	quest.4DC5D99569CC3F68.quest_subtitle: "Mystical Power Re-emerges"
	quest.4DC5D99569CC3F68.title: "Sculk Growth – Seeing the Deep Dark Again"
	quest.4E154F6CBE09CA32.quest_desc: [
		"&6Fang of Thirst&r&7"
		"&7A material dropped after killing the &#8B0000Thirst Walker&r&7.&r"
		""
		"&7When the Thirst Walker's &#DC143CBite Attack&r&7 is blocked by a &#1E90FFShield&r&7, there is also a &#FFA07A 16.67%&r&7 chance to drop 0~2 &#8B0000Fangs of Thirst&r&7.&r"
		""
		"&7Can be used to craft the &#FF4500Dagger of Thirst&r&7 and various decorative blocks.&r"
		""
		"&7Besides kill drops, there is a special way for Fang of Thirst to drop:&r"
		""
		"&7If the Thirst Walker's &#DC143CBite Attack&r&7 is blocked by a &#1E90FFShield&r&7 (including other equipment with the same mechanic), that Thirst Walker has a &#FFA07A 16.67%&r&7 chance to drop 0~2 &#8B0000Fangs of Thirst&r&7.&r"
		""
		"&7\"&#FFD700Losing Teeth&r&7\" does not affect the Thirst Walker's subsequent behavior or attack damage.&r"
	]
	quest.4E7B1EFF01114F88.quest_desc: [
		"&6Steam Engine&r"
		""
		"&7An advanced power source that requires a &eBoiler&r&7 to generate power.&r"
		"&7Stress Output: &c0 ~ 16384 su&r"
		"&7RPM Output: &c16 ~ 64 RPM&r"
		""
		"&6Acquisition&r"
		"&7Crafting Table synthesis.&r"
		""
		"&6Usage&r"
		""
		"&6Placement&r"
		"&7Steam Engines must be installed on any face of a &eFluid Tank&r&7, which then becomes a &6Boiler&r&7. To enable power output, place a &eCogwheel&r&7 two blocks in front of the engine. Right-click the engine with an item cogwheel to attach.&r"
		""
		"&6Outputting Stress from Boiler&r"
		"&7Steam Engines output stress from the boiler. Boiler stress generation is detailed under &6Boiler&r&7.&r"
		"&7Boiler stress is evenly distributed among all Steam Engines on it. A single engine can output a maximum of &c16384 su&r&7. If total stress exceeds this, install more engines to avoid waste. Installing a number of engines equal to the boiler's level outputs all stress.&r"
		"&7Placing more engines than needed does not increase efficiency.&r"
	]
	quest.4E826A5530F49919.quest_subtitle: "Stage 2"
	quest.4EB3AF395EE2F05E.quest_desc: ["&7A straightforward stat stick. As an add-on material, it increases reach distance—when armor is weak early on, having longer reach effectively reduces risk. As a handle material, it provides a +5 attack damage bonus. Requires mining Uranium/Nickel ores and smelting in a furnace. Slightly more expensive than Hardened Steel, but not difficult to make."]
	quest.4EB3AF395EE2F05E.quest_subtitle: "An inch longer makes you stronger"
	quest.4EF6614B03841586.quest_desc: [
		"&6Dusk Eye Fish&r&7"
		"&7A common aquatic creature in the Abyss; cannot survive out of water (loses mobility and gradually loses health over time until death).&r"
		""
		"&7Unlike the &#ADD8E6Light Pufferfish&r&7 and &#87CEEBLight Horn Piranha&r&7, this creature cannot be picked up with a bucket.&r"
		""
		"&7Only retaliates when attacked (melee only, attacks can be blocked with a shield).&r"
		""
		"&7Group Aggro: After being attacked, all Dusk Eye Fish in the vicinity will target the attacker.&r"
		""
		"&7Dusk Eye Fish will stop chasing a target if it leaves the water body they are in.&r"
	]
	quest.4EF6614B03841586.title: "Dusk Eye Fish"
	quest.501A9D4E77A9D0EA.quest_subtitle: "Soul Rending"
	quest.501AB9740C6C4447.quest_desc: [
		"&6Heartiness Rune&r"
		""
		"&7Unlike similar runes that provide healing, the Heartiness Rune forces the form to heal beyond its limits, granting a small amount of &aAdditional Health&r&7.&r"
	]
	quest.501AB9740C6C4447.quest_subtitle: "Healing That Which is Whole"
	quest.502FAEFE4F6CF6B2.title: "Playtime 8h"
	quest.5057DE8E48849E95.quest_desc: [
		"&6Brass&r"
		""
		"&7Molten copper and zinc meet in the furnace, cooling into this warm golden metal. It's relatively soft yet sufficient to shape the initial forms of machinery.&r"
		""
		"&6Uses&r"
		"&7Hold it and use it on a placed &eStripped Log&r&7 to coat it with a metallic sheen, turning it into a sturdy &eBrass Casing&r&7—an indispensable starting point for many complex constructs.&r"
		"&7Beside a &eStonecutter&r&7, it can be shaped into corresponding &escaffolding&r&7 and structural parts, paving the way for larger builds.&r"
		"&7On a &eCrafting Table&r&7, its forms are more delicate: becoming the agile joints of &eBrass Hand Parts&r&7, shaping into &eBrass Funnels&r&7 to guide material flow, or extending as &eBrass Tunnels&r&7 for energy and matter to pass through unseen.&r"
		""
		"&8A small line on the manuscript edge: It's friendly enough that even a beginner with a file and hammer can start working. Of course, don't expect to make a sword from it.&r"
	]
	quest.5057DE8E48849E95.quest_subtitle: "An important metal material, often used in synthesizing advanced components."
	quest.5077E77C727BD6FD.quest_desc: ["Attempts to output specific items into a container."]
	quest.5077E77C727BD6FD.quest_subtitle: "Output items or fluids from the RS network."
	quest.50B7EEE2AA34EAFE.quest_desc: [
		"&6Equipment Repair&r"
		""
		"&7During your journey, weapons and equipment will inevitably wear down. &eRepair Kits&r&7 can help you effectively maintain them.&r"
		""
		"&7*   &eAnvil Repair&r&7：Utilizes materials more fully, restoring more durability, but consumes experience.&r"
		"&7*   &eRepair Kit Repair&r&7：No experience cost, simple operation, but material utilization is slightly lower.&r"
		"{@pagebreak}"
		"&6Repair Principles&r"
		"&7Repair involves two core concepts:&r"
		"&7*   &eRepair Efficiency&r&7：Repair Kits, equipment, or components may have this multiplier. During repair, it multiplies with the material's durability, affecting the final amount restored.&r"
		"&7*   &eRepair Value&r&7：Some materials possess this attribute. Their own durability is multiplied by it, making certain materials particularly suitable or unsuitable for repairs.&r"
		"{@pagebreak}"
		"&6Material Selection&r"
		"&7&cKey Principle&r&7：Must use materials that are &cidentical to the equipment's main material&r&7 for repair.&r"
		"&7*   &eAttribute Application&r&7：When repairing armor and shields, refer to the material's &bArmor Durability&r&7；when repairing other tools/weapons, refer to its &bNormal Durability&r&7.&r"
		"&7*   &eEfficiency Impact&r&7：Some materials also have &bRepair Efficiency Modifiers&r&7, which affect their actual repair effectiveness.&r"
		"{@pagebreak}"
		"&6Repair Kit Details&r"
		"&7Kits come in multiple tiers. Higher-tier kits have &alarger capacity&r&7 and &ahigher repair efficiency&r&7.&r"
		"{@pagebreak}"
		"&6Usage Method&r"
		"&71.  &eFill Materials&r&7：Place a Repair Kit and one or more compatible materials in a crafting grid to store the materials in the kit.&r"
		"&72.  &ePerform Repair&r&7：&r"
		"&7    *   Place the &cfilled&r&7 Repair Kit and the equipment needing repair in a crafting grid to repair.&r"
		"&7    *   You can also place &cadditional materials&r&7 in the crafting grid along with the Repair Kit and equipment during repair. These extra materials will be consumed directly.&r"
		"{@pagebreak}"
		"&6Important Note&r&7：&r"
		"&7*   Repair Kits &aconsume materials as needed&r&7. For example, if repair only requires half an iron ingot, the remaining half stays in the kit.&r"
		"&7*   However, &cmaterials placed additionally in the crafting grid during repair&r&7 are &centirely consumed&r&7, even if they exceed what's needed.&r"
		"{@pagebreak}"
		"&6Emptying the Kit&r"
		"&7To empty a Repair Kit, simply craft it with a stick. Note: This operation &cdestroys&r&7 all stored materials in the kit, returning only an empty kit.&r"
		"{@pagebreak}"
		"&6Anvil Repair&r"
		"&7Operation is identical to vanilla: place equipment on the left, compatible material on the right. Its repair efficiency is 50%.&r"
	]
	quest.50B7EEE2AA34EAFE.quest_subtitle: "Repair Your Tools"
	quest.50E57652755EC341.quest_desc: [
		"&aTier (0~50):&r&7 Determines the maximum enchantment level the enchanting table can apply. Max enchantment level = Tier × 2"
		"&r"
		"&cQuantization (0%~100%):&r &7Causes your final enchantment level to fluctuate, making the final enchantment level fall within the interval [2e(1-q), 2e(1+q)]"
		"(where e is the Tier value, q is the Quantization value)"
		"&3The enchanting table inherently has 15% Quantization. For example, if the enchanting table Tier is 50 and Quantization is 90%, when using the third-level cost to enchant any enchantable item, the final enchantment level interval is [10, 190] (levels)."
		""
		"&r&5Arcana (0%~100%):&r&7 Determines the probability of 'rare enchantments' appearing. When Arcana reaches 100%, some common enchantments (e.g., Sharpness) become rare."
		"&r"
		"{@pagebreak}"
		""
		"&eQuantization Stability:&r&7 Alters the minimum final enchantment level affected by Quantization fluctuation. The minimum level is 1. The adjusted Quantization interval is \"[-q(1-r), +q], 0<q≤1\" (where q is the Quantization value, r is the Calibration value). So if the enchanting table has 100% Calibration, the final Quantization interval becomes [0, +q]."
		""
		"&r&bEnchantment Insight:&r&7 The number of enchantments that can be previewed. Default is 1.&r"
	]
	quest.50E57652755EC341.quest_subtitle: "I Have a FOMO Table"
	quest.5125C8D0790C81BB.quest_desc: [
		"&6Howling Winds Rune&r"
		""
		"&7The Howling Winds Rune's ability is similar to the ritual of the same name, granting the wearer the &bHowling Winds&r&7 effect at half strength, increasing &aMovement Speed&r&7 and &aAttack Speed&r&7.&r"
	]
	quest.5125C8D0790C81BB.quest_subtitle: "Swift-Firing Pulse"
	quest.5177469D5E64C1E3.quest_desc: [
		"&6Sandpaper Polishing&r"
		""
		"&6Polishing Methods&r"
		"&7‘Sandpaper Polishing’ can be performed via:&r"
		"&7Holding sandpaper in one hand and the item to process in the other, then right-clicking;&r"
		"&7Holding sandpaper and right-clicking an item entity;&r"
		"&7Having a Deployer hold sandpaper and polish, with the same effect as manual.&r"
		"&7Each polish consumes 1 durability of sandpaper.&r"
		""
		"&6Polishing Copper Blocks&r"
		"&7Can perform surface treatment on vanilla copper blocks:&r"
		"&7If waxed, removes wax;&r"
		"&7If oxidized, reduces oxidation by one stage.&r"
		"&7Mechanism is identical to vanilla axes.&r"
		""
		"&6Polishing Building Blocks&r"
		"&7Can convert some vanilla building blocks (like stone bricks, andesite) into their ‘Polished’ variants.&r"
		""
		"&6Enchanting&r"
		"&7Sandpaper can be enchanted at an enchanting table or anvil. Applicable enchantments include Unbreaking, Mending, Curse of Vanishing.&r"
		"&8An extremely small, scribbled line at the page edge: Would anyone really enchant this?&r"
	]
	quest.51BCF840DB0DBE44.quest_desc: ["&7This is your oldest companion from vanilla enchanting, unremarkable, providing only 2 points of &l&aQuanta&7. Yet, it still leads you into the halls of enchantment."]
	quest.51BCF840DB0DBE44.quest_subtitle: "It All Starts Here"
	quest.51BCF840DB0DBE44.title: "Magic's Oldest Friend"
	quest.51BE2E9C9209091D.quest_desc: [
		"&6Grasp of the Tides Rune&r"
		""
		"&7The Grasp of the Tides Rune's ability is similar to the ritual of the same name, granting the wearer the &bGrasp of the Tides&r&7 effect at half strength, slightly extending &aBlock Interaction Range&r&7 and &aItem Pickup Range&r&7.&r"
	]
	quest.51BE2E9C9209091D.quest_subtitle: "Extending Pulse"
	quest.527B5583A09AF510.quest_desc: ["The Wither Skeleton Skull has a deeper connection to hell, thus capable of generating more powerful Quantization force."]
	quest.527B5583A09AF510.quest_subtitle: "Stronger Quantization Increase"
	quest.527B5583A09AF510.title: "The Sacrificed Skull"
	quest.52FB65193EF182F4.quest_desc: [
		"&#FF5555Wrath - Erosion&r&7"
		"&7When carrying the 'Wrath' effect, it is considered to apply &#FF5555Stillness Timer&r&7.&r"
		"&#00FFAA[Every 1 second]&r&7 &#FF5555Stillness Timer&r&7 increases by 1 second.&r"
		"&#00FFAA[Stillness Timer ≥ 60 seconds]&r&7 Deals damage to yourself equal to 10% of max health, and resets &#FF5555Stillness Timer&r&7 to 0.&r"
		"&#00FFAA[When attacked]&r&7 If you have the &#FFAA00Wrath&r&7 effect, apply &#FF5555Glowing&r&7 (duration 20 seconds) and &#FF5555Wrath Mark&r&7 (duration 20 seconds) to the attacker.&r"
		"&#00FFAA[When attack hits]&r&7 If you have the &#FFAA00Wrath&r&7 effect and the target has the &#FF5555Wrath Mark&r&7, add extra damage to this attack's final damage equal to 2 times the base damage; upon successful addition, remove the target's &#FF5555Wrath Mark&r&7 and &#FF5555Glowing&r&7 effects.&r"
		"&#00FFAA[When attack hits]&r&7 If you are not in the 'Wrath' state, reset &#FF5555Stillness Timer&r&7 to 0.&r"
	]
	quest.52FB65193EF182F4.quest_subtitle: "WIP"
	quest.52FB65193EF182F4.title: "Wrath Erosion"
	quest.530E224CB690AC4D.quest_desc: [
		"&6Abyss&r"
		"&7Is an ocean biome in the Starlight Dimension, relatively uncommon."
		""
		"&7The Abyss's terrain features are typical of long, narrow trenches, with an overall &cCramped&r space"
		"&7and an &aExtremely Large&r height difference from the seabed surface."
		"&7The deepest part of the Abyss biome is often &aExtremely Close&r&7 to the bedrock layer of the Starlight Dimension (which also means non-aquatic creatures almost cannot spawn within the Abyss biome)."
		""
		"&7The Abyss generates many unique &#1E90FFAquatic Creatures&r&7 and &#FF4500Abyssal Magma Blocks&r&7 that create bubble columns."
		"&7Unique plants in the Abyss are &#FF0000Red Moss&r&7 and &#32CD32Sticky Floss Moss&r&7. Some coral reefs also generate adjacent to the upper layers of the Abyss."
		"&7Sticky Floss Moss Balls can be converted into &#8FBC8FSlimeballs&r&7 in a crafting grid."
		""
		"&7Players within the Abyss biome have their vision &cExtremely Limited&r&7. It is recommended to prepare &#00FF00Night Vision Potions&r&7 and &#00CED1Water Breathing Potions&r&7 with sufficient duration before exploring."
	]
	quest.530E224CB690AC4D.quest_subtitle: "If you gaze into the abyss..."
	quest.530E224CB690AC4D.title: "Abyss"
	quest.532E3C393BCE6BA6.quest_desc: ["Ghast Tears can increase the maximum number of mobs a spawner can spawn. Normally, a spawner stops when N mobs are already spawned nearby. Ghast Tears increase the value of N."]
	quest.532E3C393BCE6BA6.quest_subtitle: "Rush Hour Subway"
	quest.533E6E13F1C9E939.quest_desc: [
		"&6Conveyor Belt&r"
		""
		"&7It is the flowing road in the machinist's hands, responsible for moving items between two points, or transmitting unseen rotational force.&r"
		""
		"&6Laying This Road&r"
		"&7You need at least two cogwheels facing the same direction as start and end points. Hold the Conveyor Belt, right-click the first cogwheel, then red particle trails appear where you aim—it's asking for the endpoint. Only when particles turn green does the other cogwheel accept the connection; right-click again to lay the belt. If particles stay red, placement is wrong; if they vanish, distance exceeds its limit.&r"
		"&7It can extend horizontally, vertically, or at a precise 45-degree angle, but total length (including end cogwheels) cannot exceed &c20 blocks&7 (if diagonal, &c15 blocks&7).&r"
		""
		"&6Trimming and Modifying&r"
		"&7Hold a new Conveyor Belt and right-click the end of an existing belt (doesn't consume the held item) to extend it by one block; the end cogwheel moves accordingly. To retract it, tap the end with a wrench.&r"
		"{@pagebreak}"
		"&7Using a wrench in the middle severs it—this usually consumes two cogwheels (unless in Creative). For two separate belts of compliant length and same direction, hold a belt and click one's endpoint to connect them, returning one belt and two cogwheels.&r"
		"&7You can also hold a cogwheel and right-click an empty spot in the middle of a belt to insert a new support; use a wrench to remove it.&r"
		""
		"&7It doesn't have to be dull metal. Use dye to color it any shade you want. To wash off the color, a bucket of water or a water bottle suffices.&r"
		""
		"&8The manuscript's margin has a sketch of a winding conveyor belt, with a note: The road is laid. Now, make things move.&r"
	]
	quest.53634A7FA785B1D3.quest_subtitle: "Not Necessarily Negative"
	quest.53634A7FA785B1D3.title: "Seven Sins Erosion"
	quest.536380EE035D7850.quest_subtitle: "拿着任意末地创世的眼睛右键门框上已有的眼睛可以卸下"
	quest.5372150CD0958B7B.quest_desc: [
		"&6Crushing Wheel&r"
		""
		"&6Item Processing&r"
		"&7Designed specifically for executing ‘&cCrushing&r&7’ recipes. Items without a corresponding recipe are destroyed directly."
		"&7Most ‘&cCrushing&r&7’ recipes are identical to ‘&eGrinding&r&7’ recipes, so functionally it can replace most &eMillstones&7."
		"&7Must be used in pairs, and the two wheels' rotation directions must be coordinated to work.&r"
		""
		"&6Entity Processing&r"
		"&7Active Crushing Wheels deal &cdamage&7 to entities entering their range (except players in Peaceful), and drop crushed products at the output."
		"&7This damage ignores armor, Protection enchantments, and Resistance effects but can be absorbed by Absorption."
		"&7For horizontally placed wheels, placing a block above prevents suction; for vertically placed, a chute above the gap avoids suction without hindering work.&r"
		""
		"{@pagebreak}"
		""
		"&6Placement and Operation Mechanism&r"
		"&7When a pair is correctly placed, if the one-block gap between them is unobstructed, an invisible block is automatically generated: the &eCrushing Wheel Controller&7."
		"&7This block has collision, cannot be moved by pistons or contraptions, acts as an open container that absorbs and processes items, and supports logistics input/output."
		"&7It controls the entire wheel pair's behavior; dismantling the wheels removes this block."
		""
		"&7A functional wheel pair requires:"
		"&7They are spaced &cexactly 1 block&7 apart with no obstruction between;"
		"&7Their wheel faces must be &cparallel&7.&r"
		""
		"&8This part of the manuscript has deep scratches, as if ground by wheel teeth. That you can see this manuscript is thanks to its owner having installed a proper shutdown mechanism...&r"
	]
	quest.5372150CD0958B7B.quest_subtitle: "An operation component capable of crushing items."
	quest.5378D02C832E3260.quest_subtitle: "Food Value >= 14"
	quest.5378D02C832E3260.title: "Feast Recycle"
	quest.5394037EDC7769D9.quest_desc: [
		"&6Treaty of Sustained Volley"
		"&7You cannot feign perfect accuracy.&r&cMissing a shot removes all draw speed gains, instead reducing this attribute"
		"&7Precision is key.&r&aDealing ranged damage speeds up the draw speed of most ranged weapons"
	]
	quest.5394037EDC7769D9.quest_subtitle: "Becoming the Arrowhead"
	quest.5394037EDC7769D9.title: "Treaty of Sustained Volley"
	quest.53C821423589F530.quest_desc: [
		"Please do not summon during the day. The Skeleton King enters a berserk state during the day, with extremely high defense and massively increased damage that can oneshot players."
		""
		"Defeating him unlocks Nether Gobber ore."
	]
	quest.53C821423589F530.quest_subtitle: "Stage 1, unlocks Stage 2 after kill"
	quest.54207C49530C50BC.quest_desc: [
		"&6World Difficulty&r"
		"&7You may or may not have noticed that changes to world difficulty are not just simple name changes.&r"
		"&7It affects mob spawn health, damage, and other attributes.&r"
		""
		"&7&6Classic Mode&r&7：Default values.&r"
		""
		"&7&6Expert Mode&r&7：&r"
		"&7Health, Attack, Armor x&c1.2&r"
		""
		"&7&6Master Mode&r&7：&r"
		"&7Health, Attack, Armor, Armor Toughness, Tracking Range x&c1.5&r"
		"{image:kubejs:textures/gui/difficuity_kjs.png width:180 height:50 align:center fit:true}"
		"&dSo... pal... if you can't handle it, don't turn up the difficulty...&r"
	]
	quest.54207C49530C50BC.quest_subtitle: "Nobody reads the essential reading.png"
	quest.54DAB6324FA151F2.quest_desc: [
		"&7The book expelled by the well seems to have changed; though it's my record of research, countless shadows have appeared on it."
		""
		"&7I need to concentrate to see the shadows clearly. They are also paper-like existences, tangible yet intangible, like... spirits."
		""
		"&7These shadows are linked to the notes of my research, like annotations or guidance; the content written on them is familiar yet strange."
		""
		"&z&mI have seen the truth"
	]
	quest.54DAB6324FA151F2.quest_subtitle: "Falling into Darkness"
	quest.54DCDB42738F0557.quest_desc: [
		"&6Mandate of the Inverted Heart&r"
		""
		"&7Your soul is the world's soul. Your heart is the world's heart. Open your heart, for all to see, and for all to control.&r"
		"&7-&cMagic Damage&r&7 taken quadrupled&r"
		""
		"&7Mandate—the treaty between your form and the world's original.&r"
		"&7-Your soul is open to the world; if other souls see your soul, an &eConnection&r is established&r"
		"&7-Damage you take and deal is &bShared&r with them&r"
	]
	quest.54DCDB42738F0557.quest_subtitle: "Forging Many Hearts into One"
	quest.54DCDB42738F0557.title: "Mandate of the Inverted Heart"
	quest.54F1765FA7F3571B.quest_subtitle: "Rare Treasure"
	quest.551FB78D5B444E41.quest_desc: [
		"&6Arcane Restoration"
		"&7The &bSpirit Crucible&r&7 has an annoying quirk—it damages the tools that interact with it. Even if the cost of using the crucible is inevitable, I'd rather pay in installments. I designed this instrument called the \"&6Repair Pylon&r&7\" to repair tools when they break."
		"&7"
		"&7The Repair Pylon requires a large amount of &eArcane Energy&r&7 and suitable materials for repair. Once items are prepared, the pylon searches for damaged items in nearby item stands, item pedestals, and spirit crucibles. Theoretically, it should be possible to repair items using only Arcane Energy... but for now, that's just theory."
		"&7"
		"{@pagebreak}"
		"&6Repairing Tools"
		"&7The Repair Pylon isn't limited to repairing Focus Tokens. Many mundane tools—even magical ones—can be repaired this way without consuming experience, simply swapping the driving force of repair from intellect to &dSpirits&r&7. Of course, this process still requires supplying repair materials and restores about half the durability."
		"&7"
		"&7If the equipment's material can resonate with &dSpirits&r&7—directly or indirectly related to spirits—then such repair methods are more efficient. Most tools and armor recorded in this book can restore three-quarters of their durability, not half."
	]
	quest.551FB78D5B444E41.quest_subtitle: "Mysterious Repair"
	quest.551FB78D5B444E41.title: "Arcane Restoration"
	quest.5538FE04FFC149D5.quest_desc: [
		"As an upgraded version of the bookshelf, the Ocean Bookshelf provides a higher enchanting cap than an ordinary bookshelf. Magic from the deep sea grants the bookshelf additional &5&lArcana&r&r."
		"{@pagebreak}"
		"&oPS: You can check the pufferfish in JEI&r"
	]
	quest.5538FE04FFC149D5.quest_subtitle: "Arcana's Blessing"
	quest.5538FE04FFC149D5.title: "Deep Sea Enchanting Power – Gazing into Mystery"
	quest.553B4B865F0C526B.quest_desc: ["Want to remove curses from weapons? The properties of Prismarine Spider Web can strip away and adhere curses—though no one knows how it works."]
	quest.553B4B865F0C526B.quest_subtitle: "Remove Curses"
	quest.5543C9B27A71B835.quest_desc: [
		"&7Fire is the foundation, and metal is the pillar. With iron, I can forge my own weapons and equipment. I can piece materials together and hang them on myself for protection, or simply press iron sheets into makeshift weapons, but this is obviously a waste of materials, only suitable as a stopgap. What I truly need is a &6blazing blast furnace&7."
		""
		"&7While searching for iron, I found some familiar crystals, exactly the raw material needed for Hardened Steel. I think I'll soon be able to craft my own equipment."
	]
	quest.5543C9B27A71B835.title: "Metal Smelting"
	quest.55566ED56D9E8281.quest_desc: ["This summoning ritual can only be performed within the Cursed Garden."]
	quest.55566ED56D9E8281.quest_subtitle: "Moonvine Colossus"
	quest.55566ED56D9E8281.title: "Summoning Ritual"
	quest.555729244B7C2153.quest_desc: [
		"&6Magic Essence&r"
		"&7A consumable used to increase &bSpell Potency&r&7 and &bSpell Resistance&r&7. Each type has 3 tiers and a usage limit. Obtained via:&r"
		"&7Potency: Dropped by &emagical creatures&r&7, upgraded via &6rituals&r&7.&r"
		"&7Resistance: Obtained via the &eShrinker&r&7, upgraded via &6rituals&r&7.&r"
	]
	quest.555729244B7C2153.title: "&6Magic Essence: Potency&r"
	quest.558E23816B266EF8.title: "Glow Leech"
	quest.55A1FBEF21D0FE68.quest_subtitle: "Stage 2"
	quest.55A79D65F67123C4.quest_desc: [
		"&6Skybind Rune&r"
		""
		"&7The Skybind Rune's ability is similar to the ritual of the same name, granting the wearer the &bSkybind&r&7 effect at half strength, increasing &aJump Height&r&7, slightly reducing &aGravity's&r&7 effect, and very slightly reducing &cFall Damage&r&7.&r"
	]
	quest.55A79D65F67123C4.quest_subtitle: "Ascending Pulse"
	quest.55BA0F294A5D2F55.quest_desc: ["&7A flower infused with magic that replenishes the required energy for a spell when a caster selects it but lacks mana.&r"]
	quest.55BA0F294A5D2F55.quest_subtitle: "Auto-Recovery"
	quest.568D517E18953F2F.quest_desc: [
		"&6Crimson Essence&r"
		""
		"&7When there is water, the Alchemical Cauldron inflicts &cdamage&r&7 to creatures inside. If there is an empty potion slot, it will attempt to generate &cBlood&r&7. Use a glass bottle to right-click and collect, obtaining &cCrimson Essence&r&7.&r"
		""
		"&8Immerse the still-beating sin into this boiling cauldron of judgment. Wait for the crimson to struggle and precipitate from the gap between life and the liquid's surface, then you may hold a bottle to receive it—that is the concentrated negation condensed from sin's resentment, an extracted and stripped proof of ‘life’ still bearing warmth.&r"
	]
	quest.56B761C2894F3C2E.quest_desc: [
		"&6Spirit Jars"
		"&7A simple application of Hallowed Gold is the &6Spirit Jar&r&7."
		""
		"&7Spirits in their raw form have no mass, and containing them under &eHallowed Gold&r&7 is a good method to store them &bwithout physical constraints&r&7."
		""
		"&7These jars have &aNearly Unlimited&r&7 capacity, but they can only store &cOne Type of Spirit&r&7."
		""
		"Simple and practical spirit storage technology that can save a lot of storage space"
	]
	quest.56B761C2894F3C2E.quest_subtitle: "Arcane Archive"
	quest.56B761C2894F3C2E.title: "Spirit Storage"
	quest.56CB359C8D5426A3.quest_desc: ["Please note: this is for setting difficulty. N1 is not the starting difficulty. To remove difficulty settings, use the &6Clear Difficulty Settings&r below."]
	quest.56CB359C8D5426A3.quest_subtitle: "Abandon all hope, ye who enter here."
	quest.57045442B4763EC9.quest_subtitle: "Swimming Champion"
	quest.571979CF7DC3291C.quest_desc: [
		"&#FFD700Pride - Erosion&r&7"
		"&7When carrying the 'Scorn' effect, it is considered to apply &#FFD700Scorn Count&r&7.&r"
		"&#00FFAA[When attack hits]&r&7 If you have the &#FFAA00Scorn&r&7 effect, increase &#FFD700Scorn Count&r&7 by 1 stack (duration 5 seconds).&r"
		"&#00FFAA[Scorn Count ≥ 2 stacks]&r&7 Apply 1 level of &#FFD700Armor Break&r&7 to the target (duration 30 seconds).&r"
		"&#00FFAA[Scorn Count ≥ 4 stacks]&r&7 Apply 2 levels of &#FFD700Armor Break&r&7 to the target (duration 30 seconds).&r"
		"&#00FFAA[Scorn Count ≥ 6 stacks]&r&7 Apply 3 levels of &#FFD700Armor Break&r&7 to the target (duration 30 seconds).&r"
		"&#00FFAA[Scorn Count ≥ 8 stacks]&r&7 Apply 4 levels of &#FFD700Armor Break&r&7 to the target (duration 30 seconds).&r"
		"&#00FFAA[Scorn Count ≥ 10 stacks]&r&7 Apply 5 levels of &#FFD700Armor Break&r&7 to the target (duration 30 seconds).&r"
		"&7"
		"&#00FFAA[Per stack of Scorn Count]&r&7 Increases your attack damage by 10%, but reduces attack speed by 5% (max attack speed reduction 50%).&r"
	]
	quest.571979CF7DC3291C.title: "Pride Erosion"
	quest.5731A86EC589BF22.quest_desc: [
		"&7Are you tired of placing &bblocks&r&7 one by one?&r"
		"&7Don't worry! The &bBuilder's Wand&r&7 can place multiple blocks at once!!!&r"
		""
		"&7Whether you're a skilled &barchitect&r&7 or just have simple building needs, it's highly worth using!&r"
	]
	quest.5731A86EC589BF22.quest_subtitle: "Artisan's Craft"
	quest.57D76B1B33C57F9F.quest_desc: ["Even though you've swum so long you probably don't lack these, I'm still giving them to you because I don't know what else to give... Some aquatic specialties, I guess."]
	quest.57D76B1B33C57F9F.quest_subtitle: "Then tell me, why didn't I just take a boat?"
	quest.5883458218829D00.quest_desc: ["&7The Pro Max version of Soul-Steeped Steel. High cost, powerful effect. The Primordial Malice modifier provides a large amount of soul shield and scythe proficiency."]
	quest.5883458218829D00.quest_subtitle: "Stack the Thickest Armor"
	quest.589CD98F3C3AA8D3.quest_desc: [
		"&e\"Running fast doesn't guarantee winning; not falling is true success\"&7"
		"&7With a philosophy of stability and caution, Quadcopters have achieved a perfect zero-accident record. As for the cost... well."
		""
		"&7Suitable for hovering and assisting with building projects—very stable but also very slow. Since the aircraft is considered silent, it can also hold its own when messing with Wardens in ancient cities."
	]
	quest.58BCF9F1BE8BAA5E.quest_desc: ["&7When it falls again, the power sealed within seems to dissipate... I must investigate and see what traces are left."]
	quest.58CA43B9AA0530E2.quest_subtitle: "Stage 2"
	quest.58DE58D4F8290C1C.quest_desc: [
		"&7This item was obtained by chance during my travels."
		""
		"However, with my current superficial knowledge, I cannot yet comprehend the mysteries hidden within."
		""
		"&7To preserve myself in such circumstances, I must possess some reliance. The knowledge sealed within this scroll may be the key."
		""
		"&8\"To me, this is an unsolvable riddle, a door without a keyhole. Yet I need it to become a key—if only to briefly push open this encroaching darkness.\""
	]
	quest.58DE58D4F8290C1C.quest_subtitle: "Novel Power"
	quest.58DE58D4F8290C1C.title: "Magic Scroll"
	quest.58FD71F9C065E1AC.quest_desc: ["&7Feeling lucky?&r"]
	quest.58FD71F9C065E1AC.quest_subtitle: "Random Spell + Random Tier"
	quest.591B10BC5FA20823.quest_desc: ["&7Can be used to locate ancient cities. Although the Deep Dark has certain generation patterns, having a Deep Dark doesn't guarantee an ancient city, hence the need for locating methods. The structure of ancient cities has changed significantly compared to vanilla—they are more open and the loot is richer, but Sculk Shrieker might also be hiding in dark corners, so caution is still needed."]
	quest.593ABE7FAC454B34.quest_desc: [
		"&6Ailment Purge Rune&r"
		""
		"&7The Ailment Purge Rune urges the form to catalyze, transform, and alter substances, speeding up the processing and dissolution of &cNegative Effects&r&7, overcoming them at a speed beyond normal.&r"
	]
	quest.593ABE7FAC454B34.quest_subtitle: "Pulse That Promotes Processing"
	quest.5A46895D552BC15F.quest_subtitle: "Am I not feeling energetic? I feel perfectly fine though"
	quest.5A5CB66A9C32EDDA.quest_desc: ["&7This is not any place you know, but at least you're alive, and you must stay alive."]
	quest.5A5CB66A9C32EDDA.title: "Chaotic Wasteland"
	quest.5A8ACB926DFAB615.quest_subtitle: "You will receive a starter kit."
	quest.5A8ACB926DFAB615.title: "&a\"Honey that Masks Suffering at the Beginning?!\""
	quest.5A8B3E256CCCB82C.quest_desc: [
		"&7Building a blast furnace is the foundation for metal smelting and casting. Although I never imagined needing to build one in the wild, it's not actually difficult for me."
		""
		"Fortunately, I had the good habit of taking notes while studying metallurgy. The notes at least contain the specific components and requirements for building a blast furnace. I call it &6'Complete Guide to Metallurgical Techniques'&7."
		""
		"&0The bad news is, why does it only note how to build the furnace and nothing else? What's so 'complete' about it..."
	]
	quest.5A8B3E256CCCB82C.title: "The Situation Demands It, Fire Up the Furnace!"
	quest.5A8B7CD00226572C.quest_subtitle: "Stage 1"
	quest.5AEF01E9FF0A0727.quest_desc: [
		"&bAn upgraded version of the Lead"
		""
		"&bLeft-click an animal (ineffective on other entities) to capture it inside. Right-click the ground to release."
		""
		"&dNo one knows the internal mechanics of this rope... not even Endermen."
	]
	quest.5AEF01E9FF0A0727.quest_subtitle: "Poké Ball"
	quest.5B941F073DDCD277.quest_subtitle: "Consuming Twisted-type products will increase sanity instead of decreasing it."
	quest.5B941F073DDCD277.title: "&a\"Sweet Dew Blooming from Filth\""
	quest.5BDB153064430D05.quest_desc: [
		"&6Research: Aura Ember"
		"&7After passing through the &dWeeping Well&r&7, &eBlaze Powder&r&7 transformed into a substance I call \"&6Aura Ember&r&7\". Ethereal golden flames, yet also solid, tangible objects. They burn like charcoal, but their flames are unrelated to the combustion process."
		"&7"
		"&7Despite this brilliant substance standing out among all materials retrieved from the well, it still follows a similar pattern. The well strips away certain components of the input material—impurities, material components, something more esoteric—any of these are possible. In this case, what seems stripped away is everything except pure fire, producing an incarnation of change."
		"&7"
		"{@pagebreak}"
		"&6Revisiting: Aura Ember"
		"&7Contrary to my previous conception, the well does not strip things away. Rather, it &cReverses&r&7 them, replacing them with void-like similar matter. Aura Ember is probably the purest example of this: everything not belonging to the &cEssence of Evolution&r&7 is shrouded in a veil of void darkness, producing material &aFar&r&7 more perfect than merely \"suited for a purpose\"."
	]
	quest.5BDB153064430D05.quest_subtitle: "Essence of Evolution"
	quest.5C10F3B6A94BA227.quest_desc: [
		"&7In short, iron is mundane. Tuning iron with &6Soulstone&r&7 creates a type of steel that is both in-phase and out-of-phase with the world—&5Soulstained Steel&r&7."
		""
		"&7Anything made of &5Soulstained Steel&r&7 inherently possesses the ability to shatter souls, without needing the precise craftsmanship of a scythe."
		""
		"&6But directly wearing armor made solely of Soulstained Steel is quite dangerous, as my own soul would also be affected. A countermeasure is needed."
	]
	quest.5C10F3B6A94BA227.quest_subtitle: "Forging Reality"
	quest.5C65959659507556.quest_desc: ["This item affects the spawner's minimum spawn delay. A lower value means the shortest possible time between spawns is shorter, but the effect is less noticeable than the maximum delay; both need to work together. One item affects the time by 10 ticks. Minimum is 20 ticks."]
	quest.5C65959659507556.quest_subtitle: "I can't wait"
	quest.5C6B5AC7571785F6.quest_desc: [
		"&6Rotation Speed Controller&r"
		""
		"&6Usage&r"
		"&7Before use, place a &eLarge Cogwheel&7 on top. Both the top cogwheel and the controller's bottom shaft can serve as stress input or output.&r"
		""
		"&7Aim at the controller's RPM display interface and long right-click to precisely adjust output &aRPM&7 and &aRotation Direction&7.&r"
		""
		"&7If power enters via the bottom shaft, the controller controls the top cogwheel's RPM and direction. If power enters via the top cogwheel, it controls the bottom shaft's output.&r"
		""
		"&7You can think of it as an automatic transmission—but note: when setting high output RPM, ensure the power source's &cStress&7 is sufficient to avoid overload.&r"
		""
		"&8This page of the manuscript is torn.&r"
	]
	quest.5C6B5AC7571785F6.quest_subtitle: "A transmission component that can maintain constant RPM"
	quest.5CF40BE797380E84.quest_desc: [
		"Holding a scythe and killing creatures easily harvests their souls, quickly obtaining &6Spirits&r. Harvested spirits automatically fly towards the player."
		""
		"Different creatures yield different spirits based on their soul essence. Try killing various creatures to obtain more types."
		""
		"{@pagebreak}"
		""
		"&7After many failed attempts, I successfully embedded &6Soulstone&r&7 into a weapon and could stably &6Harvest Spirit Crystals&r&7."
		""
		"&7Its long blade allows enough time for the physical death before the soul is struck, and grants it the ability for wide &cSweeping Attacks&r&7. It is not as sharp as a sword, but sufficient for my needs."
		"{@pagebreak}"
		"&7What previously required careful, laborious experiments, the scythe accomplishes in seconds. The souls of the monsters I kill shatter upon impact, delivering some richly colored substance—&6Spirit Crystals&r&7—into my hands. Finally, my research can truly begin."
	]
	quest.5CF40BE797380E84.quest_subtitle: "Harvest"
	quest.5CF40BE797380E84.title: "Any Scythe"
	quest.5D095029A0B8B414.quest_subtitle: "mcmod.cn"
	quest.5DEF70A03509B309.quest_desc: [
		"In Apotheosis, your spawner is highly customizable. You can adjust it according to your needs."
		"Adjustments are divided into two aspects: Spawn Target Adjustment and Spawner Attribute Adjustment."
		"{@pagebreak}"
		"Spawn Target Adjustment requires using a Spawn Egg or an Apotheosis Magma Rope with a captured entity by right-clicking the target spawner. Spawn Eggs can be obtained using the Capturing enchantment, while Apotheosis Magma Ropes are obtained through crafting. &4Please note: For balance reasons, both methods have certain limitations.&r"
		"Spawner Attribute Adjustment requires right-clicking the spawner with the corresponding adjustment item, consuming the item to adjust the spawner's attributes. Subsequent tasks will detail adjustment items."
	]
	quest.5DEF70A03509B309.quest_subtitle: "Creature Energy Adjustment"
	quest.5E01EC2AC8CE43F0.quest_desc: [
		"&6Graveyard&r"
		"&7This new structure belongs to the &8Soul Sand Valley&r&7, a realm where &cDeath&r&7 reigns. &cNecromancers&r&7 are naturally drawn to such places, so you are sure to find them here.&r"
	]
	quest.5E01EC2AC8CE43F0.title: "&6Graveyard&r"
	quest.5E313592ACB65BC2.quest_desc: [
		"&7Gobber's unique properties allow it to carry the abilities contained in other objects. Crafting it into medals and rings enables absorption of other objects, thereby activating the corresponding effects for extended periods. Please check JEI for specific recipes. It's worth noting that even rings do not need to be worn; once activated and placed in an Ender Chest, they remain effective."
		""
		"&7Note: The effect of a low-tier Healing Medal is to slowly restore saturation for the player."
	]
	quest.5E313592ACB65BC2.title: "Gobber Medals/Rings"
	quest.5E3276B22F0E8C6D.quest_desc: ["&7Crimson Iron ore can be found in the Nether. It's a common material with somewhat mediocre stats. When combined with Blaze Rods, it can be crafted into Crimson Steel... although its stats remain unremarkable, it can be used to construct some special tools."]
	quest.5E3B1B0AB352F0F3.quest_subtitle: "Familiar Summoning Ritual"
	quest.5E513FFD985CDDF9.quest_desc: [
		"&6Golem Forge&r"
		"&7Is a large underground structure guarded by the &cStarlight Golem&r&7."
		""
		"&7The Golem Forge usually generates within the &8Voidstone Layer&r&7 at Y<0, mainly constructed from &8Voidstone&r&7, &#C0C0C0Golem Steel&r&7, and &#8B7355Oxidized Golem Steel&r&7 decorative blocks."
		"&7The interior of the structure is composed of many &8Narrow Passages&r&7 connecting various rooms filled with &#FF4500Lava&r&7 below."
		""
		"&7Some rooms contain &bFrozen One Spawners&r&7, and these rooms also have a high probability of generating &6Loot Barrels&r."
		"&7You can use the &eSeeker's Eye&r&7 to locate this structure."
	]
	quest.5E513FFD985CDDF9.quest_subtitle: "Once a sanctuary for countless lives, now only broken walls and ruins remain silent in the wind and sand."
	quest.5E513FFD985CDDF9.title: "Golem Forge"
	quest.5E69573B6AA70AFA.quest_desc: [
		"&6Accelerating Lining&r"
		""
		"&7The Accelerating Lining, utilizing components with excellent mana conductivity from bizarre fabrics, greatly increases the &aFocus Speed&r&7 of the &eCrucible&r&7, with no negative side effects.&r"
	]
	quest.5E69573B6AA70AFA.quest_subtitle: "Doubling Down"
	quest.5E69992403F40955.quest_subtitle: "Familiar Summoning Ritual"
	quest.5F1C1AA992472C3D.quest_desc: [
		"&6Heretical Rune&r"
		""
		"&7The Heretical Rune dismantles magic, &cSilencing&r&7 enemies, similar to the Erosion Scepter. This effect weakens their &eSpirit Magic&r&7 and can stack to completely suppress the opponent's &cMagical Ability&r&7.&r"
	]
	quest.5F1C1AA992472C3D.quest_subtitle: "Destroying That Which is Created"
	quest.5F253340FE9F4FCF.quest_desc: [
		"&7With many new materials unlocked, it's time to upgrade your equipment. Try more alloy combinations and select materials based on your needs."
		""
		"&7Many of the tier 1 materials recommended in the Silent Gear chapter are still usable. Balancing material modifiers and values under the powerful alloy system is necessary. While incorporating as many modifiers as possible, you also need to comprehensively consider armor values/damage and other attributes."
	]
	quest.5FFB29607E15D805.quest_desc: [
		"&6Treaty of Defiance"
		"&7Magic has transformed your perception of death: damage becomes more &cPainful&r&7.&r&cMaximum health reduced by one-fifth"
		"&7The form is infused with unnatural regenerative abilities: an eternal &aDesire&r&7 to &aGrow&r&7.&r&aHealth regeneration from saturation becomes twice as fast, tripled when near death&r&aHealing received increased by four-tenths"
	]
	quest.5FFB29607E15D805.quest_subtitle: "Defying Limitations"
	quest.5FFB29607E15D805.title: "Treaty of Defiance"
	quest.6038063D7681AFB5.quest_subtitle: "Food Value >= 14"
	quest.6038063D7681AFB5.title: "Feast Recycle x32"
	quest.609ED89F7E454DCA.quest_desc: [
		"&eThe energy within is exceptionally volatile."
		"&6Doubled speed, surging high temperature, a leap in performance."
		""
		"⚡ Speed: 2.0x | ♨ Temperature: 4000 | ⏳ Consumption: 0.2"
		""
		"&aTip&r&7: &f♨ &r&7Temperature determines the grade of materials that can be processed, ⚡ Speed affects processing time, ⏳ Consumption represents fuel longevity."
	]
	quest.609ED89F7E454DCA.quest_subtitle: "Excessive Combustion"
	quest.60BAD1C5ADE6C33A.quest_desc: [
		"&6Research: Malice's Lead"
		"&7After passing through the &dWeeping Well&r&7, &eDeeprock Precious Gold&r&7 converts into &cMalice's Lead&r&7. The various arcane energies bound to gold mostly transform into &cWicked Arcane Energy&r&7, causing this metal to fall from the alchemist's altar to become the lowliest of materials."
		"&7"
		"&7The arcane energy within the metal also roughly halves. Was it stripped away by the well, or transformed into something I haven't yet separated and identified? Both are possible. This might be related to the arcane interaction abilities displayed by &8Void Slate&r&7..."
		"&7"
		"{@pagebreak}"
		"&6Revisiting: Malice's Lead"
		"&7Currently, I only have &cMalice's Lead&r&7 as a method to examine the physical form of &8Umbral Crystals&r&7—precisely having lost half its arcane mass, what other cause could there be?"
		"&7"
		"&7Separating the microcrystals within &eDeeprock Precious Gold&r&7, and the wicked crystals within &cMalice's Lead&r&7, has yet to yield results. But until I can obtain more material, this is the best avenue to research the structure of &8Umbral Arcane Energy&r&7."
	]
	quest.60BAD1C5ADE6C33A.quest_subtitle: "Turning the Miraculous into the Dull"
	quest.60BBE14FB14FB583.quest_desc: [
		"&7This bookshelf is different from previous ones. You can place books inside it yourself, like a Chiseled Bookshelf, but it exhibits precise and powerful magical isolation. &eDuring enchanting, it will completely block any enchantments stored within (for books with multiple enchantments, only the first enchantment is blocked)&7, preventing the enchantment table from offering those enchantments."
		""
		"&7What is this? I sense a maternal love here. Like an overindulgent mother, it strips away everything you don't want."
	]
	quest.60BBE14FB14FB583.quest_subtitle: "Like an Infant in Mother's Arms"
	quest.60BBE14FB14FB583.title: "Embrace of the Ocean"
	quest.60C42244ED37BA5F.quest_desc: [
		"&7It seems this world is not as tranquil as I had envisioned. The strange powers continuously emerging are entirely beyond my previous understanding..."
		""
		"Perhaps I should call it ‘magic’?"
		""
		"&7Fortunately, there are still a few scrolls in my pack, which may contain clues to guide the way forward."
	]
	quest.60C42244ED37BA5F.quest_subtitle: "Magical Creations"
	quest.61365E0F2831F348.quest_desc: ["&7Obtained by entering the Starlight Dimension and seeking out the Frozen Magic Forest. Can be used as a handle material, providing a good bonus for low attack speed weapons."]
	quest.61365E0F2831F348.quest_subtitle: "Swift"
	quest.613D2E97D95993FF.quest_subtitle: "Mother's Tenderness"
	quest.61AD6CC3CE0AC9F4.quest_subtitle: "Global Options"
	quest.62214066B0F19784.quest_desc: ["Tired of the annoying noises from your slaughterhouse? Sick of hearing the creatures' squeaking? This modification makes mobs spawned by the spawner silent. Reduces noise pollution."]
	quest.62214066B0F19784.quest_subtitle: "SHUT UP!"
	quest.629600F80E05353F.quest_desc: [
		"&7When a Security Manager is added to the storage network, by default, no player can access it."
		""
		"The Fallback Security Card defines permissions for players without a corresponding security card."
		""
		"&7The configuration interface is the same as for Security Cards."
	]
	quest.629600F80E05353F.quest_subtitle: "&mFallback Hidden Abil... Permissions...!"
	quest.62F882E969E15846.quest_subtitle: "Used for casting nuggets"
	quest.62FCCE8BC35F8C17.quest_desc: [
		"&7To overcome the limitations of single-material performance, I developed the Recrystallizer."
		""
		"This device can fuse multiple input items, supporting up to four components. The final crystallized material's parameters vary based on the types and proportions of the input items."
		""
		"&eCalculated based on the main component (the first item in the placement order) and the rarity of each item."
	]
	quest.62FCCE8BC35F8C17.quest_subtitle: "&cImportant Item"
	quest.631BFAA4FFA96698.quest_desc: ["Can directly retrieve items from the network to edit crafting patterns."]
	quest.631BFAA4FFA96698.quest_subtitle: "Crafting Patterns"
	quest.6324F101E1CFA4CA.quest_desc: [
		"&6Glimmer River&r"
		"&7Is a surface biome in the Starlight Dimension."
		""
		"&7Like rivers in the Overworld, it is typically a &8Transitional Biome&r that separates water routes within or between multiple biomes."
		"&7The Glimmer River is narrow and long but eventually flows into the vast &#87CEEBSea of Starlight&r&7."
		""
		"&7The Glimmer River also has some &#9ACD32Abyssal Fruit Plants&r&7 and &#20B2AAAquatic Vegetation&r&7 similar to lily pads."
		"&7Non-aquatic creatures can only spawn dozens of blocks deep underground, away from the Glimmer River—essentially not in the river itself."
	]
	quest.6324F101E1CFA4CA.quest_subtitle: "Glimmer in the Lake"
	quest.6324F101E1CFA4CA.title: "Glimmer River"
	quest.633471475BE20F2E.quest_desc: [
		"&7A material dropped after killing the &#ADD8E6Light Pufferfish&r&7 (mob).&r"
		""
		"Can be used to make ink."
		""
		"&8Does anyone know how he conjured two glass bottles?"
	]
	quest.633B88042B030B5E.quest_subtitle: "The long night... hardest to endure~"
	quest.63423F9C2A3931E5.quest_subtitle: "One Tree at a Time"
	quest.634CBFD54B22E624.quest_desc: [
		"&6Brass Funnel&r"
		""
		"&6Usage&r"
		"&7Its basic usage is almost identical to the Andesite Funnel, with the core difference being finer control: it supports &eitem filtering&7 and can set &ethe number of items transferred per cycle&7.&r"
		"&7In output mode, look at its filter slot and scroll the mouse wheel to adjust the per-cycle output, up to &c64&7.&r"
		""
		"&6Additional Notes&r"
		"&7A Brass Funnel can output up to one full stack per cycle.&r"
		"&7When in downward output mode, it only continues output if it detects no item entities in the block below; if items are piled, it pauses.&r"
		""
		"&8It's smart enough to know when to stop.&r"
	]
	quest.6456C4ED798E5EBD.quest_desc: [
		"&6Crimson Forest&r"
		"&7Is a surface biome in the Starlight Dimension."
		""
		"&7Unlike most biomes, the main color tone of the Crimson Forest is a &#DC143CRed&r&7 with low brightness and saturation, not purple."
		"&7The main tree type in the Crimson Forest is &#DC143CCrimson Tree&r."
		""
		"&7&#FFD700Glow Mushrooms&r&7 (features) are more likely to generate in the Crimson Forest."
		"&7Most plant types that generate on the surface of the Crimson Forest are the same as in Starlight Forest, but there are also a few unique plant species."
	]
	quest.6456C4ED798E5EBD.quest_subtitle: "A polluted forest, slowly purifying itself."
	quest.6456C4ED798E5EBD.title: "Crimson Forest"
	quest.6495C96750D3BA0C.quest_desc: ["&7Some aircraft models can mount weapons, but generally, aircraft don't really need combat capabilities. Among them, the Bomb Bay offers decent damage output but also has higher consumption."]
	quest.64AC4146C392E8A6.quest_desc: [
		"&#CC88FFEnvy - Erosion&r&7"
		"&7When carrying the 'Envy' effect, it is considered to apply &#CC88FFEnvy Count&r&7.&r"
		"&#00FFAA[When attack hits]&r&7 If you have the &#FFAA00Envy&r&7 effect, transfer all status effects from the target to yourself (single effect transfer up to 200 ticks). Upon successful transfer, increase &#CC88FFEnvy Count&r&7 by the number of transferred effects.&r"
		"&#00FFAA[Every 2 seconds]&r&7 &#CC88FFEnvy Count&r&7 stacks decrease by 1 (minimum 0 stacks).&r"
		"&7"
		"&#00FFAA[When dealing damage]&r&7 If you have the &#FFAA00Envy&r&7 effect, increase this damage by (&#CC88FFEnvy Count&r&7 × 3%) times, up to a maximum of 2 times.&r"
	]
	quest.64AC4146C392E8A6.title: "Envy Erosion"
	quest.64E40E59C864874C.quest_desc: [
		"&6Meteor Shower&r"
		"&7Is a special weather event that can only occur in the &bStarlight Dimension&r&7, with a relatively low probability."
		""
		"&7During a Meteor Shower:"
		"&7Several meteors with &dPurple Trails&r&7 descend in straight lines, striking the ground and dealing &cDamage&r&7 to creatures within one block."
		"&7Resource-containing &eMeteorites&r&7 also have a chance to strike down in the same way. Upon hitting the ground, they cause an &cExplosion&r&7 (does not destroy terrain) and emit particles."
		""
		"&7After a meteorite strikes, it has a chance to produce only &b8 pieces&r&7 of &6Coarse Celestial Ore&r."
		"&7It also has a chance to generate several resource blocks composed of &eNebula Stone&r&7 and &6Coarse Celestial Block&r&7 at the impact location."
		"&7After a meteorite strikes, there is a chance for a &cBitter Cometspook&r to spawn on the spot."
		""
		"&7Players in Survival mode can craft and launch &bStar Attractor Rockets&r&7 to actively trigger Meteor Shower events."
		"&7&8Small Bitter Cometspooks&r&7 will begin to spawn naturally in any low-light areas of the Starlight Dimension during a Meteor Shower event."
		"&7You can construct &aCelestial Golems&r&7 to intercept meteorites falling towards the ground."
	]
	quest.64E40E59C864874C.quest_subtitle: "Sometimes meteor showers occur here. During a meteor shower, countless meteors streak across the night sky, creating a beautiful spectacle..."
	quest.64E40E59C864874C.title: "Meteor Shower"
	quest.651B146F0F9BEA1D.quest_desc: [
		"&6Powered Press&r"
		""
		"&6Pressing&r"
		"&7Processes item entities or items on a &eConveyor Belt/Depot&r&7 via pressing recipes.&r"
		"&7Primarily used to turn metal ingots into &eMetal Sheets&r&7.&r"
		""
		"&6Shaping&r"
		"&7Processes items inside a &eMixing Basin&r&7 via shaping recipes.&r"
		"&7Used to craft products from multiple ingredients.&r"
		""
		"&6Auto-Compacting&r"
		"&7Processes items inside a &eMixing Basin&r&7 via compacting recipes.&r"
		"&7Used for &c4*4&r&7 or &c9*9&r&7 single-material crafting recipes.&r"
	]
	quest.65823964A5871AED.quest_desc: ["&dCompared to the previous generation, this version is much more stable, capable of containing even some resisting creatures... Handle them as you wish.&r"]
	quest.65823964A5871AED.quest_subtitle: "Master Ball"
	quest.65B3DDCC5C5B7361.quest_desc: [
		"&6Deployer&r"
		""
		"&6Usage&r"
		"&7The Deployer has two modes: Use and Attack. Toggle with a wrench.&r"
		""
		"&6Use Mode&r"
		"&7Default is Use/Place mode, simulating player right-click behavior.&r"
		"&7It can place blocks, operate doors, shear sheep, etc., essentially performing any action possible via right-click in Survival.&r"
		"&7When given tools or items, enchantments apply and durability is consumed; giving food feeds creatures.&r"
		""
		"&6Attack/Destroy Mode&r"
		"&7Simulates player left-click, attacking creatures and breaking blocks. When given weapons or tools, enchantments apply but durability is consumed.&r"
		"&7Creatures killed by it are considered player kills, dropping appropriate items and experience.&r"
		"&7Its attacks are always fully charged, regardless of working speed.&r"
		""
		"&6Operation Mechanism&r"
		"&7When powered, its forearm extends/retracts rhythmically, performing one use/attack action at full extension.&r"
		"&7Full cycle: Extend → Use/Attack → Retract → Wait.&r"
		"&7Cycle frequency depends on RPM. Effective RPM range is &c4 RPM&7 to &c256 RPM&7; beyond this, speed changes don't affect efficiency.&r"
		"{@pagebreak}"
		"&7Its target is always the block or entity in the second block directly in front, unaffected by intervening blocks.&r"
		"&6It stops working under these conditions:&r"
		"&7Item overflow;"
		"&7No power;"
		"&7Held item is the item form of the target block;"
		"&7Held item is a bucket of the target fluid;"
		"&7Receives a redstone signal (if active during a cycle, waits for completion before stopping).&r"
		""
		"&6Item Storage&r"
		"&7Has internal storage for one stack. Items can be input/output via logistics components.&r"
		"&7Place an item or filter in its filter slot to mark items not to be output.&r"
		"&7When performing actions that yield drops (shearing, breaking blocks, killing), products go directly into its storage. If storage already contains items, it enters overflow state.&r"
		""
		"&6Item Overflow&r"
		"&7Overflow occurs in two cases:&r"
		"&7It stores more than one type of item;"
		"&7Internal items don't match the filter slot setting.&r"
		"&7In overflow, it stops working; must remove excess via logistics to resume.&r"
		"&7Placing the tool in use in the filter slot prevents accidental output.&r"
		"{@pagebreak}"
		"&6Feeding/Breeding&r"
		"&7In Use mode, it can consume held food to feed creatures or players. Creatures enter breeding mode; players restore hunger/saturation and gain food effects.&r"
		""
		"&6Item Processing&r"
		"&7Place above a Depot or Conveyor Belt to process items on it. See specific usage guides.&r"
		""
		"&6Contraptions&r"
		"&7Deployers on moving contraptions still work, but held items aren't displayed.&r"
		"&7Right-click a contraption Deployer to give items directly; wrench to toggle mode.&r"
		"&7Deployers on contraptions can automatically take items from the contraption's storage and send overflow items back.&r"
		"&7When a deployed blueprint is in the filter slot, it follows the blueprint to place blocks from contraption storage, enabling systems like ‘&e3D Printers&7’.&r"
		""
		"&8It can do what you do—just more stubborn and tireless.&r"
	]
	quest.65B599AA9888FBF2.quest_desc: [
		"&6Stellar Mechanism&r"
		""
		"&7Harnessing the harmonic crystals forged in the depths of stellar cores, the Stellar Mechanism unconditionally stabilizes the fundamental framework of the &eTuning Process&r&7, permanently enhancing its strength."
	]
	quest.65B599AA9888FBF2.quest_subtitle: "Stellar Blessing"
	quest.660EAD8BBC2734CA.quest_desc: [
		" &#FFAA00Sloth - Erosion&r&7"
		"&7Normal attack multiplier is &#00AA000.8x&r&7, and you have &#00AA0035% damage reduction&r&7.&r"
		"&#00FFAA[When taking damage]&r&7 If you have the &#FFAA00Sloth&r&7 effect, accumulate the damage taken. When accumulated damage reaches (10 + 5 × Sloth level) points, enter the &#FFAA00'Bedhead'&r&7 state (duration 100 seconds), increase attack multiplier to &#00AA001.0~10.0x&r&7, and reset accumulated damage.&r"
		"&#00FFAA[When flipping a coin]&r&7 If you are in the &#FFAA00'Bedhead'&r&7 state, make the probability of the lowest value (1) the same as the probability of any other single value.&r"
		"&#00FFAA[When attack hits]&r&7 If you are in the &#FFAA00'Bedhead'&r&7 state, remove the &#FFAA00'Bedhead'&r&7 state, and grant yourself &#FF5555Blindness III&r&7, &#FF5555Darkness III&r&7, &#FF5555Bad Luck III&r&7, &#FF5555Slowness III&r&7 (duration 10 seconds), and &#FFAA00Resistance IV&r&7 (duration 9 seconds).&r"
	]
	quest.660EAD8BBC2734CA.quest_subtitle: "Sloth Erosion"
	quest.660EAD8BBC2734CA.title: "Sloth Erosion"
	quest.66481C79877E0ED7.quest_subtitle: "Food Value >= 14"
	quest.66481C79877E0ED7.title: "Feast Recycle x10"
	quest.664DF00DAF0D957A.quest_desc: [
		"&6Fiery Solace Rune&r"
		""
		"&7The Fiery Solace Rune toughens the skin when the wearer is on fire, granting a certain amount of &aResistance&r&7 to all types of damage taken. However, it does nothing about the &cFlames&r&7 that are currently burning.&r"
	]
	quest.664DF00DAF0D957A.quest_subtitle: "Fueling That Which Burns"
	quest.66B362ABCF6C2B8D.quest_desc: [
		"&7Stone resists change, but the energy of an unbound soul is also unstoppable."
		""
		"&7Forcing it to change with &6Primordial Arcane Energy&r&7 creates stone with practical magical properties. Using &bSacred Arcane Energy&r&7 as a catalyst forms &5Foulstone&r&7, a stone that dissolves surrounding magic."
	]
	quest.66B362ABCF6C2B8D.quest_subtitle: "Infused with Arcana"
	quest.66B362ABCF6C2B8D.title: "Spirit Stones"
	quest.66D8D31B50D06630.quest_subtitle: "Hero of the Village...?"
	quest.66E6753DF809DA3D.quest_desc: ["After placing a Pattern into it, you can select and start auto-crafting from within the terminal."]
	quest.66E6753DF809DA3D.quest_subtitle: "Assembly Line Operation"
	quest.66EA89C1E75509EB.quest_desc: ["&eOptional, not a mandatory quest. Does not affect the vast majority of gameplay. Do not enable unless necessary."]
	quest.66EA89C1E75509EB.quest_subtitle: "&6\"Once you take this step, there is no turning back.\""
	quest.66EA89C1E75509EB.title: "&cAdditional Tribulations"
	quest.66F8BBB3BC24A7FF.quest_desc: [
		"&dThis rope, entwined with a bizarre aura, can capture the souls of most creatures..."
		""
		"&5Perhaps paired with a spawner, they could be revived?&r"
	]
	quest.66F8BBB3BC24A7FF.quest_subtitle: "Origin Ball"
	quest.67A539CCFEDE8EBC.quest_subtitle: "Stage 2"
	quest.67D8839DF18183B2.quest_desc: [
		"&6Light Pufferfish&r&7"
		"&7A common aquatic creature in the Abyss; cannot survive out of water (will flop on the spot and gradually lose health over time until death).&r"
		""
		"&7Hold a bucket and right-click the Light Pufferfish: transforms it into item form (&#ADD8E6Light Pufferfish Bucket&r&7) for storage.&r"
		""
		"&7Only retaliates after taking damage, and the attack method is special.&r"
		""
		"&7After the Light Pufferfish takes damage, if the attacker is ≤ 3 blocks away from this Light Pufferfish:&r"
		""
		"&7This Light Pufferfish will swell slightly for 0.5 seconds (wind-up) and then deal damage to the attacker and apply &aPoison I for 3 seconds&r&7.&r"
		""
		"&7If a single instance of damage is enough to kill the Light Pufferfish instantly, it will be unable to perform this attack.&r"
	]
	quest.67D8839DF18183B2.title: "Light Pufferfish"
	quest.67E10AA6F43353E2.quest_desc: [
		"&7During my explorations, I had already noticed this strange structure—a frame of obsidian. Someone had obviously used it for something, because no matter where I went, I encountered broken frames in various forms."
		""
		"&7This time, there was a chest beside the frame containing some worn golden tools and a... lighter?"
		""
		"&7On a whim, I sparked it against the obsidian. The fire caught on the frame like oil, spreading wildly, instantly covering the inside. Then, as if squeezed, it contracted violently towards the center, pulling open a distorted, rippling purple film."
		""
		"&7Maybe I should go in and see?"
	]
	quest.67E10AA6F43353E2.title: "Gate of Purgatory"
	quest.67F1B7217A46DF7E.quest_desc: [
		"&eSeems to faintly echo with screams."
		"&6Low consumption brings long-lasting power."
		""
		"⚡ Speed: 1.0x | ♨ Temperature: 3000 | ⏳ Consumption: 0.1"
		""
		"&aTip&r&7: &f♨ &r&7Temperature determines the grade of materials that can be processed, ⚡ Speed affects processing time, ⏳ Consumption represents fuel longevity."
	]
	quest.67F1B7217A46DF7E.quest_subtitle: "Burning Souls"
	quest.680583B3F5EF1CC2.quest_desc: [
		"&6Caustic Catalyzer&r"
		""
		"&7&cInfernal Fire&r&7 and &bAzure Water&r&7 combine violently, usually driving change and destruction. The Caustic Catalyzer increases &aTuning Strength&r&7 when the destabilization risk of the &eCrucible System&r&7 rises; that is, trading impending violent reaction for powerful force.&r"
	]
	quest.680583B3F5EF1CC2.quest_subtitle: "Destabilizing Blaze"
	quest.681DDFCA829035FB.quest_desc: [
		"Apotheosis is a large general-purpose adventure mod that modifies core Minecraft elements like potions, enchantments, spawners, and equipment to provide more adventure and a higher ceiling across multiple aspects."
		"Here, Apotheosis is divided into several sections. In this modpack, we use the Enchantment Module and the Spawner Module."
	]
	quest.681DDFCA829035FB.quest_subtitle: "Bestowing Upon You a False Divinity"
	quest.68780331B0515EB6.quest_desc: [
		"&6Pact of the Reckless Fist&r"
		""
		"&7Impulses within the soul make you act without thinking.&r"
		"&7-&cSpell Projectiles&r&7 are fired immediately after charging completes&r"
		""
		"&7Impulses fused into form and soul.&r"
		"&7-&aSpell&r&7 charge time halved&r"
	]
	quest.68780331B0515EB6.quest_subtitle: "Never Hesitate"
	quest.68780331B0515EB6.title: "Pact of the Reckless Fist"
	quest.688BD76E40216736.quest_desc: [
		"This change makes the spawner produce baby variants of mobs (if a baby variant exists); otherwise, it has no effect."
		"This upgrade seems most directly useful for obtaining Turtle Shells."
	]
	quest.688BD76E40216736.quest_subtitle: "Don't Want to Grow Up"
	quest.688BD76E40216736.title: "Turtle Egg"
	quest.68954EBEC12D958D.quest_subtitle: "Stage 3"
	quest.68EF2FB94A761FFD.quest_desc: [
		"&aI often hear the term \"Intellect,\" referring to what others call experience."
		""
		"&7Its link to the soul is not strong, &6but it is part of the soul and can be collected and reused for enchanting and repairing."
		""
		"&eWhat most people don't know is that it can also condense into physical form."
		""
		"&7I've heard rumors they drop from ores, but &6the most reliable source is small ore clusters where souls dissipate&f&7, the experience left behind by souls etched onto rock."
	]
	quest.68EF2FB94A761FFD.quest_subtitle: "Experience Materialized"
	quest.6A03DEB0CCE71AF2.quest_desc: [
		"&6Armor Plates&r"
		"&7Consumables used to increase a familiar's &aArmor&r&7. There are 3 tiers, each with a usage limit."
	]
	quest.6A8313927B15ECEE.quest_desc: [
		"&6Thirst Walker&r&7"
		"&7A creature that resembles an &#8A2BE2Enderman&r&7 but lacks the Enderman's &#ADFF2FTeleportation&r&7 ability and &#1E90FFWater Phobia&r&7 weakness.&r"
		""
		"&7The Thirst Walker is a &8Conditionally Hostile Mob&r&7, only performing melee attacks. A successful hit additionally applies &#FF8C00Hunger I for 6 seconds&r&7.&r"
		""
		"&7It has special &#FFD700Aggro Logic&r&7:&r"
		""
		"&7Regardless of whether the player attacks it, an unprovoked Thirst Walker will &#00CED1Actively Follow&r&7 the player and attempt one melee attack.&r"
		""
		"&7This melee attack has a special attack animation (hereafter called the &#DC143CBite Attack&r&7).&r"
		""
		"&7If the bite hits / is blocked by a shield: This Thirst Walker will &#A9A9A9Quickly Flee&r&7 from the player and stop following for a period.&r"
		""
		"&7If the bite misses: This Thirst Walker will continuously attempt melee attacks until it successfully hits once.&r"
		""
		"&7If that player / another creature &#FF4500Attacks&r&7 the Thirst Walker:&r"
		""
		"&7The Thirst Walker becomes &#FF0000Enraged&r&7, immediately treating them as hostile and &#DC143CChasing&r&7 the target to attack until one of them dies.&r"
		""
		"&7Afterwards, the Thirst Walker's attack animation changes to &#808080Swinging Arm Attack&r&7 (the two attacks differ only in animation; actual stats and effects are identical).&r"
		""
		"&7All the above attacks can be blocked with a shield.&r"
	]
	quest.6A8313927B15ECEE.title: "Thirst Walker"
	quest.6ABFDDD6E155A37F.quest_desc: [
		"&6Umbral Snail&r&7"
		"&7Is one of the passive mobs that generate in the Starlight Dimension, with &cExtremely Slow&r&7 movement speed."
		""
		"&7When damaged, it &bRetreats into its Shell&r&7 on the spot:"
		"&7During and after retreating, it cannot move and takes &a85% reduced damage of all types&r&7."
		"&7If it doesn't take damage for a few seconds after retreating, it pops its head back out and resumes previous behavior.&r"
	]
	quest.6ABFDDD6E155A37F.title: "Umbral Snail"
	quest.6AC481C1ADA516D4.quest_desc: [
		"&7When a creature dies, its soul dissipates. This is a foundational theory, and numerous examples have proven its correctness thus far."
		""
		"&7There is also a theory that occasionally this energy lingers within the creature's form at death, which would explain why they drop reagents. But this theory remains unproven."
		""
		"&rCreatures struck by a scyhave have their souls briefly exposed; if they die during this exposure, they drop special items."
		"{@pagebreak}"
		"&7But now, with the assistance of my &5Scythe&r&7, proving this is quite easy. When a soul shatters, its energy collides with the remaining physical shell, even if the contact time is extremely brief."
		""
		"&4This collision can create entirely new reagents, which cannot be produced by simply destroying the form. This phenomenon seems to drive a powerful reaction and cause some kind of transformation."
		""
		"&7I have discovered several reagents born from this process, detailed below."
		"{@pagebreak}"
		"&7In summary:"
		"&7Zombie flesh congeals into &2Rotting Essence&r"
		""
		"&7Skeleton bones crystallize into &8Chill Bones&r"
		""
		"&7Phantom membranes spiral into &bStarlight Fabric&r"
		""
		"&7Wind charge essence persists as &eGale Core&r"
		""
		"&7Enderman magic solidifies into &5Twisted Flux&r"
		""
		"&7Illager remains erode into &#AA4AFFShadow Soul&r"
		""
		"&7Various mages' energies sanctify into &dLight Soul&r"
	]
	quest.6AC481C1ADA516D4.quest_subtitle: "Leaked Magic"
	quest.6AE8CFDBDC8CF939.quest_subtitle: "Crafting Supplies"
	quest.6AF6ADCEE5546549.quest_desc: [
		"&7Previously, I limited spirit magic to enhancing myself and creating materials."
		"&7Now, I will affect the world."
		"Place a Totem Base on the ground and up to five Runewood Poles above it to form a complete Totem Pole."
		"When activated, the Totem Pole may affect nearby &6Environmental Blocks&r; choose the location carefully."
		"{@pagebreak}"
		"&7To activate totem magic, I need to etch &dSpirit Arcane Energy&r&7 into &6Runewood Poles&r&7, forming &bSigils&r&7 representing that energy."
		""
		"Hold a spirit and right-click a Runewood Pole to inscribe it."
		""
		"&7If a sigil is not needed, it can be removed with an axe."
		"&7I have a concept in mind: prepare a Runewood &eTotem Base&r&7, then inscribe a specific combination of sigils onto the &6Totem Pole&r above it to activate a &5Spirit Rite&r&7."
		""
		"&7The functions of various rites differ, but patterns can still be discerned, allowing them to be categorized."
		"&7Spirit Rites may affect the &cSouls&r&7 of nearby creatures or the &dArcane Structure&r&7 of the surrounding physical world."
		"&7Both methods of manifesting spirit arcane power use a kind of \"&bRite Site&r&7\", that is, guided &eEnergy Sparks&r&7 woven by the totem."
		"{@pagebreak}"
		"&6Signal Totem Control"
		"&7The nature of totems dictates their &cChaos&r&7; the order in which multiple simultaneous rites take effect is extremely difficult to keep consistent."
		"&7Inspired by my research into signal artificing, I designed a solution."
		""
		"&7Normally, a spirit rite only activates after gathering sufficient energy from the world's spontaneous arcane flow."
		"&7For a &bSignal Totem Base&r&7, this energy remains in a kind of \"&eStored&r&7\" state until it receives a &cRedstone Pulse&r&7."
		"&7When organizing multiple rites, &6Redstone Observers&r&7 can be used to pinpoint the exact moment a spirit rite can activate."
		""
		"&7The timing for sending a pulse to the Signal Totem Base can be tricky."
		"&7Note that a sustained signal is not necessary; the internal circuit only recognizes the pulse at the start of the signal."
	]
	quest.6AF6ADCEE5546549.quest_subtitle: "&6Miracles Manifested in the World"
	quest.6AF6ADCEE5546549.title: "Totem Magic"
	quest.6B03AFED832B87A7.quest_desc: [
		"&6Sea of Starlight&r"
		"&7Is the most common ocean biome in the Starlight Dimension."
		""
		"&7Unlike oceans in the Overworld, the seabed of the Sea of Starlight is more &#aFlat&r."
		"&7&#9ACD32Abyssal Fruit&r&7 plants and &#87CEEBSea Ball Flowers&r&7 are the main vegetation of the Sea of Starlight."
		"&7Some seas adjacent to land or the Abyss biome generate patches of &#FF6B6BCoral Reefs&r&7 (similar to Warm Oceans in the Overworld)."
		""
		"&7Except for the &#483D8BTower Squid&r&7, other aquatic creatures typically spawn in other ocean biomes."
		"&7Non-aquatic creatures can only spawn dozens of blocks deep underground, away from the Sea of Starlight."
	]
	quest.6B03AFED832B87A7.quest_subtitle: "A bright star falls from the heavens!"
	quest.6B03AFED832B87A7.title: "Sea of Starlight"
	quest.6B475F80CCD29781.quest_subtitle: "Crafting Supplies"
	quest.6B5F16B4F3E12902.quest_desc: ["&r&5Arcana (0%~100%):&r&7 Determines the probability of 'rare enchantments' appearing. When Arcana reaches 100%, some common enchantments (like Sharpness) become rare."]
	quest.6B82BD57F8A68CEE.quest_subtitle: "Familiar Summoning Ritual"
	quest.6B847A24B0B7CC0E.quest_desc: [
		"&0&m\"Prologue complete. Player action phase ends. Entering myth phase.\""
		"&0&m\"Player draws encounter card. Encounter card content: Dead King's Revival.\""
		"\"You sense a surge of malice about to awaken in a certain direction.\""
		"\"Scene advances. Opening Act 1: Banish Evil.\""
		"\"Plot advances.\""
		""
		"The quest will pause here for now. Due to the lack of substantial follow-up content, there's not much more to the story for now. Stay tuned!"
	]
	quest.6B847A24B0B7CC0E.title: "Intermission"
	quest.6B97738CD8E10A57.quest_desc: [
		"&6Treaty of Self-Care"
		"&7Hunger is the loss of self.&r&cHealth depletes much faster at low hunger"
		"&7Feast, revel, enjoy food, cleanse the soul.&r&aFood restores more saturation&r&aEating food clears negative effects"
	]
	quest.6B97738CD8E10A57.quest_subtitle: "Caring for Oneself"
	quest.6B97738CD8E10A57.title: "Treaty of Self-Care"
	quest.6BF48D5C9D1B191A.quest_desc: [
		"&7To address the lack of portability in terminal networks, I developed the Portable Terminal."
		""
		"Although its single storage capacity is limited, the larger the disk capacity, the more items it can hold."
	]
	quest.6BF48D5C9D1B191A.quest_subtitle: "Portable Space"
	quest.6C0395DDA06A6B98.quest_subtitle: "Used for casting plates"
	quest.6C33A7DFF72E3C76.quest_desc: [
		"Place a Carved Lunar Moth Cactus Fruit on top of a Celestial Block to summon it."
		""
		"&6Behavior&r"
		"&7Anti-air utility creature; only targets a &cSmall subset of airborne hostile mobs&r&7."
		"&7When attacking mobs, its attack speed is &aExtremely Fast&r&7, range is &aExtremely Far&r&7, and damage area is &aExtremely Large&r&7, but even so, its attacks &cCannot Harm&r&7 other non-airborne creatures."
		""
		"&7When there are no &eMeteorites&r&7 or the above targets nearby, the &6Celestial Golem&r&7 will not retaliate even if attacked by other creatures."
		""
		"&6Intercepting Celestial Meteors&r"
		"&7When the &6Celestial Golem&r&7 is on the surface and the current weather is &cMeteor Shower&r&7, the Celestial Golem will directly shoot down &eMeteorites&r&7 while they are falling through the air."
		"&7Shot-down &eMeteorites&r&7 will still produce their respective items."
		"&7&cBitter Cometspooks&r&7 also fail to spawn because the meteorite is shot down."
	]
	quest.6C33A7DFF72E3C76.quest_subtitle: "Planetary Protection Policy"
	quest.6C33A7DFF72E3C76.title: "Celestial Golem"
	quest.6C8EF5FE6AB70D3B.quest_desc: [
		"&7Aircraft—an excellent travel tool. Different models have different performance characteristics, suitable for various scenarios. Some are extremely fast, great for exploring and finding ruins; others hover steadily, perfect for building. As long as you're willing to invest some materials, there's always a model that can help you."
		""
		"&7But be careful not to crash..."
	]
	quest.6C8EF5FE6AB70D3B.quest_subtitle: "Please equip feather falling—there's some turbulence ahead"
	quest.6C8EF5FE6AB70D3B.title: "Set Sail for the Skies"
	quest.6CA6DCCDEB5167BD.quest_desc: [
		"&6&#55AAFFStarlight Dimension&r&7"
		"&7A realm isomorphic yet differently colored from the Overworld, where &#55AAFFstars hang low&r&7, plants thrive, &#55AAFFcelestial phenomena are magnificent&r&7, as if sunk into a dream from which one never awakens."
		""
		"&6Dimension Log:&r"
		"&7Terrain height distribution is similar to the Overworld. Most naturally generating blocks correspond to the Overworld, but its surface and vegetation are mostly &#55AAFFBlue-toned&r&7, while the sky is a blend of purple starry sky and &#FFAA00Twilight Warm Orange&r&7."
		"&7Divided into the upper &8Gloomstone Layer&r&7 and the lower &8Voidstone Layer&r&7 by the &cY 0 Layer&r&7."
		"&7The variety and splendor of decorative plants far surpass the Overworld, full of vitality."
		"&7In addition to regular weather, magnificent and unique weather phenomena like &dMeteor Showers&r&7 and &dAuroras&r&7 occur."
		"{@pagebreak}"
		"&6Basic Principles:&r"
		"&7Teleportation & Coordinates: Coordinate scaling is &a1.0&r&7, corresponding 1:1 with Overworld coordinates."
		""
		"&7Time & Sky: Time is frozen in eternal &#FFAA00Twilight&r&7 (12900), with a custom &dPurple Starry Sky&r&7 and &#FFAA00Warm Orange Firmament&r&7."
		""
		"&7Lighting Rules: No day-night cycle; the sky provides light. Base ambient light level is &c0&r&7. Monsters can spawn at light levels &c0~7&r&7."
		""
		"&7Building & Respawning: Height range &b-64 to 384&r&7. &aBeds&r&7 and &aRespawn Anchors&r&7 can be used safely."
		""
		"&7Ecology & Threats: Raids cannot be triggered. &cPiglins&r&7, &cPiglin Brutes&r&7, and &cHoglins&r&7 from the Nether will become &8Zombified&r&7 here."
	]
	quest.6CA6DCCDEB5167BD.quest_subtitle: "Bygone Days"
	quest.6CA6DCCDEB5167BD.title: "Eternal Starlight"
	quest.6CF68E9E0A3CB0E7.quest_desc: [
		"&7Natural Quartz, as the name suggests, is the naturally occurring equivalent of &6Nether Quartz&r&7. Its uses are mostly the same as Nether Quartz."
		""
		"&eIt is quite rare&r&7, found deep underground, often forming &6Geodes&r&7."
	]
	quest.6D0D20A34E2B3703.quest_desc: [
		"&7When held and right-clicked in the &bStarlight Dimension&r&7, it can switch the current weather to &cMeteor Shower&r&7 after a short time, very useful for players wanting to obtain &eCelestial&r&7 and other resources."
		""
		"&7Usage in dimensions other than the Starlight Dimension will &cFail&r."
	]
	quest.6D0D20A34E2B3703.quest_subtitle: "Make a Wish Upon a Star"
	quest.6D571AC85912D827.quest_desc: [
		"&6Runic Substrate&r"
		"&7The foundation for crafting all other runes. Can be found in small quantities in some &bvanilla structures&r&7, more commonly in &cIron's Spell 'n Spellbooks&r&7 structures. Each type of mage drops one substrate of their type upon death (except Necromancers).&r"
		""
		"&8\"The pale foundation, precipitated from the final embers of a mage's soul, used to anchor all runic laws.\""
	]
	quest.6D571AC85912D827.quest_subtitle: "Arcane Materials"
	quest.6D7E037569A98460.quest_desc: [
		"&6Treaty of the High Priest"
		"&7Overbearing control brings harm.&r&cAfter being hit, interaction range gains go on cooldown&r&cDuring gain cooldown, movement speed reduced"
		"&7The entire world is yours.&r&aBlock interaction range increased by one-fifth, entity interaction range increased by one-tenth"
	]
	quest.6D7E037569A98460.quest_subtitle: "Spreading Thin"
	quest.6D7E037569A98460.title: "Treaty of the High Priest"
	quest.6D895DFB1144DF16.quest_desc: [
		"&6Yeti Fur&r&7"
		"&7Obtained by killing a Yeti / using shears on a Yeti to shear it, yielding &#F5F5DCYeti Fur&r&7.&r"
		""
		"&7Yeti Fur is a flammable building block similar to wool.&r"
		""
		"&7Creatures landing on this block do not take fall damage and bounce upwards based on the fall distance (similar to slime blocks).&r"
		""
		"&7Yeti Fur can also block &8Sculk Sensors&r&7 / &8Sculk Shriekers&r&7 from detecting sound.&r"
		""
		"&7Yetis only have a white texture by default and cannot be dyed like sheep. Variants of Yeti Fur other than white can only be crafted manually.&r"
	]
	quest.6D895DFB1144DF16.title: "Yeti Fur"
	quest.6E0EE5297B295288.quest_subtitle: "&eAll neutral creatures will become hostile to you."
	quest.6E0EE5297B295288.title: "&e\"No Purity Remains in the Filthy Body\""
	quest.6E25E82DBD18D2C8.quest_subtitle: "&cThe world will be plunged into eternal night."
	quest.6E25E82DBD18D2C8.title: "&c\"Eternal Journey Under the Lightless Long Night\""
	quest.6E995B7F0867CE19.quest_subtitle: "Familiar Summoning Ritual"
	quest.6EFBE085639D2967.quest_desc: [
		"&7&eTemplate Substrates&r&7 can be used to create bases for various weapon components. While not as convenient as reusable blueprints, they are cheaper and easier to use.&r"
		"{@pagebreak}"
		"&7&eTemplates&r&7 are similar to blueprints but can only be used once. &eBlueprints&r&7 can be used infinitely. If you don't yet have paper or blue dye to craft blueprint paper, templates are a good alternative.&r"
		""
		"&7Templates require &eTemplate Plates&r&7. Template Plates require a &eKnife&r&7 or &eDagger&r&7 and a &eStone Anvil&r&7 to craft. Place a log on the stone anvil and right-click with a knife. Sometimes knives from other mods may also work. You might not have a knife blueprint yet, so first craft a &cCrude Knife&r&7.&r"
	]
	quest.6EFBE085639D2967.title: "Mold Base / Blank Blueprint"
	quest.6F1B0D7041FBCD4B.quest_desc: [
		"&6Mountain's Bulwark Rune&r"
		""
		"&7The Mountain's Bulwark Rune's ability is similar to the ritual of the same name, granting the wearer the &bMountain's Bulwark&r&7 effect at half strength, slightly reducing &aDamage&r&7 taken, with enhanced effect when not wearing armor.&r"
	]
	quest.6F1B0D7041FBCD4B.quest_subtitle: "Guardian Pulse"
	quest.6F5E956AAA173600.quest_subtitle: "Used for casting ingots"
	quest.6F6ACDE9BCEFD6A5.quest_desc: [
		"&6Treaty of the Cloudleaper"
		"&7What you rely on will eventually destroy you.&r&cFall damage doubled"
		"&7Gravity—the most difficult force to defy.&r&aPropulsion from strong winds increased and grants Soaring&r&aSoaring enhances aerial maneuverability"
	]
	quest.6F6ACDE9BCEFD6A5.quest_subtitle: "Flying Above All Things"
	quest.6F6ACDE9BCEFD6A5.title: "Treaty of the Cloudleaper"
	quest.6F7065E85A4EE4DA.quest_desc: ["Can be used to trace records of items I have crafted, which is quite useful for someone as forgetful as I am."]
	quest.6F7065E85A4EE4DA.quest_subtitle: "I'll always stone sword you... forever..."
	quest.6F7643BD60F5534F.quest_subtitle: "Big Spoon"
	quest.6F7DF3491AA2E9DF.quest_desc: [
		"&6Treaty of Parasitism"
		"&7Your vulnerabilities remain unignorable.&r&cHealing received reduced by four-tenths"
		"&7Surplus confidence fused into consciousness; pain no longer matters.&r&aHarvesting spirits grants damage absorption"
	]
	quest.6F7DF3491AA2E9DF.quest_subtitle: "Stealing Shields to Support"
	quest.6F7DF3491AA2E9DF.title: "Treaty of Parasitism"
	quest.6FA8C31F0875CB8E.quest_desc: [
		"&7The most common use is for restocking Totems of Undying. By refilling your off-hand with totems and carrying a backpack full of them, you can achieve a 'how are you still here' effect. But don't ask me how to get a backpack full of totems..."
		""
		"&7It can also be used in other situations to automatically fill items into your hotbar for easy access."
	]
	quest.6FA8C31F0875CB8E.quest_subtitle: "All I See Is an Endless Supply of Totems of Undying"
	quest.6FDF4D8E43BF594B.quest_desc: ["&7As expected, I harvested many spirits, but they are independent entities, almost between tangible and intangible. I need a means to attach their properties to other objects..."]
	quest.701467707AD4CCE8.quest_subtitle: "Used for casting gems"
	quest.70195B5ED5D18F70.quest_desc: [
		"&6Treaty of the Skycleaver"
		"&7A debt of blood repaid with destruction.&r&cKnockback taken doubled"
		"&7Gravity—the strongest force imposed upon others.&r&aTaking fall damage automatically attacks nearby creatures&r&aDealing fall damage attacks the target regardless of distance"
	]
	quest.70195B5ED5D18F70.quest_subtitle: "Striking Down All Things"
	quest.70195B5ED5D18F70.title: "Treaty of the Skycleaver"
	quest.707879003CF228C6.quest_desc: [
		"&7The effort was not in vain. The properties of these new minerals fascinate me—Chlorophyte resonates almost perfectly with magic, exponentially amplifying spell effects; Gobber's hardness far exceeds ordinary metals; and Cragrock... it directly touches the soul itself. Its two completely different products from different processing methods both point towards soul amplification."
		""
		"&7But I still lack a furnace capable of processing these ores, and I need a stable place to store these hard-earned minerals and arrange those正在形成的构想. After much thought, returning to settle in the village is the safest option."
		""
		"&7It's also a good opportunity to bring back the news—the Necromancer King will not rise again. The village has been on alert for so long, yet the expected undead uprising never came. That stern old village chief must be looking quite puzzled right now. I wonder what expression he'll have when he sees me walking through the village entrance."
	]
	quest.707879003CF228C6.title: "Taking Stock"
	quest.70A16F668336C964.quest_desc: [
		"The Enchantment Module brings a more powerful and progressive enchanting experience to Minecraft."
		"Here, enchantment outcomes are no longer influenced solely by the enchantment level, but by five attributes: &a&lQuanta&r&r, &4&lQuantization&r&r, &5&lArcana&r&r, &e&lStability&r&r, and &3Enchantment Clues&r."
		""
		"{@pagebreak}"
		""
		"In the current version, the specific values and meanings of these attributes are as follows:"
		"&a&lQuanta&r&r: Represents the source of power, ranging from 0 to 100. It determines the minimum level required for the highest possible enchantment. Like vanilla, higher levels lead to better enchantments."
		"&4&lQuantization&r&r: Represents chaotic entropy, ranging from 0% to 100%. It indicates the degree of influence on the upper and lower bounds of enchantment results. The higher the value, the greater the fluctuation in the actual enchantment level. For example: If the enchantment table has &a&lQuanta&r&r of 100 and &4&lQuantization&r&r of 90%, using the third slot to enchant any item results in a final enchantment level range of [10, 190]. Default value is 15%."
		"&l&5Arcana&r&r: Represents the gift of mystery, ranging from 0% to 100%. It determines the probability of obtaining &bRare Enchantments&r. Certain special enchantments require a specific Arcana value to appear (e.g., Prospector's Fortune). To prevent essential vanilla enchantments from being crowded out by rare ones at high Arcana, when Arcana reaches 100%, important enchantments like Sharpness become classified as rare."
		"&l&eStability&r&r: Represents the world's stability, provided by the Geode-Encased Stability Bookshelf. It is used to eliminate the impact of Quantization on the lower bound. With Stability, the enchantment level range in the above Quantization example becomes [100, 190]."
		"&3Enchantment Clues&r: Represents the sight of truth. The value indicates the number of enchantment results you can preview before enchanting. Some advanced bookshelves affect this. Default is 1 clue."
	]
	quest.70A16F668336C964.quest_subtitle: "Enhanced Enchanting Power"
	quest.70A16F668336C964.title: "Apotheosis – Enchantment Module"
	quest.70F085FC6F1CAAF2.quest_desc: [
		"Before you leave, a reminder: some powerful ores have been taken over by Boss creatures."
		""
		"They have placed an invisible curse on the ores they claim, meaning you must kick them to death to free the ores. Otherwise, you won't find them even if you dig to the world's core."
	]
	quest.70F085FC6F1CAAF2.quest_subtitle: "It's time…"
	quest.70F085FC6F1CAAF2.title: "The Journey Begins"
	quest.712A04EBF3733C96.quest_desc: [
		"&7The Material Grader can grade the vast majority of materials supported by Silent Gear into different tiers. Materials of different grades provide corresponding levels of enhancement to the crafted components and equipment."
		""
		"&3Grade differences affect many material parameters. The grading tiers are: E, D, C, B, A, S, SS, SSS, Dream."
		""
		"&eThis device requires a catalyst to function: the second input slot of the grader is for the catalyst. Each grading consumes the catalyst, and the average grading level is increased based on the catalyst's own grade. Simply put, the higher the catalyst quality, the higher the possible final grade."
		""
		"&7If a graded material is placed into the grader again, it will be re-evaluated. If a higher grade is obtained, it overrides the previous grade. If the grade is the same or lower, no change occurs, but the catalyst is still consumed."
	]
	quest.712A04EBF3733C96.quest_subtitle: "Upgrade!"
	quest.713CA5306C2B86A2.quest_desc: [
		"&6Link Connector&r"
		""
		"&7Place two Link Connectors facing each other. Hold a &eCopper Wire Spool&7 and right-click each to create a powered link between them. The spool is consumed, returning an empty spool. Once linked, energy can flow.&r"
		""
		"&8If either connector is removed, the link breaks, dropping four copper wires.&r"
		""
		"&7One pull, one link, a line between—energy flows.&r"
	]
	quest.714645D7B7F4C7BA.quest_desc: [
		"&7Can be made into &#A020F0Umbral Snail Shell Powder:&r&7"
		""
		"&7Produced by decomposing &#A020F0Umbral Snail Shell&r&7 in a crafting grid.&r"
		""
		"&7Can be used like Bone Meal to accelerate crops to the next growth stage.&r"
		"&7Also works on saplings, mushrooms, and other plants that can be accelerated by Bone Meal.&r"
		"&7Can also be further crafted into Black Dye in a crafting grid.&r"
	]
	quest.714645D7B7F4C7BA.quest_subtitle: "Material dropped after killing an Umbral Snail."
	quest.71B24EEAADB29F3A.quest_desc: [
		"&7Trading with villagers can get you three types of Reforging Hammers. You can also craft them yourself, which is much more convenient than trading."
		"&7You can reforge weapons, armor, tools, and accessories separately. The best modifier for weapons is mostly &6Legendary&7, while accessory and armor modifiers cover different aspects."
		""
		"Best accessory modifiers:"
		"Warding: +2 Armor"
		"Menacing: +4% Attack Damage"
		"Lucky: +2% Critical Strike Chance"
		""
		"&7Reforging involves risk. Don't get obsessed early on. 'Good enough' is fine."
		"&7Reforging often consumes a lot of anvil durability. You can use the &6Anvil Upgrade&7 from the Sophisticated Backpacks mod to save iron ingots."
	]
	quest.71B24EEAADB29F3A.title: "Skill Acquisition"
	quest.71C2AB4CCFAA1C59.quest_desc: ["&7Increases the spawn range of the spawner. Each upgrade adds 2 blocks, up to a maximum of 48 blocks. Can be used together with Quartz to reduce the spawn range and make it more concentrated."]
	quest.71C2AB4CCFAA1C59.quest_subtitle: "The factory must grow"
	quest.72387868BC05D119.quest_desc: ["&7The Nether now has many new &6flying enemies&7. Be cautious. Most fly fast and are hard to escape. The best way to deal with them is to kill them quickly."]
	quest.72387868BC05D119.title: "Gate of Purgatory"
	quest.727B996FAE26B0BB.quest_desc: [
		"Use the Seer Orb to right-click the portal frame to activate the rift."
		""
		"&7After the Chaotic Rifts gradually closed, the power to open them was sealed within Seer Orbs. Only those recognized as brave by the gatekeeper can enter the rift."
		""
		"&7The gatekeeper gave you some seeds, hoping you would feed the &6Starlight Birds&7 in the Starlight Forest. He hasn't returned there for a very, very long time."
		""
		"Starlight Bird nests are usually found high in the treetops of the Starlight Forest. Place seeds in the nests and feed nearby Starlight Birds to make them breed. The birds will reward you with random items as thanks, including special &6forging materials&r."
		""
		"Chapter Unlocked: &5Eternal Starlight"
		"[ { \"text\": \"[Click to Jump]\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6CA6DCCDEB5167BD\" } } ]"
	]
	quest.727B996FAE26B0BB.title: "Open the Door"
	quest.727E7E58CDD35234.quest_desc: [
		"&7To overcome the limitations of single-material performance, I developed the &6Alloy Furnace&r&7."
		""
		"&7This device can fuse multiple input items, supporting up to four components. The final &ematerial parameters&r&7 vary based on the types and proportions of the input items.&r"
		""
		"&7&eCalculated based on the main component&r&7 (the first item in the placement order) and the &erarity&r&7 of each item.&r"
	]
	quest.727E7E58CDD35234.quest_subtitle: "&cImportant Item"
	quest.72C552BE02BA433D.quest_desc: [
		"The Apotheosis Spawner Module brings players more powerful and customizable spawners, as well as convenient implementation solutions for部分 monster farm automation."
		"The spawner's attributes are numerous but very concise and easy to understand, so I won't go into detail here. Please refer to subsequent tasks for specific aspects."
	]
	quest.72C552BE02BA433D.quest_subtitle: "Super Monster Factory"
	quest.72C552BE02BA433D.title: "Apotheosis – Spawner Module"
	quest.7306BEC7A3E98304.quest_subtitle: "The Undead"
	quest.731473A765D3B6B6.quest_desc: [
		"&7While searching for traces of &dArcane Energy&r&7 across the land, the most commonly found is &bAzure Sky Arcana&r&7."
		"&7All &eWeather Phenomena&r&7 carry faint imprints of Azure Sky Arcana; but essentially, they don't have the form of a spirit, merely the &8Residual Memory&r&7 of its impact on the world."
		"&7Their influence has dissipated, but with a little effort, it can be restored."
		""
		"&7These &bWind Memories&r&7 linger everywhere, having lost the power of the gale, merely drifting about."
		"&7However, by infusing them with &eAzure Sky Arcana&r&7, the flow of &dArcane Energy&r&7 can be used to reweave these memories, restoring them to their original state."
		"&7They can thus once again influence the world."
		"&7Building upon existing uses, with &6Wind Charges&r&7 and &aGale Cores&r&7, I've found two new applications for this effect."
		""
		"{@pagebreak}"
		"&6Gale Activator"
		"&7Wind Charges carry scattered memories. They have a chaotic nature and thus release upon impact."
		"&7When activated by redstone, the Gale Activator weaves a &bGale&r&7 that pushes all surrounding things outward."
		"&7The Tinker's Claw can configure the strength and specific form of this effect."
		""
		"{@pagebreak}"
		"&6Wind Tunnel Device"
		"&7Gale Cores are captured from strong winds; they are more powerful and have direction."
		"&7When activated by a connected Gale Activator, the Wind Tunnel Device continuously weaves an upward-blowing &eWind Column&r&7 that can lift most objects and creatures."
		"&7The Tinker's Claw can configure the distance and direction of this effect."
	]
	quest.731473A765D3B6B6.quest_subtitle: "Eliciting Air Currents"
	quest.731473A765D3B6B6.title: "Gale Weaving"
	quest.732853B6E9D536CC.quest_desc: [
		"&6Aurora Deer Antler&r&7"
		"&7A special drop produced while the Aurora Deer is not killed.&r"
		""
		"&7Players need to &#FFA500Attack&r&7 the Aurora Deer to enrage it, making its &#00FFFFCharge Attack&r&7 collide with the side of a &#808080Hard Block like stone&r&7. Only then is there a chance for it to drop an &#FFA500Aurora Deer Antler&r&7.&r"
	]
	quest.73689A06F7BF9EB3.quest_desc: ["Can be used to craft custom accessories."]
	quest.73689A06F7BF9EB3.quest_subtitle: "Jewelry Polishing"
	quest.737AC021C2A2CF1D.quest_desc: [
		"&2During your travels, you often encounter weapons with excellent enchantments that you cannot use, which is truly a pity."
		""
		"&6This Disassembly Tome can, through an anvil, transfer half (rounded up) of the random enchantments from an equipment piece into the book, consuming (number of enchantments × 10) levels of experience to convert into an enchantment book. The original equipment is destroyed."
		""
		"&eCan also be used repeatedly on marked equipment to refresh the combination of enchantments to be extracted."
	]
	quest.737AC021C2A2CF1D.quest_subtitle: "Recycle"
	quest.73ABE2AF17B6405C.quest_desc: [
		"&7As more and more materials are collected, making parts from a single material can no longer meet performance demands—there are so many modifiers, do I really have to choose just one? The Alloy Smelter's answer is: I want them all."
		""
		"&7A special workstation that can smelt up to four types of metal into an alloy. If you want to stack as many modifiers as possible, smelt four different materials. However, if you're aiming for a specific stat direction, such as attack damage or spell power, reducing the number of material types and using two of the same material might yield better results. Specific effects are subject to actual results. For more information on composite materials, check the Silent Gear chapter."
		""
		"&7Similar workstations include the Sewing Machine and the Recrystallizer. The former is used for fabric composites, but some special materials cannot be used with the Sewing Machine, limiting its utility. The latter can only be crafted after reaching the End, making it a later-game option."
	]
	quest.73ABE2AF17B6405C.title: "Fusion"
	quest.73E6FF96B1846AF3.quest_desc: [
		"&6Treaty of the Bulwark"
		"&7Grand exterior and sluggish nature are inseparable.&r&cSoul Shield recovery rate halved"
		"&7Compressed form soul shield, grand and precise.&r&aIncreases Soul Shield capacity&r&aSoul Shield stability increased by half"
	]
	quest.73E6FF96B1846AF3.quest_subtitle: "Standing Firm in Defense"
	quest.73E6FF96B1846AF3.title: "Treaty of the Bulwark"
	quest.7458C276CADE77AC.quest_subtitle: "Better Defense"
	quest.746B034A029684EA.quest_desc: [
		"&6Smart Filter&r"
		"&7Controls device input/output filtering with higher complexity.&r"
		"&7Right-click to open configuration GUI. Mark items in the top inventory. Bottom buttons from left: Black/White List, Match/Ignore NBT, Clear, Confirm.&r"
		"{@pagebreak}"
		"&7If a List Filter or Attribute Filter with data is marked, it reads internal mark info to generate filtering logic via logical operations. (Different marks within the same filter are OR logic; using a blacklist is NOT logic.)&r"
		"&7Example: List Filter A marks iron sword & gold sword using blacklist, Attribute Filter B marks non-full durability, List Filter C marks filters A & B using blacklist. Then C's logic is NOT ( NOT (iron sword OR gold sword) OR NOT full durability ), simplified to (iron sword OR gold sword) AND full durability.&r"
		"&7A filter can contain another filter, allowing more complex item filtering.&r"
		"{@pagebreak}"
		"&6Attribute Filter&r"
		"&7Attribute Filters filter based on some ‘&eattributes&r&7’ of items, more flexible than regular filters, providing smarter effects in automated processing (though regular filters remain irreplaceable).&r"
		"&7Hold and use an Attribute Filter to open its GUI. To add a condition, place a reference item. The GUI's center then displays all ‘&eattributes&r&7’ of that item; use mouse wheel to select. After selection, click [ &a+&r&7 ] or [ &c+!&r&7 ] to add as a positive or negative filter. Positive matches items with the attribute; negative matches items without it. You can add multiple conditions; set matching logic for multiple tags in the GUI's bottom left.&r"
	]
	quest.746B034A029684EA.title: "Filters"
	quest.7494DCB39DEAF4F5.quest_desc: [
		"&7This should be considered an improved terminal. I removed its disk-dependent design, sacrificing some functionality for maximum storage space."
		""
		"Sneak + right-click the terminal network to bind it. Once bound, you can remotely access its contents anytime. Sneak + right-click a &6Tesla Coil&r to recharge it."
	]
	quest.7494DCB39DEAF4F5.quest_subtitle: "Remote Storage"
	quest.74F6BCC9482F2FD6.quest_desc: [
		"&6Treaty of Reflection"
		"&7Your heart holds only &cStruggle&r&7.&r&cDisables natural Soul Shield recovery"
		"&7A transformation, a new mechanism of refutation.&r&aDealing magic damage restores Soul Shield&r&aGreatly increases Soul Shield capacity&r&aSoul Shield restoration amount doubled"
	]
	quest.74F6BCC9482F2FD6.quest_subtitle: "Returning Double"
	quest.74F6BCC9482F2FD6.title: "Treaty of Reflection"
	quest.7501056B288C71E1.quest_subtitle: "Food Value > 8"
	quest.750FC99EE02F979D.quest_desc: [
		"&7To overcome the limitations of single-material performance, I developed the Sewing Machine."
		""
		"This device can fuse multiple input items, supporting up to four components. The final crystallized material's parameters vary based on the types and proportions of the input items."
		""
		"&eCalculated based on the main component (the first item in the placement order) and the rarity of each item."
	]
	quest.750FC99EE02F979D.quest_subtitle: "No Need to Sew in a Sweatshop"
	quest.7535B9010BCF5E06.quest_desc: [
		"&6Embrace of Flames Rune&r"
		""
		"&7The Embrace of Flames Rune's ability is similar to the ritual of the same name, granting a burning wearer the &bEmbrace of Flames&r&7 effect at half strength, extinguishing &cFlames&r&7 and providing &aPassive Healing&r&7.&r"
	]
	quest.7535B9010BCF5E06.quest_subtitle: "Extinguishing Pulse"
	quest.754B74CB9D6E7C5A.quest_desc: [
		"&7Allows the spawner to spawn mobs even when no players are nearby."
		""
		"&7Use with caution..."
	]
	quest.754B74CB9D6E7C5A.quest_subtitle: "Stabbed to death in the unmanned factory"
	quest.756DE36F8CEBB947.quest_subtitle: "Starlight Traveler"
	quest.75DF4040BA1F636B.quest_desc: ["&7Spawns mobs already on fire"]
	quest.75DF4040BA1F636B.quest_subtitle: "Patience is key"
	quest.75EB87C487763166.quest_desc: [
		"Inscribing all five Runewood Poles above a Totem Base with Arcane Spirits activates the &bRite of Unbinding&r, which significantly alters the nearby environment and prompts the growth of Soul Saplings."
		""
		"&7After further research, I found that the &6Soulwood Trees&r&7 produced by the &bRite of Unbinding&r&7 have become a different species, completely distinct from the original &eRunewood Trees&r&7. Their growth process is different, their traits are different..."
		"&7"
		"&7It seems the &dSpirit Scar&r&7 that created it isn't limited to color and magical properties. The most noticeable differences are form and leaf color. Soulwood trees are taller and thinner than Runewood trees. Unlike the vibrant orange-yellow leaves of Runewood, their leaves are a sickly purple-red. However, their uses are largely the same."
		"&7"
		"{@pagebreak}"
		"&6Soulwood Research: Growth"
		"&7Similar to &8Withering&r&7, its saplings accept &dSpirit Arcane Energy&r&7 and common fertilizers like bone meal, with roughly similar results."
		"&7"
		"{@pagebreak}"
		"&6Soulwood Research: Withering"
		"&7Another significant difference is its effect on surroundings. For example, it uses the energy of its growth to reproduce the &bUnbound Rite&r&7, transmuting surrounding things into Withering. If planting this tree, it's best to designate a safe, controlled area."
		"&7"
		"{@pagebreak}"
		"&6Soulwood Research: Sap"
		"&7Soulwood's viscous sap veins seem to fill more easily than Runewood's. The resulting sap is similarly corrupted. &cCursed Sap&r&7 doesn't restore my vitality but rather enhances it, increasing my attack power and providing damage resistance."
	]
	quest.75EB87C487763166.quest_subtitle: "Twisted Sapling"
	quest.760AED607B00C7CA.quest_desc: [
		"&6Treaty of Mana Devouring"
		"&7The soul resides within the form for a reason.&r&cAll damage taken becomes magic damage&r&cSoul Shield stability halved"
		"&7Part of your soul disperses outside the body to attract arcane energy.&r&aShattering souls produces additional Arcane Energy&r&aHarvesting spirits boosts most magical attributes"
	]
	quest.760AED607B00C7CA.quest_subtitle: "Detaching from Self"
	quest.760AED607B00C7CA.title: "Treaty of Mana Devouring"
	quest.7655A85408A81AA1.quest_desc: [
		"If fortunate enough to encounter a wild familiar, perhaps you can offer Arcane Essence in exchange for their assistance."
		""
		"&eAlternatively, use a summoning ritual to summon familiars."
		"{@pagebreak}"
		"&6Basic Familiar Mechanics&r"
		"&7Familiars can be tamed using &bArcane Essence&r&7. Right-click a familiar with a stick to set it to &astay in place&r&7, causing it to remain stationary and not attack. Tamed familiars can be &aSummoned/Dismissed&r&7 by selecting the corresponding familiar in the familiar selection interface. The selection interface can be opened via a keybind; then you can use the summon/dismiss hotkey to control the selected familiar. After obtaining the advancement ‘&cLearning Necromancy&r&7’, familiars will avoid death at the cost of consuming &eMana&r&7, but if your mana is depleted, they will still die.&r"
	]
	quest.7655A85408A81AA1.quest_subtitle: "Finding Familiars"
	quest.7655A85408A81AA1.title: "Eternal Companions"
	quest.768F736B2B18FA1B.quest_desc: [
		"&6Pact of the Keen Eye&r"
		""
		"&7Perceptiveness within the soul makes you plan ahead.&r"
		"&7-&cSpell Projectile&r&7 recovery rate halved&r"
		""
		"&7The arcane seeking eye fused into the soul.&r"
		"&7-&eStaff Projectiles&r&7 will &aHome&r&7 on targets&r"
	]
	quest.768F736B2B18FA1B.quest_subtitle: "Hitting the Bull's-Eye"
	quest.768F736B2B18FA1B.title: "Pact of the Keen Eye"
	quest.76BD72A25B241E0C.quest_desc: ["&7Using the light of Glowstone, I improved the Nether Bookshelf, a symbol of chaos. While providing additional &4Quantization&7, it also grants a small amount of &5Arcana&7. Although still not as good as the Ocean Bookshelf, every little bit helps, right?"]
	quest.76BD72A25B241E0C.quest_subtitle: "A More Balanced Nether Bookshelf"
	quest.76BD72A25B241E0C.title: "Chaotic Expansion"
	quest.770E6D9F52724FCC.quest_desc: [
		"&7By fusing multiple materials of the same type together, you can create Composite Materials. Their properties are quite complex, requiring experimentation and research to find suitable combinations."
		""
		"&7First, Composite Materials inherit all the modifiers from their components. This means you can use them to stack大量 modifiers to craft trinkets. Trinkets only care about modifiers—other negative effects are basically negligible, and stacking a巨量 of modifiers can greatly enhance trinket performance."
		""
		"&7Second, if you want the Composite Material's attack damage to be as high as possible, you need to include high-damage materials in the crafting process, such as Obsidian Ingots obtained from ancient city exploration."
		""
		"&7Finally, there are specific rules regarding which parts Composite Materials can be used to craft. For example, if you want to use Composite Material to craft a Coating, then all原材料 used to create the Composite Material must themselves be capable of crafting a Coating. The resulting Composite Material will then also be capable of crafting a Coating, and its properties will be綜合 calculated. If any原材料 cannot be used to craft a Coating, then the resulting Composite Material also cannot be used to craft a Coating. The same applies to other parts."
	]
	quest.770E6D9F52724FCC.title: "Composite Materials"
	quest.773AC14F2AF8822B.quest_desc: [
		"Nether Quartz is the most special of the adjustment items. When used, it needs to be paired with another adjustment item and is not consumed itself (similar to a wrench). Quartz will reverse the magic of the adjustment item, causing an effect opposite to using the item alone."
		"When using Quartz, you need to hold the other adjustment item in your off-hand."
	]
	quest.773AC14F2AF8822B.quest_subtitle: "Reverse Adjustment"
	quest.7779D406142005D6.quest_desc: [
		"&6Research: Void Salt"
		"&7After passing through the &dWeeping Well&r&7, &8Cursed Ash&r&7 changed into a substance I call \"&8Void Salt&r&7\". This dark powder is chemically similar to Cursed Ash, but lacks carbon components, so it can no longer be called \"ash\"."
		"&7"
		"&7It seems composed of an unknown unstable metal, bonded with some caustic substance I cannot identify. It's perplexing beyond the physical. Carbon is the basis of life, but this substance with carbon removed... seems to move? I haven't been able to confirm this in experiments, but I'm almost certain this substance has some kind of life and moves."
		"&7"
		"{@pagebreak}"
		"&6Revisiting: Void Salt"
		"&7&AExistence&r&7 arising from &cNon-existence&r&7 is a manifestation of &8Umbral Arcane Energy&r&7 existing. It might &cTruly&r&7 be alive... but its life is defined by void, not material existence. Extending this, could there be more complex life in the void?"
	]
	quest.7779D406142005D6.quest_subtitle: "Clues to the Soul's Essence"
	quest.779B259771323E1B.quest_desc: [
		"&7击败死者之王将解锁以下矿物：&r"
		"&7"
		"&#67B1E5戈伯&r&7"
		"&#C9C8E1泽纳莱特&r&7"
		"&#757369符文碎屑&r&7"
		"&#7EE344叶绿矿&r&7"
		"&#770808惧石&r&7"
		"&#DD660A烈阳核心&r"
	]
	quest.779B259771323E1B.quest_subtitle: "亡者力量"
	quest.77A67AF0D408E4DC.quest_desc: [
		"&6Crucible Enhancement"
		"&7The &bSpirit Crucible&r&7 holds deep potential, but most of it remains untapped. Various &dCores&r&7 made from &6Alchemical Mineral Dust&r&7 can unleash this potential, a process I call \"&6Enhancement&r&7\"."
		"&7"
		"&7Each &dEnhancement&r&7 has a unique effect; place it in a &bSpirit Catalyzer&r&7 or up to four in a Spirit Crucible to take effect. Using multiple of the same enhancement stacks the effect."
		"&7"
		"&7For ease of operation during enhancement, I modified a tuning fork. Holding the &6Tuning Fork&r&7 allows viewing of a crucible's unique resonance and its enhancements. Moreover, using the Tuning Fork on a crucible lets you select an attribute to boost, while others are slightly lowered."
	]
	quest.77A67AF0D408E4DC.quest_subtitle: "Adjusting the Tuner"
	quest.77A67AF0D408E4DC.title: "Crucible Enhancement"
	quest.77CA1E58A49F362C.quest_desc: [
		"&eBasic fuel, found everywhere."
		"&6Average consumption, but low power and speed."
		""
		"⚡ Speed: 0.5x | ♨ Temperature: 1500 | ⏳ Consumption: 0.2"
		""
		"&aTip&r&7: &f♨ &r&7Temperature determines the grade of materials that can be processed, ⚡ Speed affects processing time, ⏳ Consumption represents fuel longevity."
	]
	quest.77CA1E58A49F362C.quest_subtitle: "Classic Fuel"
	quest.78294B68D04E42A9.quest_desc: [
		"&dA blind guardian comes to protect the ancient city..."
		""
		"&7The embodiment of pure power, possessing extremely brutal melee capabilities. Fighting with long-range weapons or spells is a safer strategy. The Sculk Tendrils dropped upon defeat are an important material for Echoing Sculk Shelves."
	]
	quest.783683CB8A00E9B7.quest_desc: [
		"&6Aura Enhancement"
		"&7The Arcane Pylon combines &6Soulwood&r&7 and &eRunewood&r&7 in its construction, making it exceptionally adept at channeling &dSpirit Arcana&r&7. Supplying it with &dSpirits&r&7 releases the stored energy of the spirits."
		"&7"
		"&7Totems are designed to avoid constant spirit consumption. When a rite activates, a &dResonance&r&7 inevitably forms, its sequence matching the order of &dSpirits&r&7 composing the totem; this property imposes only a negligible burden. This is acceptable for passive effects, but it severely limits effect strength. The &bArcane Pylon&r&7 mitigates this limitation, allowing &6Totem Magic&r&7 to exert its full power."
	]
	quest.783683CB8A00E9B7.quest_subtitle: "Higher Obelisk"
	quest.783683CB8A00E9B7.title: "Aura Enhancement"
	quest.784CD820CEC6F25B.quest_desc: [
		"Hover your mouse over the top-left corner of the quest selection box to find an arrow. Clicking it reveals the following screen:"
		"{image:kubejs:textures/gui/ftb_kjs3.png width:120 height:80 align:center}"
		""
		""
		"{@pagebreak}"
		""
		"Click again to see which prerequisite quests exist. Selecting one will automatically navigate to that prerequisite quest."
		"{image:kubejs:textures/gui/ftb_kjs4.png width:120 height:80 align:center}"
		"You can also click the right arrow in the top-right corner of a quest to open a dropdown menu listing all dependent quests."
	]
	quest.784CD820CEC6F25B.quest_subtitle: "&mHow the hell do I complete this cursed task"
	quest.784CD820CEC6F25B.title: "View Prerequisites"
	quest.7874BB44F0FADAEB.quest_desc: [
		"&7Some main quest points have lore checkpoints beneath them, containing a small piece of &zUnofficial History&r"
		""
		"&7You can ignore them if you don't want to or don't have time to read."
		""
		"&7For example, this checkpoint is a lore checkpoint."
		""
		"This is a piece of lore."
	]
	quest.7874BB44F0FADAEB.title: "Lore Checkpoint"
	quest.789A0AD70CA77553.quest_desc: [
		"&7People often use &6Gold&r&7 as a base for mystical research; its natural magic conductivity makes it quite useful. Spirit arcane energy is no exception. And by using &bSacred Arcana&r&7, gold's magic conductivity can be enhanced."
		""
		"&7Hallowed Gold's physical properties are similar to gold. Infusing the alloy with pure arcane energy makes other arcane energies conduct smoothly; &6Hallowed Gold&r&7 with this property is an excellent conductor needed for my research. It can also be used to craft several fashionable item stands."
	]
	quest.789A0AD70CA77553.quest_subtitle: "In Tune"
	quest.78E0C869F2BB2516.quest_desc: ["&7When used as a Tip Upgrade, it provides 1.5 Luck—extremely powerful. It's recommended to &6max out&7 Lapis Lazuli on this tip upgrade early on, once you have access to the tip upgrade slot. This can greatly increase the item output from loot chests."]
	quest.78E0C869F2BB2516.quest_subtitle: "Ab! So! Lu! Te! Luck!"
	quest.791787D97B46619C.quest_desc: [
		"The modpack includes a Nature's Compass for searching specific biomes, but does not have a Structure Compass installed."
		""
		"It is recommended to explore the Overworld first when equipment is poor in the early game. Entering the Nether too early is not advised."
	]
	quest.791787D97B46619C.title: "Exploration"
	quest.79244245C1776777.quest_desc: ["&7Purely human-powered—consumes a stack of steak per hundred kilometers. Also has hovering capabilities with decent flight speed. No major advantages or disadvantages."]
	quest.7924CE833E734123.quest_desc: [
		"&7Spirit Rites are &cComplex&r&7 yet &aSimple&r&7, a paradox with its own logic."
		"&7Simple, fixed effects, yet rooted in the &dFlow of Arcane Energy&r&7—judging a rite's range is therefore quite difficult."
		""
		"&7I crafted a &6Staff&r&7 to serve as a \"&bTuning Fork&r&7\" for rite energy."
		"&7Holding it allows resonance with the world's arcane energy flow, enabling direct vision of the &eTotem's Area of Effect&r&7."
		""
		"&7Interestingly, this staff can also \"&bCalibrate&r&7\" sigils to an active state, even those not on a totem, by interacting while holding it."
		"&7As far as I know, this effect is purely &8Visual&r&7."
		"&7But even without great utility, they are sufficiently &6Aesthetic&r&7."
	]
	quest.7924CE833E734123.quest_subtitle: "Insight into Rites"
	quest.7924CE833E734123.title: "Totem Resonance"
	quest.7964EFBEAA0F5D57.quest_desc: ["&7Click the &a√&r&7 to unlock the next quest."]
	quest.7964EFBEAA0F5D57.quest_subtitle: "As you can see, this is a quest."
	quest.7964EFBEAA0F5D57.title: "Guidance"
	quest.79B12E63C90B3C61.quest_desc: [
		"Can provide a temperature of 3000 degrees Celsius. Requires a Power Furnace to function normally."
		""
		"&eIt's not that one forge can only use one... multiple can be placed in the same furnace to supply fuel consumption."
	]
	quest.79B12E63C90B3C61.quest_subtitle: "Sustained Output"
	quest.79B7BF074539AA91.quest_desc: [
		"&6Smart Fluid Pipe&r"
		"&7Has a filter slot for marking items or inserting filters. (Mark using bucket or bottle fluids.)&r"
		"&7Only allows fluids meeting the condition to pass.&r"
		"&7When using Smart Fluid Pipes, place them as close to the fluid source as possible; otherwise, other fluid types may be expelled first, potentially causing &cclogs&r&7.&r"
	]
	quest.7A1141EE7A34D62F.quest_desc: [
		"&6Pact of Ethereal Resistance&r"
		""
		"&7The Pact dulls the edge of Malicious Strikes.&r"
		"&7-Restoring &cMalice's Shelter&r&7 reduces &cMalicious Critical&r&7 damage&r"
		""
		"&7Corrosive patterns engraved into malice-summoning souls.&r"
		"&7-&6Malicious Critical&r&7 charges &aMalice's Shelter&r&7&r"
	]
	quest.7A1141EE7A34D62F.quest_subtitle: "Confined to Slaughter"
	quest.7A1141EE7A34D62F.title: "Pact of Ethereal Resistance"
	quest.7A3C6671435E2BA9.quest_desc: [
		"&eA furnace that requires materials to be placed inside to function."
		""
		"&eFuel can be input via fluid pipes, etc."
		"&r"
		"Although materials must be placed to burn, as the grade of the input materials increases, the released heat also increases significantly, making it irreplaceable in specific processes."
	]
	quest.7A3C6671435E2BA9.quest_subtitle: "Thermal Smelting"
	quest.7A4449338F885205.quest_desc: ["Defeating it unlocks Ender Gobber ore."]
	quest.7A4449338F885205.quest_subtitle: "Stage 2, unlocks Stage 3 after kill"
	quest.7A63B4E0381D9BA4.quest_desc: [
		"&6Treaty of Patient Returns"
		"&7Better a long pain than a short one.&r&cBuffered damage becomes magic damage and gains one-fifth strength when released"
		"&7Disperse impact, slow damage.&r&aBuffers half the damage taken, converting it into damage over time&r&aBuffered damage cannot cause death"
	]
	quest.7A63B4E0381D9BA4.quest_subtitle: "Diluting Pain"
	quest.7A63B4E0381D9BA4.title: "Treaty of Patient Returns"
	quest.7AF763EC94AE76CA.quest_desc: ["&7Increases the level cap for stored enchantments, but has no other improvements..."]
	quest.7AF763EC94AE76CA.quest_subtitle: "A Bigger Library"
	quest.7AF858E2ECF74FAD.quest_subtitle: "Stage 1"
	quest.7B098F5DB49DB51F.title: "Night Veil Spider"
	quest.7B2DD9D8E6237F68.quest_desc: ["The sacrificed head, representing blood sacrifice, connects to hell, providing additional Quantization attribute."]
	quest.7B2DD9D8E6237F68.quest_subtitle: "Minor Quantization Increase"
	quest.7B2DD9D8E6237F68.title: "Primitive Chaotic Sacrifice"
	quest.7B470F04445F5D8B.quest_desc: [
		"&7I have been able to discern the composition of &cMalice's Lead&r&7, facilitating the design of uses. Just as &8Umbral Arcana&r&7 is strange, its alloy with metal possesses special properties. &eDeeprock Precious Gold&r&7 becomes lowly, producing Malice's Lead; this &cPewter&r&7 craves to act outwardly. It craves to erode, dismantle, eliminate human development."
		"&7"
		"&7This property certainly has mundane uses—as a weapon to further damage armor while harming and shattering souls; its esoteric uses are also noteworthy. Malice Pewter is not inert on a magical level, nor does it absorb magic. Rather, magic seems unable to &cForm&r&7 around it at all, symbolizing the fading of the pursuit of knowledge."
		"&7"
		"&7This metal is quite tough and sharp, but wearing &cAnti-Magic Armor&r&7 would certainly cause problems... and grant new abilities. I already have a general idea of using it to make an armor set that utilizes the metal's abilities, which should be extremely powerful."
		"{@pagebreak}"
		"&6Malice's Bastion Armor"
		"&7&cMalice Pewter&r&7 repels magic, so from a magician's perspective, wearing it is a strange choice. But I &aAm&r&7 also a magician, and the Bastion Armor I created is immensely powerful."
		"&7"
		"&7The armor beneath the Malice Pewter plating is the opposite of &6Soulstained Steel Armor&r&7—my soul is not protected; rather, the flow of arcana is ruined by this metal. It twists arcana to flow outward, disrupting incoming damage. When wearing a full set of Bastion Armor, my soul ultimately takes half the damage it otherwise would."
		"&7"
		"{@pagebreak}"
		"&7This armor affects more than incoming magic. The wearer's own arcane circuits are also affected. Their usual path towards the soul is disrupted, stolen, processed, and twisted. And in the dissolution of arcana, energy remains. The armor reacts to this energy and is enhanced by it."
		"&7"
		"&7There are two key points in this effect. First, the armor's magic absorption process should be called \"&cMalice Conversion&r&7\". It is the interception of arcana flowing towards the soul and the absorption of the resulting energy. Second, the armor weaves the stolen energy, giving it new form and intent. The effect of this process should be named \"&6Malice's Shelter&r&7\"."
		"&7"
		"{@pagebreak}"
		"&7Malice's Shelter essentially acts as a powerful shield, directly negating almost all types of damage. As the armor continuously absorbs magic, the capacity of Malice's Shelter, even its recovery rate and recovery bonus, will grow, varying based on the absorbed attribute. Based on current research, this is the most powerful ability of Malice's Bastion Armor."
	]
	quest.7B470F04445F5D8B.quest_subtitle: "Evolution No More"
	quest.7B6F7BDF000CF379.quest_desc: [
		"&6Fused Consciousness&r"
		""
		"&7The future holds many mysteries... but you can know part of it in advance.&r"
		"&7Throwing an Iron Block into the &eWeeping Well&r&7 creates an &bAnomalous Component&r&7. Throwing a complete component into the &eWeeping Well&r&7 creates a Fused Consciousness.&r"
	]
	quest.7B6F7BDF000CF379.quest_subtitle: "The Blueprint for All Past and Future"
	quest.7B8819152EE73E21.quest_desc: [
		"&6Life Fruits&r"
		"&7Consumables used to increase a familiar's &aHealth&r&7. There are 3 tiers, each with a usage limit.&r"
	]
	quest.7B8819152EE73E21.title: "&6Life Fruits&r"
	quest.7BACE6601BC4DFED.quest_desc: ["After storing emeralds inside, they will never be lost..."]
	quest.7BACE6601BC4DFED.quest_subtitle: " Prevent Loss"
	quest.7BD9DC7DB2278AA5.quest_desc: ["&7Obtained from Ancient City loot chests. It has quite high attack damage but no special modifiers, making it suitable for use in alloying weapon components."]
	quest.7BD9DC7DB2278AA5.quest_subtitle: "Simple, High Damage"
	quest.7C74D47B9ED97737.quest_desc: [
		"&7The Security Manager is a block that can store Security Cards."
		""
		"You can configure what permissions each player (bound to a Security Card) has."
		""
		"{@pagebreak}"
		""
		"&eWhen there are no Security Cards on the network, every player can access all permissions."
		""
		"&6Start inserting Security Cards to define player permissions."
		""
		"&ePlayers without a configured Security Card can still do everything (all permissions) in the network."
		""
		"&6To configure a set of 'global' permissions for all unconfigured players, configure a Security Card not bound to any player and insert it into the Security Manager."
		""
		"&eOperators on a server have access to all permissions."
		""
		"&6The placer of the Security Manager can always open its GUI and change security settings, regardless of permissions."
	]
	quest.7C74D47B9ED97737.quest_subtitle: "Access Denied"
	quest.7C7A1613FB9C97E8.quest_subtitle: "Surely you two didn't agree to farm each other legitimately"
	quest.7C7A1613FB9C97E8.title: "Catch 64 Fish"
	quest.7C7C7734793AB866.quest_desc: [
		"&6Prismarine Focusing Lens&r"
		""
		"&7Sometimes, simplicity is the answer. The Prismarine Focusing Lens refracts not light, but Arcane Energy, greatly reducing the &cDestabilization Risk&r&7 of the &eSpirit Focusing&r&7 process. But note, stability only prevents additional wear on the Focus Token.&r"
	]
	quest.7C7C7734793AB866.quest_subtitle: "Stabilizing"
	quest.7CACDAC57F697371.quest_subtitle: "Ore Sniffer"
	quest.7CDF0A87C605E833.quest_subtitle: "Familiar Summoning Ritual"
	quest.7CE0C7EC4D46C170.quest_subtitle: "Familiar Summoning Ritual"
	quest.7CEF4D8E514066A7.quest_desc: [
		"&6Tower Squid&r&7"
		"&7A common marine creature in the Starlight Dimension, smaller in size than vanilla squids.&r"
		""
		"&7Cannot survive out of water (completely loses mobility and gradually loses health over time until death).&r"
		""
		"&7Hold a bucket and right-click the Tower Squid: transforms it into item form (&#1E90FFTower Squid Bucket&r&7) for storage.&r"
	]
	quest.7CEF4D8E514066A7.title: "Tower Squid"
	quest.7CF77F3C6D4073BD.quest_desc: [
		"&7Spirits successfully infuse into items; they tangibly alter the objects' properties, and I can indirectly utilize the abilities held by the spirits by manipulating these items."
		""
		"&7Based on these materials, I focused my research on three directions: Soul, Body, and World."
		""
		"{@pagebreak}"
		""
		"&7Spirits are born from souls, so using their power to influence souls is relatively easy. However, similarly, because they are born from souls with self-will, they cannot be completely controlled by my will, meaning the power they bring often has negative side effects."
		""
		"I call these spirit-granted powers with negative aspects \"&4Mandates&r\"."
		"{@pagebreak}"
		"&7Making spirit creations affect the body is slightly more troublesome. After repeated experiments, I believe they still require a \"carrier\" to exert their effect."
		""
		"I call these carriers that allow spirits to act upon the body \"&4Runes&r\"."
		""
		"{@pagebreak}"
		"&7For spirits to affect the world requires sheer force—greatly increasing their output power. Since they don't need to act on living bodies, the experiments are more open-ended, and bold experiments have yielded many results, mostly practical tools."
	]
	quest.7CF77F3C6D4073BD.quest_subtitle: "Inspiration Strikes"
	quest.7CF77F3C6D4073BD.title: "Infinite Possibilities"
	quest.7D0410D74877C78A.quest_desc: [
		"As shown, you can place the Controller, Storage Terminal, and Storage Blocks together to link them, while also supplying power to the Controller."
		""
		"{image:kubejs:textures/gui/refinedstorage1.png width:180 height:100 align:center}"
		""
		"The size and number of linked Storage Blocks determine the amount of item storage you have."
		""
		"{@pagebreak}"
		"You can also link them using cables; this will calculate all blocks connected by the cables."
		""
		"{image:kubejs:textures/gui/refinedstorage2.png width:180 height:100 align:center}"
	]
	quest.7D0410D74877C78A.quest_subtitle: "Basic Tutorial"
	quest.7D0410D74877C78A.title: "Tips: Basic Usage"
	quest.7D237676ED4A865D.quest_desc: [
		"&7The Apotheosis Enchantment Module introduces a new crafting method to MC – &bInfusion&7. Infusion is similar to ordinary enchanting, but imposes restrictions on certain attributes. Almost all items have a minimum &aQuanta&7 requirement, and almost none have an upper &aQuanta&7 limit ("
		""
		"&7Special and powerful items, however, impose restrictions on &4Quantization&7 and &5Arcana&7. Some particularly strong items have &6very strict&7 requirements. Therefore, learning how to choose and balance bookshelves is crucial."
		"{@pagebreak}"
		"I will mark my &brecommended Infusion bookshelves&r with a gearwheel block as a reminder."
	]
	quest.7D237676ED4A865D.quest_subtitle: "Strengthening Magic with Magic"
	quest.7D237676ED4A865D.title: "Understanding Infusion Operations"
	quest.7D2FD37CB2502689.quest_subtitle: "Legendary Tank"
	quest.7D61EDF0B7F33C80.quest_desc: ["Has a facing direction. When placed by a player, it faces the block side clicked. Only the network on the facing side is separated from networks accessed from other sides."]
	quest.7D61EDF0B7F33C80.quest_subtitle: "Functions like a cable, but can be controlled by redstone signals."
	quest.7D628BA502AB05E5.quest_desc: [
		"&7The Skeleton King must be summoned using the Calamity Lich's Spirit Altar. Remember to summon him at night; summoning during the day will immediately enrage him, granting him massive damage capable of oneshotting players."
		""
		"To be continued"
	]
	quest.7D628BA502AB05E5.title: "Target: Skeleton King"
	quest.7D6295CE0F8D8951.quest_desc: [
		"&6Alternator&r"
		""
		"&7A machine converting rotational stress into electric current, opposite to the &eElectric Motor&7 that converts electricity back to rotation. It accepts stress input on one end and outputs energy on the other.&r"
		""
		"&7Requires at least &c32 RPM&7 to start, with an internal buffer of &c5 kFE&7.&r"
		""
		"&7Through it, you can convert mechanical kinetic energy into more storable and remotely transmittable &eelectric energy&7, then use electric motors to drive machinery again. Note: energy is always lost in the two conversions.&r"
	]
	quest.7DC30B49569B363E.quest_desc: [
		"&6Oakwood's Might Rune&r"
		""
		"&7The Oakwood's Might Rune's ability is similar to the ritual of the same name, granting the wearer the &bOakwood's Might&r&7 effect at half strength, providing a fixed amount of &aDamage Boost&r&7, enhanced when empty-handed.&r"
	]
	quest.7DC30B49569B363E.quest_subtitle: "Empowering Pulse"
	quest.7DDA9820D328CC3F.quest_subtitle: "Beloved Kin"
	quest.7E11D3149C613671.quest_desc: [
		"&7Can accept liquids from the drain, but remember to place a mold on the casting table before pouring in the liquid. Otherwise, it won't take shape and you'll just waste materials."
		""
		"&7If a mold is present, after pouring in a certain amount of liquid, it will begin to cool and transform into different items depending on the mold."
		""
		"To create a mold, place a &6corresponding item&r on the casting table, then pour in &6molten steel&r. For example, to make an ingot mold, place any ingot on an empty casting table, then open the drain and pour in 360mb of molten steel."
		""
		"&7Molten steel is obtained by smelting coal and iron together in a furnace at a 1:1 ratio. Four coal and four iron will produce 360mb of molten steel."
	]
	quest.7E11D3149C613671.quest_subtitle: "Cast fluid into items"
	quest.7E57D8FC5D757153.quest_desc: [
		"&0&m\"Act One complete. Player turn ends. Entering Mythos Phase.\""
		"&0&m\"Player draws Encounter card. Encounter card: &kInsatiable Greed&r&0&m.\""
		""
		"\"The Lord of the Dead has been defeated. Ores sealed within the world have reappeared. The following ores have been unlocked:&r"
		""
		"&#67B1E5Gobe&r&7"
		"&#C9C8E1Zenalite&r&7"
		"&#757369Runic Debris&r&7"
		"&#7EE344Chlorophyte&r&7"
		"&#770808Fearstone&r&7"
		"&#DD660ASolar Core&r\""
		""
		"\"Your ambition swells.\""
		"\"Scene advances. Beginning &3Act Two: Blind Harvest.&r\""
	]
	quest.7E57D8FC5D757153.title: "A Brief Respite"
	quest.7E59A0E6979C8FF1.quest_desc: [
		"&6Treaty of Blazing Flame&r"
		""
		"&7The nature of fire is undeniable.&r"
		"&7-Forcefully extinguishing flames causes you to suffer &cInfernal Arcane Impact&r"
		""
		"&7Nothing can oppose raging fire.&r"
		"&7-&eFire Effects&r&7 inflicted on enemies are more potent&r"
	]
	quest.7E59A0E6979C8FF1.quest_subtitle: "Adding Fuel to the Fire"
	quest.7E59A0E6979C8FF1.title: "Treaty of Blazing Flame"
	quest.7EB97CBE6483FCF7.quest_desc: ["But I still have to remind you, Phantoms now only spawn when you keep a regular sleep schedule...."]
	quest.7EB97CBE6483FCF7.quest_subtitle: "Sleep Tight"
	quest.7EF077D05E3E3B7E.quest_desc: [
		"&6Unwavering Rune&r"
		""
		"&7The Unwavering Rune stabilizes the wearer's posture, negating all &cKnockback&r&7.&r"
	]
	quest.7EF077D05E3E3B7E.quest_subtitle: "Withstanding the Unstoppable"
	quest.7EFFB6E94996077C.quest_desc: [
		"&7With newly forged tools and weapons, I expanded my exploration range. The wilderness isn't devoid of everything. I discovered remnants of civilization: half-collapsed stone fortresses, heavily wind-eroded ancient shrines. They are utterly silent, completely abandoned, as if their owners left centuries ago."
		""
		"&7The ruins are no more friendly. Slightly more intact ruins harbor monsters. Undead like zombies and skeletons appear in groups. Even more bizarre are undead archers riding flying hostile mobs. This cannot be natural; it's simply... man-made. If they aren't guardians left by the ruin's masters, then they must be manifestations of the &5pure malice&7 of certain individuals."
		""
		"&7During my exploration, I accidentally spotted humanoid intelligent creatures. Perhaps it had been too long since I'd seen people, I overlooked their grayish-blue skin and almost ran towards them without defenses. The consequence was obvious—he, or they? They exchanged a few words amongst themselves and then attacked me. I don't know where this malice comes from. I can't understand. I want to find &5someone I can communicate with&7."
	]
	quest.7EFFB6E94996077C.title: "Exploration"
	quest.7F11174C00472167.quest_desc: [
		"&6Starlight Forest&r"
		"&7Is a surface biome in the Starlight Dimension, the most ordinary and common one."
		""
		"&7The main tree type in Starlight Forest is &eMoonglow Tree&r."
		"&7Compared to its variant biome (&8Starlight Dense Forest&r&7), the Moonglow trees in this biome generally grow &aTaller&r."
		"&7The spacing between individual Moonglow trees is &aLonger&r&7, and the ground shaded by the trees appears relatively more &aOpen&r."
		""
		"&7In addition to the &eMoonglow Berries&r&7 plants hanging from the leaves, the surface of this biome also has some unique plants: &8Starlight Flower, Starlight Torch Flower, Yellow Ridge Grass, etc.&r"
		"&7Some plants that can &aGlow and Illuminate&r&7 also reduce monster spawning on the biome's surface to some extent."
	]
	quest.7F11174C00472167.quest_subtitle: "Utterly Normal"
	quest.7F11174C00472167.title: "Starlight Forest"
	quest.7F2C0291CE6F6B66.quest_desc: [
		"&#FF66CCLust - Erosion&r&7"
		"&7Normal attack multiplier is &#00AA001.0x&r&7. When attacking a target with &#FF66CC'Rose'&r&7, attack multiplier increases to &#00AA001.1x&r&7; when attacking a target with &#CC0000'Blood-stained Rose'&r&7, attack multiplier increases to &#00AA001.2x&r&7.&r"
		""
		"&#00FFAA[When attack hits]&r&7 If the target does not have &#FF66CC'Rose'&r&7 or &#CC0000'Blood-stained Rose'&r&7, grant it 1 stack of &#FF66CC'Rose'&r&7. If the target already has a bleeding effect, instead grant 1 stack of &#CC0000'Blood-stained Rose'&r&7.&r"
		""
		"&#00FFAA[When attack hits]&r&7 If the target has 5 stacks of &#FF66CC'Rose'&r&7, consume all stacks to grant yourself 1 stack of &#FFAA00Damage Boost&r&7.&r"
		""
		"&#00FFAA[When attack hits]&r&7 If the target has 10 stacks of &#CC0000'Blood-stained Rose'&r&7, consume all stacks to grant yourself 3 stacks of &#FFAA00Damage Boost&r&7, and deal 1 instance of bleeding damage to the target based on its current bleeding level.&r"
	]
	quest.7F2C0291CE6F6B66.quest_subtitle: "WIP"
	quest.7F2C0291CE6F6B66.title: "Lust Erosion"
	quest.7F53C2C16D225E49.quest_subtitle: "Can break blocks or fluids in front, and also absorb item entities in front."
	quest.7F578E1D8C765465.quest_desc: [
		"&7Spirit rites mostly have similarities. Simple rites manifest effects by seeking &dRite Sites&r&7, while more complex rites—those seeking to affect the world without a specific target—manifest effects through solidified &dRite Sites&r&7."
		"&7"
		"&7When a solidified rite site forms, it travels in the direction indicated by the totem. I measured its movement speed at precisely four blocks per second, and it can activate its effect eight times before dissipating."
		"&7"
		"{@pagebreak}"
		"&7Foulstone has a unique negative effect on magic. It interferes with arcane flow, eventually completely dispersing it. Without any special external construction, the only thing to note is its interfering nature. Rite sites flying over &cFoulstone&r&7 do not activate their effect and thus do not dissipate."
		"&7"
		"&7Finally, rite sites are intangible, therefore massless, unaffected by gravity, and can pass through any solid matter."
		"&7"
		"{@pagebreak}"
		"&7The &bRite Anchor&r&7 is an instrument that can guide and enhance traveling rite sites. Embedding &dSpirit Arcana&r&7 into it establishes a flight path, affecting all sites that pass over it. The arcane etching technology used for the path is inherently sensitive, so rite anchors cannot function under redstone influence."
		"&7"
		"{@pagebreak}"
		"&6Site Speed"
		"&7Embedding &bAzure Sky Arcana&r&7 into a &bRite Anchor&r&7 grants sites a speed boost, increasing their movement speed through the world. Each site can accept this effect twice, each time doubling the speed."
		"&7"
		"{@pagebreak}"
		"&6Site Strength"
		"&7Embedding &bAzure Water Arcana&r&7 into a &bRite Anchor&r&7 grants sites a strength boost, enhancing their efficacy when interacting with certain rite anchor etchings. Each site can accept this effect twice, each time doubling the strength."
		"&7"
		"{@pagebreak}"
		"&6Site Potency"
		"&7Embedding &bEarthen Arcana&r&7 into a &bRite Anchor&r&7 grants sites a potency boost, enhancing the strength of the effect produced per activation. Each site can accept this effect twice, each time doubling the potency."
		"&7"
		"{@pagebreak}"
		"&6Site Range"
		"&7Embedding &bInfernal Fire Arcana&r&7 into a &bRite Anchor&r&7 grants sites a range boost, allowing them to travel further before dissipating. Each site can accept this effect twice, each time doubling the range."
		"&7"
		"{@pagebreak}"
		"&6Repairing Sites"
		"&7Embedding &bSacred Arcana&r&7 into a &bRite Anchor&r&7 causes sites to continuously repair themselves, extending their existence time, thus traveling further. Each site can accept this effect four times."
		"&7"
		"{@pagebreak}"
		"&6Reviving Sites"
		"&7Embedding &bWicked Arcana&r&7 into a &bRite Anchor&r&7 causes sites to sacrifice existing elemental boosts to instantly repair themselves. The limit is the same as for Sacred Arcana."
		"&7"
		"{@pagebreak}"
		"&6Directing Sites"
		"&7Embedding &bPrimordial Arcana&r&7 into a &bRite Anchor&r&7 causes sites to change their flight path, without cost or side effects. Primordial Arcana is pure energy without direction; its effect is naturally relatively mundane, but fitting."
		"&7"
		"{@pagebreak}"
		"&6Splitting Sites"
		"&7Embedding &bEldritch Arcana&r&7 into a &bRite Anchor&r&7 causes sites to split into two unrelated but functionally identical sites. Each site can accept this effect four times. The duplicated sites are monochrome and cannot be duplicated further."
		"&7"
		"{@pagebreak}"
		"&6Rite Research: Elemental Boosts"
		"&7A site is a primitive arcane construct; it has no specialization and thus limited functionality. Using &bRite Anchors&r&7 to transmit &eElemental Arcana&r&7 solves this problem, though I need to detail the specific functions."
		"&7"
		"&7When a rite site flies over a rite anchor etched with &bAzure Sky&r&7, &bAzure Water&r&7, &bEarthen&r&7, or &bInfernal Fire&r&7 sigils, it receives an elemental boost. Only the first two applications within a group are effective. Also, because the site's structure is simple, it can only accept up to four boosts."
		"&7"
		"{@pagebreak}"
		"&6Rite Research: Site Revival"
		"&7A site is a primitive arcane construct; my prototype design only required etched effects and mobility. Later, self-maintenance was added as a key function. Not self-repair like a living being, but still self-sustaining."
		"&7"
		"&7Upon receiving the command of &cWicked Arcana&r&7, a site forcibly sacrifices itself. It abandons all existing elemental boosts. Speed is least important, so speed boosts are abandoned first. Next is strength, then potency. Range is most important and is only abandoned when no other boosts remain."
	]
	quest.7F578E1D8C765465.quest_subtitle: "Moving Arcana"
	quest.7F578E1D8C765465.title: "Site Management"
	quest.7F921AB47163D20E.quest_desc: ["This item changes the maximum spawn delay. A shorter maximum delay means that when conditions are met, the spawner guarantees a spawn in the shortest possible time. One item affects the time by 20 ticks. Generally used in conjunction with the minimum spawn delay."]
	quest.7F921AB47163D20E.quest_subtitle: "MADE IN HAVEN"
	quest.7FD6941949B8C8F4.quest_desc: [
		"&6Mechanical Crafter&r"
		"&7An operation component capable of automatically crafting items.&r"
		"&7Stress Consumption: &c2 su/RPM&r"
		""
		"&6Usage&r"
		"&6Item Crafting&r"
		"&7Executes ‘&eAuto-Crafting&r&7’ and ‘&6Powered Crafting&r&7’ recipes.&r"
		"&7‘Auto-Crafting’ automatically adapts all vanilla crafting table recipes; ‘Powered Crafting’ are special Create recipes.&r"
		""
		"&6Placement and Adjustment&r"
		"&7When crafting, place multiple crafters in the shape of the target recipe to form a &eCrafting Structure&r&7.&r"
		"&7Then, use a wrench to adjust internal paths so crafters' crafting paths connect.&r"
		"&7After connecting paths, you must set an &aItem Exit&r&7, or crafting won't complete.&r"
		""
		"&6Material Input and Power&r"
		"&7Players can right-click a crafter's front with items to insert directly, or input via logistics from any side. It's also a valid target for Mechanical Arms.&r"
		"&7It requires stress input via a gear on its side. It can transmit power, so a structure needs power in only one place.&r"
		""
		"&6Operation&r"
		"&6Triggering&r"
		"&7When all crafters in a structure are filled, it automatically starts. To force-start an unfilled structure, give a redstone signal to any crafter.&r"
		"&7Install ‘&eCrafter Covers&r&7’ on crafters. Covered crafters cannot store items but are considered filled; when others are filled, the structure starts automatically.&r"
		""
		"&6Starting Craft&r"
		"&7During operation, materials move along paths from ends toward the exit, each step taking &c1000/RPM Ticks&7.&r"
		"&7When all materials reach the end, they consume one step time to craft the product, then the product is ejected.&r"
		"&7If the end crafter points to a container, the product is stored there.&r"
		"&7If the recipe is invalid, all materials are ejected at the last step.&r"
		""
		"&6Linking&r"
		"&7Hold a wrench and right-click the seam between two crafters facing the same direction to link them. When one receives items, items are distributed evenly among linked crafters.&r"
		"&7Right-click the same seam again with a wrench to unlink.&r"
		""
		"&6Crafting Speed&r"
		"&7Speed mainly depends on RPM, but not solely.&r"
		"&7The number of steps also affects speed. This depends on path arrangement; optimized paths reduce steps, improving efficiency.&r"
		""
		"&8This manuscript page is sticky. You can't help but wonder what its owner synthesized it with.&r"
	]
	quest.7FF37718528D1FB5.quest_desc: ["&6Compared to the previous two tomes, the Extraction Tome is particularly precious—it can completely extract the enchantment energy from an item without damaging it at all.&r"]
	quest.7FF37718528D1FB5.quest_subtitle: "Recycle... No Recycling! Reuse!"
	quest.7FFEDC8A8DA45A2F.quest_desc: [
		"# &6Font Preferences &r"
		""
		"### &eAvailable Fonts &r"
		"&fThe modpack provides two fonts by default:"
		"&7- Storage path: &e\\\\kubejs\\\\assets\\\\ &r"
		"&7- &6ChironGoRoundTC &r (Default font)"
		"&7- &6Maple_UI.ttf &r"
		""
		"### &bFont Switching Method &r"
		"1. Press &4Ctrl + K &r to open the Modern UI control interface."
		"2. Click &ePreference Settings &r"
		"3. In the interface, &eswipe right &r"
		"4. Select your preferred font."
		""
		"### &3Custom Fonts &r"
		"&7- You can download other font files yourself."
		"&7- Place the font file in any directory and call it directly."
		"&7- &aAll default fonts are free for commercial use, no copyright risk. &r"
		""
		"&7- Default uses the &6ChironGoRoundTC .ttf &r font."
	]
	quest.7FFEDC8A8DA45A2F.quest_subtitle: "Don't like the modpack's fonts!"
	reward.0039A626D8431A26.title: "Forget All Learned Spells"
	reward.0116627ECA2E3471.title: "Toggle Fragile Soul Status"
	reward.0271EB97C3EE0E0B.title: "Disable Exile Effect"
	reward.0587A8A6F15D12D2.title: "Warrior"
	reward.08D44DB184D9838B.title: "Second Chance"
