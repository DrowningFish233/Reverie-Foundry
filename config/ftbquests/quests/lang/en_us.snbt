	quest.02AFD33E635B23E1.quest_desc: [
		"&6Mindbreak Addict Treaty"
		"&7Spell-induced side effects should not be underestimated.&r&cEach day without harvesting souls leads to withdrawal stacking, constantly consuming more hunger until craving satisfied"
		"&7Spells imposed on consciousness—endless craving for arcane energy.&r&aShattering souls yields extra arcane energy&r&aConsecutive shatters yield more"
	]
	quest.02AFD33E635B23E1.quest_subtitle: "Break Mind Repeatedly"
	quest.02AFD33E635B23E1.title: "Mindbreak Addict Treaty"
	quest.02BFE6EA90831AED.quest_desc: [
		"&6Burdened Consciousness Oath&r"
		""
		"&7Knowledge gained demands careful consideration.&r"
		"&7-&cSpell&r&7 charge time increased by one quarter&r"
		""
		"&7Arcane knowledge dwelling within consciousness.&r"
		"&7-&aSpell bullet capacity&r&7 doubled&r"
	]
	quest.02BFE6EA90831AED.quest_subtitle: "Ten-Thousand Jun Burden"
	quest.02BFE6EA90831AED.title: "Burdened Consciousness Oath"
	quest.02CBB1D9A926F86B.quest_desc: [
		"&6Trade Mat&r"
		""
		"&7A block that combines item display and trading functionality. It can store and display up to four items, accessible via right-click. The texture connects automatically when multiple Trade Mats are placed adjacently.&r"
		""
		"&6Shop Functionality&r"
		"&7When paired with a &eSchematicannon&r&7, it can build an automated shop to sell stocked items to other players and collect payment.&r"
		""
		"&6Setting up for Sale&r"
		"&7To build a shop, follow these steps:&r"
		"&7Hold the Trade Mat and right-click a &eStorage Manager&r.&r"
		"&7In the interface, select the item(s) and quantity to sell, specify the destination for goods, then click the &a\"Configure\"&r&7 button.&r"
		"&7Place the configured Trade Mat in a suitable location to display the goods.&r"
		"&7Set the price for the goods on the side of the Trade Mat.&r"
		"&7Each selling Trade Mat can be configured for up to nine types of goods, but only the first four can be displayed simultaneously.&r"
		"&7Be sure to &clock the logistics network&r&7 in the top-right corner of the Storage Manager interface to prevent others from directly extracting goods.&r"
		"{@pagebreak}"
		"&6Purchasing Items&r"
		"&7Aim at a selling Trade Mat to view transaction details. Direct trade is possible when stock is sufficient.&r"
		"&7Right-clicking a selling Trade Mat yields a &ePurchase List&r&7, which records currently selected goods. Holding the list allows you to continue shopping for other goods in the same store, with subsequent items automatically added to the list.&r"
		"&7Hold the Purchase List and right-click the Manager to check out. The system will automatically deduct corresponding payment items from your inventory. The &eSchematicannon&r&7 will then send a request to extract the purchased goods.&r"
		"&7Payment from customers is temporarily stored in the Schematicannon. The shop owner can right-click to collect it directly or use components like &eHoppers&r&7 for automatic extraction.&r"
		""
		"&8A note in small script beside the manuscript: Display, price, trade—all governed by simple contract.&r"
	]
	quest.02CBB1D9A926F86B.quest_subtitle: "Trade Mat/Desktop"
	quest.02CBB1D9A926F86B.title: "Shop"
	quest.0342F51828C72B82.quest_subtitle: "Recidivist"
	quest.03639EDED6577831.quest_desc: [
		"&#FFD700Greed - Corrosion&r&7"
		"&7No special multiplier correction under normal conditions.&r"
		"&#00FFAA[Every 10 seconds]&r&7 If you have the &#FFAA00Greed&r&7 effect, increase its level by 1 (max level 3).&r"
		"&#00FFAA[Upon being attacked]&r&7 If you have the &#FFAA00Greed&r&7 effect, reset its level to 1.&r"
		"&7"
		"&#00FFAA[Per level of Greed effect]&r&7 Provides the following bonuses:&r"
		"&7- Mob drop chance for special items +5%&r"
		"&7- Looting, Luck of the Sea, and other enchantment effect levels +2&r"
		"&7- Experience orb and item pickup range +2 blocks&r"
		"&7- Mining and kill experience gain +35%&r"
		"&7- Chance for spell scrolls not to consume +15%&r"
	]
	quest.046E980EB69A1209.quest_desc: [
		"&6Miniature Totem&r"
		"&7Can be bound to a familiar, and a familiar can only be bound to one totem at a time. When that familiar dies and you have no mana to resurrect it, the bound totem will be consumed to &arevive&r&7 the familiar, and the totem will also be consumed.&r"
	]
	quest.0490EDB36F1CF908.quest_subtitle: "The Sky is the Limit"
	quest.04DD58980F332FEE.quest_subtitle: "Survivor's Essential"
