	]
	quest.017E000317AA737C.quest_subtitle: "Sword, come!"
	quest.017E000317AA737C.title: "Flying Sword"
	quest.01891B78BD11035B.quest_subtitle: "Choose One of Two"
	quest.01891B78BD11035B.title: "&a\"Honey That Conceals Suffering at the Start?!\""
	quest.01DFC41A894B42AC.quest_desc: [
		"&7Can be used for &#66CCFFfishing&7. You can use &#FFD700Luck&7 to shorten the bite time."
		"&7The number of hooks cast is determined by the fishing rod's &6rarity&7 attribute. When any one hook gets a bite, all hooks are considered successful and yield loot."
