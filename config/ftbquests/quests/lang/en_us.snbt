		""
		"&7When it fell again, the power sealed within its body seemed to dissipate... I must go investigate and see what traces were left."
		""
		"&dUnlock: Magical Minerals"
	]
	quest.0BCF6B18963AB88F.quest_subtitle: "Power of the Dead"
