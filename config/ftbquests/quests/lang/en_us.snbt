	quest.0C2F2186BE39605E.quest_desc: [
		"&6Hunter Camp&r"
		"&7Hunters live in groups, so they build camps along their main hunting routes, primarily in &bforest&r&7 biomes rich in prey. These camps can also be found using the &eScroll Map&r&7 obtained from the Origin Island.&r"
	]
	quest.0C2F2186BE39605E.quest_subtitle: "Discover a Hunter Camp"
	quest.0C2F2186BE39605E.title: "&6Hunter Camp&r"
	quest.0C95DCE08BB56AF5.quest_desc: [
		"&6Soul-Solidifying Rune&r"
		""
		"&7Soul-Solidifying Rune does not enhance form's abilities, but only applies pressure to its arcane existence, increasing &esoul shield&r&7 capacity and stability.&r"
	]
	quest.0C95DCE08BB56AF5.quest_subtitle: "Pulse Promoting Creation"
	quest.0CC6907B16C93F5E.quest_subtitle: "Jungle Essence"
	quest.0CCFA64CA88D2D22.quest_desc: [
		"# &3Press R Key for One-Key Sorting (Under Default Settings) &r"
		""
		"### &bNotes &r"
		"&7- By default, pressing R sorts in creative mode&r "
		"&7- Pressing Shift+R sorts by quantity&r "
